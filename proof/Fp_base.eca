(* the parameters of the exponentiation, as Bn_exp expects them *)
hoare fun_mulU_h _c _x _y:
 M(P).fun_mulU
 : arg.`3 = _c /\ ctx_fp (bn (FPC.ctxP _c)) _c
   /\ 0 <= bn arg.`1 < bn (FPC.ctxP _c) /\ 0 <= bn arg.`2 < bn (FPC.ctxP _c)
   /\ bn arg.`1 = _x /\ bn arg.`2 = _y
   ==> bn res = red (bn (FPC.ctxP _c)) (_x * _y).
proof.
proc; exlim a, b => __a __b.
call (_mulmU__h (bn (FPC.ctxP _c)) __a __b); auto => />.
qed.

hoare fun_sqrU_h _c _x:
 M(P).fun_sqrU
 : arg.`2 = _c /\ ctx_fp (bn (FPC.ctxP _c)) _c
   /\ 0 <= bn arg.`1 < bn (FPC.ctxP _c) /\ bn arg.`1 = _x
   ==> bn res = red (bn (FPC.ctxP _c)) (_x * _x).
proof.
proc; exlim a => __a.
call (_sqrmU__h (bn (FPC.ctxP _c)) __a); auto => />.
qed.

(* additions and subtractions *)
lemma adc00 cf: to_uint (addc (W64.of_int 0) (W64.of_int 0) cf).`2 = b2i cf.
proof. by case: cf; rewrite addcE /=. qed.

hoare _addm__h _p _a _b:
 M(P)._addm_
 : FPC.ctx_mod _p ctx /\ a = _a /\ b = _b /\ bn _a < _p /\ bn _b < _p
   ==> bn res = (bn _a + bn _b) %% _p.
proof.
proc.
ecall (BNB._cminusP__h r tmp lastbit).
wp; ecall (BNB._add__h a b).
wp; skip => &hr [Hc [-> [-> [Ha Hb]]]] [cf r] /= Hs.
have [H1 [_ [_ HmP]]] := Hc.
have HPR := FPC.ctx_mod_bnd _ _ Hc.
rewrite adc00; split; first by case: cf Hs.
move=> _ rx ->.
have := addm_math _p BN.bn_modulus (bn _a) (bn _b) (b2i cf) (bn r) _ _ _ _ _ _.
- smt().
- smt(BN.bnk_cmp).
- smt(BN.bnk_cmp).
- by move: Hs; rewrite /bnk_withcarry BN.bn_modulusE /= /#.
- smt(BN.bnk_cmp BN.bn_modulusE).
- by case: cf Hs.
rewrite HmP.
by case: (BN.bn_modulus <= b2i cf * BN.bn_modulus + bn r + (BN.bn_modulus - _p)) => C /=;
 [rewrite BN.bn_ofintK | ].
qed.

hoare _addmU__h _p _a _b:
 M(P)._addmU_
 : FPC.ctx_mod _p ctx /\ a = _a /\ b = _b /\ bn _a < _p /\ bn _b < _p
   ==> bn res = (bn _a + bn _b) %% _p.
proof.
proc.
ecall (BNB._cminusP__h a tmp lastbit).
wp; ecall (BNB._addU__h a b).
wp; skip => &hr [Hc [-> [-> [Ha Hb]]]] [cf r] /= Hs.
have [H1 [_ [_ HmP]]] := Hc.
have HPR := FPC.ctx_mod_bnd _ _ Hc.
rewrite adc00; split; first by case: cf Hs.
move=> _ rx ->.
have := addm_math _p BN.bn_modulus (bn _a) (bn _b) (b2i cf) (bn r) _ _ _ _ _ _.
- smt().
- smt(BN.bnk_cmp).
- smt(BN.bnk_cmp).
- by move: Hs; rewrite /bnk_withcarry BN.bn_modulusE /= /#.
- smt(BN.bnk_cmp BN.bn_modulusE).
- by case: cf Hs.
rewrite HmP.
by case: (BN.bn_modulus <= b2i cf * BN.bn_modulus + bn r + (BN.bn_modulus - _p)) => C /=;
 [rewrite BN.bn_ofintK | ].
qed.

hoare _subm__h _p _a _b:
 M(P)._subm_
 : FPC.ctx_mod _p ctx /\ a = _a /\ b = _b /\ bn _a < _p /\ bn _b < _p
   ==> bn res = (bn _a - bn _b) %% _p.
proof.
proc.
ecall (BNB._caddU__h r tmp cf).
wp; ecall (BNB._sub__h a b).
wp; skip => &hr [Hc [-> [-> [Ha Hb]]]] [cf r] /= Hs.
have [H1 [_ [HP _]]] := Hc.
have HPR := FPC.ctx_mod_bnd _ _ Hc.
move=> rx ->.
have := subm_math _p BN.bn_modulus (bn _a) (bn _b) (b2i cf) (bn r) _ _ _ _ _ _.
- smt().
- smt(BN.bnk_cmp).
- smt(BN.bnk_cmp).
- by move: Hs; rewrite /bnk_withborrow BN.bn_modulusE /= /#.
- smt(BN.bnk_cmp BN.bn_modulusE).
- by case: cf Hs.
move=> H; case: cf Hs H => /= Hs H.
- by rewrite BN.bn_ofintK HP -H.
- by rewrite -H.
qed.

hoare _submU__h _p _a _b:
 M(P)._submU_
 : FPC.ctx_mod _p ctx /\ a = _a /\ b = _b /\ bn _a < _p /\ bn _b < _p
   ==> bn res = (bn _a - bn _b) %% _p.
proof.
proc.
ecall (BNB._caddU__h a tmp cf).
wp; ecall (BNB._subU__h a b).
wp; skip => &hr [Hc [-> [-> [Ha Hb]]]] [cf r] /= Hs.
have [H1 [_ [HP _]]] := Hc.
have HPR := FPC.ctx_mod_bnd _ _ Hc.
move=> rx ->.
have := subm_math _p BN.bn_modulus (bn _a) (bn _b) (b2i cf) (bn r) _ _ _ _ _ _.
- smt().
- smt(BN.bnk_cmp).
- smt(BN.bnk_cmp).
- by move: Hs; rewrite /bnk_withborrow BN.bn_modulusE /= /#.
- smt(BN.bnk_cmp BN.bn_modulusE).
- by case: cf Hs.
move=> H; case: cf Hs H => /= Hs H.
- by rewrite BN.bn_ofintK HP -H.
- by rewrite -H.
qed.

(* the bound check: err is set (all ones) unless a < p *)
hoare _chk_bnds__h _p _err _a:
 M(P)._chk_bnds_
 : FPC.ctx_mod _p ctx /\ err = _err /\ a = _a
   ==> res = _err `|` W64.of_int (- b2i (! (bn _a < _p))).
proof.
proc.
wp; ecall (BNUTIL.__ncf_mask_h cf).
ecall (BNB._lt_cf__h a p).
wp; skip => &hr [Hc [-> ->]] /=.
have [_ [_ [HP _]]] := Hc.
by rewrite HP.
qed.

(* P-2, the exponent of Fermat inversion *)
hoare __Pm2_h _p:
 M(P).__Pm2 : FPC.ctx_mod _p ctx ==> bn res = _p - 2.
proof.
have Hn := gt0_nlimbs.
proc.
while (1 <= i <= nlimbs /\ FPC.ctx_mod _p ctx /\ BN.bnk i r - b2i cf * W64.modulus ^ i = BN.bnk i (FPC.ctxP ctx) - 2).
- wp; skip => &hr [[[Hi1 Hi2] [Hc Hinv]] Hi] /=.
split; first smt().
split => //.
have := W64.subcP ctx{hr}.[i{hr}] (W64.of_int 0) cf{hr}.
case: (W64.subc ctx{hr}.[i{hr}] (W64.of_int 0) cf{hr}) => c' z /= E.
rewrite BN.bnkS 1:/# BN.bnkS 1:/# /= BN.A.get_setE 1:/# /= BN.bnk_setO 1:/#.
rewrite /FPC.ctxP BN.A.initiE 1:/# /= -/(FPC.ctxP ctx{hr}).
rewrite exprS 1:/#.
move: Hinv; rewrite (_: W64.modulus = 18446744073709551616) // => Hinv.
have Hz: to_uint z = to_uint ctx{hr}.[i{hr}] - b2i cf{hr} + 18446744073709551616 * b2i c' by smt().
have HB: bnk i{hr} r{hr} = bnk i{hr} (FPC.ctxP ctx{hr}) - 2 + b2i cf{hr} * 18446744073709551616 ^ i{hr} by smt().
by rewrite Hz HB; ring.
wp; skip => &hr /= Hc.
have [H1 [Hodd [HP HmP]]] := Hc.
split.
split; first smt().
split => //.
have := W64.subcP ctx{hr}.[0] (W64.of_int 2) false.
case: (W64.subc ctx{hr}.[0] (W64.of_int 2) false) => c' z /= E.
rewrite BN.bnk1 BN.bnk1 /= BN.A.get_setE 1:/# /= /FPC.ctxP BN.A.initiE 1:/# /=.
smt().
move=> cf0 i0 r0 Hi0 [[Hi1 Hi2] [_ Hinv]].
move: Hinv; rewrite (_: i0 = nlimbs) 1:/# HP -BN.bn_modulusE => Hinv.
have Hr := BN.bnk_cmp nlimbs r0.
move: Hr; rewrite -BN.bn_modulusE => Hr.
case: cf0 Hinv => /= Hinv; smt().
qed.

(* the exponentiation parameters of the sub-instance BNE *)
lemma P_EXP_mulU_h c x y:
 hoare [ M(P).P_EXP.fun_mulU
       : ctx = c /\ ctx_fp (bn (FPC.ctxP c)) c
         /\ 0 <= bn a < bn (FPC.ctxP c) /\ 0 <= bn b < bn (FPC.ctxP c)
         /\ bn a = x /\ bn b = y
         ==> bn res = red (bn (FPC.ctxP c)) (x * y) ].
proof. by proc*; call (fun_mulU_h c x y); auto. qed.

lemma P_EXP_sqrU_h c x:
 hoare [ M(P).P_EXP.fun_sqrU
       : ctx = c /\ ctx_fp (bn (FPC.ctxP c)) c
         /\ 0 <= bn a < bn (FPC.ctxP c) /\ bn a = x
         ==> bn res = red (bn (FPC.ctxP c)) (x * x) ].
proof. by proc*; call (fun_sqrU_h c x); auto. qed.

(* losslessness *)
lemma _chk_bnds__ll: islossless M(P)._chk_bnds_.
proof. by proc; wp; call BNUTIL.__ncf_mask_ll; call BNB._lt_cf__ll; auto. qed.

lemma _addm__ll: islossless M(P)._addm_.
proof. by proc; call BNB._cminusP__ll; wp; call BNB._add__ll; auto. qed.

lemma _addmU__ll: islossless M(P)._addmU_.
proof. by proc; call BNB._cminusP__ll; wp; call BNB._addU__ll; auto. qed.

lemma _subm__ll: islossless M(P)._subm_.
proof. by proc; call BNB._caddU__ll; wp; call BNB._sub__ll; auto. qed.

lemma _submU__ll: islossless M(P)._submU_.
proof. by proc; call BNB._caddU__ll; wp; call BNB._subU__ll; auto. qed.

lemma _mulm__ll: islossless M(P)._mulm_.
proof. by proc; call fun_red_ll; wp; call fun_muln_ll; auto. qed.

lemma _mulmU__ll: islossless M(P)._mulmU_.
proof. by proc; call fun_red_ll; wp; call fun_muln_ll; auto. qed.

lemma _sqrm__ll: islossless M(P)._sqrm_.
proof. by proc; call fun_red_ll; wp; call fun_sqrn_ll; auto. qed.

lemma _sqrmU__ll: islossless M(P)._sqrmU_.
proof. by proc; call fun_red_ll; wp; call fun_sqrn_ll; auto. qed.

lemma fun_mulU_ll: islossless M(P).fun_mulU.
proof. by proc; call _mulmU__ll. qed.

lemma fun_sqrU_ll: islossless M(P).fun_sqrU.
proof. by proc; call _sqrmU__ll. qed.

lemma __Pm2_ll: islossless M(P).__Pm2.
proof. proc; while (true) (nlimbs - i); by auto => /#. qed.

lemma P_EXP_mulU_ll: islossless M(P).P_EXP.fun_mulU.
proof. by proc*; call fun_mulU_ll. qed.

lemma P_EXP_sqrU_ll: islossless M(P).P_EXP.fun_sqrU.
proof. by proc*; call fun_sqrU_ll. qed.

(* inversion (Fermat): a^(p-2) in the monoid of representatives; see
   red_mexp for its value *)
hoare _invmU__h _p _c _a:
 M(P)._invmU_
 : ctx = _c /\ a = _a /\ ctx_fp _p _c /\ bn _a < _p
   ==> bn res = BNE.mexp _c (bn _a) (_p - 2).
proof.
proc.
ecall (BNE._expmU_noct__h (<: M(P).P_EXP) P_EXP_mulU_ll P_EXP_sqrU_ll P_EXP_mulU_h P_EXP_sqrU_h _c a pm2).
ecall (__Pm2_h _p).
by wp; skip => /> *; split; [smt(BN.bnk_cmp) | move=> *; smt()].
qed.

hoare _invm__h _p _c _a:
 M(P)._invm_
 : ctx = _c /\ a = _a /\ ctx_fp _p _c /\ bn _a < _p
   ==> bn res = BNE.mexp _c (bn _a) (_p - 2).
proof.
proc.
ecall (BNE._expm_noct__h (<: M(P).P_EXP) P_EXP_mulU_ll P_EXP_sqrU_ll P_EXP_mulU_h P_EXP_sqrU_h _c a pm2).
ecall (__Pm2_h _p).
by wp; skip => /> *; split; [smt(BN.bnk_cmp) | move=> *; smt()].
qed.

lemma _invmU__ll: islossless M(P)._invmU_.
proof.
proc.
call (BNE._expmU_noct__ll (<: M(P).P_EXP) P_EXP_mulU_ll P_EXP_sqrU_ll P_EXP_mulU_h P_EXP_sqrU_h).
by call __Pm2_ll; auto.
qed.

lemma _invm__ll: islossless M(P)._invm_.
proof.
proc.
call (BNE._expm_noct__ll (<: M(P).P_EXP) P_EXP_mulU_ll P_EXP_sqrU_ll P_EXP_mulU_h P_EXP_sqrU_h).
by call __Pm2_ll; auto.
qed.

end section.

(* the value of a power of representatives *)
lemma red_mexp p c x n: ctx_fp p c => 0 <= x < p => 0 <= n =>
  red p (BNE.mexp c x n) = (red p x) ^ n %% p.
proof.
move=> Hc Hx; have [HP H1] := ctx_fp_p _ _ Hc.
elim/natind: n => [n Hn H0|n Hn IH _].
- rewrite (_: n = 0) 1:/# BNE.mexp0 expr0 modz_small 1:/#.
  by have [_ [_ [_ ->]]] := Hc.
- rewrite BNE.mexpS //= HP red_mul IH // modzMmr exprS //.
qed.
