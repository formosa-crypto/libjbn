section.

declare module P <: MParam.

declare axiom fun_muln_ll: islossless P.fun_muln.
declare axiom fun_sqrn_ll: islossless P.fun_sqrn.
declare axiom fun_red_ll: islossless P.fun_red.

declare axiom fun_muln_h _a _b:
 hoare [ P.fun_muln : arg.`2 = _a /\ arg.`3 = _b ==> BN2.bn res = bn _a * bn _b ].

declare axiom fun_sqrn_h _a:
 hoare [ P.fun_sqrn : arg.`2 = _a ==> BN2.bn res = bn _a * bn _a ].

declare axiom fun_red_h p _x:
 hoare [ P.fun_red
       : FPC.ctx_mod p arg.`3 /\ red_ctx p arg.`3 /\ arg.`2 = _x
         /\ BN2.bn _x < p * BN.bn_modulus
         ==> bn res = red p (BN2.bn _x) ].

(* products: the reduction of the product of the operands *)
hoare _mulm__h _p _a _b:
 M(P)._mulm_
 : FPC.ctx_mod _p ctx /\ red_ctx _p ctx /\ a = _a /\ b = _b /\ bn _a < _p /\ bn _b < _p
   ==> bn res = red _p (bn _a * bn _b).
proof.
proc.
ecall (fun_red_h _p tmp); wp.
ecall (fun_muln_h a b).
wp; skip => &hr /= [Hc [Hr [-> [-> [Ha Hb]]]]] t Ht.
have HPR := FPC.ctx_mod_bnd _ _ Hc.
split; last by move=> _ r ->; rewrite Ht.
do 2! (split => //).
rewrite Ht; apply (StdOrder.IntOrder.ltr_pmul); smt(BN.bnk_cmp).
qed.

