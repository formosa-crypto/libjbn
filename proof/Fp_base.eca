require import AllCore Int IntDiv List StdOrder.
from Jasmin require import JModel_x86.
import SLH64.

require JBigNumber.

(* Correctness contracts for fp_base@fp.jinc: arithmetic modulo P, given by
   a context, and generic in the multiplication (fun_muln/fun_sqrn) and in
   the reduction (fun_red), the module parameter of M.

   The reduction is abstract: it multiplies by a factor redK p, invertible
   modulo p, i.e. red p x = x * redK p mod p (R^-1 for Montgomery, 1 for a
   plain reduction). red p x is also the value that a representative x
   stands for, and red p (x * y) represents the product of the values of x
   and y. *)

(* Parameters *)
op nlimbs: int.
axiom gt0_nlimbs: 0 < nlimbs.
(* the limb indices of the exponentiation are signed words *)
axiom nlimbs_bnd: 64 * nlimbs < W64.modulus.

clone export JBigNumber.BigN
 with op nlimbs <- nlimbs
      proof gt0_nlimbs by exact gt0_nlimbs.

import BN2.
import BN.

require Bn_util.
clone Bn_util as BNUTIL.
module BNUTIL_M = BNUTIL.M.

require Bn_base.
clone Bn_base as BNB
 with op nlimbs <- nlimbs,
      theory BigN <- BigN,
      theory BNUTIL <- BNUTIL
      proof gt0_nlimbs by exact gt0_nlimbs.
module BNB_M = BNB.M.

require Fp_ctx.
clone Fp_ctx as FPC
 with op nlimbs <- nlimbs,
      theory BigN <- BigN
      proof gt0_nlimbs by exact gt0_nlimbs.
import FPC.CTX.

(* the reduction: its factor, and what it needs from a context *)
op redK : int -> int.
op red_ctx : int -> W64.t FPC.CTX.t -> bool.

op red (p x: int) : int = x * redK p %% p.

(* c is a context of p for this reduction: it holds p and R - p, what the
   reduction needs, and ONE, a representative of 1 *)
pred ctx_fp (p: int) (c: W64.t FPC.CTX.t) =
  FPC.ctx_mod p c /\ red_ctx p c
  /\ 0 <= bn (FPC.ctxONE c) < p /\ red p (bn (FPC.ctxONE c)) = 1.

(* the arithmetic of representatives *)
lemma red_range p x: 0 < p => 0 <= red p x < p.
proof. by move=> Hp; rewrite /red; smt(modz_ge0 ltz_pmod). qed.

lemma redMr p x y: red p (x * (y %% p)) = red p (x * y).
proof.
rewrite /red (_: x * (y %% p) * redK p = (y %% p) * (x * redK p)) 1:/# modzMml.
by rewrite (_: y * (x * redK p) = x * y * redK p); first by ring.
qed.

lemma redC p x y: red p (x * y) = red p (y * x).
proof. by rewrite mulzC. qed.

(* the value of a product of representatives *)
lemma red_mul p x y: red p (red p (x * y)) = red p x * red p y %% p.
proof.
rewrite {1}/red (_: x * y * redK p %% p * redK p = redK p * (x * y * redK p %% p)) 1:/#.
rewrite modzMmr /red modzMml modzMmr.
by rewrite (_: redK p * (x * y * redK p) = x * redK p * (y * redK p)); first by ring.
qed.

lemma red_assoc p x y z: red p (x * red p (y * z)) = red p (red p (x * y) * z).
proof.
rewrite /red.
rewrite (_: x * (y * z * redK p %% p) * redK p = (y * z * redK p %% p) * (x * redK p)) 1:/# modzMml.
rewrite (_: (x * y * redK p %% p) * z * redK p = (x * y * redK p %% p) * (z * redK p)) 1:/# modzMml.
by rewrite (_: y * z * redK p * (x * redK p) = x * y * redK p * (z * redK p)); first by ring.
qed.

lemma red_one p one x:
  red p one = 1 => 0 <= x < p => red p (one * x) = x.
proof.
rewrite /red => H1 Hx.
rewrite (_: one * x * redK p = (one * redK p) * x) 1:/# -modzMml H1 /=.
by rewrite modz_small /#.
qed.

lemma ctx_fp_p p c: ctx_fp p c => bn (FPC.ctxP c) = p /\ 1 < p.
proof. by move=> [[H1 [_ [HP _]]] _]. qed.

(* the monoid of representatives of a context *)
lemma fp_mmul_dom c x y:
  ctx_fp (bn (FPC.ctxP c)) c => 0 <= x < bn (FPC.ctxP c) => 0 <= y < bn (FPC.ctxP c) =>
  0 <= red (bn (FPC.ctxP c)) (x * y) < bn (FPC.ctxP c).
proof. by move=> Hc _ _; apply red_range; smt(ctx_fp_p). qed.

lemma fp_mone_dom c:
  ctx_fp (bn (FPC.ctxP c)) c => 0 <= bn (FPC.ctxONE c) < bn (FPC.ctxP c).
proof. by move=> [_ [_ [H _]]]. qed.

lemma fp_mmul1 c x:
  ctx_fp (bn (FPC.ctxP c)) c => 0 <= x < bn (FPC.ctxP c) =>
  red (bn (FPC.ctxP c)) (bn (FPC.ctxONE c) * x) = x.
proof. by move=> [_ [_ [_ H]]] Hx; apply red_one. qed.

(* the conditional corrections of the modular addition and subtraction *)
lemma addm_math (p R a b lb r: int):
  0 < p < R => 0 <= a < p => 0 <= b < p =>
  lb * R + r = a + b => 0 <= r < R => 0 <= lb <= 1 =>
  (if R <= lb * R + r + (R - p) then (r + (R - p)) %% R else r) = (a + b) %% p.
proof.
move=> [Hp HpR] [Ha0 Ha1] [Hb0 Hb1] Hs [Hr0 Hr1] Hlb.
case: (p <= a + b) => Hab.
- rewrite (_: (a + b) %% p = a + b - p).
  + by rewrite (_: a + b = (a + b - p) + 1 * p) 1:/# modzMDr modz_small /#.
  rewrite (_: R <= lb * R + r + (R - p)) 1:/# /=.
  case: (lb = 0) => Hl.
  + by rewrite (_: r + (R - p) = (a + b - p) + 1 * R) 1:/# modzMDr modz_small /#.
  + by rewrite modz_small /#.
- by rewrite modz_small 1:/# (_: !(R <= lb * R + r + (R - p))) 1:/# /= /#.
qed.

lemma subm_math (p R a b c r: int):
  0 < p < R => 0 <= a < p => 0 <= b < p =>
  r - c * R = a - b => 0 <= r < R => (c = 0 \/ c = 1) =>
  (if c = 1 then (r + p) %% R else r) = (a - b) %% p.
proof.
move=> [Hp HpR] [Ha0 Ha1] [Hb0 Hb1] Hs [Hr0 Hr1] [Hc|Hc]; rewrite Hc /=.
- by rewrite (_: r = a - b) 1:/# modz_small /#.
- rewrite (_: r + p = (a - b + p) + 1 * R) 1:/# modzMDr modz_small 1:/#.
  by rewrite (_: a - b = (a - b + p) + (-1) * p) 1:/# modzMDr modz_small /#.
qed.

(* exponentiation in the monoid of representatives *)
require Bn_exp.
clone Bn_exp as BNE
 with op nlimbs <- nlimbs,
      op nlimbsexp <- nlimbs,
      theory BigN <- BigN,
      theory BNexp <- BN,
      theory BNUTIL <- BNUTIL,
      theory BNB <- BNB,
      theory FPC <- FPC,
      op mok <- (fun c => ctx_fp (bn (FPC.ctxP c)) c),
      op mdom <- (fun c x => 0 <= x < bn (FPC.ctxP c)),
      op mmul <- (fun c x y => red (bn (FPC.ctxP c)) (x * y))
 proof gt0_nlimbs by exact gt0_nlimbs,
       gt0_nlimbsexp by exact gt0_nlimbs,
       nlimbsexp_bnd by exact nlimbs_bnd,
       nlimbs_bnd by exact nlimbs_bnd,
       mmul_dom by exact fp_mmul_dom,
       mmulA by smt(red_assoc),
       mmulC by smt(redC),
       mone_dom by exact fp_mone_dom,
       mmul1 by exact fp_mmul1.

