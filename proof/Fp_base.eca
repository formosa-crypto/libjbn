 M(P)._mulmU_
 : FPC.ctx_mod _p ctx /\ red_ctx _p ctx /\ a = _a /\ b = _b /\ bn _a < _p /\ bn _b < _p
   ==> bn res = red _p (bn _a * bn _b).
