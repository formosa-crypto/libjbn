(* the inverse by Fermat's little theorem: a^(p-2) in the monoid of
   representatives (Fp_base), which is the integers modulo p here *)
hoare _invm__h _p _c _a:
 M(P)._invm_
 : ctx = _c /\ a = _a /\ ctx_pm _p _c /\ bn _a < _p
   ==> bn res = FPB.BNE.mexp _c (bn _a) (_p - 2).
proof.
proc*; call (FPB._invm__h (<: M(P).P_FPB) P_FPB_muln_ll P_FPB_sqrn_ll P_FPB_red_ll P_FPB_muln_h P_FPB_sqrn_h P_FPB_red_h _p _c _a).
by auto => /> *; smt(ctx_pm_fp).
qed.

lemma _invm__ll: islossless M(P)._invm_.
proof. by proc*; call (FPB._invm__ll (<: M(P).P_FPB) P_FPB_muln_ll P_FPB_sqrn_ll P_FPB_red_ll P_FPB_muln_h P_FPB_sqrn_h P_FPB_red_h). qed.

hoare _invmU__h _p _c _a:
 M(P)._invmU_
 : ctx = _c /\ a = _a /\ ctx_pm _p _c /\ bn _a < _p
   ==> bn res = FPB.BNE.mexp _c (bn _a) (_p - 2).
proof.
proc*; call (FPB._invmU__h (<: M(P).P_FPB) P_FPB_muln_ll P_FPB_sqrn_ll P_FPB_red_ll P_FPB_muln_h P_FPB_sqrn_h P_FPB_red_h _p _c _a).
by auto => /> *; smt(ctx_pm_fp).
qed.

lemma _invmU__ll: islossless M(P)._invmU_.
proof. by proc*; call (FPB._invmU__ll (<: M(P).P_FPB) P_FPB_muln_ll P_FPB_sqrn_ll P_FPB_red_ll P_FPB_muln_h P_FPB_sqrn_h P_FPB_red_h). qed.

(* the context of a qualifying p (odd, c = R mod p < 2^32, R < 3p) *)
hoare _ctx_init__h _p:
 M(P)._ctx_init_
 : bn p = _p /\ 1 < _p /\ _p %% 2 = 1
   /\ BN.bn_modulus %% _p < 4294967296 /\ BN.bn_modulus < 3 * _p
   ==> ctx_pm _p res.
proof.
have Hn := gt0_nlimbs.
proc.
(* P and R-P *)
seq 10 : (bn p = _p /\ 1 < _p /\ _p %% 2 = 1 /\ BN.bn_modulus %% _p < 4294967296 /\ BN.bn_modulus < 3 * _p
          /\ FPC.ctx_mod _p ctx).
+ wp; ecall (BNB._neg__h p).
  wp; ecall (BNB._mov__h p).
  wp; skip => &hr [Hp [H1 [Hodd [Hc32 H3p]]]] /=.
  move=> r -> [cf t] Ht /=.
  rewrite !FPC.ctx_wrE.
  move: Hp => /= Hp.
  have [HP0 _] := FPC.ctx_wr_parts ctx{hr} 0 p{hr} _; first by left.
  have [HP1 [HMP1 _]] := FPC.ctx_wr_parts (FPC.ctx_wr ctx{hr} 0 p{hr}) nlimbs t _; first by right; left.
  rewrite /FPC.ctx_mod HP1 HMP1 HP0 /= (_: nlimbs <> 0) 1:/# /=.
  have := FPC.neg_val p{hr} cf t _ Ht; smt().
(* ONE = 1, R2 = 0 *)
seq 7 : (bn p = _p /\ 1 < _p /\ _p %% 2 = 1 /\ BN.bn_modulus %% _p < 4294967296 /\ BN.bn_modulus < 3 * _p
         /\ FPC.ctx_mod _p ctx /\ bn (FPC.ctxONE ctx) = 1).
+ wp; ecall (BNB._set0__h); wp; ecall (BNB._set0__h).
  wp; skip => &hr [Hp [H1 [Hodd [Hc32 [H3p Hctx]]]]] /= t1 Ht1 t2 Ht2.
  rewrite !FPC.ctx_wrE.
  have H20: 2 * nlimbs <> 0 by smt().
  have H21: 2 * nlimbs <> nlimbs by smt().
  have H30: 3 * nlimbs <> 0 by smt().
  have H31: 3 * nlimbs <> nlimbs by smt().
  have H32: 3 * nlimbs <> 2 * nlimbs by smt().
  have [HP1 [HMP1 [HONE1 _]]] := FPC.ctx_wr_parts ctx{hr} (2 * nlimbs) t1 _; first by right; right; left.
  have [HP2 [HMP2 HONE2]] := ctx_setONE_parts (FPC.ctx_wr ctx{hr} (2 * nlimbs) t1) (W64.of_int 1).
  have [HP3 [HMP3 [HONE3 _]]] := FPC.ctx_wr_parts (FPC.ctx_wr ctx{hr} (2 * nlimbs) t1).[2 * nlimbs <- W64.of_int 1] (3 * nlimbs) t2 _; first by right; right; right.
  move: HP1 HMP1 HONE1 HP3 HMP3 HONE3; rewrite H20 H21 H30 H31 H32 /= => HP1 HMP1 HONE1 HP3 HMP3 HONE3.
  do 5! (split; first done).
  split; first by move: Hctx; rewrite /FPC.ctx_mod HP3 HMP3 HP2 HMP2 HP1 HMP1.
  by rewrite HONE3 HONE2 HONE1 FPC.bn_one_of_zero.
(* U0 = R mod p, from (R-p) + (R-p) *)
wp; ecall (BNB._cminusP__h x mP z); wp; ecall (BNB._mov__h mP).
wp; skip => &hr [Hp [H1 [Hodd [Hc32 [H3p [Hctx HONE]]]]]] /= r -> /=.
move=> r' ->.
have EmP: BN.A.init (fun i => ctx{hr}.[nlimbs + i]) = FPC.ctxMP ctx{hr} by rewrite /FPC.ctxMP.
rewrite EmP.
have [_ [_ [HP HmP]]] := Hctx.
have HpR := FPC.ctx_mod_bnd _p ctx{hr} Hctx.
have Hv := cminus_val (FPC.ctxMP ctx{hr}) _p HmP HpR H3p.
have [HP' [HMP' [HONE' [_ HU']]]] := FPC.ctx_setU0_parts ctx{hr}
   (if BN.bn_modulus <= bn (FPC.ctxMP ctx{hr}) + bn (FPC.ctxMP ctx{hr})
    then BN.bn_ofint (bn (FPC.ctxMP ctx{hr}) + bn (FPC.ctxMP ctx{hr}))
    else FPC.ctxMP ctx{hr}).[0].
rewrite /ctx_pm /pm_ctx /FPC.ctx_mod HP' HMP' HONE' HU' HONE /=.
split; first by move: Hctx; rewrite /FPC.ctx_mod.
split; last by split.
by rewrite -bn_word0; rewrite Hv //; move: Hc32; smt().
qed.

lemma _ctx_init__ll: islossless M(P)._ctx_init_.
proof.
proc.
wp; call BNB._cminusP__ll; wp; call BNB._mov__ll; wp; call BNB._set0__ll.
wp; call BNB._set0__ll; wp; call BNB._neg__ll; wp; call BNB._mov__ll.
by auto.
qed.

end section.
