(******************************************************************************
 **                                 CONTRACTS                                **
 ******************************************************************************)

section.

declare module P <: MParam.

declare axiom fun_muln_ll: islossless P.fun_muln.
declare axiom fun_sqrn_ll: islossless P.fun_sqrn.

declare axiom fun_muln_h _a _b:
 hoare [ P.fun_muln : arg.`2 = _a /\ arg.`3 = _b ==> BN2.bn res = bn _a * bn _b ].

declare axiom fun_sqrn_h _a:
 hoare [ P.fun_sqrn : arg.`2 = _a ==> BN2.bn res = bn _a * bn _a ].

(* the pseudo-Mersenne reduction: a mod p, for any a < R^2 *)
hoare _redPM_h p _a:
 M(P)._redPM
 : FPC.ctx_mod p ctx /\ pm_ctx p ctx /\ a = _a
   ==> bn res = BN2.bn _a %% p.
proof.
have Hn := gt0_nlimbs.
proc.
exists* ctx; elim* => cx.
have [H|[Hm Hu]]: !(FPC.ctx_mod p cx /\ pm_ctx p cx) \/ (FPC.ctx_mod p cx /\ pm_ctx p cx) by smt().
+ by conseq (_: false ==> _) => // /#.
have [H1 [Hodd [HP HmP]]] := Hm.
have [Hc [Hc32 H3p]] := Hu.
have HpR := FPC.ctx_mod_bnd p cx Hm.
(* the first fold: [r ; t] = lo + c * hi *)
seq 5 : (ctx = cx /\ a = _a /\ c = FPC.ctxU0 cx
         /\ bn r + to_uint t * 18446744073709551616 ^ nlimbs = bn (lo2 _a) + to_uint c * bn (hi2 _a)
         /\ to_uint t <= to_uint c).
+ while (ctx = cx /\ a = _a /\ c = FPC.ctxU0 cx /\ 0 <= i <= nlimbs
         /\ bnk i r + to_uint t * 18446744073709551616 ^ i = bnk i (lo2 _a) + to_uint c * bnk i (hi2 _a)
         /\ to_uint t <= to_uint c).
  - wp; skip => /> &hr Hi0 _ Hv Ht Hin.
    have M2 := JBigNumber.mac2P _a.[nlimbs + i{hr}] (FPC.ctxU0 cx) _a.[i{hr}] t{hr}.
    rewrite bnk_put 1:/# bnk_lo2S 1:/# bnk_hi2S 1:/#.
    split; first smt().
    split.
    - rewrite M2.
      have ->: bnk i{hr} r{hr} = bnk i{hr} (lo2 _a) + to_uint (FPC.ctxU0 cx) * bnk i{hr} (hi2 _a)
                                 - to_uint t{hr} * 18446744073709551616 ^ i{hr} by smt().
      by ring.
    apply (fold_hi _ _ _ _ _ _ (wbnd _) (wbnd _) (wbnd _) _ _ M2); move: Ht; smt(wbnd).
  wp; skip => /> &hr *.
  split; first by rewrite !BN.bnk0 /=; smt(W64.to_uint_cmp).
  move=> i0 r0 t0 Hi _ Hi0 Hi1 Hv Ht.
  have Ei: i0 = nlimbs by smt().
  by move: Hv Ht; rewrite Ei.
(* the second fold: [cf ; r] = r + t * c *)
exists* r, t; elim* => r1 t1.
seq 6 : (ctx = cx /\ c = FPC.ctxU0 cx
         /\ bn r + b2i cf * 18446744073709551616 ^ nlimbs = bn r1 + to_uint t1 * to_uint (FPC.ctxU0 cx)
         /\ bn r1 + to_uint t1 * 18446744073709551616 ^ nlimbs = bn (lo2 _a) + to_uint (FPC.ctxU0 cx) * bn (hi2 _a)
         /\ to_uint t1 <= to_uint (FPC.ctxU0 cx)).
+ while (ctx = cx /\ c = FPC.ctxU0 cx /\ 1 <= i <= nlimbs
         /\ bnk i r + b2i cf * 18446744073709551616 ^ i = bnk i r1 + to_uint t1 * to_uint (FPC.ctxU0 cx)
         /\ (forall k, i <= k < nlimbs => r.[k] = r1.[k])
         /\ bn r1 + to_uint t1 * 18446744073709551616 ^ nlimbs = bn (lo2 _a) + to_uint (FPC.ctxU0 cx) * bn (hi2 _a)
         /\ to_uint t1 <= to_uint (FPC.ctxU0 cx)).
  - wp; skip => /> &hr Hi1 _ Hv Hk HF Ht1 Hin.
    split; first smt().
    split; last smt(BN.A.get_setE).
    rewrite bnk_put 1:/# JBigNumber.addc_to_uint W64.to_uint0 bnkSw 1:/# -(Hk i{hr}) 1:/#.
    rewrite (_: W64.modulus = 18446744073709551616) //.
    have ->: bnk i{hr} r{hr} = bnk i{hr} r1 + to_uint t1 * to_uint (FPC.ctxU0 cx)
                               - b2i cf{hr} * 18446744073709551616 ^ i{hr} by smt().
    by ring.
  wp; skip => /> HF Ht1.
  split.
  - split; first smt().
    split; last smt(BN.A.get_setE).
    rewrite bnk_put0 JBigNumber.addc_to_uint bnk1w /=.
    rewrite W64.to_uintM_small; last by ring.
    have := sq32 (to_uint t1) (to_uint (FPC.ctxU0 cx)) _ _; smt(wbnd).
  move=> cf0 i0 r0 Hi0 Hi1 Hi2 Hv _.
  have Ei: i0 = nlimbs by smt().
  by move: Hv; rewrite Ei.
(* the correction: if cf, r + c (no carry) *)
seq 5 : (ctx = cx /\ bn r %% p = BN2.bn _a %% p).
+ wp; ecall (BNUTIL.__cf_mask_h cf); skip => /> &hr Hv HF Ht1.
  rewrite mask_and.
  have Rv: BN.bn_modulus = 18446744073709551616 ^ nlimbs by rewrite /BN.bn_modulus.
  have HR: BN.bn_modulus %% p = to_uint (FPC.ctxU0 cx) %% p by rewrite Hc modz_mod.
  have HA: BN2.bn _a %% p = (bn r{hr} + b2i cf{hr} * to_uint (FPC.ctxU0 cx)) %% p.
  - rewrite bn2_halves (modR _ _ _ _ _ HR).
    rewrite (_: bn (lo2 _a) + bn (hi2 _a) * to_uint (FPC.ctxU0 cx)
                = bn r1 + to_uint t1 * BN.bn_modulus) 1:/#.
    rewrite (modR _ _ _ _ _ HR).
    rewrite (_: bn r1 + to_uint t1 * to_uint (FPC.ctxU0 cx)
                = bn r{hr} + b2i cf{hr} * BN.bn_modulus) 1:/#.
    by rewrite (modR _ _ _ _ _ HR).
  rewrite HA; case: (cf{hr}) => Hcf /=.
  - have Hb := sq32 (to_uint t1) (to_uint (FPC.ctxU0 cx)) _ _; first 2 smt(wbnd).
    have Hr: bn r{hr} <= 18446744065119617025.
    + move: Hv; rewrite Hcf /= => Hv.
      have := bn_bnd r1; smt().
    rewrite bn_set0w W64.to_uintD_small.
    + rewrite -bn_word0; smt(wbnd).
    by rewrite -bn_word0; smt(wbnd).
  by rewrite bn_set0w /= /#.
(* two conditional subtractions of p *)
while (ctx = cx /\ 0 <= j <= 2 /\ bn r %% p = BN2.bn _a %% p /\ bn r < (3 - j) * p).
+ exists* r; elim* => r0.
  seq 5 : (ctx = cx /\ 0 <= j < 2 /\ r = r0 /\ bn r0 %% p = BN2.bn _a %% p /\ bn r0 < (3 - j) * p
           /\ bn _s + b2i cf * 18446744073709551616 ^ nlimbs = bn r0 + bn (FPC.ctxMP cx)).
  + while (ctx = cx /\ 0 <= j < 2 /\ r = r0 /\ bn r0 %% p = BN2.bn _a %% p /\ bn r0 < (3 - j) * p
           /\ 1 <= i <= nlimbs
           /\ bnk i _s + b2i cf * 18446744073709551616 ^ i = bnk i r0 + bnk i (FPC.ctxMP cx)).
    - wp; skip => /> &hr Hj0 Hj1 Hr0 Hb Hi1 _ Hv Hin.
      split; first smt().
      rewrite bnk_put 1:/# JBigNumber.addc_to_uint bnkSw 1:/# bnk_mPS 1:/#.
      rewrite (_: W64.modulus = 18446744073709551616) //.
      have ->: bnk i{hr} _s{hr} = bnk i{hr} r0 + bnk i{hr} (FPC.ctxMP cx)
                                  - b2i cf{hr} * 18446744073709551616 ^ i{hr} by smt().
      by ring.
    wp; skip => /> &hr Hj0 Hj2 Hb Hlt Hj1.
    split.
    - split; first smt().
      rewrite bnk_put0 JBigNumber.addc_to_uint !bnk1w /=.
      by rewrite /FPC.ctxMP BN.A.initiE; smt(gt0_nlimbs).
    move=> s0 cf0 i0 Hi0 Hi1 Hi2 Hv.
    have Ei: i0 = nlimbs by smt().
    by move: Hv; rewrite Ei.
  seq 2 : (ctx = cx /\ 0 <= j < 2 /\ bn r0 %% p = BN2.bn _a %% p /\ bn r0 < (3 - j) * p
           /\ bn _s + b2i cf * 18446744073709551616 ^ nlimbs = bn r0 + bn (FPC.ctxMP cx)
           /\ r = if cf then _s else r0).
  + while (ctx = cx /\ 0 <= j < 2 /\ bn r0 %% p = BN2.bn _a %% p /\ bn r0 < (3 - j) * p
           /\ bn _s + b2i cf * 18446744073709551616 ^ nlimbs = bn r0 + bn (FPC.ctxMP cx)
           /\ 0 <= i <= nlimbs
           /\ forall k, 0 <= k < nlimbs =>
                r.[k] = if k < i then (if cf then _s.[k] else r0.[k]) else r0.[k]).
    - wp; skip => /> &hr Hj0 Hj1 Hm0 Hb Hv Hi0 _ Hk Hin.
      split; first smt().
      move=> k Hk0 Hk1; rewrite BN.A.get_setE 1:/#.
      case: (k = i{hr}) => Ek; first by rewrite Ek Hk 1:/# /#.
      by rewrite Hk 1:/# /#.
    wp; skip => /> &hr Hj0 Hj1 Hm0 Hb Hv.
    split; first smt().
    move=> i0 r2 Hi0 Hi1 Hi2 Hk.
    apply BN.A.ext_eq => k Hk0; rewrite Hk 1:/#; smt().
  wp; skip => /> &hr Hj0 Hj1 Hm0 Hb Hv.
  have Rv: BN.bn_modulus = 18446744073709551616 ^ nlimbs by rewrite /BN.bn_modulus.
  have HmP' : bn (FPC.ctxMP cx) = 18446744073709551616 ^ nlimbs - p by rewrite HmP Rv.
  case: (cf{hr}) => Hcf /=.
  - have Es: bn _s{hr} = bn r0 - p by move: Hv; rewrite Hcf HmP' /= /#.
    split; first smt().
    split; last smt().
    by rewrite Es -Hm0 (_: bn r0 - p = bn r0 + (-1) * p) 1:/# modzMDr.
  have Hr0: bn r0 < p by move: Hv (bn_bnd _s{hr}); rewrite Hcf HmP' /= /#.
  smt().
wp; skip => /> &hr Hm1.
have Rv: BN.bn_modulus = 18446744073709551616 ^ nlimbs by rewrite /BN.bn_modulus.
split; first by move: (bn_bnd r{hr}) H3p; rewrite Rv; smt().
move=> j0 r0 Hj0 Hj1 Hj2 Hm0 Hb.
have Ej: j0 = 2 by smt().
have Hb2: bn r0 < p by move: Hb; rewrite Ej.
by rewrite -Hm0 modz_small; move: (bn_bnd r0); smt().
qed.

hoare _redPM__h p _a:
 M(P)._redPM_
 : FPC.ctx_mod p ctx /\ pm_ctx p ctx /\ a = _a
   ==> bn res = BN2.bn _a %% p.
proof. by proc; wp; call (_redPM_h p _a); auto. qed.

hoare fun_red_h p _a:
 M(P).fun_red
 : FPC.ctx_mod p ctx /\ pm_ctx p ctx /\ a = _a /\ BN2.bn _a < p * BN.bn_modulus
   ==> bn res = FPB.red p (BN2.bn _a).
proof. by proc; call (_redPM__h p _a); auto => /> *; rewrite red_mod. qed.

(* the representation is the number: conversions are the identity *)
hoare _toM__h _a:
 M(P)._toM_ : a = _a ==> res = _a.
proof. by proc; auto. qed.

hoare _fromM__h _a:
 M(P)._fromM_ : a = _a ==> res = _a.
proof. by proc; auto. qed.

(* losslessness *)
lemma _redPM_ll: islossless M(P)._redPM.
proof.
proc.
while true (2 - j).
+ move=> z; wp.
  while true (nlimbs - i); first by move=> z'; auto => /#.
  wp; while true (nlimbs - i); first by move=> z'; auto => /#.
  by auto => /#.
wp; call BNUTIL.__cf_mask_ll; wp.
while true (nlimbs - i); first by move=> z; auto => /#.
wp; while true (nlimbs - i); first by move=> z; auto => /#.
by auto => /#.
qed.

lemma _redPM__ll: islossless M(P)._redPM_.
proof. by proc; wp; call _redPM_ll; auto. qed.

lemma fun_red_ll: islossless M(P).fun_red.
proof. by proc; call _redPM__ll. qed.

lemma _toM__ll: islossless M(P)._toM_.
proof. by proc; auto. qed.

lemma _fromM__ll: islossless M(P)._fromM_.
proof. by proc; auto. qed.

(* the parameters of Fp_base: the multiplication of P, and the
   pseudo-Mersenne reduction *)
lemma P_FPB_muln_ll: islossless M(P).P_FPB.fun_muln.
proof. by proc*; call fun_muln_ll. qed.

lemma P_FPB_sqrn_ll: islossless M(P).P_FPB.fun_sqrn.
proof. by proc*; call fun_sqrn_ll. qed.

lemma P_FPB_red_ll: islossless M(P).P_FPB.fun_red.
proof. by proc*; call fun_red_ll. qed.

lemma P_FPB_muln_h _a _b:
 hoare [ M(P).P_FPB.fun_muln : a = _a /\ b = _b ==> BN2.bn res = bn _a * bn _b ].
proof. by proc*; call (fun_muln_h _a _b). qed.

lemma P_FPB_sqrn_h _a:
 hoare [ M(P).P_FPB.fun_sqrn : a = _a ==> BN2.bn res = bn _a * bn _a ].
proof. by proc*; call (fun_sqrn_h _a). qed.

lemma P_FPB_red_h p _x:
 hoare [ M(P).P_FPB.fun_red
       : FPC.ctx_mod p ctx /\ pm_ctx p ctx /\ a = _x /\ BN2.bn _x < p * BN.bn_modulus
         ==> bn res = FPB.red p (BN2.bn _x) ].
proof. by proc*; call (fun_red_h p _x). qed.

(* the field operations (Fp_base, with the reduction modulo p) *)
hoare _mulm__h _p _a _b:
 M(P)._mulm_
 : FPC.ctx_mod _p ctx /\ pm_ctx _p ctx /\ a = _a /\ b = _b /\ bn _a < _p /\ bn _b < _p
   ==> bn res = bn _a * bn _b %% _p.
proof.
proc*; call (FPB._mulm__h (<: M(P).P_FPB) P_FPB_muln_ll P_FPB_sqrn_ll P_FPB_red_ll P_FPB_muln_h P_FPB_sqrn_h P_FPB_red_h _p _a _b).
by auto => /> *; rewrite red_mod.
qed.

lemma _mulm__ll: islossless M(P)._mulm_.
proof. by proc*; call (FPB._mulm__ll (<: M(P).P_FPB) P_FPB_muln_ll P_FPB_sqrn_ll P_FPB_red_ll P_FPB_muln_h P_FPB_sqrn_h P_FPB_red_h). qed.

