hoare _chk_bnds__h _p _err _a:
 M(P)._chk_bnds_
 : FPC.ctx_mod _p ctx /\ err = _err /\ a = _a
   ==> res = _err `|` W64.of_int (- b2i (! (bn _a < _p))).
proof. by proc*; call (FPB._chk_bnds__h (<: M(P).P_FPB) P_FPB_muln_ll P_FPB_sqrn_ll P_FPB_red_ll P_FPB_muln_h P_FPB_sqrn_h P_FPB_red_h _p _err _a). qed.

