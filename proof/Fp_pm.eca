require import AllCore Int IntDiv List StdOrder.
from Jasmin require import JModel_x86.
import SLH64.

require JBigNumber.

(* Correctness contracts for fp_pm@fp.jinc: arithmetic modulo a
   pseudo-Mersenne P, in normal representation, generic in the
   multiplication (fun_muln/fun_sqrn, the module parameter of M).

   With R = 2^(64*nlimbs), P qualifies when c = R mod P < 2^32 and R < 3P;
   the context holds c in place of U0. The field operations are those of
   Fp_base, with the reduction modulo P (factor 1): a representative is the
   number itself. *)

(* Parameters *)
op nlimbs: int.
axiom gt0_nlimbs: 0 < nlimbs.
(* as in Fp_base, which bounds its loop counters with it *)
axiom nlimbs_bnd: 64 * nlimbs < W64.modulus.

clone export JBigNumber.BigN
 with op nlimbs <- nlimbs
      proof gt0_nlimbs by exact gt0_nlimbs.

import BN2.
import BN.

require Bn_util.
clone Bn_util as BNUTIL.
module BNUTIL_M = BNUTIL.M.

require Bn_base.
clone Bn_base as BNB
 with op nlimbs <- nlimbs,
      theory BigN <- BigN,
      theory BNUTIL <- BNUTIL
      proof gt0_nlimbs by exact gt0_nlimbs.
module BNB_M = BNB.M.

require Fp_ctx.
clone Fp_ctx as FPC
 with op nlimbs <- nlimbs,
      theory BigN <- BigN
      proof gt0_nlimbs by exact gt0_nlimbs.
import FPC.CTX.

(* the reduction modulo p (factor 1); it needs c = R mod p in place of U0,
   and the qualification of p: c < 2^32, R < 3p *)
op one_k (p: int) : int = 1.
op pm_ctx (p: int) (c: W64.t FPC.CTX.t) : bool =
  to_uint (FPC.ctxU0 c) = BN.bn_modulus %% p
  /\ BN.bn_modulus %% p < 4294967296 /\ BN.bn_modulus < 3 * p.

require Fp_base.
clone Fp_base as FPB
 with op nlimbs <- nlimbs,
      theory BigN <- BigN,
      theory BNUTIL <- BNUTIL,
      theory BNB <- BNB,
      theory FPC <- FPC,
      op redK <- one_k,
      op red_ctx <- pm_ctx
 proof gt0_nlimbs by exact gt0_nlimbs,
       nlimbs_bnd by exact nlimbs_bnd.

lemma red_mod p x: FPB.red p x = x %% p.
proof. by rewrite /FPB.red /one_k. qed.

(* a context of the pseudo-Mersenne field: P, R-P, c, and ONE = 1 *)
pred ctx_pm (p: int) (c: W64.t FPC.CTX.t) =
  FPC.ctx_mod p c /\ pm_ctx p c /\ bn (FPC.ctxONE c) = 1.

(* it is a context of the field operations (Fp_base) *)
lemma ctx_pm_fp p c: ctx_pm p c => FPB.ctx_fp p c.
proof.
move=> [Hm [Hu Hone]]; have [H1 _] := Hm.
split => //; split => //; rewrite Hone red_mod.
by split; [smt() | rewrite modz_small /#].
qed.

(* the halves of a double-size number *)
op lo2 (a: BN2.t) : BN.t = BN.A.init (fun i => a.[i]).
op hi2 (a: BN2.t) : BN.t = BN.A.init (fun i => a.[nlimbs + i]).

lemma bn2_halves (a: BN2.t): BN2.bn a = bn (lo2 a) + bn (hi2 a) * BN.bn_modulus.
proof. by apply bn2_pack => j Hj; rewrite BN.A.initiE. qed.

lemma bnk_lo2S (a: BN2.t) i: 0 <= i < nlimbs =>
  bnk (i+1) (lo2 a) = bnk i (lo2 a) + to_uint a.[i] * 18446744073709551616 ^ i.
proof.
move=> Hi; rewrite BN.bnkS 1:/# /= {1}/lo2 BN.A.initiE 1:/# /=.
by ring.
qed.

lemma bnk_hi2S (a: BN2.t) i: 0 <= i < nlimbs =>
  bnk (i+1) (hi2 a) = bnk i (hi2 a) + to_uint a.[nlimbs + i] * 18446744073709551616 ^ i.
proof.
move=> Hi; rewrite BN.bnkS 1:/# /= {1}/hi2 BN.A.initiE 1:/# /=.
by ring.
qed.

(* the first fold: the high word of x * c + z + t, for t <= c, is at most c *)
lemma fold_hi (x z t l h c: int):
  0 <= x < 18446744073709551616 => 0 <= z < 18446744073709551616 =>
  0 <= c < 18446744073709551616 => 0 <= t <= c => 0 <= l =>
  l + 18446744073709551616 * h = x * c + z + t => h <= c.
proof.
move=> [Hx0 Hx1] [Hz0 Hz1] [Hc0 Hc1] [Ht0 Ht1] Hl E.
have Hxc: x * c <= 18446744073709551615 * c by apply StdOrder.IntOrder.ler_wpmul2r; smt().
smt().
qed.

(* writing the first word of a big number *)
lemma wbnd (w: W64.t): 0 <= to_uint w < 18446744073709551616.
proof.
by have := W64.to_uint_cmp w.
qed.

lemma bnkSw (x: BN.t) i: 0 <= i =>
  bnk (i+1) x = bnk i x + to_uint x.[i] * 18446744073709551616 ^ i.
proof.
move=> Hi; rewrite BN.bnkS //=.
by ring.
qed.

lemma bn_bnd (x: BN.t): 0 <= bn x < 18446744073709551616 ^ nlimbs.
proof.
by have := BN.bnk_cmp nlimbs x.
qed.

lemma modR (p r c x y: int): r %% p = c %% p => (x + y * r) %% p = (x + y * c) %% p.
proof.
move=> H.
by rewrite -modzDmr -modzMmr H modzMmr modzDmr.
qed.

lemma bnk1w (x: BN.t): bnk 1 x = to_uint x.[0].
proof.
by rewrite BN.bnk1 /BN.dig expr0.
qed.

lemma bnk_put0 (r: BN.t) (lo: W64.t) (v: int):
  bnk 1 r.[0 <- lo] + v * 18446744073709551616 = to_uint lo + 18446744073709551616 * v.
proof.
by rewrite bnk1w BN.A.get_setE; smt(gt0_nlimbs).
qed.

lemma sq32 (t c: int): 0 <= t <= c => c < 4294967296 => t * c <= 18446744065119617025.
proof.
move=> [Ht0 Ht1] Hc.
have H1: t * c <= c * c by apply StdOrder.IntOrder.ler_wpmul2r; smt().
have H2: c * c <= 4294967295 * 4294967295 by apply StdOrder.IntOrder.ler_pmul; smt().
smt().
qed.

lemma bnk_mPS (c: W64.t FPC.CTX.t) i: 0 <= i < nlimbs =>
  bnk (i+1) (FPC.ctxMP c) = bnk i (FPC.ctxMP c) + to_uint c.[nlimbs + i] * 18446744073709551616 ^ i.
proof.
move=> Hi; rewrite bnkSw 1:/#.
by rewrite {2}/FPC.ctxMP BN.A.initiE 1:/#.
qed.

lemma ctx_setONE_parts (c: W64.t FPC.CTX.t) u:
  FPC.ctxP c.[2 * nlimbs <- u] = FPC.ctxP c
  /\ FPC.ctxMP c.[2 * nlimbs <- u] = FPC.ctxMP c
  /\ FPC.ctxONE c.[2 * nlimbs <- u] = (FPC.ctxONE c).[0 <- u].
proof.
have Hn := gt0_nlimbs.
split; first by apply BN.A.ext_eq => i Hi; rewrite /FPC.ctxP !BN.A.initiE //= FPC.CTX.get_setE 1:/#; smt().
split; first by apply BN.A.ext_eq => i Hi; rewrite /FPC.ctxMP !BN.A.initiE //= FPC.CTX.get_setE 1:/#; smt().
apply BN.A.ext_eq => i Hi; rewrite /FPC.ctxONE BN.A.initiE //= FPC.CTX.get_setE 1:/#.
by rewrite BN.A.get_setE //= BN.A.initiE //=; smt().
qed.

(* (R-p) + (R-p), reduced once by R-p (the last step of _ctx_init_), is R mod p *)
lemma cminus_val (x: BN.t) p: bn x = BN.bn_modulus - p => 1 < p < BN.bn_modulus => BN.bn_modulus < 3 * p =>
  bn (if BN.bn_modulus <= bn x + bn x then BN.bn_ofint (bn x + bn x) else x) = BN.bn_modulus %% p.
proof.
move=> Hx [H1 HpR] H3.
case: (BN.bn_modulus <= bn x + bn x) => H /=.
- rewrite BN.bn_ofintK Hx.
  have E1: (BN.bn_modulus - 2 * p + 1 * BN.bn_modulus) %% BN.bn_modulus = BN.bn_modulus - 2 * p.
  + by rewrite modzMDr modz_small; smt().
  have E2: (BN.bn_modulus - 2 * p + 2 * p) %% p = BN.bn_modulus - 2 * p.
  + by rewrite modzMDr modz_small; smt().
  move: E1 E2; rewrite (_: BN.bn_modulus - 2 * p + 1 * BN.bn_modulus = BN.bn_modulus - p + (BN.bn_modulus - p)) 1:/#.
  by rewrite (_: BN.bn_modulus - 2 * p + 2 * p = BN.bn_modulus) 1:/# => -> ->.
rewrite Hx.
have E: (BN.bn_modulus - p + 1 * p) %% p = BN.bn_modulus - p by rewrite modzMDr modz_small; smt().
by move: E; rewrite (_: BN.bn_modulus - p + 1 * p = BN.bn_modulus) 1:/# => ->.
qed.

lemma bn_set0w (x: BN.t) (y: W64.t):
  bn x.[0 <- y] = bn x - to_uint x.[0] + to_uint y.
proof.
have Hn := gt0_nlimbs.
have E := BN.bn_k_kup 1 x.[0 <- y] _; first smt().
have Ex := BN.bn_k_kup 1 x _; first smt().
have Hup := BN.bnkup_setO 1 x y _; first smt().
move: Hup; rewrite (_: 1 - 1 = 0) 1:// => Hup.
by rewrite E Ex Hup !BN.bnk1 /= BN.A.get_setE 1:/#; ring.
qed.

(* a big number below 2^64 is its first word *)
lemma bn_word0 (x: BN.t): bn x < 18446744073709551616 => bn x = to_uint x.[0].
proof.
move=> Hx; have Hn := gt0_nlimbs.
have Ex := BN.bn_k_kup 1 x _; first smt().
have Hu: 0 <= BN.bnkup 1 x.
+ rewrite -BN.bn_div_kup 1:/#; apply divz_ge0; smt(StdOrder.IntOrder.expr_gt0 BN.bnk_cmp).
have := W64.to_uint_cmp x.[0].
move: Ex Hx; rewrite BN.bnk1 /=; smt().
qed.

(* the mask of the third fold: c when the carry is set, 0 otherwise *)
lemma mask_and (cf: bool) (c: W64.t):
  W64.of_int (- b2i cf) `&` c = if cf then c else W64.zero.
proof.
case: cf => /=; last by rewrite W64.and0w.
have ->: W64.of_int (-1) = W64.onew by rewrite /W64.onew -W64.of_int_mod.
by rewrite W64.and1w.
qed.

