(* Safety of bn_mulx (src/amd64/ref/bn_mulx@n.jinc): the lemmas of the
   specifications of theories/Bn_mulx_safety_xtr.eca. The rows of the
   squaring cover the words 1 .. of the result (ranges from byte 8). *)
require import AllCore IntDiv CoreMap List Distr.
from Jasmin require import JModel_x86.
import SLH64.
from Jasmin require import Jcheck JSafety JByte_array JMemory.
require import ByteArrayInit JbnSafetyLib.
require Bn_mulx_safety_xtr.

clone include Bn_mulx_safety_xtr.

clone ByteArrayLib as BL_8n with theory A <- BA_8n.
clone ByteArrayLib as BL_16n with theory A <- BA_16n.
clone SubByteArrayInit as SBI_16n__8n with theory SB <- SB_16n__8n.

lemma __mul1_proof _r _b_r _a _b _b_b : __mul1_spec _r _b_r _a _b _b_b.
proof.
hint +safety.
rewrite /__mul1_spec; proc.
wp; while (valid trace___mul1 /\ 1 <= i <= nlimbs /\ BA_16n.is_init b_r 0 (8 * i)).
- auto => /> &hr hv hi0 hi1 hr hin.
  have e := BL_16n.is_init_ext64 b_r{hr} i{hr} _ hr; 1: smt().
  smt().
auto => /> hb.
split; first smt(gt0_nlimbs).
move=> b_r0 i0 tr0 hi _ hi0 hi1 hr0.
have hie : i0 = nlimbs by smt().
move: hr0; rewrite hie => hr0.
have e := BL_16n.is_init_ext64 b_r0 nlimbs _ hr0; 1: smt(gt0_nlimbs).
smt(gt0_nlimbs).
qed.

lemma __mul1acc_proof _k _r _b_r _a _b _b_b : __mul1acc_spec _k _r _b_r _a _b _b_b.
proof.
hint +safety.
rewrite /__mul1acc_spec; proc.
wp; while (valid trace___mul1acc /\ 1 <= i <= nlimbs /\ 1 <= k < nlimbs
           /\ BA_16n.is_init b_r 0 (8 * (k + nlimbs))).
- auto => /> &hr hv hi0 hi1 hk0 hk1 hr hin.
  have w := BL_16n.is_init_word _ (k{hr} + i{hr}) _ _ _ hr; 1,2: smt().
  have m := BL_16n.is_init_mono64 _ ((k{hr} + i{hr}) * 8) _ _ hr.
  smt().
auto => /> hk0 hk1 hr hb.
have w := BL_16n.is_init_word _ _k _ _ _ hr; 1,2: smt(gt0_nlimbs).
have m := BL_16n.is_init_mono64 _ (_k * 8) _ _ hr.
split; first smt(gt0_nlimbs).
move=> b_r0 i0 tr0 _ _ _ _ hr0.
have e := BL_16n.is_init_ext64 b_r0 (_k + nlimbs) _ hr0; 1: smt(gt0_nlimbs).
smt(gt0_nlimbs).
qed.

lemma _os_muln_proof _r _b_r _a _b_a _b _b_b : _os_muln_spec _r _b_r _a _b_a _b _b_b.
proof.
hint +safety.
rewrite /_os_muln_spec; proc.
wp; while (valid trace__os_muln /\ 1 <= k <= nlimbs
           /\ BA_16n.is_init b_r 0 (8 * (k + nlimbs))
           /\ BA_8n.is_init b_a 0 (8 * nlimbs) /\ BA_8n.is_init b_b 0 (8 * nlimbs)).
- wp; ecall (__mul1acc_proof param_2 param_3 b_param_0 param_4 param_5 ((BA_8n.init_arr (W8.of_int 255)))).
  auto => /> &hr *; smt().
wp; ecall (__mul1_proof param b_param param_0 param_1 ((BA_8n.init_arr (W8.of_int 255)))).
auto => /> *; smt(gt0_nlimbs).
qed.

lemma _os_muln__proof _r _b_r _a _b_a _b _b_b : _os_muln__spec _r _b_r _a _b_a _b _b_b.
proof.
hint +safety.
rewrite /_os_muln__spec; proc.
wp; ecall (_os_muln_proof param b_param param_0 ((BA_8n.init_arr (W8.of_int 255))) param_1 ((BA_8n.init_arr (W8.of_int 255)))).
by auto => />.
qed.

lemma __sqr_row0_proof _r _b_r _a _b_a : __sqr_row0_spec _r _b_r _a _b_a.
proof.
hint +safety.
rewrite /__sqr_row0_spec; proc.
wp; while (valid trace___sqr_row0 /\ 2 <= j <= nlimbs /\ BA_16n.is_init b_r 8 (8 * (j - 1))).
- auto => /> &hr hv hj0 hj1 hr hjn.
  have e := BL_16n.is_init_ext64_at b_r{hr} 8 (8 * (j{hr} - 1)) hr.
  smt().
auto => /> hn ha.
move=> b_r0 j0 tr0 hj _ hj0 hj1 hr0.
have hje : j0 = nlimbs by smt().
move: hr0; rewrite hje => hr0.
have e := BL_16n.is_init_ext64_at b_r0 8 (8 * (nlimbs - 1)) hr0.
smt().
qed.

lemma __sqr_rowacc_proof _i _r _b_r _a _b_a : __sqr_rowacc_spec _i _r _b_r _a _b_a.
proof.
hint +safety.
rewrite /__sqr_rowacc_spec; proc.
wp; while (valid trace___sqr_rowacc /\ i + 2 <= j <= nlimbs /\ 1 <= i < nlimbs - 1
           /\ BA_16n.is_init b_r 8 (8 * (i + nlimbs - 1))).
- auto => /> &hr hv hj0 hj1 hi0 hi1 hr hjn.
  have w := BL_16n.is_init_sub _ _ _ ((i{hr} + j{hr}) * 8) 8 hr _ _; 1,2: smt().
  have m := BL_16n.is_init_mono64 _ ((i{hr} + j{hr}) * 8) _ _ hr.
  smt().
auto => /> hi0 hi1 hr ha.
have w := BL_16n.is_init_sub _ _ _ ((2 * _i + 1) * 8) 8 hr _ _; 1,2: smt().
have m := BL_16n.is_init_mono64 _ ((2 * _i + 1) * 8) _ _ hr.
split; first smt().
move=> b_r0 j0 tr0 hj _ hj0 hj1 hr0.
have e := BL_16n.is_init_ext64_at b_r0 8 (8 * (_i + nlimbs - 1)) hr0.
smt().
qed.

lemma __sqr_diag_proof _r _b_r _a _b_a : __sqr_diag_spec _r _b_r _a _b_a.
proof.
hint +safety.
rewrite /__sqr_diag_spec; proc.
wp; while (valid trace___sqr_diag /\ inc = nlimbs - 1 /\ 1 <= i <= nlimbs - 1 /\ 2 <= nlimbs
           /\ BA_16n.is_init b_r 0 (8 * (2 * i))
           /\ BA_16n.is_init b_r 8 (8 * (2 * nlimbs - 2))).
- auto => /> &hr hv hi0 hi1 hn hr0 hr8 hin.
  have r1 := BL_16n.is_init_sub _ _ _ (2 * i{hr} * 8) 8 hr8 _ _; 1,2: smt().
  have m1 := BL_16n.is_init_mono64 _ (2 * i{hr} * 8) _ _ hr8.
  have r2 := BL_16n.is_init_sub _ _ _ ((2 * i{hr} + 1) * 8) 8 m1 _ _; 1,2: smt().
  have e1 := BL_16n.is_init_ext64 b_r{hr} (2 * i{hr}) _ hr0; 1: smt().
  have e2 := BL_16n.is_init_ext64 _ (2 * i{hr} + 1) _ e1; 1: smt().
  have m2 := BL_16n.is_init_mono64 _ ((2 * i{hr} + 1) * 8) _ _ m1.
  smt().
auto => /> hn hr8 ha.
have s8 := BL_16n.is_init_sub _ _ _ 8 8 hr8 _ _; 1,2: smt().
have m0 := BL_16n.is_init_mono64 _ 0 _ _ hr8.
have m1 := BL_16n.is_init_mono64 _ 8 _ _ m0.
split; first smt().
move=> b_r0 i0 tr0 hi _ hi0 hi1 hr0 hr80.
have hie : i0 = nlimbs - 1 by smt().
move: hr0; rewrite hie => hr0.
have w := BL_16n.is_init_sub _ _ _ ((2 * nlimbs - 2) * 8) 8 hr80 _ _; 1,2: smt().
have e1 := BL_16n.is_init_ext64 b_r0 (2 * nlimbs - 2) _ _; 1,2: smt().
have e2 := BL_16n.is_init_ext64 (BA_16n.set64d b_r0 ((2 * nlimbs - 2) * 8) BL_16n.m1_64) (2 * nlimbs - 1) _ _; 1,2: smt().
smt().
qed.

lemma _os_sqrn_proof _r _b_r _a _b_a : _os_sqrn_spec _r _b_r _a _b_a.
proof.
hint +safety.
rewrite /_os_sqrn_spec; proc.
seq ^if : (valid trace__os_sqrn /\ BA_8n.is_init b_a 0 (8 * nlimbs)).
- by auto.
if.
- auto => /> &hr hv ha hn1.
  by rewrite hn1 /=.
wp; ecall (__sqr_diag_proof param_4 b_param_1 param_5 ((BA_8n.init_arr (W8.of_int 255)))).
wp; while (valid trace__os_sqrn /\ inc = nlimbs - 1 /\ 1 <= i <= nlimbs - 1 /\ 2 <= nlimbs
           /\ BA_16n.is_init b_r 8 (8 * (i + nlimbs - 1)) /\ BA_8n.is_init b_a 0 (8 * nlimbs)).
- wp; ecall (__sqr_rowacc_proof param_1 param_2 b_param_0 param_3 ((BA_8n.init_arr (W8.of_int 255)))).
  auto => /> &hr *; smt().
wp; ecall (__sqr_row0_proof param b_param param_0 ((BA_8n.init_arr (W8.of_int 255)))).
auto => /> *; smt(gt0_nlimbs).
qed.

lemma _os_sqrn__proof _r _b_r _a _b_a : _os_sqrn__spec _r _b_r _a _b_a.
proof.
hint +safety.
rewrite /_os_sqrn__spec; proc.
wp; ecall (_os_sqrn_proof param b_param param_0 ((BA_8n.init_arr (W8.of_int 255)))).
by auto => />.
qed.

lemma __mont_redM_proof _r _b_r _a _b_a __P_mP _b__P_mP __U0 : __mont_redM_spec _r _b_r _a _b_a __P_mP _b__P_mP __U0.
proof.
hint +safety.
rewrite /__mont_redM_spec; proc.
wp; ecall (BNB._cminusP__proof param b_param param_0 b_param_0 param_1).
wp.
while (valid trace___mont_redM /\ 0 <= k <= nlimbs /\ (0 < k => BA_8n.is_init b_r 0 (8 * nlimbs))).
- wp.
  while (valid trace___mont_redM /\ 1 <= i <= nlimbs /\ 0 <= k < nlimbs
         /\ (0 < k => BA_8n.is_init b_r 0 (8 * nlimbs)) /\ BA_8n.is_init b_r 0 (8 * (i - 1))).
  + auto => /> &hr hv hi0 hi1 hk0 hk1 hr hp hin.
    have e := BL_8n.is_init_ext64 b_r{hr} (i{hr} - 1) _ hp; 1: smt().
    split => [hk | hk].
    - smt().
    have hf := hr _; 1: smt().
    have w := BL_8n.is_init_word _ i{hr} _ _ _ hf; 1,2: smt().
    have m := BL_8n.is_init_mono64 _ ((i{hr} - 1) * 8) _ _ hf.
    smt().
  auto => /> &hr hv hk0 hk1 hr hkn.
  split; first smt(gt0_nlimbs).
  move=> b_r0 i0 tr0 hi _ hi0 hi1 hr0 hp0.
  have hie : i0 = nlimbs by smt().
  move: hp0; rewrite hie => hp0.
  have e := BL_8n.is_init_ext64 b_r0 (nlimbs - 1) _ hp0; 1: smt(gt0_nlimbs).
  split => [hk | hk].
  - smt(gt0_nlimbs).
  have hf := hr0 _; 1: smt().
  have m := BL_8n.is_init_mono64 _ ((nlimbs - 1) * 8) _ _ hf.
  smt(gt0_nlimbs).
auto => /> ha hpm.
have hmP: BA_8n.is_init (SB_16n__8n.get_sub _b__P_mP (8 * nlimbs)) 0 (8 * nlimbs).
- rewrite SBI_16n__8n.is_init_get_sub; 1..4: smt(gt0_nlimbs).
  by apply (BL_16n.is_init_sub _ _ _ _ _ hpm); smt(gt0_nlimbs).
split; first smt(gt0_nlimbs).
move=> b_r0 k0 tr0 hk _ hk0 hk1 hr0.
have hf := hr0 _; 1: smt(gt0_nlimbs).
split; first by split.
move=> _ _ rr _ _.
smt(gt0_nlimbs).
qed.
