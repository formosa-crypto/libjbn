(* Safety of fp_mont (src/amd64/ref/fp_mont@fp.jinc): the lemmas of the
   specifications of theories/Fp_mont_safety_xtr.eca, for any function
   parameters (and selected __mont_redM) meeting their contracts. *)
require import AllCore IntDiv CoreMap List Distr.
from Jasmin require import JModel_x86.
import SLH64.
from Jasmin require import Jcheck JSafety JByte_array JMemory.
require import ByteArrayInit JbnSafetyLib.
require Fp_mont_safety_xtr.

clone include Fp_mont_safety_xtr.

clone ByteArrayLib as BL_8n with theory A <- BA_8n.
clone ByteArrayLib as BL_16n with theory A <- BA_16n.
clone ByteArrayLib as BL_32n_8 with theory A <- BA_32n_8.
clone SubByteArrayInit as SBI_16n__8n with theory SB <- SB_16n__8n.
clone SubByteArrayInit as SBI_32n_8__16n with theory SB <- SB_32n_8__16n.
clone SubByteArrayInit as SBI_32n_8__8n with theory SB <- SB_32n_8__8n.

clone SubByteArrayLib as SBL_16n__8n with theory SB <- SB_16n__8n.
clone SubByteArrayLib as SBL_32n_8__8n with theory SB <- SB_32n_8__8n.

(* slices of a full context *)
lemma ctx_full8 (b : BA_32n_8.t) o :
  0 <= o => o + 8 * nlimbs <= 8 * ((4 * nlimbs) + 1) =>
  BA_32n_8.is_init b 0 (8 * ((4 * nlimbs) + 1)) =>
  BA_8n.is_init (SB_32n_8__8n.get_sub b o) 0 (8 * nlimbs).
proof.
move=> h0 h1 h; rewrite SBI_32n_8__8n.is_init_get_sub; 1..4: smt(gt0_nlimbs).
by apply (BL_32n_8.is_init_sub _ _ _ _ _ h); smt().
qed.

lemma ctx_full16 (b : BA_32n_8.t) :
  BA_32n_8.is_init b 0 (8 * ((4 * nlimbs) + 1)) =>
  BA_16n.is_init (SB_32n_8__16n.get_sub b 0) 0 (16 * nlimbs).
proof.
move=> h; rewrite SBI_32n_8__16n.is_init_get_sub; 1..4: smt(gt0_nlimbs).
by apply (BL_32n_8.is_init_sub _ _ _ _ _ h); smt(gt0_nlimbs).
qed.

(* the two halves of the double-size temporary of _fromM_ *)
lemma tmp_halves (t : BA_16n.t) :
  BA_16n.is_init (SB_16n__8n.set_sub (SB_16n__8n.set_sub t 0 (BA_8n.init_arr (W8.of_int 255)))
                    (8 * nlimbs) (BA_8n.init_arr (W8.of_int 255))) 0 (16 * nlimbs).
proof.
pose I := BA_8n.init_arr (W8.of_int 255).
have h1 : BA_16n.is_init (SB_16n__8n.set_sub t 0 I) 0 (8 * nlimbs).
- by have := SBL_16n__8n.is_init_ext_sub t 0 _ _; [done | rewrite BL_16n.is_init_le0 | smt()].
have := SBL_16n__8n.is_init_ext_sub (SB_16n__8n.set_sub t 0 I) (8 * nlimbs) _ h1; 1: smt(gt0_nlimbs).
smt().
qed.

section.

declare module P <: MParam.

declare axiom __mont_redM_h _r _b_r _a _b_a __P_mP _b__P_mP __U0 :
  hoare [P.__mont_redM :
    arg = (_r, _b_r, _a, _b_a, __P_mP, _b__P_mP, __U0) /\ __mont_redM_pre _r _b_r _a _b_a __P_mP _b__P_mP __U0
    ==> __mont_redM_post _r _b_r _a _b_a __P_mP _b__P_mP __U0 res /\ valid res.`3].

declare axiom fun_muln_h _r _b_r _a _b_a _b _b_b :
  hoare [P.fun_muln :
    arg = (_r, _b_r, _a, _b_a, _b, _b_b) /\ fun_muln_pre _r _b_r _a _b_a _b _b_b
    ==> fun_muln_post _r _b_r _a _b_a _b _b_b res /\ valid res.`3].

declare axiom fun_sqrn_h _r _b_r _a _b_a :
  hoare [P.fun_sqrn :
    arg = (_r, _b_r, _a, _b_a) /\ fun_sqrn_pre _r _b_r _a _b_a
    ==> fun_sqrn_post _r _b_r _a _b_a res /\ valid res.`3].

lemma _redM_proof _r _b_r _a _b_a _ctx _b_ctx :
  hoare [M(P)._redM :
    arg = (_r, _b_r, _a, _b_a, _ctx, _b_ctx) /\ _redM_pre _r _b_r _a _b_a _ctx _b_ctx
    ==> _redM_post _r _b_r _a _b_a _ctx _b_ctx res /\ valid res.`3].
proof.
hint +safety.
proc.
wp; ecall (__mont_redM_h param b_param param_0 ((BA_16n.init_arr (W8.of_int 255))) param_1 b_param_0 param_2).
by auto => /> *; smt(ctx_full8 ctx_full16 tmp_halves gt0_nlimbs).
qed.

lemma _redM__proof _r _b_r _a _b_a _ctx _b_ctx :
  hoare [M(P)._redM_ :
    arg = (_r, _b_r, _a, _b_a, _ctx, _b_ctx) /\ _redM__pre _r _b_r _a _b_a _ctx _b_ctx
    ==> _redM__post _r _b_r _a _b_a _ctx _b_ctx res /\ valid res.`3].
proof.
hint +safety.
proc.
wp; ecall (_redM_proof param b_param param_0 ((BA_16n.init_arr (W8.of_int 255))) param_1 ((BA_32n_8.init_arr (W8.of_int 255)))).
by auto => /> *; smt(ctx_full8 ctx_full16 tmp_halves gt0_nlimbs).
qed.

lemma _fromM__proof _a _b_a _ctx _b_ctx :
  hoare [M(P)._fromM_ :
    arg = (_a, _b_a, _ctx, _b_ctx) /\ _fromM__pre _a _b_a _ctx _b_ctx
    ==> _fromM__post _a _b_a _ctx _b_ctx res /\ valid res.`3].
proof.
hint +safety.
proc.
wp; ecall (_redM__proof param_2 ((BA_8n.init_arr (W8.of_int 255))) param_3 b_param_1 param_4 ((BA_32n_8.init_arr (W8.of_int 255)))).
wp; ecall (BNB._set0__proof param_1 b_param_0).
wp; ecall (BNB._mov__proof param b_param param_0 ((BA_8n.init_arr (W8.of_int 255)))).
by auto => /> *; smt(ctx_full8 ctx_full16 tmp_halves gt0_nlimbs).
qed.

lemma fun_red_proof _r _b_r _a _b_a _ctx _b_ctx :
  hoare [M(P).fun_red :
    arg = (_r, _b_r, _a, _b_a, _ctx, _b_ctx) /\ fun_red_pre _r _b_r _a _b_a _ctx _b_ctx
    ==> fun_red_post _r _b_r _a _b_a _ctx _b_ctx res /\ valid res.`3].
proof.
hint +safety.
proc.
wp; ecall (_redM__proof param b_param param_0 ((BA_16n.init_arr (W8.of_int 255))) param_1 ((BA_32n_8.init_arr (W8.of_int 255)))).
by auto => /> *; smt(ctx_full8 ctx_full16 tmp_halves gt0_nlimbs).
qed.

(* the parameters of the field operations of fp_base (included module):
   the multiplications of P and this field's fun_red *)
lemma P_FPB_muln_h _r _b_r _a _b_a _b _b_b :
  hoare [M(P).P_FPB.fun_muln :
    arg = (_r, _b_r, _a, _b_a, _b, _b_b) /\ FPB.fun_muln_pre _r _b_r _a _b_a _b _b_b
    ==> FPB.fun_muln_post _r _b_r _a _b_a _b _b_b res /\ valid res.`3].
proof. by conseq (fun_muln_h _r _b_r _a _b_a _b _b_b). qed.

lemma P_FPB_sqrn_h _r _b_r _a _b_a :
  hoare [M(P).P_FPB.fun_sqrn :
    arg = (_r, _b_r, _a, _b_a) /\ FPB.fun_sqrn_pre _r _b_r _a _b_a
    ==> FPB.fun_sqrn_post _r _b_r _a _b_a res /\ valid res.`3].
proof. by conseq (fun_sqrn_h _r _b_r _a _b_a). qed.

lemma P_FPB_red_h _r _b_r _a _b_a _ctx _b_ctx :
  hoare [M(P).P_FPB.fun_red :
    arg = (_r, _b_r, _a, _b_a, _ctx, _b_ctx) /\ FPB.fun_red_pre _r _b_r _a _b_a _ctx _b_ctx
    ==> FPB.fun_red_post _r _b_r _a _b_a _ctx _b_ctx res /\ valid res.`3].
proof. by conseq (fun_red_proof _r _b_r _a _b_a _ctx _b_ctx). qed.

lemma _toM__proof _a _b_a _ctx _b_ctx :
  hoare [M(P)._toM_ :
    arg = (_a, _b_a, _ctx, _b_ctx) /\ _toM__pre _a _b_a _ctx _b_ctx
    ==> _toM__post _a _b_a _ctx _b_ctx res /\ valid res.`3].
proof.
hint +safety.
proc.
wp; ecall (FPB._mulmU__proof (<: M(P).P_FPB) P_FPB_muln_h P_FPB_sqrn_h P_FPB_red_h param ((BA_8n.init_arr (W8.of_int 255))) param_0 b_param param_1 ((BA_32n_8.init_arr (W8.of_int 255)))).
by auto => /> *; smt(ctx_full8 ctx_full16 tmp_halves gt0_nlimbs).
qed.

lemma _ctx_init__proof _ctx _b_ctx _p _b_P :
  hoare [M(P)._ctx_init_ :
    arg = (_ctx, _b_ctx, _p, _b_P) /\ _ctx_init__pre _ctx _b_ctx _p _b_P
    ==> _ctx_init__post _ctx _b_ctx _p _b_P res /\ valid res.`3].
proof.
hint +safety.
proc.
wp; ecall (BNB._mov__proof param_22 b_param_9 param_23 ((BA_8n.init_arr (W8.of_int 255)))).
wp.
while (valid trace__ctx_init_ /\ BA_32n_8.is_init b_ctx 0 (8 * (3 * nlimbs)) /\ BA_32n_8.is_init b_ctx (8 * (4 * nlimbs)) 8).
- wp; ecall (FPB._addm__proof (<: M(P).P_FPB) P_FPB_muln_h P_FPB_sqrn_h P_FPB_red_h param_18 ((BA_8n.init_arr (W8.of_int 255))) param_19 ((BA_8n.init_arr (W8.of_int 255))) param_20 ((BA_8n.init_arr (W8.of_int 255))) param_21 b_param_8).
  wp; ecall (FPB._addm__proof (<: M(P).P_FPB) P_FPB_muln_h P_FPB_sqrn_h P_FPB_red_h param_14 b_param_6 param_15 ((BA_8n.init_arr (W8.of_int 255))) param_16 ((BA_8n.init_arr (W8.of_int 255))) param_17 b_param_7).
  auto => /> &hr hv hc hu hi.
  have hmp : BA_32n_8.is_init b_ctx{hr} (8 * nlimbs) (8 * nlimbs).
  - by apply (BL_32n_8.is_init_sub _ _ _ _ _ hc); smt(gt0_nlimbs).
  smt().
wp; ecall (BNB._mov__proof param_12 b_param_5 param_13 ((BA_8n.init_arr (W8.of_int 255)))).
wp.
while (valid trace__ctx_init_ /\ BA_32n_8.is_init b_ctx 0 (8 * (2 * nlimbs)) /\ BA_32n_8.is_init b_ctx (8 * (4 * nlimbs)) 8).
- wp; ecall (FPB._addm__proof (<: M(P).P_FPB) P_FPB_muln_h P_FPB_sqrn_h P_FPB_red_h param_8 ((BA_8n.init_arr (W8.of_int 255))) param_9 ((BA_8n.init_arr (W8.of_int 255))) param_10 ((BA_8n.init_arr (W8.of_int 255))) param_11 b_param_4).
  wp; ecall (FPB._addm__proof (<: M(P).P_FPB) P_FPB_muln_h P_FPB_sqrn_h P_FPB_red_h param_4 b_param_2 param_5 ((BA_8n.init_arr (W8.of_int 255))) param_6 ((BA_8n.init_arr (W8.of_int 255))) param_7 b_param_3).
  auto => /> &hr hv hc hu hi.
  have hmp : BA_32n_8.is_init b_ctx{hr} (8 * nlimbs) (8 * nlimbs).
  - by apply (BL_32n_8.is_init_sub _ _ _ _ _ hc); smt(gt0_nlimbs).
  smt().
wp; ecall (BNB._set0__proof param_3 b_param_1).
wp; while (valid trace__ctx_init_).
- by auto.
wp; ecall (BNB._neg__proof param_1 b_param_0 param_2 ((BA_8n.init_arr (W8.of_int 255)))).
wp; ecall (BNB._mov__proof param b_param param_0 ((BA_8n.init_arr (W8.of_int 255)))).
auto => /> hp.
pose I := BA_8n.init_arr (W8.of_int 255).
pose B2 := SB_32n_8__8n.set_sub (SB_32n_8__8n.set_sub _b_ctx 0 I) (8 * nlimbs) I.
pose B3 := BA_32n_8.set64d B2 (4 * nlimbs * 8) BL_32n_8.m1_64.
pose B4 := SB_32n_8__8n.set_sub B3 (8 * (2 * nlimbs)) I.
pose B5 := SB_32n_8__8n.set_sub B4 (8 * (3 * nlimbs)) I.
have h1 : BA_32n_8.is_init (SB_32n_8__8n.set_sub _b_ctx 0 I) 0 (8 * nlimbs).
- by have := SBL_32n_8__8n.is_init_ext_sub _b_ctx 0 _ _; [done | rewrite BL_32n_8.is_init_le0 | smt()].
have h2 : BA_32n_8.is_init B2 0 (8 * (2 * nlimbs)).
- by have := SBL_32n_8__8n.is_init_ext_sub (SB_32n_8__8n.set_sub _b_ctx 0 I) (8 * nlimbs) _ h1; [smt(gt0_nlimbs) | smt()].
have h3 : BA_32n_8.is_init B3 0 (8 * (2 * nlimbs)) by apply BL_32n_8.is_init_mono64.
have u3 : BA_32n_8.is_init B3 (8 * (4 * nlimbs)) 8.
- by rewrite /B3 BL_32n_8.is_init_set64d_sub 1,2:/#.
have h4 : BA_32n_8.is_init B4 0 (8 * (3 * nlimbs)).
- by have := SBL_32n_8__8n.is_init_ext_sub B3 (8 * (2 * nlimbs)) _ h3; [smt(gt0_nlimbs) | smt()].
have u4 : BA_32n_8.is_init B4 (8 * (4 * nlimbs)) 8 by apply SBL_32n_8__8n.is_init_mono_sub.
have h5 : BA_32n_8.is_init B5 0 (8 * (4 * nlimbs)).
- by have := SBL_32n_8__8n.is_init_ext_sub B4 (8 * (3 * nlimbs)) _ h4; [smt(gt0_nlimbs) | smt()].
have u5 : BA_32n_8.is_init B5 (8 * (4 * nlimbs)) 8 by apply SBL_32n_8__8n.is_init_mono_sub.
have f5 : BA_32n_8.is_init B5 0 (8 * ((4 * nlimbs) + 1)).
- by have := BL_32n_8.is_init_cat B5 0 (8 * (4 * nlimbs)) 8 _ h5 _; [smt(gt0_nlimbs) | done | smt()].
move: h3 u3 h4 u4 f5; rewrite /B5 /B4 /B3 /B2 /I => h3 u3 h4 u4 f5.
smt(gt0_nlimbs).
qed.

end section.
