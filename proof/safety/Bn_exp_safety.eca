wp; ecall (BNB._mov__proof param b_param param_0 b_param_0).
by auto => /> *; smt(ctx_one gt0_nlimbs).
qed.

lemma _expm_noct_proof _r _b_r _a _b_a _b _b_b _ctx _b_ctx :
  hoare [M(P)._expm_noct :
    arg = (_r, _b_r, _a, _b_a, _b, _b_b, _ctx, _b_ctx) /\ _expm_noct_pre _r _b_r _a _b_a _b _b_b _ctx _b_ctx
    ==> _expm_noct_post _r _b_r _a _b_a _b _b_b _ctx _b_ctx res /\ valid res.`3].
proof.
hint +safety.
proc.
wp.
while (valid trace__expm_noct /\ 0 <= j <= nlimbsexp).
- wp.
  while (valid trace__expm_noct /\ 0 <= j < nlimbsexp).
  + seq ^if : (valid trace__expm_noct /\ 0 <= j < nlimbsexp).
    * by auto.
    if.
    * wp; ecall (fun_sqrU_h param_4 ((BA_8n.init_arr (W8.of_int 255))) param_5 ((BA_32n_8.init_arr (W8.of_int 255)))).
      wp; ecall (fun_mulU_h param_1 ((BA_8n.init_arr (W8.of_int 255))) param_2 ((BA_8n.init_arr (W8.of_int 255))) param_3 ((BA_32n_8.init_arr (W8.of_int 255)))).
      by auto => />.
    wp; ecall (fun_sqrU_h param_4 ((BA_8n.init_arr (W8.of_int 255))) param_5 ((BA_32n_8.init_arr (W8.of_int 255)))).
    by auto => />.
  wp; ecall (fun_sqrU_h param_4 ((BA_8n.init_arr (W8.of_int 255))) param_5 ((BA_32n_8.init_arr (W8.of_int 255)))).
  wp.
  seq ^if : (valid trace__expm_noct /\ 0 <= j < nlimbsexp).
  + by auto => /> &hr *; smt().
  if.
  + wp; ecall (fun_mulU_h param_1 ((BA_8n.init_arr (W8.of_int 255))) param_2 ((BA_8n.init_arr (W8.of_int 255))) param_3 ((BA_32n_8.init_arr (W8.of_int 255)))).
    by auto => /> &hr *; smt().
  by auto => /> &hr *; smt().
wp; ecall (BNB._mov__proof param b_param param_0 ((BA_8n.init_arr (W8.of_int 255)))).
by auto => />; smt(gt0_nlimbsexp).
qed.

