    (trace___mont_redM ++
    [(Assert, ((0 <= (nlimbs * 8)) /\ (((nlimbs * 8) + (8 * nlimbs)) <= (16 * nlimbs))))]);
    b_mP <- (SB_16n__8n.get_sub64 b__P_mP nlimbs);
    mP <- (SB_16n__8n.get_sub64 _P_mP nlimbs);
    b_param <- b_r;
    param <- r;
    b_param_0 <- b_mP;
    param_0 <- mP;
    param_1 <- c;
    (aux, aux_0, tmp__trace) <@ BNB.M._cminusP_ (param, b_param, param_0,
    b_param_0, param_1);
    result <- aux;
    b_result <- aux_0;
    trace___mont_redM <-
    (trace___mont_redM ++ tmp__trace);
    trace___mont_redM <-
    (trace___mont_redM ++
    [(Assert, (BA_8n.is_init b_result 0 (8 * nlimbs)))]);
    r <- result;
    b_r <- (BA_8n.init_arr (W8.of_int 255));
    return (r, b_r, trace___mont_redM);
  }
}.

