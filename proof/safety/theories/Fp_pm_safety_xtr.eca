    [(Assert, (BA_8n.is_init b_result_2 0 (8 * nlimbs)))]);
    t <- result_3;
    trace__ctx_init_ <-
    (trace__ctx_init_ ++
    [(Assert, ((0 <= ((3 * nlimbs) * 8)) /\ ((((3 * nlimbs) * 8) + (8 * nlimbs)) <= (8 * ((4 * nlimbs) + 1)))))]);
    b_ctx <-
    (SB_32n_8__8n.set_sub64 b_ctx (3 * nlimbs) (BA_8n.init_arr (W8.of_int 255)));
    ctx <- (SB_32n_8__8n.set_sub64 ctx (3 * nlimbs) t);
    b_x <- b__x;
    x <- _x;
    trace__ctx_init_ <-
    (trace__ctx_init_ ++
    [(Assert, ((0 <= (nlimbs * 8)) /\ (((nlimbs * 8) + (8 * nlimbs)) <= (8 * ((4 * nlimbs) + 1)))))]);
    b_mP <- (SB_32n_8__8n.get_sub64 b_ctx nlimbs);
    mP <- (SB_32n_8__8n.get_sub64 ctx nlimbs);
    b_param_3 <- b_x;
    param_5 <- x;
    b_param_4 <- b_mP;
    param_6 <- mP;
    (aux_8, aux_9, tmp__trace) <@ BNB.M._mov_ (param_5, b_param_3, param_6,
    b_param_4);
    result_4 <- aux_8;
    b_result_3 <- aux_9;
    trace__ctx_init_ <- (trace__ctx_init_ ++ tmp__trace);
    trace__ctx_init_ <-
    (trace__ctx_init_ ++
    [(Assert, (BA_8n.is_init b_result_3 0 (8 * nlimbs)))]);
    x <- result_4;
    z <- (W64.of_int 0);
    trace__ctx_init_ <-
    (trace__ctx_init_ ++
    [(Assert, ((0 <= (nlimbs * 8)) /\ (((nlimbs * 8) + (8 * nlimbs)) <= (8 * ((4 * nlimbs) + 1)))))]);
    b_mP <- (SB_32n_8__8n.get_sub64 b_ctx nlimbs);
    mP <- (SB_32n_8__8n.get_sub64 ctx nlimbs);
    param_7 <- x;
    b_param_5 <- b_mP;
    param_8 <- mP;
    param_9 <- z;
    (aux_10, aux_11, tmp__trace) <@ BNB.M._cminusP_ (param_7,
    (BA_8n.init_arr (W8.of_int 255)), param_8, b_param_5, param_9);
    result_5 <- aux_10;
    b_result_4 <- aux_11;
    trace__ctx_init_ <- (trace__ctx_init_ ++ tmp__trace);
    trace__ctx_init_ <-
    (trace__ctx_init_ ++
    [(Assert, (BA_8n.is_init b_result_4 0 (8 * nlimbs)))]);
    x <- result_5;
    c <- (BA_8n.get64 x 0);
    trace__ctx_init_ <-
    (trace__ctx_init_ ++
    [(Assert, ((0 <= ((4 * nlimbs) * 8)) /\ ((((4 * nlimbs) * 8) + 8) <= (8 * ((4 * nlimbs) + 1)))))]);
    b_ctx <-
    (BA_32n_8.set64d b_ctx ((4 * nlimbs) * 8) (W64.of_int 18446744073709551615));
    ctx <- (BA_32n_8.set64 ctx (4 * nlimbs) c);
    return (ctx, b_ctx, trace__ctx_init_);
  }
  module P_FPB = {
    proc fun_muln = P.fun_muln
    proc fun_sqrn = P.fun_sqrn
    proc fun_red = fun_red
  }
  proc _chk_bnds_ = FPB.M(P_FPB)._chk_bnds_
  proc _addm_ = FPB.M(P_FPB)._addm_
  proc _addmU_ = FPB.M(P_FPB)._addmU_
  proc _subm_ = FPB.M(P_FPB)._subm_
  proc _submU_ = FPB.M(P_FPB)._submU_
  proc _mulm_ = FPB.M(P_FPB)._mulm_
  proc _mulmU_ = FPB.M(P_FPB)._mulmU_
  proc _sqrm_ = FPB.M(P_FPB)._sqrm_
  proc _sqrmU_ = FPB.M(P_FPB)._sqrmU_
  proc fun_mulU = FPB.M(P_FPB).fun_mulU
  proc fun_sqrU = FPB.M(P_FPB).fun_sqrU
  proc __Pm2 = FPB.M(P_FPB).__Pm2
  proc _invmU_ = FPB.M(P_FPB)._invmU_
  proc _invm_ = FPB.M(P_FPB)._invm_
}.

(* the specifications, as module-free pre- and postconditions (an op
   cannot mention the declared module of a section) *)

op _redPM_pre (_r : BA_8n.t) (_b_r : BA_8n.t) (_a : BA_16n.t) (_b_a : BA_16n.t) (_ctx : BA_32n_8.t) (_b_ctx : BA_32n_8.t) =
  ((BA_16n.is_init _b_a 0 (16 * nlimbs)) /\
   (BA_32n_8.is_init _b_ctx 0 (8 * ((4 * nlimbs) + 1)))).

op _redPM_post (_r : BA_8n.t) (_b_r : BA_8n.t) (_a : BA_16n.t) (_b_a : BA_16n.t) (_ctx : BA_32n_8.t) (_b_ctx : BA_32n_8.t) (_res : BA_8n.t * BA_8n.t * trace) =
  (BA_8n.is_init _res.`2 0 (8 * nlimbs)).

op _redPM__pre (_r : BA_8n.t) (_b_r : BA_8n.t) (_a : BA_16n.t) (_b_a : BA_16n.t) (_ctx : BA_32n_8.t) (_b_ctx : BA_32n_8.t) =
  ((BA_16n.is_init _b_a 0 (16 * nlimbs)) /\
   (BA_32n_8.is_init _b_ctx 0 (8 * ((4 * nlimbs) + 1)))).

op _redPM__post (_r : BA_8n.t) (_b_r : BA_8n.t) (_a : BA_16n.t) (_b_a : BA_16n.t) (_ctx : BA_32n_8.t) (_b_ctx : BA_32n_8.t) (_res : BA_8n.t * BA_8n.t * trace) =
  (BA_8n.is_init _res.`2 0 (8 * nlimbs)).

op _fromM__pre (_a : BA_8n.t) (_b_a : BA_8n.t) (_ctx : BA_32n_8.t) (_b_ctx : BA_32n_8.t) =
  ((BA_32n_8.is_init _b_ctx 0 (8 * ((4 * nlimbs) + 1))) /\ (BA_8n.is_init _b_a 0 (8 * nlimbs))).

op _fromM__post (_a : BA_8n.t) (_b_a : BA_8n.t) (_ctx : BA_32n_8.t) (_b_ctx : BA_32n_8.t) (_res : BA_8n.t * BA_8n.t * trace) =
  (BA_8n.is_init _res.`2 0 (8 * nlimbs)).

op fun_red_pre (_r : BA_8n.t) (_b_r : BA_8n.t) (_a : BA_16n.t) (_b_a : BA_16n.t) (_ctx : BA_32n_8.t) (_b_ctx : BA_32n_8.t) =
  ((BA_16n.is_init _b_a 0 (16 * nlimbs)) /\
   (BA_32n_8.is_init _b_ctx 0 (8 * ((4 * nlimbs) + 1)))).

op fun_red_post (_r : BA_8n.t) (_b_r : BA_8n.t) (_a : BA_16n.t) (_b_a : BA_16n.t) (_ctx : BA_32n_8.t) (_b_ctx : BA_32n_8.t) (_res : BA_8n.t * BA_8n.t * trace) =
  (BA_8n.is_init _res.`2 0 (8 * nlimbs)).

op _toM__pre (_a : BA_8n.t) (_b_a : BA_8n.t) (_ctx : BA_32n_8.t) (_b_ctx : BA_32n_8.t) =
  ((BA_32n_8.is_init _b_ctx 0 (8 * ((4 * nlimbs) + 1))) /\ (BA_8n.is_init _b_a 0 (8 * nlimbs))).

op _toM__post (_a : BA_8n.t) (_b_a : BA_8n.t) (_ctx : BA_32n_8.t) (_b_ctx : BA_32n_8.t) (_res : BA_8n.t * BA_8n.t * trace) =
  (BA_8n.is_init _res.`2 0 (8 * nlimbs)).

op _ctx_init__pre (_ctx : BA_32n_8.t) (_b_ctx : BA_32n_8.t) (_p : BA_8n.t) (_b_P : BA_8n.t) =
  (BA_8n.is_init _b_P 0 (8 * nlimbs)).

op _ctx_init__post (_ctx : BA_32n_8.t) (_b_ctx : BA_32n_8.t) (_p : BA_8n.t) (_b_P : BA_8n.t) (_res : BA_32n_8.t * BA_32n_8.t * trace) =
  (BA_32n_8.is_init _res.`2 0 (8 * ((4 * nlimbs) + 1))).

op fun_muln_pre (_r : BA_16n.t) (_b_r : BA_16n.t) (_a : BA_8n.t) (_b_a : BA_8n.t) (_b : BA_8n.t) (_b_b : BA_8n.t) =
  ((BA_8n.is_init _b_a 0 (8 * nlimbs)) /\ (BA_8n.is_init _b_b 0 (8 * nlimbs))).

op fun_muln_post (_r : BA_16n.t) (_b_r : BA_16n.t) (_a : BA_8n.t) (_b_a : BA_8n.t) (_b : BA_8n.t) (_b_b : BA_8n.t) (_res : BA_16n.t * BA_16n.t * trace) =
  (BA_16n.is_init _res.`2 0 (16 * nlimbs)).

op fun_sqrn_pre (_r : BA_16n.t) (_b_r : BA_16n.t) (_a : BA_8n.t) (_b_a : BA_8n.t) =
  (BA_8n.is_init _b_a 0 (8 * nlimbs)).

op fun_sqrn_post (_r : BA_16n.t) (_b_r : BA_16n.t) (_a : BA_8n.t) (_b_a : BA_8n.t) (_res : BA_16n.t * BA_16n.t * trace) =
  (BA_16n.is_init _res.`2 0 (16 * nlimbs)).

