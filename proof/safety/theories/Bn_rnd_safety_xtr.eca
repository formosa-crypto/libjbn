op _rnd__spec _a _b_a =
   hoare [M(Syscall)._rnd_ :
   (((_b_a = b_a) /\ (_a = a)) /\ true) ==>
   ((BA_8n.is_init res.`2 0 (8 * nlimbs)) /\ (valid res.`3))].

op __bnd_mask_spec _mask _b_mask _bnd _b_bnd =
   hoare [M(Syscall).__bnd_mask :
   (((_b_bnd = b_bnd) /\
    ((_bnd = bnd) /\ ((_b_mask = b_mask) /\ (_mask = mask)))) /\
   (BA_8n.is_init _b_bnd 0 (8 * nlimbs))) ==>
   ((BA_8n.is_init res.`2 0 (8 * nlimbs)) /\ (valid res.`3))].

op _rsample__spec _a _b_a _bnd _b_bnd =
   hoare [M(Syscall)._rsample_ :
   (((_b_bnd = b_bnd) /\ ((_bnd = bnd) /\ ((_b_a = b_a) /\ (_a = a)))) /\
   (BA_8n.is_init _b_bnd 0 (8 * nlimbs))) ==>
   ((BA_8n.is_init res.`2 0 (8 * nlimbs)) /\ (valid res.`3))].

