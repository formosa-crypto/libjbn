    trace_fp_fromM <-
    (trace_fp_fromM ++
    [(Assert,
     ((is_valid ptr_modulus Glob.mem_v (W64.to_uint ap) (8 * nlimbs)) /\
     (is_valid ptr_modulus Glob.mem_v (W64.to_uint rp) (8 * nlimbs))))]);
    b__a <- (BA_8n.init_arr (W8.of_int 0));
    _rp <- rp;
    b_a <- b__a;
    a <- _a;
    b_param <- b_a;
    param <- a;
    param_0 <- ap;
    (aux, aux_0, tmp__trace) <@ BNB.M._load_ (param, b_param, param_0);
    result <- aux;
    b_result <- aux_0;
    trace_fp_fromM <- (trace_fp_fromM ++ tmp__trace);
    trace_fp_fromM <-
    (trace_fp_fromM ++ [(Assert, (BA_8n.is_init b_result 0 (8 * nlimbs)))]);
    a <- result;
    ctx <- glob_ctx;
    param_1 <- a;
    param_2 <- ctx;
    (aux_1, aux_2, tmp__trace) <@ P._fromM_ (param_1,
    (BA_8n.init_arr (W8.of_int 255)), param_2,
    (BA_32n_8.init_arr (W8.of_int 255)));
    result_0 <- aux_1;
    b_result_0 <- aux_2;
    trace_fp_fromM <- (trace_fp_fromM ++ tmp__trace);
    trace_fp_fromM <-
    (trace_fp_fromM ++ [(Assert, (BA_8n.is_init b_result_0 0 (8 * nlimbs)))]);
    a <- result_0;
    rp <- _rp;
    param_3 <- rp;
    param_4 <- a;
    tmp__trace <@ BNB.M._store_ (param_3, param_4,
    (BA_8n.init_arr (W8.of_int 255)));
    trace_fp_fromM <- (trace_fp_fromM ++ tmp__trace);
    return (trace_fp_fromM);
  }
}.

(* the specifications, as module-free pre- and postconditions (an op
   cannot mention the declared module of a section) *)

op fp_add_pre (_mem_v : global_mem_v_t) (_rp : W64.t) (_ap : W64.t) (_bp : W64.t) =
  (true /\
   (true /\
   (true /\
   (((is_valid ptr_modulus _mem_v (W64.to_uint _ap) (8 * nlimbs)) /\
    (is_valid ptr_modulus _mem_v (W64.to_uint _bp) (8 * nlimbs))) /\
   (is_valid ptr_modulus _mem_v (W64.to_uint _rp) (8 * nlimbs)))))).

op fp_add_post (_rp : W64.t) (_ap : W64.t) (_bp : W64.t) (_res : trace) =
  true.

