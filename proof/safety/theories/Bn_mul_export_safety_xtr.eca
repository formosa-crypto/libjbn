   (((is_valid ptr_modulus _mem_v (W64.to_uint _ap) (8 * nlimbs)) /\
    (is_valid ptr_modulus _mem_v (W64.to_uint _bp) (8 * nlimbs))) /\
   (is_valid ptr_modulus _mem_v (W64.to_uint _rp) (8 * (2 * nlimbs))))))).

op bn_ps_muln_post (_rp : W64.t) (_ap : W64.t) (_bp : W64.t) (_res : trace) =
  true.

op bn_ps_sqrn_pre (_mem_v : global_mem_v_t) (_rp : W64.t) (_ap : W64.t) =
  (true /\
   (true /\
   ((is_valid ptr_modulus _mem_v (W64.to_uint _ap) (8 * nlimbs)) /\
   (is_valid ptr_modulus _mem_v (W64.to_uint _rp) (8 * (2 * nlimbs)))))).

op bn_ps_sqrn_post (_rp : W64.t) (_ap : W64.t) (_res : trace) =
  true.

op bn_os_muln_pre (_mem_v : global_mem_v_t) (_rp : W64.t) (_ap : W64.t) (_bp : W64.t) =
  (true /\
