(* the specifications, as module-free pre- and postconditions (an op
   cannot mention the declared module of a section) *)

op bN____store_pre (_mem_v : global_mem_v_t) (_ap : W64.t) (_a : BA_16n.t) (_b_a : BA_16n.t) =
  (true /\
   ((is_valid ptr_modulus _mem_v (W64.to_uint _ap) (8 * (2 * nlimbs))) /\
   (BA_16n.is_init _b_a 0 (8 * (2 * nlimbs))))).

op bN____store_post (_ap : W64.t) (_a : BA_16n.t) (_b_a : BA_16n.t) (_res : trace) =
  true.

op bN___store__pre (_mem_v : global_mem_v_t) (_ap : W64.t) (_a : BA_16n.t) (_b_a : BA_16n.t) =
  (true /\
   ((is_valid ptr_modulus _mem_v (W64.to_uint _ap) (8 * (2 * nlimbs))) /\
   (BA_16n.is_init _b_a 0 (8 * (2 * nlimbs))))).

op bN___store__post (_ap : W64.t) (_a : BA_16n.t) (_b_a : BA_16n.t) (_res : trace) =
  true.

op bn_ps_muln_pre (_mem_v : global_mem_v_t) (_rp : W64.t) (_ap : W64.t) (_bp : W64.t) =
