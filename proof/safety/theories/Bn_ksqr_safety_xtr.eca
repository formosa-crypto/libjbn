    (aux, aux_0, tmp__trace) <@ _kar_sqrn (param, b_param, param_0,
    (BA_16n.init_arr (W8.of_int 255)));
    result <- aux;
    b_result <- aux_0;
    trace__kar_sqrn_ <- (trace__kar_sqrn_ ++ tmp__trace);
    trace__kar_sqrn_ <-
    (trace__kar_sqrn_ ++
    [(Assert, (BA_32n.is_init b_result 0 (32 * nlimbs)))]);
    r <- result;
    r <- r;
    b_r <- (BA_32n.init_arr (W8.of_int 255));
    return (r, b_r, trace__kar_sqrn_);
  }
}.

(* the specifications, as module-free pre- and postconditions (an op
   cannot mention the declared module of a section) *)

op __sub_abs_pre (_r : BA_8n.t) (_b_r : BA_8n.t) (_a : BA_8n.t) (_b_a : BA_8n.t) (_b : BA_8n.t) (_b_b : BA_8n.t) =
  ((BA_8n.is_init _b_a 0 (8 * nlimbs)) /\ (BA_8n.is_init _b_b 0 (8 * nlimbs))).

op __sub_abs_post (_r : BA_8n.t) (_b_r : BA_8n.t) (_a : BA_8n.t) (_b_a : BA_8n.t) (_b : BA_8n.t) (_b_b : BA_8n.t) (_res : BA_8n.t * BA_8n.t * trace) =
  (BA_8n.is_init _res.`2 0 (8 * nlimbs)).

op _kar_sqrn_pre (_r : BA_32n.t) (_b_r : BA_32n.t) (_a : BA_16n.t) (_b_a : BA_16n.t) =
  (BA_16n.is_init _b_a 0 (8 * (2 * nlimbs))).

op _kar_sqrn_post (_r : BA_32n.t) (_b_r : BA_32n.t) (_a : BA_16n.t) (_b_a : BA_16n.t) (_res : BA_32n.t * BA_32n.t * trace) =
  (BA_32n.is_init _res.`2 0 (16 * (2 * nlimbs))).

op _kar_sqrn__pre (_r : BA_32n.t) (_b_r : BA_32n.t) (_a : BA_16n.t) (_b_a : BA_16n.t) =
  (BA_16n.is_init _b_a 0 (8 * (2 * nlimbs))).

op _kar_sqrn__post (_r : BA_32n.t) (_b_r : BA_32n.t) (_a : BA_16n.t) (_b_a : BA_16n.t) (_res : BA_32n.t * BA_32n.t * trace) =
  (BA_32n.is_init _res.`2 0 (16 * (2 * nlimbs))).

op _subU__pre (_a : BA_16n.t) (_b_a : BA_16n.t) (_b : BA_16n.t) (_b_b : BA_16n.t) =
  ((BA_16n.is_init _b_b 0 (16 * nlimbs)) /\ (BA_16n.is_init _b_a 0 (16 * nlimbs))).

op _subU__post (_a : BA_16n.t) (_b_a : BA_16n.t) (_b : BA_16n.t) (_b_b : BA_16n.t) (_res : bool * BA_16n.t * BA_16n.t * trace) =
  (BA_16n.is_init _res.`3 0 (16 * nlimbs)).

op fun_ksqrn_pre (_r : BA_16n.t) (_b_r : BA_16n.t) (_a : BA_8n.t) (_b_a : BA_8n.t) =
  (BA_8n.is_init _b_a 0 (8 * nlimbs)).

op fun_ksqrn_post (_r : BA_16n.t) (_b_r : BA_16n.t) (_a : BA_8n.t) (_b_a : BA_8n.t) (_res : BA_16n.t * BA_16n.t * trace) =
  (BA_16n.is_init _res.`2 0 (8 * (2 * nlimbs))).

