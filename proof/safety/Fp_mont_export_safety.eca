lemma fp_add_proof _rp _ap _bp :
  hoare [M(P).fp_add :
    arg = (_rp, _ap, _bp) /\ fp_add_pre Glob.mem_v _rp _ap _bp
    ==> fp_add_post _rp _ap _bp res /\ valid res].
proof.
hint +safety.
proc.
rewrite /fp_add_pre /fp_add_post /_addmU__pre /_addmU__post.
wp; ecall (BNB._store__proof param_6 param_7 ((BA_8n.init_arr (W8.of_int 255)))).
wp; ecall (_addmU__h param_3 ((BA_8n.init_arr (W8.of_int 255))) param_4 ((BA_8n.init_arr (W8.of_int 255))) param_5 ((BA_32n_8.init_arr (W8.of_int 255)))).
wp; ecall (BNB._load__proof param_1 b_param_0 param_2).
wp; ecall (BNB._load__proof param b_param param_0).
by auto => /> *; smt(gt0_nlimbs).
qed.

