lemma __mont_redM_proof _r _b_r _a _b_a __P_mP _b__P_mP __U0 : __mont_redM_spec _r _b_r _a _b_a __P_mP _b__P_mP __U0.
proof.
hint +safety.
rewrite /__mont_redM_spec; proc.
wp; ecall (BNB._cminusP__proof param_23 b_param_5 param_24 b_param_6 param_25).
wp.
while (valid trace___mont_redM /\ inc = 2 * nlimbs - 1
       /\ nlimbs <= k <= 2 * nlimbs - 1
       /\ BA_8n.is_init b_r 0 (8 * nlimbs) /\ BArray24.is_init b_x 0 24
       /\ BA_8n.is_init b_P 0 (8 * nlimbs) /\ BA_16n.is_init b__P_mP 0 (16 * nlimbs)).
- wp; ecall (BNUTIL.__addacc3_proof param_19 ((BArray24.init_arr (W8.of_int 255))) param_20 param_21 param_22).
  wp; ecall (__muln_innerloop_proof param_13 b_param_2 param_14 param_15 param_16 param_17 b_param_3 param_18 b_param_4).
  auto => /> &hr hv hk0 hk1 hr hx hp hpm hin.
  have hsub: BA_8n.is_init b_r{hr} (8 * (k{hr} - nlimbs + 1))
                                (8 * (nlimbs - (k{hr} - nlimbs + 1))).
  - by apply (BL_8n.is_init_sub _ _ _ _ _ hr); smt().
  split; first smt().
  move=> *; split; first smt(mod3_bnd).
  split; first smt().
  by apply BL_8n.is_init_mono64.
wp.
while (valid trace___mont_redM /\ 0 <= k <= nlimbs
       /\ BA_8n.is_init b_r 0 (8 * k) /\ BArray24.is_init b_x 0 24
       /\ BA_8n.is_init b_P 0 (8 * nlimbs) /\ BA_16n.is_init b__P_mP 0 (16 * nlimbs)).
- wp; ecall (BNUTIL.__addacc3_proof param_9 ((BArray24.init_arr (W8.of_int 255))) param_10 param_11 param_12).
  wp; ecall (BNUTIL.__addacc3_proof param_5 ((BArray24.init_arr (W8.of_int 255))) param_6 param_7 param_8).
  wp; ecall (__muln_innerloop_proof param b_param param_0 param_1 param_2 param_3 b_param_0 param_4 b_param_1).
  auto => /> &hr hv hk0 hk1 hr hx hp hpm hin.
  split; first smt().
  move=> *; split.
  - split; first smt(mod3_bnd).
    by apply (BL_8n.is_init_sub _ _ _ _ _ hp); smt().
  split; first smt().
  by apply BL_8n.is_init_ext64 => /#.
auto => /> ha hpm.
have hP: BA_8n.is_init (SB_16n__8n.get_sub _b__P_mP 0) 0 (8 * nlimbs).
- rewrite SBI_16n__8n.is_init_get_sub; 1..4: smt(gt0_nlimbs).
  by apply (BL_16n.is_init_sub _ _ _ _ _ hpm); smt(gt0_nlimbs).
have hmP: BA_8n.is_init (SB_16n__8n.get_sub _b__P_mP (8 * nlimbs)) 0 (8 * nlimbs).
- rewrite SBI_16n__8n.is_init_get_sub; 1..4: smt(gt0_nlimbs).
  by apply (BL_16n.is_init_sub _ _ _ _ _ hpm); smt(gt0_nlimbs).
split; first smt(gt0_nlimbs).
move=> b_r0 b_x0 k0 tr0 hk hv0 hk0 hk1 hr0 hx0 _.
split; first smt(gt0_nlimbs).
move=> b_r1 b_x1 k1 tr1 hk' hv1 hk2 hk3 hr1 hx1.
split; first by split; [done | apply BL_8n.is_init_mono64].
move=> _ _ r0 _ _.
have hx2 := BL24.is_init_sub _ _ _ (2 * nlimbs %% 3 * 8) 8 hx1 _ _; 1,2: smt(mod3_bnd).
have hx3 := BL24.is_init_sub _ _ _ ((2 * nlimbs - 1) %% 3 * 8) 8 hx1 _ _; 1,2: smt(mod3_bnd).
smt(mod3_bnd gt0_nlimbs).
qed.
