lemma __sqrn_innerloop_proof _x _b_x _k _istart _iend _a _b_a : __sqrn_innerloop_spec _x _b_x _k _istart _iend _a _b_a.
proof.
hint +safety.
rewrite /__sqrn_innerloop_spec; proc.
wp; while (valid trace___sqrn_innerloop /\ inc = iend
           /\ istart <= i /\ (istart <= iend => i <= iend)
           /\ 0 <= istart /\ iend <= nlimbs /\ 0 <= k - (iend - 1) /\ k - istart < nlimbs).
- wp; ecall (BNUTIL.__addacc3x2_proof param (BArray24.init_arr (W8.of_int 255)) param_0 param_1 param_2).
  by auto => /> &hr *; smt().
by auto => /> &hr *; smt().
qed.

lemma __ps_sqrn_proof _r _b_r _a _b_a : __ps_sqrn_spec _r _b_r _a _b_a.
proof.
hint +safety.
rewrite /__ps_sqrn_spec; proc.
wp.
while (valid trace___ps_sqrn /\ inc = 2 * nlimbs - 1 /\ nlimbs <= k <= 2 * nlimbs - 1
       /\ BA_16n.is_init b_r 0 (8 * k) /\ BArray24.is_init b_x 0 24).
- seq ^if : (valid trace___ps_sqrn /\ inc = 2 * nlimbs - 1 /\ nlimbs <= k < 2 * nlimbs - 1 /\ BA_16n.is_init b_r 0 (8 * k) /\ b_x = (BArray24.init_arr (W8.of_int 255))).
  + wp; ecall (__sqrn_innerloop_proof param_8 b_param_0 param_9 param_10 param_11 param_12 ((BA_8n.init_arr (W8.of_int 255)))).
    by auto => /> &hr *; smt().
  if.
  + wp; ecall (BNUTIL.__addacc3_proof param_13 ((BArray24.init_arr (W8.of_int 255))) param_14 param_15 param_16).
    auto => /> &hr *.
    have h := BL_16n.is_init_ext64 b_r{hr} k{hr} _ _; 1,2: smt().
    smt(mod3_bnd BL24.is_init_mono64).
  auto => /> &hr *.
  have h := BL_16n.is_init_ext64 b_r{hr} k{hr} _ _; 1,2: smt().
  smt(mod3_bnd BL24.is_init_mono64).
wp.
while (valid trace___ps_sqrn /\ 1 <= k <= nlimbs /\ BA_16n.is_init b_r 0 (8 * k) /\ BArray24.is_init b_x 0 24).
- seq ^if : (valid trace___ps_sqrn /\ 1 <= k < nlimbs /\ BA_16n.is_init b_r 0 (8 * k) /\ b_x = (BArray24.init_arr (W8.of_int 255))).
  + wp; ecall (__sqrn_innerloop_proof param b_param param_0 param_1 param_2 param_3 ((BA_8n.init_arr (W8.of_int 255)))).
    by auto => /> &hr *; smt().
  if.
  + wp; ecall (BNUTIL.__addacc3_proof param_4 ((BArray24.init_arr (W8.of_int 255))) param_5 param_6 param_7).
    auto => /> &hr *.
    have h := BL_16n.is_init_ext64 b_r{hr} k{hr} _ _; 1,2: smt().
    smt(mod3_bnd BL24.is_init_mono64).
  auto => /> &hr *.
  have h := BL_16n.is_init_ext64 b_r{hr} k{hr} _ _; 1,2: smt().
  smt(mod3_bnd BL24.is_init_mono64).
auto => /> *; split; first smt(gt0_nlimbs).
move=> b_r0 b_x0 k0 tr0 hk hv hk0 hk1 hr0 hx0.
split; first smt(gt0_nlimbs).
move=> b_r1 b_x1 k1 tr1 hk' hv1 hk2 hk3 hr1 hx1.
have hk4 : k1 = 2 * nlimbs - 1 by smt().
move: hr1; rewrite hk4 => hr1.
have h := BL_16n.is_init_ext64 b_r1 (2 * nlimbs - 1) _ hr1; 1: smt(gt0_nlimbs).
have w := BL24.is_init_sub _ _ _ ((2 * nlimbs - 1) %% 3 * 8) 8 hx1 _ _; 1,2: smt(mod3_bnd).
split; first by rewrite (_: 16 * nlimbs = 8 * (2 * nlimbs - 1 + 1)) 1:/#.
smt(mod3_bnd gt0_nlimbs).
qed.

