qed.

lemma _mulm__proof _r _b_r _a _b_a _b _b_b _ctx _b_ctx :
  hoare [M(P)._mulm_ :
    arg = (_r, _b_r, _a, _b_a, _b, _b_b, _ctx, _b_ctx) /\ _mulm__pre _r _b_r _a _b_a _b _b_b _ctx _b_ctx
    ==> _mulm__post _r _b_r _a _b_a _b _b_b _ctx _b_ctx res /\ valid res.`3].
proof.
hint +safety.
proc.
wp; ecall (fun_red_h param_2 b_param_0 param_3 ((BA_16n.init_arr (W8.of_int 255))) param_4 ((BA_32n_8.init_arr (W8.of_int 255)))).
wp; ecall (fun_muln_h param b_param param_0 ((BA_8n.init_arr (W8.of_int 255))) param_1 ((BA_8n.init_arr (W8.of_int 255)))).
by auto => /> *; smt(ctx_slice ctx_full ctx_p gt0_nlimbs).
qed.

