proc.
wp; ecall (_mulmU__proof param ((BA_8n.init_arr (W8.of_int 255))) param_0 ((BA_8n.init_arr (W8.of_int 255))) param_1 ((BA_32n_8.init_arr (W8.of_int 255)))).
