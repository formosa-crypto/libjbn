(* the parameters of the exponentiation (sub-instance EXP): this field's
   fun_mulU and fun_sqrU *)
lemma P_EXP_mulU_h _a _b_a _b _b_b _ctx _b_ctx :
  hoare [M(P).P_EXP.fun_mulU :
    arg = (_a, _b_a, _b, _b_b, _ctx, _b_ctx) /\ BNE.fun_mulU_pre _a _b_a _b _b_b _ctx _b_ctx
    ==> BNE.fun_mulU_post _a _b_a _b _b_b _ctx _b_ctx res /\ valid res.`3].
proof.
by conseq (fun_mulU_proof _a _b_a _b _b_b _ctx _b_ctx).
qed.

lemma P_EXP_sqrU_h _a _b_a _ctx _b_ctx :
  hoare [M(P).P_EXP.fun_sqrU :
    arg = (_a, _b_a, _ctx, _b_ctx) /\ BNE.fun_sqrU_pre _a _b_a _ctx _b_ctx
    ==> BNE.fun_sqrU_post _a _b_a _ctx _b_ctx res /\ valid res.`3].
proof.
by conseq (fun_sqrU_proof _a _b_a _ctx _b_ctx).
qed.

lemma __Pm2_proof _r _b_r _ctx _b_ctx :
  hoare [M(P).__Pm2 :
    arg = (_r, _b_r, _ctx, _b_ctx) /\ __Pm2_pre _r _b_r _ctx _b_ctx
    ==> __Pm2_post _r _b_r _ctx _b_ctx res /\ valid res.`3].
proof.
hint +safety.
proc.
wp; while (valid trace___Pm2 /\ 1 <= i <= nlimbs /\ BA_8n.is_init b_r 0 (8 * i)).
- auto => /> &hr hv hi0 hi1 hb hin.
  have h := BL_8n.is_init_ext64 b_r{hr} i{hr} _ hb; 1: smt().
  smt().
by auto => /> *; smt(gt0_nlimbs).
qed.

lemma _invmU__proof _a _b_a _ctx _b_ctx :
  hoare [M(P)._invmU_ :
    arg = (_a, _b_a, _ctx, _b_ctx) /\ _invmU__pre _a _b_a _ctx _b_ctx
    ==> _invmU__post _a _b_a _ctx _b_ctx res /\ valid res.`3].
proof.
hint +safety.
proc.
wp; ecall (BNE._expmU_noct__proof (<: M(P).P_EXP) P_EXP_mulU_h P_EXP_sqrU_h param_1 ((BA_8n.init_arr (W8.of_int 255))) param_2 ((BA_8n.init_arr (W8.of_int 255))) param_3 ((BA_32n_8.init_arr (W8.of_int 255)))).
wp; ecall (__Pm2_proof param b_param param_0 ((BA_32n_8.init_arr (W8.of_int 255)))).
by auto => />.
qed.

lemma _invm__proof _r _b_r _a _b_a _ctx _b_ctx :
  hoare [M(P)._invm_ :
    arg = (_r, _b_r, _a, _b_a, _ctx, _b_ctx) /\ _invm__pre _r _b_r _a _b_a _ctx _b_ctx
    ==> _invm__post _r _b_r _a _b_a _ctx _b_ctx res /\ valid res.`3].
proof.
hint +safety.
proc.
wp; ecall (BNE._expm_noct__proof (<: M(P).P_EXP) P_EXP_mulU_h P_EXP_sqrU_h param_1 b_param_0 param_2 ((BA_8n.init_arr (W8.of_int 255))) param_3 ((BA_8n.init_arr (W8.of_int 255))) param_4 ((BA_32n_8.init_arr (W8.of_int 255)))).
wp; ecall (__Pm2_proof param b_param param_0 ((BA_32n_8.init_arr (W8.of_int 255)))).
by auto => />.
qed.

end section.
