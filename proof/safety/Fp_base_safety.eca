hint +safety.
proc.
wp; ecall (fun_red_h param_1 ((BA_8n.init_arr (W8.of_int 255))) param_2 ((BA_16n.init_arr (W8.of_int 255))) param_3 ((BA_32n_8.init_arr (W8.of_int 255)))).
wp; ecall (fun_sqrn_h param b_param param_0 ((BA_8n.init_arr (W8.of_int 255)))).
