lemma fpc_ctx_init_proof _ctx _b_ctx _pp :
  hoare [M(P).fpc_ctx_init :
    arg = (_ctx, _b_ctx, _pp) /\ fpc_ctx_init_pre Glob.mem_v _ctx _b_ctx _pp
    ==> fpc_ctx_init_post _ctx _b_ctx _pp res /\ valid res.`3].
proof.
hint +safety.
proc.
rewrite /fpc_ctx_init_pre /fpc_ctx_init_post /_ctx_init__pre /_ctx_init__post.
wp; ecall (_ctx_init__h param_1 b_param_0 param_2 ((BA_8n.init_arr (W8.of_int 255)))).
wp; ecall (BNB._load__proof param b_param param_0).
by auto => /> *; smt(gt0_nlimbs).
qed.

