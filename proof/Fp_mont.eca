 : FPC.ctx_mod _p ctx /\ mont_ctx _p ctx /\ a = _a /\ b = _b /\ bn _a < _p /\ bn _b < _p
   ==> bn res = FPB.red _p (bn _a * bn _b).
proof. by proc*; call (FPB._mulmU__h (<: M(P).P_FPB) P_FPB_muln_ll P_FPB_sqrn_ll P_FPB_red_ll P_FPB_muln_h P_FPB_sqrn_h P_FPB_red_h _p _a _b). qed.

lemma _mulmU__ll: islossless M(P)._mulmU_.
proof. by proc*; call (FPB._mulmU__ll (<: M(P).P_FPB) P_FPB_muln_ll P_FPB_sqrn_ll P_FPB_red_ll P_FPB_muln_h P_FPB_sqrn_h P_FPB_red_h). qed.

hoare _sqrm__h _p _a:
 M(P)._sqrm_
 : FPC.ctx_mod _p ctx /\ mont_ctx _p ctx /\ a = _a /\ bn _a < _p
   ==> bn res = FPB.red _p (bn _a * bn _a).
