hoare _invm__h _p _c _a:
 M(P)._invm_
 : ctx = _c /\ a = _a /\ FPB.ctx_fp _p _c /\ bn _a < _p
   ==> bn res = FPB.BNE.mexp _c (bn _a) (_p - 2).
proof. by proc*; call (FPB._invm__h (<: M(P).P_FPB) P_FPB_muln_ll P_FPB_sqrn_ll P_FPB_red_ll P_FPB_muln_h P_FPB_sqrn_h P_FPB_red_h _p _c _a). qed.

lemma _invm__ll: islossless M(P)._invm_.
proof. by proc*; call (FPB._invm__ll (<: M(P).P_FPB) P_FPB_muln_ll P_FPB_sqrn_ll P_FPB_red_ll P_FPB_muln_h P_FPB_sqrn_h P_FPB_red_h). qed.

hoare _invmU__h _p _c _a:
 M(P)._invmU_
 : ctx = _c /\ a = _a /\ FPB.ctx_fp _p _c /\ bn _a < _p
   ==> bn res = FPB.BNE.mexp _c (bn _a) (_p - 2).
proof. by proc*; call (FPB._invmU__h (<: M(P).P_FPB) P_FPB_muln_ll P_FPB_sqrn_ll P_FPB_red_ll P_FPB_muln_h P_FPB_sqrn_h P_FPB_red_h _p _c _a). qed.

lemma _invmU__ll: islossless M(P)._invmU_.
proof. by proc*; call (FPB._invmU__ll (<: M(P).P_FPB) P_FPB_muln_ll P_FPB_sqrn_ll P_FPB_red_ll P_FPB_muln_h P_FPB_sqrn_h P_FPB_red_h). qed.

(* conversion into Montgomery form: a * R mod p *)
hoare _toM__h p _a:
 M(P)._toM_
 : FPC.ctx_mont p ctx /\ a = _a /\ bn _a < p
   ==> bn res = bn _a * BN.bn_modulus %% p.
proof.
proc.
wp; ecall (FPB._mulmU__h (<: M(P).P_FPB) P_FPB_muln_ll P_FPB_sqrn_ll P_FPB_red_ll P_FPB_muln_h P_FPB_sqrn_h P_FPB_red_h p a r2).
wp; skip => /> &hr H1 Hodd HmP Hone HR2 HU0 Ha.
rewrite HR2; split; first smt(modz_ge0 ltz_pmod).
by move=> _ _ r ->; apply toM_math.
qed.

lemma _toM__ll: islossless M(P)._toM_.
proof. by proc; wp; call (FPB._mulmU__ll (<: M(P).P_FPB) P_FPB_muln_ll P_FPB_sqrn_ll P_FPB_red_ll P_FPB_muln_h P_FPB_sqrn_h P_FPB_red_h); auto. qed.

(* the context of p, computed in constant time *)
hoare _ctx_init__h _p:
 M(P)._ctx_init_
 : bn p = _p /\ 1 < _p /\ _p %% 2 = 1
   ==> FPC.ctx_mont _p res.
proof.
have Hn := gt0_nlimbs.
have Hb := nlimbs_bndN.
proc.
(* P and R-P *)
seq 11 : (bn p = _p /\ 1 < _p /\ _p %% 2 = 1 /\ FPC.ctx_mod _p ctx /\ FPC.ctxP ctx = p).
+ wp; ecall (BNB._neg__h p).
  wp; ecall (BNB._mov__h p).
  wp; skip => &hr [Hp [H1 Hodd]] /=.
  move=> r -> [cf t] Ht /=.
  rewrite !ctx_wrE.
  move: Hp => /= Hp.
  have [HP0 _] := ctx_wr_parts ctx{hr} 0 p{hr} _; first by left.
  have [HP1 [HMP1 _]] := ctx_wr_parts (ctx_wr ctx{hr} 0 p{hr}) nlimbs t _; first by right; left.
  rewrite /FPC.ctx_mod HP1 HMP1 HP0 /= (_: nlimbs <> 0) 1:/# /=.
  have := neg_val p{hr} cf t _ Ht; smt().
(* p0^-1 mod 2^64 by Newton's iteration: 3, 6, 12, 24, 48, 96 correct bits *)
seq 4 : (bn p = _p /\ 1 < _p /\ _p %% 2 = 1 /\ FPC.ctx_mod _p ctx /\ FPC.ctxP ctx = p
         /\ p0 = p.[0] /\ p0 * inv = W64.one).
+ while (bn p = _p /\ 1 < _p /\ _p %% 2 = 1 /\ FPC.ctx_mod _p ctx /\ FPC.ctxP ctx = p
         /\ 0 <= j <= 5 /\ p0 = p.[0]
         /\ 2 ^ (cap (3 * 2 ^ j)) %| to_uint (W64.one - p0 * inv)).
  - wp; skip => &hr [[Hp [H1 [Hodd [Hctx [HP [[Hj0 Hj5] [Hp0 Hd]]]]]]] Hj] /=.
    do 5! (split; first done).
    split; first smt().
    split; first done.
    rewrite newton_sq.
    rewrite (_: 3 * 2 ^ (j{hr} + 1) = 2 * (3 * 2 ^ j{hr})); first by rewrite exprS //; ring.
    rewrite -cap2; first smt(StdOrder.IntOrder.expr_ge0).
    by apply dvd_sq => //; rewrite /cap; smt(StdOrder.IntOrder.expr_ge0).
  wp; skip => &hr [Hp [H1 [Hodd [Hctx HP]]]] /=.
  split.
  - do 5! (split; first done).
    rewrite /cap /=; apply newton_init; rewrite -bn_parity Hp Hodd //.
  move=> inv0 j0 Hj [_ [_ [_ [_ [_ [[Hj0 Hj5] Hd]]]]]].
  do 5! (split; first done).
  have Ej: j0 = 5 by smt().
  move: Hd; rewrite Ej /cap /= => Hd.
  have := dvd_full _ Hd; rewrite W64.WRingA.subr_eq0 => <- //.
(* U0 = -p0^-1, and x = 1 *)
seq 7 : (bn p = _p /\ 1 < _p /\ _p %% 2 = 1 /\ FPC.ctx_mod _p ctx
         /\ FPC.ctxU0 ctx * (FPC.ctxP ctx).[0] = W64.of_int (-1)
         /\ to_uint i = 32 * nlimbs /\ bn _x = 1).
+ wp; ecall (BNB._set0__h); wp; skip => &hr [Hp [H1 [Hodd [Hctx [HP [Hp0 Hinv]]]]]] /= x Hx.
  have [HP' [HMP' [_ [_ HU']]]] := ctx_setU0_parts ctx{hr} (- inv{hr}).
  rewrite HP' HU' HP -Hp0.
  move: Hctx; rewrite /FPC.ctx_mod HP' HMP' => Hctx.
  do 4! (split; first done).
  have Em1: W64.of_int 18446744073709551615 = - W64.one by rewrite W64.to_uint_eq W64.to_uintN.
  split; first by rewrite Em1 -Hinv; ring.
  split; first by rewrite W64.of_uintK; smt().
  by apply bn_one_of_zero.
(* R mod p = 4^(32*nlimbs) mod p, by modular doublings of 1 *)
seq 1 : (bn p = _p /\ 1 < _p /\ _p %% 2 = 1 /\ FPC.ctx_mod _p ctx
         /\ FPC.ctxU0 ctx * (FPC.ctxP ctx).[0] = W64.of_int (-1)
         /\ bn _x = BN.bn_modulus %% _p).
+ while (bn p = _p /\ 1 < _p /\ _p %% 2 = 1 /\ FPC.ctx_mod _p ctx
         /\ FPC.ctxU0 ctx * (FPC.ctxP ctx).[0] = W64.of_int (-1)
         /\ 0 <= to_uint i <= 32 * nlimbs
         /\ bn _x = 4 ^ (32 * nlimbs - to_uint i) %% _p).
  - wp; ecall (FPB._addm__h (<: M(P).P_FPB) P_FPB_muln_ll P_FPB_sqrn_ll P_FPB_red_ll P_FPB_muln_h P_FPB_sqrn_h P_FPB_red_h _p y y).
    wp; ecall (FPB._addm__h (<: M(P).P_FPB) P_FPB_muln_ll P_FPB_sqrn_ll P_FPB_red_ll P_FPB_muln_h P_FPB_sqrn_h P_FPB_red_h _p x x).
    wp; skip => &hr [[Hp [H1 [Hodd [Hctx [HU [[Hi0 Hi1] Hx]]]]]] Hi] /=.
    move: Hi; rewrite W64.ultE /= => Hi.
    have Hi': to_uint (i{hr} - W64.one) = to_uint i{hr} - 1.
    + by rewrite W64.to_uintB 1:W64.uleE /=; smt().
    split; first by rewrite Hx; smt(modz_ge0 ltz_pmod).
    move=> _ r Hr; split; first by rewrite Hr; smt(modz_ge0 ltz_pmod).
    move=> _ r0 Hr0.
    do 4! (split; first done).
    split; first by move: HU => /=.
    rewrite Hi'; split; first smt().
    rewrite Hr0 Hr Hx.
    have := quad_step _p 1 (32 * nlimbs - to_uint i{hr}) _; first smt().
    rewrite !mul1z => ->.
    by rewrite (_: 32 * nlimbs - (to_uint i{hr} - 1) = 32 * nlimbs - to_uint i{hr} + 1) 1:/#.
  skip => &hr [Hp [H1 [Hodd [Hctx [HU [Hi Hx]]]]]].
  split.
  - do 5! (split; first done).
    rewrite Hi Hx subzz expr0 modz_small; smt().
  move=> x0 i0 Hi0 [_ [_ [_ [_ [_ [[Hi00 Hi01] Hx0]]]]]].
  do 5! (split; first done).
  have Ei: to_uint i0 = 0 by move: Hi0; rewrite W64.ultE /=; smt().
  by rewrite Hx0 Ei /= pow4R.
(* ONE = R mod p *)
seq 5 : (bn p = _p /\ 1 < _p /\ _p %% 2 = 1 /\ FPC.ctx_mod _p ctx
         /\ FPC.ctxU0 ctx * (FPC.ctxP ctx).[0] = W64.of_int (-1)
         /\ bn (FPC.ctxONE ctx) = BN.bn_modulus %% _p
         /\ to_uint i = 32 * nlimbs /\ bn _x = BN.bn_modulus %% _p).
+ wp; ecall (BNB._mov__h x); wp; skip => &hr [Hp [H1 [Hodd [Hctx [HU Hx]]]]] /= r ->.
  rewrite !ctx_wrE.
  have H20: 2 * nlimbs <> 0 by smt().
  have H21: 2 * nlimbs <> nlimbs by smt().
  have [HP [HMP [HONE [_ HU0]]]] := ctx_wr_parts ctx{hr} (2 * nlimbs) _x{hr} _; first by right; right; left.
  move: HP HMP; rewrite H20 H21 /= => HP HMP.
  rewrite HP HONE HU0 /=.
  do 3! (split; first done).
  split; first by move: Hctx; rewrite /FPC.ctx_mod HP HMP.
  split; first by move: HU => /=.
  split; first done.
  by rewrite W64.of_uintK; smt().
(* R^2 mod p = R * 4^(32*nlimbs) mod p, by modular doublings of R mod p *)
seq 1 : (bn p = _p /\ 1 < _p /\ _p %% 2 = 1 /\ FPC.ctx_mod _p ctx
         /\ FPC.ctxU0 ctx * (FPC.ctxP ctx).[0] = W64.of_int (-1)
         /\ bn (FPC.ctxONE ctx) = BN.bn_modulus %% _p
         /\ bn _x = BN.bn_modulus * BN.bn_modulus %% _p).
+ while (bn p = _p /\ 1 < _p /\ _p %% 2 = 1 /\ FPC.ctx_mod _p ctx
         /\ FPC.ctxU0 ctx * (FPC.ctxP ctx).[0] = W64.of_int (-1)
         /\ bn (FPC.ctxONE ctx) = BN.bn_modulus %% _p
         /\ 0 <= to_uint i <= 32 * nlimbs
         /\ bn _x = BN.bn_modulus * 4 ^ (32 * nlimbs - to_uint i) %% _p).
  - wp; ecall (FPB._addm__h (<: M(P).P_FPB) P_FPB_muln_ll P_FPB_sqrn_ll P_FPB_red_ll P_FPB_muln_h P_FPB_sqrn_h P_FPB_red_h _p y y).
    wp; ecall (FPB._addm__h (<: M(P).P_FPB) P_FPB_muln_ll P_FPB_sqrn_ll P_FPB_red_ll P_FPB_muln_h P_FPB_sqrn_h P_FPB_red_h _p x x).
    wp; skip => &hr [[Hp [H1 [Hodd [Hctx [HU [HONE [[Hi0 Hi1] Hx]]]]]]] Hi] /=.
    move: Hi; rewrite W64.ultE /= => Hi.
    have Hi': to_uint (i{hr} - W64.one) = to_uint i{hr} - 1.
    + by rewrite W64.to_uintB 1:W64.uleE /=; smt().
    split; first by rewrite Hx; smt(modz_ge0 ltz_pmod).
    move=> _ r Hr; split; first by rewrite Hr; smt(modz_ge0 ltz_pmod).
    move=> _ r0 Hr0.
    do 4! (split; first done).
    split; first by move: HU => /=.
    split; first done.
    rewrite Hi'; split; first smt().
    rewrite Hr0 Hr Hx.
    have := quad_step _p BN.bn_modulus (32 * nlimbs - to_uint i{hr}) _; first smt().
    move=> ->.
    by rewrite (_: 32 * nlimbs - (to_uint i{hr} - 1) = 32 * nlimbs - to_uint i{hr} + 1) 1:/#.
  skip => &hr [Hp [H1 [Hodd [Hctx [HU [HONE [Hi Hx]]]]]]].
  split.
  - do 6! (split; first done).
    rewrite Hi Hx subzz expr0 mulz1; smt().
  move=> x0 i0 Hi0 [_ [_ [_ [_ [_ [_ [[Hi00 Hi01] Hx0]]]]]]].
  do 6! (split; first done).
  have Ei: to_uint i0 = 0 by move: Hi0; rewrite W64.ultE /=; smt().
  by rewrite Hx0 Ei /= pow4R.
(* R2 = R^2 mod p *)
wp; ecall (BNB._mov__h x); wp; skip => &hr [Hp [H1 [Hodd [Hctx [HU [HONE Hx]]]]]] /= r ->.
rewrite !ctx_wrE.
have H30: 3 * nlimbs <> 0 by smt().
have H31: 3 * nlimbs <> nlimbs by smt().
have H32: 3 * nlimbs <> 2 * nlimbs by smt().
have [HP [HMP [HONE' [HR2 HU0]]]] := ctx_wr_parts ctx{hr} (3 * nlimbs) _x{hr} _; first by right; right; right.
move: HP HMP HONE'; rewrite H30 H31 H32 /= => HP HMP HONE'.
rewrite /FPC.ctx_mont HP HONE' HR2 HU0 /=.
split; first by move: Hctx; rewrite /FPC.ctx_mod HP HMP.
split; first done.
split; first by rewrite Hx.
by move: HU => /=.
qed.

lemma _ctx_init__ll: islossless M(P)._ctx_init_.
proof.
proc.
wp; call BNB._mov__ll; wp.
while true (to_uint i).
+ move=> z; wp.
  call (FPB._addm__ll (<: M(P).P_FPB) P_FPB_muln_ll P_FPB_sqrn_ll P_FPB_red_ll P_FPB_muln_h P_FPB_sqrn_h P_FPB_red_h); wp.
  call (FPB._addm__ll (<: M(P).P_FPB) P_FPB_muln_ll P_FPB_sqrn_ll P_FPB_red_ll P_FPB_muln_h P_FPB_sqrn_h P_FPB_red_h); wp.
  skip => &hr [Hi <-]; move: Hi; rewrite W64.ultE /= => Hi.
  by rewrite W64.to_uintB 1:W64.uleE /=; smt().
wp; call BNB._mov__ll; wp.
while true (to_uint i).
+ move=> z; wp.
  call (FPB._addm__ll (<: M(P).P_FPB) P_FPB_muln_ll P_FPB_sqrn_ll P_FPB_red_ll P_FPB_muln_h P_FPB_sqrn_h P_FPB_red_h); wp.
  call (FPB._addm__ll (<: M(P).P_FPB) P_FPB_muln_ll P_FPB_sqrn_ll P_FPB_red_ll P_FPB_muln_h P_FPB_sqrn_h P_FPB_red_h); wp.
  skip => &hr [Hi <-]; move: Hi; rewrite W64.ultE /= => Hi.
  by rewrite W64.to_uintB 1:W64.uleE /=; smt().
wp; call BNB._set0__ll; wp.
while true (5 - j).
+ by move=> z; wp; skip => /> /#.
wp; call BNB._neg__ll; wp; call BNB._mov__ll; wp; skip => />.
smt(W64.to_uint_cmp W64.ultE).
qed.

end section.
