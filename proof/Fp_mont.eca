require import AllCore Int IntDiv List StdOrder.
from Jasmin require import JModel_x86.
import SLH64.

require JBigNumber.

(* Correctness contracts for fp_mont@fp.jinc: arithmetic modulo P in
   Montgomery form, generic in the multiplication (fun_muln/fun_sqrn, the
   module parameter of M). Its MUL is the selector bn_mulsel (Bn_mulsel),
   so the contracts hold for every profile. The field operations are those of Fp_base, with
   the Montgomery reduction (factor R^-1): a representative x stands for
   x * R^-1 mod P. *)

(* Parameters *)
op nlimbs: int.
axiom gt0_nlimbs: 0 < nlimbs.
(* the bit length of R = 2^(64*nlimbs) fits in a word (the context
   initialisation counts its doublings in a word; Bn_mul needs less) *)
axiom nlimbs_bnd: 64 * nlimbs < W64.modulus.
lemma nlimbs_bndN: 64 * nlimbs < 18446744073709551616 by have := nlimbs_bnd.
lemma nlimbs_bnd4: 4 * nlimbs < W64.modulus.
proof. rewrite (_: W64.modulus = 18446744073709551616) //; smt(nlimbs_bndN gt0_nlimbs). qed.

(* the profile (src/amd64/ref/profiles), which selects the Montgomery
   reduction (Bn_mulsel): any values *)
op jbn_features: int.
op jbn_reg_max: int.
op jbn_unroll_max: int.

clone export JBigNumber.BigN
 with op nlimbs <- nlimbs
      proof gt0_nlimbs by exact gt0_nlimbs.

import BN2.
import BN.

require Bn_util.
clone Bn_util as BNUTIL.
module BNUTIL_M = BNUTIL.M.

require Bn_base.
clone Bn_base as BNB
 with op nlimbs <- nlimbs,
      theory BigN <- BigN,
      theory BNUTIL <- BNUTIL
      proof gt0_nlimbs by exact gt0_nlimbs.
module BNB_M = BNB.M.

require Bn_mulsel.
clone Bn_mulsel as BNMUL
 with op nlimbs <- nlimbs,
      op jbn_features <- jbn_features,
      op jbn_reg_max <- jbn_reg_max,
      op jbn_unroll_max <- jbn_unroll_max,
      theory BigN <- BigN,
      theory BNUTIL <- BNUTIL,
      theory BNB <- BNB
      proof gt0_nlimbs by exact gt0_nlimbs,
            nlimbs_bnd by exact nlimbs_bnd4.
module BNMUL_M = BNMUL.M.

require Fp_ctx.
clone Fp_ctx as FPC
 with op nlimbs <- nlimbs,
      theory BigN <- BigN
      proof gt0_nlimbs by exact gt0_nlimbs.
import FPC.CTX.

(* the Montgomery reduction: factor R^-1; it needs U0 = -P^-1 mod 2^64 *)
op Rinv (p: int) : int = invm BN.bn_modulus p.
op mont_ctx (p: int) (c: W64.t FPC.CTX.t) : bool =
  FPC.ctxU0 c * (FPC.ctxP c).[0] = W64.of_int (-1).

(* R = 2^(64*nlimbs) is invertible modulo an odd p *)
lemma coprime_pow2 p k: p %% 2 = 1 => 0 <= k => coprime p (2 ^ k).
proof.
move=> Hp; elim/natind: k => [k Hk H0|k Hk IH _].
- by rewrite (_: k = 0) 1:/# expr0 coprimez1.
- by rewrite exprS // coprimeMr IH //= coprimez2 oddP Hp.
qed.

lemma Rinv_R p: 1 < p => p %% 2 = 1 => (Rinv p * BN.bn_modulus) %% p = 1.
proof.
move=> Hp Hodd; rewrite /Rinv mulzC; apply invmP => //.
rewrite BN.bn_modulusE (_: W64.modulus = 2 ^ 64) // -exprM.
by apply coprime_pow2 => //; smt(gt0_nlimbs).
qed.

require Fp_base.
clone Fp_base as FPB
 with op nlimbs <- nlimbs,
      theory BigN <- BigN,
      theory BNUTIL <- BNUTIL,
      theory BNB <- BNB,
      theory FPC <- FPC,
      op redK <- Rinv,
      op red_ctx <- mont_ctx
 proof gt0_nlimbs by exact gt0_nlimbs,
       nlimbs_bnd by exact nlimbs_bnd.

(* a Montgomery context is a context of the field operations (Fp_base) *)
lemma ctx_mont_fp p c: FPC.ctx_mont p c => FPB.ctx_fp p c.
proof.
move=> [Hm [Hone [_ HU0]]]; have [H1 [Hodd _]] := Hm.
have HR := Rinv_R p H1 Hodd.
split => //; split; first by rewrite /mont_ctx.
rewrite Hone; split; first smt(modz_ge0 ltz_pmod).
by rewrite /FPB.red modzMml mulzC.
qed.

(* conversion into Montgomery form: multiplication by R^2 mod p, reduced *)
lemma toM_math p a: 1 < p => p %% 2 = 1 =>
  FPB.red p (a * (BN.bn_modulus * BN.bn_modulus %% p)) = a * BN.bn_modulus %% p.
proof.
move=> H1 Hodd; have Hinv := Rinv_R p H1 Hodd.
rewrite /FPB.red.
rewrite (_: a * (BN.bn_modulus * BN.bn_modulus %% p) * Rinv p
          = (BN.bn_modulus * BN.bn_modulus %% p) * (a * Rinv p)); first by ring.
rewrite modzMml.
rewrite (_: BN.bn_modulus * BN.bn_modulus * (a * Rinv p)
          = (a * BN.bn_modulus) * (Rinv p * BN.bn_modulus)); first by ring.
by rewrite -modzMmr Hinv.
qed.

(* the context of p, computed by _ctx_init_ *)

(* -p^-1 mod 2^64 by Newton's iteration: the error 1 - p0*inv is squared at
   each step, and the power of 2 dividing it doubles (capped at 64) *)
op cap (a: int) = if a < 64 then a else 64.

lemma newton_sq (p0 inv: W64.t):
  W64.one - p0 * (inv * (- (p0 * inv) + W64.of_int 2))
  = (W64.one - p0 * inv) * (W64.one - p0 * inv).
proof. by ring. qed.

lemma dvd_sq (e: W64.t) a: 0 <= a => 2 ^ a %| to_uint e =>
  2 ^ (cap (2 * a)) %| to_uint (e * e).
proof.
move=> Ha Hd.
have H1: 2 ^ (cap (2 * a)) %| 2 ^ (2 * a) by apply dvdz_exp2l; rewrite /cap; smt().
have H2: 2 ^ (cap (2 * a)) %| W64.modulus.
+ by rewrite (_: W64.modulus = 2 ^ 64) //; apply dvdz_exp2l; rewrite /cap; smt().
have H3: 2 ^ (2 * a) %| to_uint e * to_uint e.
+ by rewrite (_: 2 * a = a + a) 1:/# exprD_nneg //; apply dvdz_mul.
rewrite W64.to_uintM modzE; apply dvdzB.
- exact (dvdz_trans _ _ _ H1 H3).
- exact (dvdz_mull _ _ _ H2).
qed.

lemma newton_init (p0: W64.t): to_uint p0 %% 2 = 1 => 2 ^ 3 %| to_uint (W64.one - p0 * p0).
proof.
move=> Hodd.
have ->: to_uint (W64.one - p0 * p0) = (1 - to_uint p0 * to_uint p0) %% W64.modulus.
+ by rewrite W64.to_uintD W64.to_uintN W64.to_uintM /= modzNm modzDmr.
have H8: 2 ^ 3 %| W64.modulus by rewrite (_: W64.modulus = 2 ^ 64) //; apply dvdz_exp2l.
rewrite modzE; apply dvdzB; last by apply dvdz_mull.
have [k Hk] := oddW (to_uint p0) _; first by rewrite oddP Hodd.
rewrite Hk (_: 1 - (2 * k + 1) * (2 * k + 1) = - 4 * (k * (k + 1))) 1:/#.
have: k %% 2 = 0 \/ k %% 2 = 1 by smt(modz_ge0 ltz_pmod).
move=> [Hk2|Hk2]; apply dvdzP.
- by exists (- (k %/ 2) * (k + 1)); smt(divz_eq).
- by exists (- k * ((k + 1) %/ 2)); smt(divz_eq).
qed.

lemma dvd_full (e: W64.t): 2 ^ 64 %| to_uint e => e = W64.zero.
proof.
move=> H; apply W64.to_uint_eq => /=.
have /dvdzP [q Hq] := H.
have := W64.to_uint_cmp e; rewrite (_: W64.modulus = 2 ^ 64) // Hq.
smt(StdOrder.IntOrder.expr_gt0).
qed.

(* R mod p and R^2 mod p by doublings: 4^(32*nlimbs) = R *)
lemma pow4R: 4 ^ (32 * nlimbs) = BN.bn_modulus.
proof.
rewrite BN.bn_modulusE (_: W64.modulus = 2 ^ 64) // (_: 4 = 2 ^ 2) // -!exprM.
by congr; ring.
qed.

lemma quad_step p k t: 0 <= t =>
  (((k * 4 ^ t) %% p + (k * 4 ^ t) %% p) %% p + ((k * 4 ^ t) %% p + (k * 4 ^ t) %% p) %% p) %% p
  = (k * 4 ^ (t + 1)) %% p.
proof.
move=> Ht; rewrite !modzDm exprS //.
rewrite (_: k * 4 ^ t %% p + k * 4 ^ t %% p + (k * 4 ^ t %% p + k * 4 ^ t %% p)
          = 4 * (k * 4 ^ t %% p)) 1:/# modzMmr.
by rewrite (_: k * (4 * 4 ^ t) = 4 * (k * 4 ^ t)); first by ring.
qed.

(* the writes of _ctx_init_ into the context: the part at offset o *)
op ctx_wr (c: W64.t FPC.CTX.t) (o: int) (t: BN.t) : W64.t FPC.CTX.t =
  FPC.CTX.init (fun i => if o <= i < o + nlimbs then t.[i - o] else c.[i]).

lemma ctx_wr_get c o t i: 0 <= i < 4 * nlimbs + 1 =>
  (ctx_wr c o t).[i] = if o <= i < o + nlimbs then t.[i - o] else c.[i].
proof. by move=> Hi; rewrite /ctx_wr FPC.CTX.initiE. qed.

lemma ctx_wr_part c o q t: 0 <= q <= 3 * nlimbs => 0 <= o <= 3 * nlimbs =>
  (q = o \/ q + nlimbs <= o \/ o + nlimbs <= q) =>
  BN.A.init (fun i => (ctx_wr c o t).[q + i])
  = if q = o then t else BN.A.init (fun i => c.[q + i]).
proof.
move=> Hq Ho Hd; have Hn := gt0_nlimbs.
apply BN.A.ext_eq => i Hi; rewrite BN.A.initiE //= ctx_wr_get 1:/#.
case: (q = o) => [->|Hqo] /=; first by rewrite (_: o <= o + i < o + nlimbs) 1:/# /= (_: o + i - o = i) 1:/#.
by rewrite (_: !(o <= q + i < o + nlimbs)) 1:/# /= BN.A.initiE.
qed.

lemma ctx_wr_U0 c o t: 0 <= o <= 3 * nlimbs =>
  FPC.ctxU0 (ctx_wr c o t) = FPC.ctxU0 c.
proof. by move=> Ho; rewrite /FPC.ctxU0 ctx_wr_get; smt(gt0_nlimbs). qed.

lemma ctx_wrE c o t:
  FPC.CTX.init (fun i => if o <= i < o + nlimbs then t.[i - o] else c.[i])
  = ctx_wr c o t.
proof. by rewrite /ctx_wr. qed.

(* the parts of a context after writing the part at offset o *)
lemma ctx_wr_parts c o t:
  o = 0 \/ o = nlimbs \/ o = 2 * nlimbs \/ o = 3 * nlimbs =>
  FPC.ctxP (ctx_wr c o t) = (if o = 0 then t else FPC.ctxP c)
  /\ FPC.ctxMP (ctx_wr c o t) = (if o = nlimbs then t else FPC.ctxMP c)
  /\ FPC.ctxONE (ctx_wr c o t) = (if o = 2 * nlimbs then t else FPC.ctxONE c)
  /\ FPC.ctxR2 (ctx_wr c o t) = (if o = 3 * nlimbs then t else FPC.ctxR2 c)
  /\ FPC.ctxU0 (ctx_wr c o t) = FPC.ctxU0 c.
proof.
move=> Ho; have Hn := gt0_nlimbs.
split; first by apply BN.A.ext_eq => i Hi; rewrite /FPC.ctxP BN.A.initiE //= ctx_wr_get 1:/#; smt(BN.A.initiE).
split; first by apply BN.A.ext_eq => i Hi; rewrite /FPC.ctxMP BN.A.initiE //= ctx_wr_get 1:/#; smt(BN.A.initiE).
split; first by apply BN.A.ext_eq => i Hi; rewrite /FPC.ctxONE BN.A.initiE //= ctx_wr_get 1:/#; smt(BN.A.initiE).
split; first by apply BN.A.ext_eq => i Hi; rewrite /FPC.ctxR2 BN.A.initiE //= ctx_wr_get 1:/#; smt(BN.A.initiE).
by apply ctx_wr_U0; smt().
qed.

(* the parts of a context after writing U0 *)
lemma ctx_setU0_parts (c: W64.t FPC.CTX.t) u:
  FPC.ctxP c.[4 * nlimbs <- u] = FPC.ctxP c
  /\ FPC.ctxMP c.[4 * nlimbs <- u] = FPC.ctxMP c
  /\ FPC.ctxONE c.[4 * nlimbs <- u] = FPC.ctxONE c
  /\ FPC.ctxR2 c.[4 * nlimbs <- u] = FPC.ctxR2 c
  /\ FPC.ctxU0 c.[4 * nlimbs <- u] = u.
proof.
have Hn := gt0_nlimbs.
split; first by apply BN.A.ext_eq => i Hi; rewrite /FPC.ctxP !BN.A.initiE //= FPC.CTX.get_setE 1:/#; smt().
split; first by apply BN.A.ext_eq => i Hi; rewrite /FPC.ctxMP !BN.A.initiE //= FPC.CTX.get_setE 1:/#; smt().
split; first by apply BN.A.ext_eq => i Hi; rewrite /FPC.ctxONE !BN.A.initiE //= FPC.CTX.get_setE 1:/#; smt().
split; first by apply BN.A.ext_eq => i Hi; rewrite /FPC.ctxR2 !BN.A.initiE //= FPC.CTX.get_setE 1:/#; smt().
by rewrite /FPC.ctxU0 FPC.CTX.get_setE 1:/#.
qed.

(* the value of the borrow-free negation of p: R - p *)
lemma neg_val (p: BN.t) (cf: bool) (t: BN.t): 0 < bn p =>
  BN.bn_withborrow (cf, t) = - bn p => bn t = BN.bn_modulus - bn p.
proof.
move=> Hp; rewrite /BN.bnk_withborrow /= -BN.bn_modulusE.
have := BN.bnk_cmp nlimbs t; have := BN.bnk_cmp nlimbs p; rewrite -BN.bn_modulusE.
case: cf => /= _ _; smt().
qed.

(* the parity of a big number is the parity of its first limb *)
lemma bn_parity (x: BN.t): bn x %% 2 = to_uint x.[0] %% 2.
proof.
have Hn := gt0_nlimbs.
rewrite (BN.bn_k_kup 1 x) 1:/#.
rewrite BN.bnk1 /=.
rewrite (_: to_uint x.[0] + BN.bnkup 1 x * 18446744073709551616
          = (BN.bnkup 1 x * 9223372036854775808) * 2 + to_uint x.[0]) 1:/#.
by rewrite modzMDl.
qed.

lemma cap2 a: 0 <= a => cap (2 * cap a) = cap (2 * a).
proof. by rewrite /cap; smt(). qed.

(* the starting value of the doublings: a zero array with limb 0 set to 1 *)
lemma bn_one_of_zero (x: BN.t): bn x = 0 => bn x.[0 <- W64.of_int 1] = 1.
proof.
move=> H0; have Hn := gt0_nlimbs.
have E := BN.bn_k_kup 1 x.[0 <- W64.of_int 1] _; first smt().
have Ex := BN.bn_k_kup 1 x _; first smt().
have Hup := BN.bnkup_setO 1 x (W64.of_int 1) _; first smt().
move: Hup; rewrite (_: 1 - 1 = 0) 1:// => Hup.
have Hk := BN.bnk_cmp 1 x.
have Hu: 0 <= BN.bnkup 1 x.
+ rewrite -BN.bn_div_kup 1:/#; apply divz_ge0; smt(StdOrder.IntOrder.expr_gt0 BN.bnk_cmp).
have HM: 0 < W64.modulus ^ 1 by rewrite StdOrder.IntOrder.expr_gt0.
have Hu0: BN.bnkup 1 x = 0 by smt().
by rewrite E Hup Hu0 BN.bnk1 /= BN.A.get_setE 1:/#.
qed.

