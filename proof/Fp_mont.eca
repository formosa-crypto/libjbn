(******************************************************************************
 **                                 CONTRACTS                                **
 ******************************************************************************)

section.

declare module P <: MParam.

declare axiom fun_muln_ll: islossless P.fun_muln.
declare axiom fun_sqrn_ll: islossless P.fun_sqrn.

declare axiom fun_muln_h _a _b:
 hoare [ P.fun_muln : arg.`2 = _a /\ arg.`3 = _b ==> BN2.bn res = bn _a * bn _b ].

declare axiom fun_sqrn_h _a:
 hoare [ P.fun_sqrn : arg.`2 = _a ==> BN2.bn res = bn _a * bn _a ].

(* the Montgomery reduction: a * R^-1 mod p, for a < p * R *)
hoare _redM_h p _a:
 M(P)._redM
 : FPC.ctx_mod p ctx /\ mont_ctx p ctx /\ a = _a /\ BN2.bn _a < p * BN.bn_modulus
   ==> bn res = FPB.red p (BN2.bn _a).
proof.
proc.
exists* ctx; elim* => c.
have [H|[Hm [Hu Ha]]]: !(FPC.ctx_mod p c /\ mont_ctx p c /\ BN2.bn _a < p * BN.bn_modulus)
                     \/ (FPC.ctx_mod p c /\ mont_ctx p c /\ BN2.bn _a < p * BN.bn_modulus).
+ by smt().
+ by conseq (_: false ==> _) => // &hr /=; smt().
have [H1 [Hodd [HP HmP]]] := Hm.
have Hr: (Rinv p * BN.bn_modulus) %% bn (FPC.ctxP c) = 1 by rewrite HP; apply Rinv_R.
have HPmP: bn (FPC.ctxP c) + bn (FPC.ctxMP c) = BN.bn_modulus by rewrite HP HmP; ring.
have Ha': BN2.bn _a < bn (FPC.ctxP c) * BN.bn_modulus by rewrite HP.
ecall (BNMUL.__mont_redM_h (Rinv p) (FPC.ctxP c) (FPC.ctxMP c) (FPC.ctxU0 c) _a Hr HPmP Hu Ha').
by wp; skip => /> &hr *; exact (FPC.ctxPmP_val c).
qed.

hoare _redM__h p _a:
 M(P)._redM_
 : FPC.ctx_mod p ctx /\ mont_ctx p ctx /\ a = _a /\ BN2.bn _a < p * BN.bn_modulus
   ==> bn res = FPB.red p (BN2.bn _a).
proof. by proc; wp; call (_redM_h p _a); auto. qed.

hoare fun_red_h p _a:
 M(P).fun_red
 : FPC.ctx_mod p ctx /\ mont_ctx p ctx /\ a = _a /\ BN2.bn _a < p * BN.bn_modulus
   ==> bn res = FPB.red p (BN2.bn _a).
proof. by proc; call (_redM__h p _a); auto. qed.

(* conversion out of Montgomery form: a * R^-1 mod p *)
hoare _fromM__h p _a:
 M(P)._fromM_
 : FPC.ctx_mod p ctx /\ mont_ctx p ctx /\ a = _a /\ bn _a < p
   ==> bn res = FPB.red p (bn _a).
proof.
proc.
ecall (_redM__h p tmp).
wp; ecall (BNB._set0__h).
wp; ecall (BNB._mov__h a).
wp; skip => /> &hr H1 Hodd HmP Hu Ha r0 Hr0.
rewrite (bn2_pack _ _a r0).
+ move=> j Hj; rewrite BN2.A.initiE 1:/# /= (_: !(nlimbs <= j < nlimbs + nlimbs)) 1:/# /=.
  by rewrite BN2.A.initiE 1:/# /= Hj.
+ move=> j Hj; rewrite BN2.A.initiE 1:/# /= (_: nlimbs <= nlimbs + j < nlimbs + nlimbs) 1:/# /=.
  smt().
+ rewrite Hr0 /=.
  have: 1 <= BN.bn_modulus by rewrite BN.bn_modulusE; smt(StdOrder.IntOrder.expr_gt0).
  smt(BN.bnk_cmp).
qed.

(* losslessness of the Montgomery procedures *)
lemma _redM_ll: islossless M(P)._redM.
proof. by proc; call BNMUL.__mont_redM_ll; auto. qed.

lemma _redM__ll: islossless M(P)._redM_.
proof. by proc; wp; call _redM_ll; auto. qed.

lemma fun_red_ll: islossless M(P).fun_red.
proof. by proc; call _redM__ll. qed.

lemma _fromM__ll: islossless M(P)._fromM_.
proof. by proc; call _redM__ll; wp; call BNB._set0__ll; wp; call BNB._mov__ll; auto. qed.

(* the parameters of Fp_base: the multiplication of P, and the Montgomery
   reduction *)
lemma P_FPB_muln_ll: islossless M(P).P_FPB.fun_muln.
proof. by proc*; call fun_muln_ll. qed.

lemma P_FPB_sqrn_ll: islossless M(P).P_FPB.fun_sqrn.
proof. by proc*; call fun_sqrn_ll. qed.

lemma P_FPB_red_ll: islossless M(P).P_FPB.fun_red.
proof. by proc*; call fun_red_ll. qed.

lemma P_FPB_muln_h _a _b:
 hoare [ M(P).P_FPB.fun_muln : a = _a /\ b = _b ==> BN2.bn res = bn _a * bn _b ].
proof. by proc*; call (fun_muln_h _a _b). qed.

lemma P_FPB_sqrn_h _a:
 hoare [ M(P).P_FPB.fun_sqrn : a = _a ==> BN2.bn res = bn _a * bn _a ].
proof. by proc*; call (fun_sqrn_h _a). qed.

lemma P_FPB_red_h p _x:
 hoare [ M(P).P_FPB.fun_red
       : FPC.ctx_mod p ctx /\ mont_ctx p ctx /\ a = _x /\ BN2.bn _x < p * BN.bn_modulus
         ==> bn res = FPB.red p (BN2.bn _x) ].
proof. by proc*; call (fun_red_h p _x). qed.

(* the field operations (Fp_base, with the Montgomery reduction) *)
hoare _mulm__h _p _a _b:
 M(P)._mulm_
 : FPC.ctx_mod _p ctx /\ mont_ctx _p ctx /\ a = _a /\ b = _b /\ bn _a < _p /\ bn _b < _p
   ==> bn res = FPB.red _p (bn _a * bn _b).
proof. by proc*; call (FPB._mulm__h (<: M(P).P_FPB) P_FPB_muln_ll P_FPB_sqrn_ll P_FPB_red_ll P_FPB_muln_h P_FPB_sqrn_h P_FPB_red_h _p _a _b). qed.

lemma _mulm__ll: islossless M(P)._mulm_.
proof. by proc*; call (FPB._mulm__ll (<: M(P).P_FPB) P_FPB_muln_ll P_FPB_sqrn_ll P_FPB_red_ll P_FPB_muln_h P_FPB_sqrn_h P_FPB_red_h). qed.

hoare _mulmU__h _p _a _b:
