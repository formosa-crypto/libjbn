proof. by proc*; call (FPB._subm__ll (<: M(P).P_FPB) P_FPB_muln_ll P_FPB_sqrn_ll P_FPB_red_ll P_FPB_muln_h P_FPB_sqrn_h P_FPB_red_h). qed.

hoare _submU__h _p _a _b:
 M(P)._submU_
 : FPC.ctx_mod _p ctx /\ a = _a /\ b = _b /\ bn _a < _p /\ bn _b < _p
   ==> bn res = (bn _a - bn _b) %% _p.
proof. by proc*; call (FPB._submU__h (<: M(P).P_FPB) P_FPB_muln_ll P_FPB_sqrn_ll P_FPB_red_ll P_FPB_muln_h P_FPB_sqrn_h P_FPB_red_h _p _a _b). qed.

