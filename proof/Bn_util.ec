 M.__addacc3
 : a=_a /\ b0=_b0 /\ b1=_b1 /\ k=_k
   /\ bn_seq [ _a.[_k%%3]; _a.[(_k+1)%%3]; _a.[(_k+2)%%3] ]
      + bn_seq [ _b0; _b1 ] < W64.modulus^3
 ==> bn_seq [ res.[_k%%3]; res.[(_k+1)%%3]; res.[(_k+2)%%3] ]
     = bn_seq [ _a.[_k%%3]; _a.[(_k+1)%%3]; _a.[(_k+2)%%3] ]
       + bn_seq [ _b0; _b1 ].
