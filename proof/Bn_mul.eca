lemma __ps_sqrn_ll: islossless M.__ps_sqrn.
proof.
(* the call to __sqrn_innerloop precedes an [if]; inlining lets [wp] go
   through it (the inner loops get the variants of the inlined code) *)
proc; inline*; wp.
while (true) (inc - k).
 move=> z; wp.
 while (true) (inc1 - i0).
  by move=> z0; auto => /#.
 by auto => /#.
wp; while (true) (nlimbs - k).
 move=> z; wp.
 while (true) (inc0 - i).
  by move=> z0; auto => /#.
 by auto => /#.
by auto => /#.
qed.

