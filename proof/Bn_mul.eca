(******************************************************************************
 **                           CORRECTNESS lemmas [hoare]                     **
 ******************************************************************************)

hoare _ps_muln__h _a _b:
 M._ps_muln_ : a=_a /\ b=_b ==> bn res = bn _a * bn _b.
admitted.

hoare _ps_sqrn__h _a:
 M._ps_sqrn_ : a=_a ==> bn res = bn _a * bn _a.
admitted.

(* obs: [bn _a < bn __P * bn_modulus] ensures that a single final
   conditional subtraction suffices *)
lemma __mont_redM_h rInv __P __mP __U0 _a:
 (rInv * BN.bn_modulus) %% BN.bn __P = 1 =>
 bn __P + BN.bn __mP = BN.bn_modulus =>
 __U0 * __P.[0] = W64.of_int (-1) =>
 bn _a < bn __P * BN.bn_modulus =>
 hoare [ M.__mont_redM
       : _P=__P /\ _mP=__mP /\ _U0=__U0 /\ a=_a ==> bn res = (bn _a * rInv) %% bn __P
       ].
proof.
move => rInv_r P_mP U0_P0 a_bnd.
admitted.


(******************************************************************************
 **                           CORRECTNESS lemmas [phoare]                    **
 ******************************************************************************)

phoare _ps_muln__ph _a _b:
 [ M._ps_muln_
 : a=_a /\ b=_b ==> bn res = bn _a * bn _b
 ] = 1%r.
proof. by conseq _ps_muln__ll (_ps_muln__h _a _b). qed.

phoare _ps_sqrn__ph _a:
 [ M._ps_sqrn_
 : a=_a ==> bn res = bn _a * bn _a
 ] = 1%r.
proof. by conseq _ps_sqrn__ll (_ps_sqrn__h _a). qed.

lemma __mont_redM_ph rInv __P __mP __U0 _a:
 (rInv * BN.bn_modulus) %% BN.bn __P = 1 =>
 bn __P + BN.bn __mP = BN.bn_modulus =>
 __U0 * __P.[0] = W64.of_int (-1) =>
 bn _a < bn __P * BN.bn_modulus =>
 phoare [ M.__mont_redM
        : _P=__P /\ _mP=__mP /\ _U0=__U0 /\ a=_a ==> bn res = (bn _a * rInv) %% bn __P
        ] = 1%r.
proof.
move => rInv_r P_mP U0_P0 a_bnd.
by conseq __mont_redM_ll (__mont_redM_h rInv __P __mP __U0 _a rInv_r P_mP U0_P0 a_bnd).
qed.
