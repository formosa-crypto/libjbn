require JBigNumber.

(* Correctness contracts for bn_mul@n.jinc: schoolbook multiplication and
   squaring (operand- and product-scanning) and Montgomery reduction. *)

(* Parameters *)
op nlimbs: int.
axiom gt0_nlimbs: 0 < nlimbs.

clone export JBigNumber.BigN
 with op nlimbs <- nlimbs
      proof gt0_nlimbs by exact gt0_nlimbs.

import BN2.
import BN.

require Bn_util.
clone Bn_util as BNUTIL.
module BNUTIL_M = BNUTIL.M.

require Bn_base.
clone Bn_base as BNB
 with op nlimbs <- nlimbs,
      theory BigN <- BigN,
      theory BNUTIL <- BNUTIL
      proof gt0_nlimbs by exact gt0_nlimbs.
module BNB_M = BNB.M.

(* arrays of nlimbs+1 words (accumulator of the operand-scanning code) *)
clone import PolyArray as BN1 with op size <- nlimbs + 1.

require import Array3.

