(* the Montgomery ladder (constant time), from x0 = 1 and x1 = a *)
hoare _expm_h c0 (a0: BN.t) e0:
 M(P)._expm
 : ctx = c0 /\ b = e0 /\ mok c0 /\ mdom c0 (bn a0)
   /\ bn x0 = mone c0 /\ bn x1 = bn a0
   ==> BN.bn res.`1 = mexp c0 (bn a0) (BNexp.bn e0).
proof.
have Hn := gt0_nlimbsexp.
proc.
while (-1 <= j < nlimbsexp /\ inc = -1 /\ _b = e0 /\ ctx = c0 /\ mok c0 /\ mdom c0 (bn a0) /\ bn x0 = mexp c0 (bn a0) (BNexp.bnkup (j + 1) e0) /\ bn x1 = mexp c0 (bn a0) (BNexp.bnkup (j + 1) e0 + 1)).
wp.
while (0 <= j < nlimbsexp /\ inc = -1 /\ _b = e0 /\ ctx = c0 /\ mok c0 /\ mdom c0 (bn a0) /\ 0 <= to_uint _k < 64 /\ (zf <=> to_uint _k = 0) /\ to_uint t = to_uint e0.[j] %% 2 ^ (to_uint _k) * 2 ^ (64 - to_uint _k) /\ bn x0 = mexp c0 (bn a0) (BNexp.bnkup (j + 1) e0 * 2 ^ (64 - to_uint _k) + to_uint e0.[j] %/ 2 ^ (to_uint _k)) /\ bn x1 = mexp c0 (bn a0) (BNexp.bnkup (j + 1) e0 * 2 ^ (64 - to_uint _k) + to_uint e0.[j] %/ 2 ^ (to_uint _k) + 1)).
