lemma _expm_noct_ll: islossless M(P)._expm_noct.
proof.
proc.
while (true) (nlimbsexp - j).
- move=> z; wp.
  while ((zf <=> to_uint _k = 0)) (to_uint _k).
  + move=> z'; wp; call fun_sqrU_ll; wp; sp.
    if; [call fun_mulU_ll|]; auto => /> &hr Hzf Hk; have [H1 H2] := DEC1E _k{hr} _; smt().
  wp; call fun_sqrU_ll; wp; sp.
  if; [call fun_mulU_ll|]; auto => /> &hr Hj; (have [H1 H2] := DEC1E (W64.of_int 64) _; first by rewrite W64.of_uintK);
   move: H1 H2; rewrite W64.of_uintK /=; smt(W64.to_uint_cmp).
wp; call BNB._mov__ll; auto => /> /#.
qed.

