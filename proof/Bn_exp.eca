move: HD1 HD2; rewrite W64.of_uintK /= => HD1 HD2.
have HH: 0 <= BNexp.bnkup (j{hr} + 1) e0.
+ rewrite -BNexp.bn_div_kup 1:/#; apply divz_ge0; [smt(StdOrder.IntOrder.expr_gt0) | smt(BNexp.bnk_cmp)].
