declare axiom fun_mulU_h _c _x _y:
 hoare [ P.fun_mulU
       : arg.`3 = _c /\ mok _c /\ mdom _c (bn arg.`1) /\ mdom _c (bn arg.`2)
         /\ bn arg.`1 = _x /\ bn arg.`2 = _y
         ==> bn res = mmul _c _x _y ].

declare axiom fun_sqrU_h _c _x:
 hoare [ P.fun_sqrU
       : arg.`2 = _c /\ mok _c /\ mdom _c (bn arg.`1) /\ bn arg.`1 = _x
         ==> bn res = mmul _c _x _x ].

