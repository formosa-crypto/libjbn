(* the Montgomery ladder (constant time), from x0 = 1 and x1 = a *)
hoare _expm_h c0 (a0: BN.t) e0:
 M(P)._expm
 : ctx = c0 /\ b = e0 /\ mok c0 /\ mdom c0 (bn a0)
   /\ bn x0 = mone c0 /\ bn x1 = bn a0
   ==> BN.bn res.`1 = mexp c0 (bn a0) (BNexp.bn e0).
proof.
have Hn := gt0_nlimbsexp.
proc.
ecall (BNB._cswap_mask__h x0 x1 (mask <> W64.zero)).
wp.
while (-1 <= j < nlimbsexp /\ inc = -1 /\ _b = e0 /\ _ctx = c0 /\ mok c0 /\ mdom c0 (bn a0) /\ linv c0 (bn a0) (BNexp.bnkup (j + 1) e0) _mask (bn x0) (bn x1)).
wp.
while (0 <= j < nlimbsexp /\ inc = -1 /\ _b = e0 /\ _ctx = c0 /\ mok c0 /\ mdom c0 (bn a0) /\ 0 <= to_uint _k < 64 /\ (zf <=> to_uint _k = 0) /\ to_uint t = to_uint e0.[j] %% 2 ^ (to_uint _k) * 2 ^ (64 - to_uint _k) /\ linv c0 (bn a0) (BNexp.bnkup (j + 1) e0 * 2 ^ (64 - to_uint _k) + to_uint e0.[j] %/ 2 ^ (to_uint _k)) _mask (bn x0) (bn x1)).
wp; ecall (fun_sqrU_h c0 (bn x0)).
wp; ecall (fun_mulU_h c0 (bn x1) (bn x0)).
wp; ecall (BNB._cswap_mask__h x0 x1 (swap_0 <> W64.zero)).
wp; ecall (BNUTIL.__cf_mask_h cf).
wp; skip => /> &hr.
move=> Hj0 Hj1 Hc HA Hk0 Hk1 Ht HL Hk.
have [HC HT] := SHL1E t{hr}; move: HC HT => /= HC HT.
have [HD1 HD2] := DEC1E _k{hr} Hk.
have He := W64.to_uint_cmp e0.[j{hr}].
have HH: 0 <= BNexp.bnkup (j{hr} + 1) e0.
+ rewrite -BNexp.bn_div_kup 1:/#; apply divz_ge0; [smt(StdOrder.IntOrder.expr_gt0) | smt(BNexp.bnk_cmp)].
have HE0: 0 <= BNexp.bnkup (j{hr} + 1) e0 * 2 ^ (64 - to_uint _k{hr}) + to_uint e0.[j{hr}] %/ 2 ^ to_uint _k{hr}.
+ have H1: 0 <= BNexp.bnkup (j{hr} + 1) e0 * 2 ^ (64 - to_uint _k{hr}).
  + by apply StdOrder.IntOrder.mulr_ge0; [exact HH | apply StdOrder.IntOrder.expr_ge0].
  have H2: 0 <= to_uint e0.[j{hr}] %/ 2 ^ to_uint _k{hr}.
  + by apply divz_ge0; [apply StdOrder.IntOrder.expr_gt0 | smt()].
  smt().
have Hcf: (SHL_64 t{hr} W8.one).`2 = (to_uint e0.[j{hr}] %/ 2 ^ (to_uint _k{hr} - 1) %% 2 = 1).
+ by rewrite HC Ht ladder_cf; smt().
rewrite HD1 HT Ht ladder_t 1,2:/# ladder_exp 1,2:/# -Hcf.
have /= := linv_step c0 (bn a0) _ ((SHL_64 t{hr} W8.one).`2) _ _ _ Hc HA HE0 HL.
pose sw := _mask{hr} `^` W64.of_int (- b2i (SHL_64 t{hr} W8.one).`2).
case: (sw = W64.zero) => Csw /= [Hsw [Hd0 [Hd1 HL']]].
- split; first done.
  move=> _; split; first done.
  move=> _ _ r1 -> r2 ->.
  by split; [smt() | split; [smt() | exact HL']].
- split; first done.
  move=> _; split; first done.
  move=> _ _ r1 -> r2 ->.
  by split; [smt() | split; [smt() | exact HL']].
wp; ecall (fun_sqrU_h c0 (bn x0)).
wp; ecall (fun_mulU_h c0 (bn x1) (bn x0)).
wp; ecall (BNB._cswap_mask__h x0 x1 (swap_0 <> W64.zero)).
wp; ecall (BNUTIL.__cf_mask_h cf).
wp; skip => /> &hr.
move=> Hj0 Hj1 Hc HA HL Hjj.
have He := W64.to_uint_cmp e0.[j{hr}].
move: He; rewrite (_: W64.modulus = 2 ^ 64) // => He.
have [HC HT] := SHL1E e0.[j{hr}]; move: HC HT => /= HC HT.
have [HD1 HD2] := DEC1E (W64.of_int 64) _; first by rewrite W64.of_uintK.
move: HD1 HD2; rewrite W64.of_uintK /= => HD1 HD2.
have HH: 0 <= BNexp.bnkup (j{hr} + 1) e0.
+ rewrite -BNexp.bn_div_kup 1:/#; apply divz_ge0; [smt(StdOrder.IntOrder.expr_gt0) | smt(BNexp.bnk_cmp)].
have Ht: to_uint e0.[j{hr}] = to_uint e0.[j{hr}] %% 2 ^ 64 * 2 ^ (64 - 64) by rewrite (_: 2 ^ 64 = W64.modulus) // W64.to_uint_mod.
have Hq: to_uint e0.[j{hr}] %/ 2 ^ 64 = 0 by rewrite (_: 2 ^ 64 = W64.modulus) // divz_small //; apply JUtils.bound_abs; exact W64.to_uint_cmp.
have Hcf: (SHL_64 e0.[j{hr}] W8.one).`2 = (to_uint e0.[j{hr}] %/ 2 ^ (64 - 1) %% 2 = 1).
+ by rewrite HC {1}Ht ladder_cf; smt().
have HTt: to_uint (SHL_64 e0.[j{hr}] W8.one).`6 = to_uint e0.[j{hr}] %% 2 ^ (64 - 1) * 2 ^ (64 - (64 - 1)).
+ by rewrite HT {1}Ht ladder_t; smt().
have Hexp := ladder_exp (BNexp.bnkup (j{hr} + 1) e0) (to_uint e0.[j{hr}]) 64 _ _; 1,2: smt().
move: Hexp; rewrite -Hcf Hq /= => Hexp.
have Hexit: forall (k0 m0: W64.t) (y0 y1: int), to_uint k0 = 0 =>
    linv c0 (bn a0) (BNexp.bnkup (j{hr} + 1) e0 * 2 ^ (64 - to_uint k0) + to_uint e0.[j{hr}] %/ 2 ^ to_uint k0) m0 y0 y1 =>
    linv c0 (bn a0) (BNexp.bnkup j{hr} e0) m0 y0 y1.
+ move=> k0 m0 y0 y1 Hk0.
  have Hup := BNexp.bnkupP (j{hr} + 1) e0 _; first smt().
  have ->//: BNexp.bnkup j{hr} e0 = BNexp.bnkup (j{hr} + 1) e0 * 2 ^ (64 - to_uint k0) + to_uint e0.[j{hr}] %/ 2 ^ to_uint k0.
  move: Hup; rewrite Hk0 (_: j{hr} + 1 - 1 = j{hr}) 1:/# (_: W64.modulus = 2 ^ 64) //= => ->.
  by ring.
have /= := linv_step c0 (bn a0) _ ((SHL_64 e0.[j{hr}] W8.one).`2) _ _ _ Hc HA HH HL.
rewrite HD1 /= HTt /= Hexp.
pose sw := _mask{hr} `^` W64.of_int (- b2i (SHL_64 e0.[j{hr}] W8.one).`2).
case: (sw = W64.zero) => Csw /= [Hsw [Hd0 [Hd1 HL']]].
- split; first done.
  move=> _; split; first done.
  move=> _ _ r1 -> r2 ->.
  split; first by rewrite HD2 HL' /#.
  move=> _k0 _mask0 t0 x00 x10 zf0 _ _ _ _ Hk00 _ HL0.
  by split; [smt() | exact (Hexit _k0 _mask0 _ _ Hk00 HL0)].
- split; first done.
  move=> _; split; first done.
  move=> _ _ r1 -> r2 ->.
  split; first by rewrite HD2 HL' /#.
  move=> _k0 _mask0 t0 x00 x10 zf0 _ _ _ _ Hk00 _ HL0.
  by split; [smt() | exact (Hexit _k0 _mask0 _ _ Hk00 HL0)].
wp; skip => /> &hr Hc HA HX0 HX1.
split.
- split; first smt().
  by rewrite BNexp.bnkup_nlimbs HX0 HX1; exact linv0.
- move=> m0 j0 x00 x10 Hj0 Hj1 Hj2.
  rewrite (_: j0 + 1 = 0) 1:/# BNexp.bnkup0 => /linv_end [Hm Hx].
  split; first exact Hm.
  by move=> _; case: (m0 = W64.zero) Hx => /=.
qed.

lemma _expm_ll: islossless M(P)._expm.
proof.
proc.
call BNB._cswap_mask__ll; wp.
while (true) (j - inc).
- move=> z; wp.
  while ((zf <=> to_uint _k = 0)) (to_uint _k).
  + move=> z'; wp; call fun_sqrU_ll; wp; call fun_mulU_ll.
    wp; call BNB._cswap_mask__ll; wp; call BNUTIL.__cf_mask_ll; auto => /> &hr *.
    have [H1 H2] := DEC1E _k{hr} _; smt().
  wp; call fun_sqrU_ll; wp; call fun_mulU_ll.
  wp; call BNB._cswap_mask__ll; wp; call BNUTIL.__cf_mask_ll; auto => /> &hr *.
  (have [H1 H2] := DEC1E (W64.of_int 64) _; first by rewrite W64.of_uintK);
   move: H1 H2; rewrite W64.of_uintK /=; smt(W64.to_uint_cmp).
by auto => /#.
qed.

lemma _expm__ll: islossless M(P)._expm_.
proof. by proc; wp; call _expm_ll; wp; call BNB._mov__ll; wp; call BNB._mov__ll; auto. qed.

lemma _expmU__ll: islossless M(P)._expmU_.
proof. by proc; wp; call _expm_ll; wp; call BNB._mov__ll; wp; call BNB._mov__ll; auto. qed.

(* left-to-right square-and-multiply (variable time) *)

(* one limb: from r = A^E, r^(2^64) * A^w = A^(E*2^64 + w); the invariant
   after 64-k bits: w holds the k remaining bits at the top *)
hoare _exp1mLR_noct_h c0 (A: int) E (w0: W64.t):
 M(P)._exp1mLR_noct
 : ctx = c0 /\ w = w0 /\ mok c0 /\ mdom c0 A /\ bn x = A /\ 0 <= E /\ bn r = mexp c0 A E
   ==> bn res = mexp c0 A (E * 2 ^ 64 + to_uint w0).
proof.
proc.
while (_ctx = c0 /\ mok c0 /\ mdom c0 A /\ bn _x = A /\ 0 <= E /\ 0 <= to_uint k <= 64
       /\ to_uint w = to_uint w0 %% 2 ^ (to_uint k) * 2 ^ (64 - to_uint k)
       /\ bn r = mexp c0 A (E * 2 ^ (64 - to_uint k) + to_uint w0 %/ 2 ^ (to_uint k))).
+ seq 7 : (_ctx = c0 /\ mok c0 /\ mdom c0 A /\ bn _x = A /\ 0 <= E /\ 0 < to_uint _k <= 64
           /\ cf = (to_uint w0 %/ 2 ^ (to_uint _k - 1) %% 2 = 1)
           /\ to_uint _w = to_uint w0 %% 2 ^ (to_uint _k - 1) * 2 ^ (64 - (to_uint _k - 1))
           /\ bn r = mexp c0 A (2 * (E * 2 ^ (64 - to_uint _k) + to_uint w0 %/ 2 ^ (to_uint _k)))).
  - wp; ecall (fun_sqrU_h c0 (bn r)); wp; skip => &hr [[Hc [HC [HA [Hx [HE [[Hk0 Hk1] [Hw Hr]]]]]]] Hk] /=.
    move: Hk; rewrite slt0_small // => Hk.
    have [HCf HT] := SHL1E w{hr}; move: HCf HT => /= HCf HT.
    have He := W64.to_uint_cmp w0.
    have HM: 0 <= E * 2 ^ (64 - to_uint k{hr}) + to_uint w0 %/ 2 ^ to_uint k{hr}.
    + have H1: 0 <= E * 2 ^ (64 - to_uint k{hr}).
      + by apply StdOrder.IntOrder.mulr_ge0; [exact HE | apply StdOrder.IntOrder.expr_ge0].
      have H2: 0 <= to_uint w0 %/ 2 ^ to_uint k{hr}.
      + by apply divz_ge0; [apply StdOrder.IntOrder.expr_gt0 | smt()].
      smt().
    split; first by rewrite Hr; split => //; split => //; apply mexp_dom.
    move=> _ r1 Hr1.
    do 5! (split; first done).
    split; first smt().
    split; first by rewrite HCf Hw ladder_cf; smt().
    split; first by rewrite HT Hw ladder_t; smt().
    by rewrite Hr1 Hr mexp_sqr.
  wp; if.
  - ecall (fun_mulU_h c0 (bn r) A); wp; skip => &hr [[Hc [HC [HA [Hx [HE [[Hk0 Hk1] [Hcf [Hw Hr]]]]]]]] Hb] /=.
    have He := W64.to_uint_cmp w0.
    have HM: 0 <= E * 2 ^ (64 - to_uint _k{hr}) + to_uint w0 %/ 2 ^ to_uint _k{hr}.
    + have H1: 0 <= E * 2 ^ (64 - to_uint _k{hr}).
      + by apply StdOrder.IntOrder.mulr_ge0; [exact HE | apply StdOrder.IntOrder.expr_ge0].
      have H2: 0 <= to_uint w0 %/ 2 ^ to_uint _k{hr}.
      + by apply divz_ge0; [apply StdOrder.IntOrder.expr_gt0 | smt()].
      smt().
    split; first by rewrite Hr Hx; smt(mexp_dom).
    move=> _ r1 Hr1.
    rewrite to_uint_dec // Hw.
    do 5! (split; first done).
    split; first smt().
    split; first done.
    rewrite Hr1 Hr ladder_exp 1,2:/# -Hcf Hb /b2i /=.
    by rewrite mexpS 1:/# mmulC //; smt(mexp_dom).
  - skip => &hr [[Hc [HC [HA [Hx [HE [[Hk0 Hk1] [Hcf [Hw Hr]]]]]]]] Hb] /=.
    have He := W64.to_uint_cmp w0.
    rewrite to_uint_dec // Hw.
    do 5! (split; first done).
    split; first smt().
    split; first done.
    by rewrite Hr ladder_exp 1,2:/# -Hcf Hb /b2i /=.
wp; skip => &hr [Hc [Hw [HC [HA [Hx [HE Hr]]]]]] /=.
have He := W64.to_uint_cmp w0; move: He => /= He.
move: Hx Hr => /= Hx Hr.
split; first by rewrite Hw Hx Hr Hc /= modz_small 1:/# divz_small 1:/#.
move=> k0 r0 w1 Hk [_ [_ [_ [_ [_ [[Hk0 Hk1] [Hw1 Hr0]]]]]]].
move: Hk; rewrite slt0_small // => Hk.
have Ek: to_uint k0 = 0 by smt().
by rewrite Hr0 Ek /=.
qed.

lemma _exp1mLR_noct_ll: islossless M(P)._exp1mLR_noct.
proof.
proc.
while (0 <= to_uint k <= 64) (to_uint k).
+ move=> z.
  seq 7 : (0 < to_uint _k <= 64 /\ to_uint _k = z).
  - by wp; call (_: true); wp; skip.
  - by wp; call fun_sqrU_ll; wp; skip => &hr [[Hk Hs] Hz]; move: Hs; rewrite slt0_small /#.
  - by wp; if; [call fun_mulU_ll; wp|]; skip => &hr; smt(to_uint_dec).
  - by hoare; wp; call (_: true); wp; skip => &hr [[Hk Hs] Hz]; move: Hs; rewrite slt0_small /#.
  by [].
by wp; skip => &hr /=; move=> k0 [_ Hk] Hk0; rewrite slt0_small //; smt().
qed.

(* the first nonzero limb: find its top bit, then scan the remaining bits *)
hoare _exp1mLR_first_noct_h c0 (A: int) (w0: W64.t):
 M(P)._exp1mLR_first_noct
 : ctx = c0 /\ w = w0 /\ w0 <> W64.zero /\ mok c0 /\ mdom c0 A /\ bn x = A
   ==> bn res = mexp c0 A (to_uint w0).
proof.
proc; swap [1..4] 5.
seq 3 : (ctx = c0 /\ mok c0 /\ mdom c0 A /\ bn x = A /\ 0 < to_uint k <= 64
         /\ to_uint w0 %/ 2 ^ (to_uint k - 1) = 1
         /\ to_uint w = to_uint w0 %% 2 ^ (to_uint k - 1) * 2 ^ (64 - (to_uint k - 1))).
+ while (ctx = c0 /\ w0 <> W64.zero /\ mok c0 /\ mdom c0 A /\ bn x = A /\ 0 < to_uint k <= 64
         /\ to_uint w0 < 2 ^ (to_uint k)
         /\ cf = (to_uint w0 %/ 2 ^ (to_uint k - 1) %% 2 = 1)
         /\ to_uint w = to_uint w0 %% 2 ^ (to_uint k - 1) * 2 ^ (64 - (to_uint k - 1))).
  - wp; skip => &hr [[Hc [Hw0 [HC [HA [Hx [[Hk0 Hk1] [Hlt [Hcf Hw]]]]]]]] Hb] /=.
    have He := W64.to_uint_cmp w0.
    have Hnz: to_uint w0 <> 0 by move: Hw0; rewrite W64.to_uint_eq.
    have Hlt': to_uint w0 < 2 ^ (to_uint k{hr} - 1) by apply top_bit0 => //; [smt() | rewrite -Hcf].
    have Hk2: 1 < to_uint k{hr}.
    + by case: (to_uint k{hr} = 1) => [Ek|]; [move: Hlt'; rewrite Ek /=; smt() | smt()].
    have [HCf HT] := SHL1E w{hr}; move: HCf HT => /= HCf HT.
    rewrite to_uint_dec 1:/#.
    do 5! (split; first done).
    split; first smt().
    split; first done.
    split; first by rewrite HCf Hw ladder_cf; smt().
    by rewrite HT Hw ladder_t; smt().
  wp; skip => &hr [Hc [Hw [Hw0 [HC [HA Hx]]]]] /=.
  have He := W64.to_uint_cmp w0.
  have [HCf HT] := SHL1E w{hr}; move: HCf HT => /= HCf HT.
  move: Hc Hw Hx He => /= Hc Hw Hx He.
  have Em: to_uint w0 %% 18446744073709551616 = to_uint w0 by rewrite modz_small; smt().
  have L1 := ladder_cf (to_uint w0) 64 _ _; 1,2: smt().
  have L2 := ladder_t (to_uint w0) 64 _ _; 1,2: smt().
  move: L1 L2 => /=; rewrite Em => L1 L2.
  split; first by rewrite HCf HT Hw; smt().
  move=> cf0 k0 w1 Hcf0 [_ [_ [_ [_ [_ [[Hk0 Hk1] [Hlt [Hcf Hw1]]]]]]]].
  do 5! (split; first done).
  split; last done.
  by apply top_bit1 => //; [smt() | rewrite -Hcf].
seq 2 : (ctx = c0 /\ mok c0 /\ mdom c0 A /\ bn x = A /\ 0 <= to_uint k <= 64
         /\ to_uint w = to_uint w0 %% 2 ^ (to_uint k) * 2 ^ (64 - to_uint k)
         /\ bn r = mexp c0 A (to_uint w0 %/ 2 ^ (to_uint k))).
+ wp; ecall (BNB._mov__h x); skip => &hr [Hc [HC [HA [Hx [[Hk0 Hk1] [Hq Hw]]]]]] /= r1 ->.
  rewrite to_uint_dec // Hq Hx mexp1 //.
  smt().
while (_ctx = c0 /\ mok c0 /\ mdom c0 A /\ bn _x = A /\ 0 <= to_uint k <= 64
       /\ to_uint w = to_uint w0 %% 2 ^ (to_uint k) * 2 ^ (64 - to_uint k)
       /\ bn r = mexp c0 A (to_uint w0 %/ 2 ^ (to_uint k))).
+ seq 7 : (_ctx = c0 /\ mok c0 /\ mdom c0 A /\ bn _x = A /\ 0 < to_uint _k <= 64
           /\ cf = (to_uint w0 %/ 2 ^ (to_uint _k - 1) %% 2 = 1)
           /\ to_uint _w = to_uint w0 %% 2 ^ (to_uint _k - 1) * 2 ^ (64 - (to_uint _k - 1))
           /\ bn r = mexp c0 A (2 * (to_uint w0 %/ 2 ^ (to_uint _k)))).
  - wp; ecall (fun_sqrU_h c0 (bn r)); wp; skip => &hr [[Hc [HC [HA [Hx [[Hk0 Hk1] [Hw Hr]]]]]] Hk] /=.
    move: Hk; rewrite slt0_small // => Hk.
    have [HCf HT] := SHL1E w{hr}; move: HCf HT => /= HCf HT.
    have He := W64.to_uint_cmp w0.
    have HM: 0 <= to_uint w0 %/ 2 ^ to_uint k{hr} by smt(divz_ge0 StdOrder.IntOrder.expr_gt0).
    split; first by rewrite Hr; split => //; split => //; apply mexp_dom.
    move=> _ r1 Hr1.
    do 4! (split; first done).
    split; first smt().
    split; first by rewrite HCf Hw ladder_cf; smt().
    split; first by rewrite HT Hw ladder_t; smt().
    by rewrite Hr1 Hr mexp_sqr.
  wp; if.
  - ecall (fun_mulU_h c0 (bn r) A); wp; skip => &hr [[Hc [HC [HA [Hx [[Hk0 Hk1] [Hcf [Hw Hr]]]]]]] Hb] /=.
    have He := W64.to_uint_cmp w0.
    have HM: 0 <= to_uint w0 %/ 2 ^ to_uint _k{hr} by smt(divz_ge0 StdOrder.IntOrder.expr_gt0).
    split; first by rewrite Hr Hx; smt(mexp_dom).
    move=> _ r1 Hr1.
    rewrite to_uint_dec // Hw.
    do 4! (split; first done).
    split; first smt().
    split; first done.
    have Hl := ladder_exp 0 (to_uint w0) (to_uint _k{hr}) _ _; 1,2: smt().
    move: Hl => /= Hl.
    rewrite Hr1 Hr Hl -Hcf Hb /b2i /=.
    by rewrite mexpS 1:/# mmulC //; smt(mexp_dom).
  - skip => &hr [[Hc [HC [HA [Hx [[Hk0 Hk1] [Hcf [Hw Hr]]]]]]] Hb] /=.
    have He := W64.to_uint_cmp w0.
    rewrite to_uint_dec // Hw.
    do 4! (split; first done).
    split; first smt().
    split; first done.
    have Hl := ladder_exp 0 (to_uint w0) (to_uint _k{hr}) _ _; 1,2: smt().
    move: Hl => /= Hl.
    by rewrite Hr Hl -Hcf Hb /b2i /=.
wp; skip => &hr [Hc [HC [HA [Hx [[Hk0 Hk1] [Hw Hr]]]]]].
split; first done.
move=> k0 r0 w1 Hk [_ [_ [_ [_ [[Hk00 Hk01] [Hw1 Hr0]]]]]].
move: Hk; rewrite slt0_small // => Hk.
have Ek: to_uint k0 = 0 by smt().
by rewrite Hr0 Ek /=.
qed.

(* terminates on a nonzero limb *)
lemma _exp1mLR_first_noct_ll w0:
 phoare [M(P)._exp1mLR_first_noct : w = w0 /\ w0 <> W64.zero ==> true] = 1%r.
proof.
proc.
while (0 <= to_uint k <= 64) (to_uint k).
+ move=> z.
  seq 7 : (0 < to_uint _k <= 64 /\ to_uint _k = z).
  - by wp; call (_: true); wp; skip.
  - by wp; call fun_sqrU_ll; wp; skip => &hr [[Hk Hs] Hz]; move: Hs; rewrite slt0_small /#.
  - by wp; if; [call fun_mulU_ll; wp|]; skip => &hr; smt(to_uint_dec).
  - by hoare; wp; call (_: true); wp; skip => &hr [[Hk Hs] Hz]; move: Hs; rewrite slt0_small /#.
  by [].
wp; call BNB._mov__ll; wp.
while (w0 <> W64.zero /\ 0 < to_uint k <= 64 /\ to_uint w0 < 2 ^ (to_uint k)
       /\ cf = (to_uint w0 %/ 2 ^ (to_uint k - 1) %% 2 = 1)
       /\ to_uint w = to_uint w0 %% 2 ^ (to_uint k - 1) * 2 ^ (64 - (to_uint k - 1)))
      (to_uint k).
+ move=> z; wp; skip => &hr [[[Hw0 [[Hk0 Hk1] [Hlt [Hcf Hw]]]] Hb] Hz] /=.
  have He := W64.to_uint_cmp w0.
  have Hnz: to_uint w0 <> 0 by move: Hw0; rewrite W64.to_uint_eq.
  have Hlt': to_uint w0 < 2 ^ (to_uint k{hr} - 1) by apply top_bit0 => //; [smt() | rewrite -Hcf].
  have Hk2: 1 < to_uint k{hr}.
  + by case: (to_uint k{hr} = 1) => [Ek|]; [move: Hlt'; rewrite Ek /=; smt() | smt()].
  have [HCf HT] := SHL1E w{hr}; move: HCf HT => /= HCf HT.
  rewrite to_uint_dec 1:/#.
  split; last smt().
  split; first done.
  split; first smt().
  split; first done.
  split; first by rewrite HCf Hw ladder_cf; smt().
  by rewrite HT Hw ladder_t; smt().
wp; skip => &hr [Hw Hw0] /=.
move: Hw => /= Hw.
have He := W64.to_uint_cmp w0; move: He => /= He.
have [HCf HT] := SHL1E w{hr}; move: HCf HT => /= HCf HT.
have Em: to_uint w0 %% 18446744073709551616 = to_uint w0 by rewrite modz_small; smt().
have L1 := ladder_cf (to_uint w0) 64 _ _; 1,2: smt().
have L2 := ladder_t (to_uint w0) 64 _ _; 1,2: smt().
move: L1 L2 => /=; rewrite Em => L1 L2.
split; first by rewrite HCf HT Hw; smt().
move=> cf0 k0 w1; split; first smt().
move=> Hcf0 [_ [[Hk0 Hk1] _]].
split; first by rewrite to_uint_dec //; smt().
by move=> k1 Hk1' Hk1''; rewrite slt0_small //; smt().
qed.

(* the exponent, from its most significant nonzero limb (i is a signed
   index, -1 when all the limbs are zero): r = A^(e >> 64*(i+1)) *)
hoare _expmLR_noct_h c0 (A: int) e0:
 M(P)._expmLR_noct
 : ctx = c0 /\ e = e0 /\ mok c0 /\ mdom c0 A /\ bn x = A
   ==> bn res = mexp c0 A (BNexp.bn e0).
proof.
have Hn := gt0_nlimbsexp.
have Hb: 64 * nlimbsexp < 18446744073709551616 by have := nlimbsexp_bnd.
have Hone: W64.one <> W64.zero by rewrite W64.to_uint_eq.
proc; swap [5..7] 3.
seq 11 : (_ctx = c0 /\ _e = e0 /\ mok c0 /\ mdom c0 A /\ bn _x = A /\ -1 <= W64.to_sint i < nlimbsexp
         /\ bn r = mexp c0 A (BNexp.bnkup (W64.to_sint i + 1) e0)).
+ (* skip the zero limbs *)
  seq 7 : (ctx = c0 /\ e = e0 /\ mok c0 /\ mdom c0 A /\ bn x = A /\ -1 <= W64.to_sint i < nlimbsexp
           /\ BNexp.bnkup (W64.to_sint i + 1) e0 = 0
           /\ (0 <= W64.to_sint i => w = e0.[W64.to_sint i] /\ w <> W64.zero)).
  - while (ctx = c0 /\ e = e0 /\ mok c0 /\ mdom c0 A /\ bn x = A /\ -1 <= W64.to_sint i < nlimbsexp
           /\ BNexp.bnkup (W64.to_sint i + 1) e0 = 0
           /\ (0 <= W64.to_sint i => w = e0.[W64.to_sint i])
           /\ (W64.to_sint i < 0 => w = W64.one)).
    * wp; skip => &hr [[Hc [He [HC [HA [Hx [[Hi0 Hi1] [Hup [Hw1 Hw2]]]]]]]] Hw] /=.
      have Hi: 0 <= W64.to_sint i{hr} by smt().
      have Hup' := BNexp.bnkupP (W64.to_sint i{hr} + 1) e0 _; first smt().
      move: Hup'; rewrite (_: W64.to_sint i{hr} + 1 - 1 = W64.to_sint i{hr}) 1:/# Hup -(Hw1 Hi) Hw /= => Hup'.
      rewrite sle0E to_sint_dec // (_: W64.to_sint i{hr} - 1 + 1 = W64.to_sint i{hr}) 1:/# Hup' He.
      case: (0 <= W64.to_sint i{hr} - 1) => H /=.
      + have Hu: W64.to_sint (i{hr} - W64.one) = to_uint (i{hr} - W64.one).
        + by apply W64.to_sint_unsigned; rewrite to_sint_dec.
        rewrite -Hu to_sint_dec //.
        do 4! (split; first done).
        split; first smt().
        by split; [done | smt()].
      + do 4! (split; first done).
        by split; [smt() | smt()].
    wp; skip => &hr [Hc [He [HC [HA Hx]]]].
    move: Hc He Hx => /= Hc He Hx.
    have Hs: W64.to_sint (W64.of_int (nlimbsexp - 1)) = nlimbsexp - 1.
    + by rewrite W64.to_sintK_small; smt().
    have Hu: to_uint (W64.of_int (nlimbsexp - 1)) = nlimbsexp - 1.
    + by rewrite W64.of_uintK modz_small; smt().
    rewrite Hs Hu /=.
    split.
    * do 5! (split; first done).
      split; first smt().
      split; first by rewrite BNexp.bnkup_nlimbs.
      by split; [rewrite He | smt()].
    * move=> i0 w0 Hw0 [_ [_ [_ [_ [_ [Hi [Hup [Hw1 Hw2]]]]]]]].
      do 5! (split; first done).
      split; first done.
      split; first done.
      by move=> H; split; [exact (Hw1 H) | done].
  (* the top limb, or the unit *)
  sp; if.
  - wp; ecall (_exp1mLR_first_noct_h c0 A w); wp; skip => &hr [[-> [-> [-> [Hc [He [HC [HA [Hx [[Hi0 Hi1] [Hup Hw]]]]]]]]]] Hi] /=.
    move: Hi; rewrite sle0E => Hi.
    have [Hw' Hnz] := Hw Hi.
    split; first done.
    move=> _ r1 Hr1.
    rewrite to_sint_dec //.
    do 5! (split; first done).
    split; first smt().
    have Hup' := BNexp.bnkupP (W64.to_sint i{hr} + 1) e0 _; first smt().
    move: Hup'; rewrite (_: W64.to_sint i{hr} + 1 - 1 = W64.to_sint i{hr}) 1:/# Hup /= => Hup'.
    by rewrite Hup' Hr1 Hw'.
  - wp; ecall (BNB._mov__h exp0); wp; skip => &hr [[-> [-> [-> [Hc [He [HC [HA [Hx [[Hi0 Hi1] [Hup Hw]]]]]]]]]] Hi] /=.
    move: Hi; rewrite sle0E => Hi.
    move=> r1 ->.
    have Ei: W64.to_sint i{hr} = -1 by smt().
    move: Hup; rewrite Ei /= => Hup.
    do 5! (split; first done).
    split; first smt().
    by rewrite Hup mexp0 /mone /FPC.ctxONE Hc.
(* the remaining limbs *)
while (_ctx = c0 /\ _e = e0 /\ mok c0 /\ mdom c0 A /\ bn _x = A /\ -1 <= W64.to_sint i < nlimbsexp
       /\ bn r = mexp c0 A (BNexp.bnkup (W64.to_sint i + 1) e0)).
+ wp; ecall (_exp1mLR_noct_h c0 A (BNexp.bnkup (W64.to_sint i + 1) e0) w).
  wp; skip => &hr [[Hc [He [HC [HA [Hx [[Hi0 Hi1] Hr]]]]]] Hi] /=.
  move: Hi; rewrite sle0E => Hi.
  have HH := bnkup_ge0 (W64.to_sint i{hr} + 1) e0 _; first smt().
  split; first by rewrite Hr.
  move=> _ r1 Hr1.
  rewrite to_sint_dec //.
  do 5! (split; first done).
  split; first smt().
  have Hup := BNexp.bnkupP (W64.to_sint i{hr} + 1) e0 _; first smt().
  move: Hup; rewrite (_: W64.to_sint i{hr} + 1 - 1 = W64.to_sint i{hr}) 1:/# => Hup.
  rewrite (_: W64.to_sint i{hr} - 1 + 1 = W64.to_sint i{hr}) 1:/# Hup Hr1 He.
  rewrite -(W64.to_sint_unsigned i{hr}) //.
  by congr; ring.
skip => &hr [Hc [He [HC [HA [Hx [[Hi0 Hi1] Hr]]]]]].
split; first done.
move=> i0 r0 Hi [_ [_ [_ [_ [_ [[Hi00 Hi01] Hr0]]]]]].
move: Hi; rewrite sle0E => Hi.
by rewrite Hr0 (_: W64.to_sint i0 + 1 = 0) 1:/# BNexp.bnkup0.
qed.

lemma _expmLR_noct_ll: islossless M(P)._expmLR_noct.
proof.
have Hn := gt0_nlimbsexp.
have Hb: 64 * nlimbsexp < 18446744073709551616 by have := nlimbsexp_bnd.
have Hone: W64.one <> W64.zero by rewrite W64.to_uint_eq.
proc.
seq 10 : (-1 <= W64.to_sint i < nlimbsexp /\ (0 <= W64.to_sint i => w <> W64.zero)).
+ by while true; auto.
+ (* the zero limbs are skipped, the index decreasing to -1 at most *)
  while (-1 <= W64.to_sint i < nlimbsexp /\ (W64.to_sint i < 0 => w = W64.one)) (W64.to_sint i + 1).
  - move=> z; wp; skip => &hr [[[Hi0 Hi1] Hw1] Hw] Hz.
    have Hi: 0 <= W64.to_sint i{hr} by smt().
    by rewrite sle0E to_sint_dec //; smt().
  wp; skip => &hr _ /=.
  have Hs: W64.to_sint (W64.of_int (nlimbsexp - 1)) = nlimbsexp - 1.
  + by rewrite W64.to_sintK_small; smt().
  rewrite Hs; split; first smt().
  by move=> i0 w0; split; smt().
+ while (-1 <= W64.to_sint i < nlimbsexp) (W64.to_sint i + 1).
  - move=> z; wp; call _exp1mLR_noct_ll; wp; skip => &hr [[[Hi0 Hi1] Hi] Hz].
    move: Hi; rewrite sle0E => Hi.
    by rewrite /= to_sint_dec //; smt().
  if.
  - wp; exists* w; elim* => w0.
    call (_exp1mLR_first_noct_ll w0); wp; skip => &hr [Hw0 [[[Hi0 Hi1] Hw] Hi]] /=.
    move: Hi; rewrite sle0E => Hi.
    split; first smt().
    move=> _; rewrite to_sint_dec //; split; first smt().
    by move=> i1 H1 H2; rewrite sle0E; smt().
  - wp; call BNB._mov__ll; wp; skip => &hr [[[Hi0 Hi1] Hw] Hi] /=.
    move: Hi; rewrite sle0E => Hi.
    split; first smt().
    by move=> i1 H1 H2; rewrite sle0E; smt().
+ hoare.
  while (-1 <= W64.to_sint i < nlimbsexp /\ (W64.to_sint i < 0 => w = W64.one)).
  - wp; skip => &hr [[[Hi0 Hi1] Hw1] Hw] /=.
    have Hi: 0 <= W64.to_sint i{hr} by smt().
    by rewrite sle0E to_sint_dec //; smt().
  wp; skip => &hr _ /=.
  have Hs: W64.to_sint (W64.of_int (nlimbsexp - 1)) = nlimbsexp - 1.
  + by rewrite W64.to_sintK_small; smt().
  rewrite Hs; split; first smt().
  by move=> i0 w0 Hw0 [[Hi0 Hi1] Hw1]; smt().
by [].
qed.

lemma _expmLR_noct__ll: islossless M(P)._expmLR_noct_.
proof. by proc; wp; call _expmLR_noct_ll; wp; call BNB._mov__ll; auto. qed.

hoare _expm_noct__h _c _a _b:
 M(P)._expm_noct_
 : ctx = _c /\ a = _a /\ b = _b /\ mok _c /\ mdom _c (bn _a)
   ==> bn res = mexp _c (bn _a) (BNexp.bn _b).
proof.
proc.
wp; ecall (_expm_noct_h _c r _a _b).
wp; ecall (BNB._mov__h exp0).
wp; skip => /> Hc HA.
split; first exact (mone_dom _ Hc).
move=> _ r2 ->.
by apply (mmul1 _ _ Hc); apply mexp_dom => //; smt(BNexp.bnk_cmp).
qed.

hoare _expmU_noct__h _c _a _b:
 M(P)._expmU_noct_
 : ctx = _c /\ a = _a /\ b = _b /\ mok _c /\ mdom _c (bn _a)
   ==> bn res = mexp _c (bn _a) (BNexp.bn _b).
proof.
proc.
ecall (_expm_noct__h _c tmp _b).
ecall (BNB._mov__h a).
by wp; skip => /> Hc HA r1 ->.
qed.

hoare _expm__h _c _a _b:
 M(P)._expm_
 : ctx = _c /\ a = _a /\ b = _b /\ mok _c /\ mdom _c (bn _a)
   ==> bn res = mexp _c (bn _a) (BNexp.bn _b).
proof.
proc.
wp; ecall (_expm_h _c _a _b).
wp; ecall (BNB._mov__h exp0).
wp; ecall (BNB._mov__h a).
by wp; skip => /> Hc HA r1 -> r0 ->.
qed.

hoare _expmU__h _c _a _b:
 M(P)._expmU_
 : ctx = _c /\ a = _a /\ b = _b /\ mok _c /\ mdom _c (bn _a)
   ==> bn res = mexp _c (bn _a) (BNexp.bn _b).
proof.
proc.
wp; ecall (_expm_h _c _a _b).
wp; ecall (BNB._mov__h exp0).
wp; ecall (BNB._mov__h a).
by wp; skip => /> Hc HA r1 -> r0 ->.
qed.

hoare _expmLR_noct__h _c _a _b:
 M(P)._expmLR_noct_
 : ctx = _c /\ a = _a /\ b = _b /\ mok _c /\ mdom _c (bn _a)
   ==> bn res = mexp _c (bn _a) (BNexp.bn _b).
proof.
proc.
wp; ecall (_expmLR_noct_h _c (bn _a) _b).
wp; ecall (BNB._mov__h exp0).
by wp; skip => /> Hc HA r1 _.
qed.

(* the windowed exponentiation (constant time) *)

(* the lookup: entry idx of the table (every entry is read) *)
hoare __tblsel_h (t0: W64.t TBL.t) (i0: W64.t):
 M(P).__tblsel
 : tbl = t0 /\ idx = i0 /\ to_uint i0 < 16
   ==> res = tblE t0 (to_uint i0).
proof.
have Hn := gt0_nlimbs; have Hb := nlimbs_bnd.
have Hnn: to_uint (W64.of_int nlimbs) = nlimbs.
+ by rewrite W64.of_uintK modz_small //; move: Hb Hn => /#.
proc.
while (0 <= to_uint k <= nlimbs /\ tbl = t0 /\ idx = i0 /\ to_uint i0 < 16
       /\ forall q, 0 <= q < to_uint k => r.[q] = t0.[to_uint i0 * nlimbs + q]).
- wp.
  while (1 <= i <= 16 /\ 0 <= to_uint k < nlimbs /\ tbl = t0 /\ idx = i0 /\ to_uint i0 < 16
         /\ t = t0.[(if to_uint i0 < i then to_uint i0 else 0) * nlimbs + to_uint k]).
  + wp; skip => /> &hr Hi0 Hi1 Hk0 Hk1 Hidx Hi.
    have Hix := tbl_idx i{hr} (to_uint k{hr}) _ _; 1,2: smt().
    have Hix0 := tbl_idx i{hr} 0 _ _; 1,2: smt().
    have Hm: to_uint (W64.of_int (i{hr} * nlimbs)) = i{hr} * nlimbs.
    * by rewrite W64.of_uintK modz_small //; move: Hix0 Hb Hn => /#.
    have Hu: to_uint (k{hr} + W64.of_int (i{hr} * nlimbs)) = to_uint k{hr} + i{hr} * nlimbs.
    * by rewrite W64.to_uintD_small Hm //; move: Hix Hb Hn => /#.
    have Hz: (i0 = W64.of_int i{hr}) = (to_uint i0 = i{hr}).
    * by rewrite W64.to_uint_eq W64.of_uintK modz_small //; move: Hi0 Hi Hb Hn => /#.
    rewrite Hz Hu; split; first smt().
    by case: (to_uint i0 = i{hr}) => [->|Hne] /=; smt().
  wp; skip => /> &hr Hk0 Hk1 Hidx Hr.
  rewrite W64.ultE Hnn => Hlt.
  split.
  + split; first done.
    by have ->: (if to_uint i0 < 1 then to_uint i0 else 0) = 0 by smt(W64.to_uint_cmp).
  move=> i1 Hge Hi0 Hi1 _.
  have Hk: to_uint (k{hr} + W64.one) = to_uint k{hr} + 1.
  + by rewrite W64.to_uintD_small /=; move: Hlt Hb Hn => /#.
  rewrite Hk; split; first smt().
  move=> q Hq0 Hq1; rewrite BN.A.get_setE 1:/#.
  have ->: (if to_uint i0 < i1 then to_uint i0 else 0) = to_uint i0 by smt().
  by case: (q = to_uint k{hr}) => [->|Hne] //=; apply Hr => /#.
wp; skip => /> &hr Hidx.
split; first smt().
move=> k0 r0; rewrite W64.ultE Hnn => Hge Hk0 Hk1 Hr.
apply BN.A.ext_eq => q Hq.
by rewrite tblE_get // Hr /#.
qed.

(* fixed window of 4 bits: a^e, from the table of a^0 .. a^15 *)
hoare _expmW_h c0 (a0: BN.t) e0:
 M(P)._expmW
 : ctx = c0 /\ a = a0 /\ b = e0 /\ mok c0 /\ mdom c0 (bn a0)
   ==> bn res = mexp c0 (bn a0) (BNexp.bn e0).
proof.
have Hn := gt0_nlimbs; have Hne := gt0_nlimbsexp; have Hbe := nlimbsexp_bnd.
have Hnn: to_uint (W64.of_int nlimbsexp) = nlimbsexp.
+ by rewrite W64.of_uintK modz_small //; move: Hbe Hne => /#.
proc.
while (0 <= to_uint j <= nlimbsexp /\ _b = e0 /\ _ctx = c0 /\ mok c0 /\ mdom c0 (bn a0)
       /\ (forall q, 0 <= q < 16 => bn (tblE tbl q) = mexp c0 (bn a0) q)
       /\ bn r = mexp c0 (bn a0) (BNexp.bnkup (to_uint j) e0)).
- wp.
  while (0 <= to_uint _j < nlimbsexp /\ _b = e0 /\ _ctx = c0 /\ mok c0 /\ mdom c0 (bn a0)
         /\ (forall q, 0 <= q < 16 => bn (tblE tbl q) = mexp c0 (bn a0) q)
         /\ 0 <= to_uint k <= 16
         /\ to_uint _t = to_uint e0.[to_uint _j] %% 2 ^ (4 * to_uint k) * 2 ^ (64 - 4 * to_uint k)
         /\ bn r = mexp c0 (bn a0) (wexp (BNexp.bnkup (to_uint _j + 1) e0) (to_uint e0.[to_uint _j]) (to_uint k))).
  + wp; ecall (fun_mulU_h c0 (bn r) (bn psel)).
    wp.
    while (0 <= s <= 4 /\ _ctx = c0 /\ mok c0 /\ mdom c0 (bn a0)
           /\ 0 <= to_uint _j < nlimbsexp
           /\ bn r = mexp c0 (bn a0) (2 ^ s * wexp (BNexp.bnkup (to_uint _j + 1) e0) (to_uint e0.[to_uint _j]) (to_uint _k))).
    * wp; ecall (fun_sqrU_h c0 (bn r)); wp; skip => /> &hr Hs0 Hs1 Hc HA Hj0 Hj1 Hr Hs.
      move: Hr; pose E := wexp _ _ _; move=> Hr.
      have HE: 0 <= E by apply wexp_ge0; [apply bnkup_ge0 => /# | smt(W64.to_uint_cmp)].
      have HE2: 0 <= 2 ^ s{hr} * E by apply StdOrder.IntOrder.mulr_ge0 => //; apply StdOrder.IntOrder.expr_ge0.
      split; first by rewrite Hr; apply mexp_dom.
      move=> _ r1 ->; split; first smt().
      by rewrite Hr mexp_sqrs.
    wp; ecall (__tblsel_h tbl idx).
    wp; skip => /> &hr Hj0 Hj1 Hc HA HT Hk0 Hk1 Ht Hr Hk.
    have Hkp: 0 < to_uint k{hr} by move: Hk; rewrite W64.to_uint_eq /= /#.
    have Hkd := to_uint_dec k{hr} Hkp.
    have He := W64.to_uint_cmp e0.[to_uint _j{hr}].
    have [Hi Hs] := win_step _t{hr} (to_uint e0.[to_uint _j{hr}]) (to_uint k{hr}) _ _ Ht; 1,2: smt().
    have HH: 0 <= BNexp.bnkup (to_uint _j{hr} + 1) e0 by apply bnkup_ge0 => /#.
    have HE := wexp_ge0 (BNexp.bnkup (to_uint _j{hr} + 1) e0) (to_uint e0.[to_uint _j{hr}]) (to_uint k{hr}) HH _; first smt().
    have Hd: 0 <= to_uint (_t{hr} `>>` W8.of_int 60) < 16 by rewrite Hi; smt(modz_ge0 ltz_pmod).
    split; first smt().
    move=> _ r0 s0 Hs4 Hs0 Hs1 Hr0.
    have Hs04: s0 = 4 by smt().
    move: Hr0; rewrite Hs04 => Hr0.
    split.
    + split; first by rewrite Hr0; apply mexp_dom => //; smt(StdOrder.IntOrder.expr_ge0).
      by rewrite HT 1:/#; apply mexp_dom => /#.
    move=> _ _ r1 ->.
    rewrite Hkd; split; first smt().
    split; first exact Hs.
    rewrite Hr0 HT 1:/# mexp_win //; first smt().
    by rewrite wexp_step 1,2:/# Hi.
  wp; skip => /> &hr Hj0 Hj1 Hc HA HT Hr Hj.
  have Hjp: 0 < to_uint j{hr} by move: Hj; rewrite W64.to_uint_eq /= /#.
  have Hjd := to_uint_dec j{hr} Hjp.
  have He := W64.to_uint_cmp e0.[to_uint j{hr} - 1].
  rewrite !Hjd (_: to_uint j{hr} - 1 + 1 = to_uint j{hr}) 1:/#.
  split.
  + split; first smt().
    split; first by rewrite modz_small //; move: He => /= /#.
    by rewrite wexp16.
  move=> t1 r1 _ _ _ ->.
  split; first smt().
  rewrite wexp0; congr.
  by have -> := BNexp.bnkupP (to_uint j{hr}) e0 _; first smt().
(* the table *)
wp; ecall (BNB._mov__h one).
wp.
while (2 <= i <= 16 /\ _a = a0 /\ _b = e0 /\ _ctx = c0 /\ mok c0 /\ mdom c0 (bn a0)
       /\ (forall q, 0 <= q < i => bn (tblE tbl q) = mexp c0 (bn a0) q)).
- wp; ecall (fun_mulU_h c0 (bn p) (bn q)).
  wp; ecall (BNB._mov__h a).
  wp; skip => /> &hr Hi0 Hi1 Hc HA HT Hi.
  rewrite !tbl_wrE !tblEE.
  have E1: tblE (tbl_wr tbl{hr} i{hr} a0) i{hr} = a0 by rewrite tblE_wr /#.
  have E2: tblE (tbl_wr tbl{hr} i{hr} a0) (i{hr} - 1) = tblE tbl{hr} (i{hr} - 1) by rewrite tblE_wr /#.
  rewrite E1 E2.
  split; first by rewrite HT 1:/#; split => //; apply mexp_dom => /#.
  move=> _ _ r1 Hr1; split; first smt().
  move=> q Hq0 Hq1; rewrite tblE_wr 1,2:/#.
  case: (q = i{hr}) => [->|Hq] /=.
  + by rewrite Hr1 HT 1:/# -mexpS 1:/#; congr; ring.
  + by rewrite tblE_wr 1,2:/# Hq /= HT /#.
wp; ecall (BNB._mov__h a).
wp; ecall (BNB._mov__h one).
wp; skip => /> Hc HA.
split.
- move=> q Hq0 Hq1.
  rewrite tbl_wrE0 tbl_wrE1 tblE_wr 1,2:/#.
  case: (q = 1) => [->|Hq] /=; first by rewrite mexp1.
  by rewrite tblE_wr 1,2:/# (_: q = 0) 1:/# /= mexp0 /mone /FPC.ctxONE.
- move=> i1 tbl1 Hi16 Hi2 Hi16' HT.
  rewrite Hnn; split; first smt().
  split; first by move=> q Hq0 Hq1; apply HT => /#.
  by rewrite BNexp.bnkup_nlimbs mexp0 /mone /FPC.ctxONE.
qed.

lemma __tblsel_ll: islossless M(P).__tblsel.
proof.
have Hn := gt0_nlimbs; have Hb := nlimbs_bnd.
have Hnn: to_uint (W64.of_int nlimbs) = nlimbs.
+ by rewrite W64.of_uintK modz_small //; move: Hb Hn => /#.
proc.
while (0 <= to_uint k <= nlimbs) (nlimbs - to_uint k).
- move=> z; wp.
  while (true) (16 - i).
  + by move=> z'; wp; skip => /#.
  wp; skip => /> &hr Hk0 Hk1; rewrite W64.ultE Hnn => Hlt.
  have Hk: to_uint (k{hr} + W64.one) = to_uint k{hr} + 1.
  + by rewrite W64.to_uintD_small /=; move: Hlt Hb Hn => /#.
  by rewrite Hk /#.
wp; skip => />; split; first smt().
by move=> k0; rewrite W64.ultE Hnn /#.
qed.

lemma _expmW_ll: islossless M(P)._expmW.
proof.
proc.
while (true) (to_uint j).
- move=> z; wp.
  while (true) (to_uint k).
  + move=> z'; wp; call fun_mulU_ll; wp.
    while (true) (4 - s).
    * by move=> z''; wp; call fun_sqrU_ll; wp; skip => /#.
    wp; call __tblsel_ll; wp; skip => /> &hr Hk.
    have Hkp: 0 < to_uint k{hr} by move: Hk; rewrite W64.to_uint_eq /=; smt(W64.to_uint_cmp).
    have Hkd := to_uint_dec k{hr} Hkp.
    by rewrite Hkd /#.
  wp; skip => /> &hr Hj.
  have Hjp: 0 < to_uint j{hr} by move: Hj; rewrite W64.to_uint_eq /=; smt(W64.to_uint_cmp).
  have Hjd := to_uint_dec j{hr} Hjp.
  move=> k0; rewrite Hjd; split; last smt().
  by move=> Hk0; rewrite W64.to_uint_eq /=; smt(W64.to_uint_cmp).
wp; call BNB._mov__ll; wp.
while (true) (16 - i).
- by move=> z; wp; call fun_mulU_ll; wp; call BNB._mov__ll; wp; skip => /#.
wp; call BNB._mov__ll; wp; call BNB._mov__ll; wp; skip => /> i0; split; first smt().
by move=> _ j0 Hj0; rewrite W64.to_uint_eq /=; smt(W64.to_uint_cmp).
qed.

lemma _expmW__ll: islossless M(P)._expmW_.
proof. by proc; wp; call _expmW_ll; auto. qed.

lemma _expmWU__ll: islossless M(P)._expmWU_.
proof. by proc; call _expmW__ll; call BNB._mov__ll; auto. qed.

hoare _expmW__h _c _a _b:
 M(P)._expmW_
 : ctx = _c /\ a = _a /\ b = _b /\ mok _c /\ mdom _c (bn _a)
   ==> bn res = mexp _c (bn _a) (BNexp.bn _b).
proof. by proc; wp; ecall (_expmW_h _c _a _b); auto. qed.

hoare _expmWU__h _c _a _b:
 M(P)._expmWU_
 : ctx = _c /\ a = _a /\ b = _b /\ mok _c /\ mdom _c (bn _a)
   ==> bn res = mexp _c (bn _a) (BNexp.bn _b).
proof.
proc.
ecall (_expmW__h _c tmp _b).
ecall (BNB._mov__h a).
by wp; skip => /> Hc HA r1 ->.
qed.

end section.
