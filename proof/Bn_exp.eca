require import AllCore Int IntDiv List StdOrder.
from Jasmin require import JModel_x86.
import SLH64.

require JBigNumber.

(* Correctness contracts for bn_exp@exp.jinc: exponentiation in a monoid,
   given by the multiplication parameters fun_mulU/fun_sqrU (the module
   parameter of M) and a context, whose ONE part is the unit. *)

(* Parameters *)
op nlimbs: int.
axiom gt0_nlimbs: 0 < nlimbs.
op nlimbsexp: int.                      (* limbs of the exponents *)
axiom gt0_nlimbsexp: 0 < nlimbsexp.
(* the limb index of the exponent is a signed word *)
axiom nlimbsexp_bnd: 64 * nlimbsexp < W64.modulus.
(* the word indices of the table lookup (__tblsel) do not wrap *)
axiom nlimbs_bnd: 64 * nlimbs < W64.modulus.

clone export JBigNumber.BigN
 with op nlimbs <- nlimbs
      proof gt0_nlimbs by exact gt0_nlimbs.

(* exponents *)
clone JBigNumber.BN as BNexp
 with op nlimbs <- nlimbsexp
      proof gt0_nlimbs by exact gt0_nlimbsexp.

import BN2.
import BN.
import BNexp.A.

require Bn_util.
clone Bn_util as BNUTIL.
module BNUTIL_M = BNUTIL.M.

require Bn_base.
clone Bn_base as BNB
 with op nlimbs <- nlimbs,
      theory BigN <- BigN,
      theory BNUTIL <- BNUTIL
      proof gt0_nlimbs by exact gt0_nlimbs.
module BNB_M = BNB.M.

require Fp_ctx.
clone Fp_ctx as FPC
 with op nlimbs <- nlimbs,
      theory BigN <- BigN
      proof gt0_nlimbs by exact gt0_nlimbs.
import FPC.CTX.

(* The table of the windowed exponentiation (_expmW): 16 numbers. [tblE t i]
   is its entry i, [tbl_wr t i p] the table with p written at entry i. *)
clone import PolyArray as TBL with op size <- 16 * nlimbs.

op tblE (tbl: W64.t TBL.t) (i: int) : BN.t =
  BN.A.init (fun k => tbl.[i * nlimbs + k]).

op tbl_wr (tbl: W64.t TBL.t) (i: int) (p: BN.t) : W64.t TBL.t =
  TBL.init (fun k => if i * nlimbs <= k < i * nlimbs + nlimbs
                     then p.[k - i * nlimbs] else tbl.[k]).

lemma tbl_idx i k: 0 <= i < 16 => 0 <= k < nlimbs =>
  0 <= i * nlimbs + k < 16 * nlimbs.
proof.
move=> [Hi0 Hi1] [Hk0 Hk1]; have Hn := gt0_nlimbs.
have H0: 0 <= i * nlimbs by apply StdOrder.IntOrder.mulr_ge0 => /#.
have H1: i * nlimbs <= 15 * nlimbs by apply StdOrder.IntOrder.ler_wpmul2r => /#.
smt().
qed.

lemma tblE_get tbl i k: 0 <= k < nlimbs => (tblE tbl i).[k] = tbl.[i * nlimbs + k].
proof. by move=> Hk; rewrite /tblE BN.A.initiE. qed.

(* the entries of a table after writing entry i *)
lemma tblE_wr tbl i j p: 0 <= i < 16 => 0 <= j < 16 =>
  tblE (tbl_wr tbl i p) j = if j = i then p else tblE tbl j.
proof.
move=> Hi Hj; have Hn := gt0_nlimbs.
apply BN.A.ext_eq => k Hk.
rewrite tblE_get // /tbl_wr TBL.initiE 1:tbl_idx //=.
case: (j = i) => [->|Hji] /=.
- by rewrite (_: i * nlimbs <= i * nlimbs + k < i * nlimbs + nlimbs) 1:/# /= (_: i * nlimbs + k - i * nlimbs = k) 1:/#.
- have Hd: j * nlimbs + nlimbs <= i * nlimbs \/ i * nlimbs + nlimbs <= j * nlimbs.
  + case: (j < i) => Hlt; [left | right].
    * have ->: j * nlimbs + nlimbs = (j + 1) * nlimbs by ring.
      by apply StdOrder.IntOrder.ler_wpmul2r => /#.
    * have ->: i * nlimbs + nlimbs = (i + 1) * nlimbs by ring.
      by apply StdOrder.IntOrder.ler_wpmul2r => /#.
  by rewrite (_: !(i * nlimbs <= j * nlimbs + k < i * nlimbs + nlimbs)) 1:/# /= tblE_get.
qed.

(* the forms of the extracted code *)
lemma tblEE (tbl: W64.t TBL.t) i:
  BN.A.init (fun k => tbl.[i * nlimbs + k]) = tblE tbl i.
proof. by rewrite /tblE. qed.

lemma tbl_wrE (tbl: W64.t TBL.t) i (p: BN.t):
  TBL.init (fun k => if i * nlimbs <= k < i * nlimbs + nlimbs
                     then p.[k - i * nlimbs] else tbl.[k])
  = tbl_wr tbl i p.
proof. by rewrite /tbl_wr. qed.

(* the same for the entries 0 and 1, whose offsets are simplified *)
lemma tbl_wrE0 (tbl: W64.t TBL.t) (p: BN.t):
  TBL.init (fun k => if 0 <= k < nlimbs then p.[k] else tbl.[k]) = tbl_wr tbl 0 p.
proof. by rewrite /tbl_wr. qed.

lemma tbl_wrE1 (tbl: W64.t TBL.t) (p: BN.t):
  TBL.init (fun k => if nlimbs <= k < nlimbs + nlimbs then p.[k - nlimbs] else tbl.[k])
  = tbl_wr tbl 1 p.
proof. by rewrite /tbl_wr. qed.

(* The monoid: for a context c with [mok c], the representatives x with
   [mdom c x], their product [mmul c x y], and the unit, the ONE part of c.
   (In a field: representatives below P, product of the representatives,
   e.g. x*y*R^-1 mod P in Montgomery form.) *)
op mok  : W64.t FPC.CTX.t -> bool.
op mdom : W64.t FPC.CTX.t -> int -> bool.
op mmul : W64.t FPC.CTX.t -> int -> int -> int.
op mone (c: W64.t FPC.CTX.t) : int = bn (FPC.ctxONE c).

axiom mmul_dom c x y: mok c => mdom c x => mdom c y => mdom c (mmul c x y).
axiom mmulA c x y z: mok c => mdom c x => mdom c y => mdom c z =>
  mmul c x (mmul c y z) = mmul c (mmul c x y) z.
axiom mmulC c x y: mok c => mdom c x => mdom c y => mmul c x y = mmul c y x.
axiom mone_dom c: mok c => mdom c (mone c).
axiom mmul1 c x: mok c => mdom c x => mmul c (mone c) x = x.

(* flags of the one-bit shifts and of the decrement *)
lemma SHR1E (t: W64.t):
  (SHR_64 t (W8.of_int 1)).`2 = (to_uint t %% 2 = 1)
  /\ to_uint (SHR_64 t (W8.of_int 1)).`6 = to_uint t %/ 2.
proof.
rewrite /SHR_64 /shift_mask /rflags_OF /= /lsb.
split; last by rewrite W64.to_uint_shr.
rewrite W64.get_to_uint /= W64.to_uint_shr //=; smt(W64.to_uint_cmp).
qed.

lemma SHL1E (t: W64.t):
  (SHL_64 t (W8.of_int 1)).`2 = (2^63 <= to_uint t)
  /\ to_uint (SHL_64 t (W8.of_int 1)).`6 = to_uint t * 2 %% W64.modulus.
proof.
rewrite /SHL_64 /shift_mask /rflags_OF /= /SF_of.
split; last by rewrite W64.to_uint_shl.
rewrite W64.get_to_uint /=.
have [H0 H1] := W64.to_uint_cmp t.
have Ht0: to_uint (t `<<<` 0) = to_uint t.
+ by rewrite W64.to_uint_shl //= W64.to_uint_mod.
rewrite Ht0.
move: H1; rewrite (_: W64.modulus = 18446744073709551616) // => H1.
case: (9223372036854775808 <= to_uint t) => H.
- have Hq: to_uint t %/ 9223372036854775808 = 1.
  + by rewrite -(edivz_eq 9223372036854775808 1 (to_uint t - 9223372036854775808)) /#.
  by rewrite Hq.
- by rewrite divz_small /#.
qed.

lemma DEC1E (k: W64.t):
  to_uint k <> 0 =>
  to_uint (DEC_64 k).`5 = to_uint k - 1 /\ ((DEC_64 k).`4 <=> to_uint k = 1).
proof.
move=> Hk.
have Hk0: k <> W64.zero by apply/negP => E; move: Hk; rewrite E.
have [[H1 H2] _] := DEC_64_counter 64 k Hk0.
split; first smt().
rewrite H2 W64.to_uint_eq /=; smt().
qed.

(* powers *)
op mexp c x n = iter n (mmul c x) (mone c).

lemma mexp0 c x: mexp c x 0 = mone c.
proof. by rewrite /mexp iter0. qed.

lemma mexpS c x n: 0 <= n => mexp c x (n + 1) = mmul c x (mexp c x n).
proof. by move=> Hn; rewrite /mexp iterS. qed.

lemma mexp_dom c x n: mok c => mdom c x => 0 <= n => mdom c (mexp c x n).
proof.
move=> Hc Hx; elim/natind: n => [n Hn H0|n Hn IH _].
- by rewrite (_: n = 0) 1:/# mexp0 mone_dom.
- by rewrite mexpS // mmul_dom // IH.
qed.

lemma mexpD c x m n: mok c => mdom c x => 0 <= m => 0 <= n =>
  mexp c x (m + n) = mmul c (mexp c x m) (mexp c x n).
proof.
move=> Hc Hx; elim/natind: m => [m Hm H0|m Hm IH _] Hn.
- by rewrite (_: m = 0) 1:/# /= mexp0 mmul1 // mexp_dom.
- rewrite (_: m + 1 + n = (m + n) + 1) 1:/# !mexpS // 1:/# IH //.
  by rewrite mmulA // mexp_dom.
qed.

lemma mexp1 c x: mok c => mdom c x => mexp c x 1 = x.
proof.
move=> Hc Hx; rewrite (_: 1 = 0 + 1) // mexpS // mexp0 mmulC //.
- exact mone_dom.
- by rewrite mmul1.
qed.

(* r * x^e * x^d = r * x^(e+d) *)
lemma mexp_acc c x r e d: mok c => mdom c x => mdom c r => 0 <= e => 0 <= d =>
  mmul c (mmul c r (mexp c x e)) (mexp c x d) = mmul c r (mexp c x (e + d)).
proof.
move=> Hc Hx Hr He Hd.
by rewrite -mmulA // ?mexp_dom // -mexpD.
qed.

(* (x^e)^2 = x^(2e) *)
lemma mexp_sqr c x e: mok c => mdom c x => 0 <= e =>
  mmul c (mexp c x e) (mexp c x e) = mexp c x (2 * e).
proof. by move=> Hc Hx He; rewrite -mexpD // (_: e + e = 2 * e) 1:/#. qed.

(* bits of an exponent *)
lemma pow2S s: 0 <= s => 2 ^ (s + 1) = 2 ^ s * 2.
proof. by move=> Hs; rewrite exprS // mulzC. qed.

lemma div_pow2S e s: 0 <= s => e %/ 2 ^ s %/ 2 = e %/ 2 ^ (s + 1).
proof. by move=> Hs; rewrite pow2S // divzMr //; apply StdOrder.IntOrder.expr_ge0. qed.

lemma mod_pow2S e s: 0 <= s =>
  e %% 2 ^ (s + 1) = e %% 2 ^ s + (e %/ 2 ^ s %% 2) * 2 ^ s.
proof.
move=> Hs.
have H2: 0 < 2 ^ s by rewrite StdOrder.IntOrder.expr_gt0.
have Hd: 2 ^ s %| 2 ^ (s + 1) by rewrite pow2S // dvdz_mulr dvdzz.
rewrite {1}(divz_eq (e %% 2 ^ (s + 1)) (2 ^ s)) modz_dvd //.
rewrite pow2S // -JUtils.divz_mod_mul // 1:/# (mulzC 2).
by ring.
qed.

(* one step of the right-to-left square-and-multiply: bit s of the limb ej
   (of weight 2^(64*j)) is folded into the accumulator r, and x squared *)
lemma sqmul_step c A R0 E0 ej j s r x (cf: bool):
  mok c => mdom c A => mdom c R0 => 0 <= j => 0 <= s => 0 <= ej => 0 <= E0 =>
  r = mmul c R0 (mexp c A (E0 + ej %% 2 ^ s * 2 ^ (64 * j))) =>
  x = mexp c A (2 ^ (64 * j + s)) =>
  cf = (ej %/ 2 ^ s %% 2 = 1) =>
  (if cf then mmul c r x else r)
    = mmul c R0 (mexp c A (E0 + ej %% 2 ^ (s + 1) * 2 ^ (64 * j)))
  /\ mmul c x x = mexp c A (2 ^ (64 * j + (s + 1))).
proof.
move=> Hc HA HR0 Hj Hs He HE0 -> -> ->.
have Hp: 0 <= 2 ^ (64 * j) by rewrite StdOrder.IntOrder.expr_ge0.
have Hq: 0 <= 2 ^ s by rewrite StdOrder.IntOrder.expr_ge0.
have Hm: 0 <= ej %% 2 ^ s * 2 ^ (64 * j).
+ by apply StdOrder.IntOrder.mulr_ge0 => //; apply modz_ge0; smt(StdOrder.IntOrder.expr_gt0).
have Hd: 0 <= 2 ^ (64 * j + s) by apply StdOrder.IntOrder.expr_ge0.
have HE: 0 <= E0 + ej %% 2 ^ s * 2 ^ (64 * j) by smt().
split.
- rewrite mod_pow2S //.
  have Hb: ej %/ 2 ^ s %% 2 = 0 \/ ej %/ 2 ^ s %% 2 = 1 by smt(modz_ge0 ltz_pmod).
  case: Hb => -> /=.
  + done.
  + rewrite mexp_acc //.
    by congr; congr; rewrite exprD_nneg // 1:/#; ring.
- rewrite mexp_sqr //.
  by congr; rewrite (_: 64 * j + (s + 1) = (64 * j + s) + 1) 1:/# pow2S 1:/#; ring.
qed.

(* left-to-right scanning of a limb: after s bits, t holds the remaining
   bits (e mod 2^(64-s)) shifted to the top *)
lemma msb_bit e s: 0 <= s < 64 => 0 <= e =>
  (2 ^ 63 <= e %% 2 ^ (64 - s) * 2 ^ s) = (e %/ 2 ^ (63 - s) %% 2 = 1).
proof.
move=> Hs He.
have H63: 2 ^ (63 - s) * 2 ^ s = 2 ^ 63.
+ by rewrite -exprD_nneg 1,2:/# (_: 63 - s + s = 63) 1:/#.
have Hk: 0 < 2 ^ (63 - s) by rewrite StdOrder.IntOrder.expr_gt0.
have Hs2: 0 < 2 ^ s by rewrite StdOrder.IntOrder.expr_gt0.
have Hl := modz_cmp e (2 ^ (63 - s)) Hk.
have Hlt: e %% 2 ^ (63 - s) * 2 ^ s < 2 ^ 63.
+ by rewrite -H63 StdOrder.IntOrder.ltr_pmul2r //; smt().
have Hge: 0 <= e %% 2 ^ (63 - s) * 2 ^ s by smt(StdOrder.IntOrder.mulr_ge0).
rewrite (_: 64 - s = (63 - s) + 1) 1:/# mod_pow2S 1:/# mulzDl.
rewrite (_: e %/ 2 ^ (63 - s) %% 2 * 2 ^ (63 - s) * 2 ^ s = e %/ 2 ^ (63 - s) %% 2 * 2 ^ 63).
+ by rewrite -H63; ring.
have Hb: e %/ 2 ^ (63 - s) %% 2 = 0 \/ e %/ 2 ^ (63 - s) %% 2 = 1 by smt(modz_ge0 ltz_pmod).
move: Hlt Hge => /= Hlt Hge.
by case: Hb => -> /=; smt().
qed.

lemma shl_low e s: 0 <= s < 64 => 0 <= e =>
  (e %% 2 ^ (64 - s) * 2 ^ s * 2) %% 2 ^ 64 = e %% 2 ^ (63 - s) * 2 ^ (s + 1).
proof.
move=> Hs He.
have H64: 2 ^ (63 - s) * 2 ^ (s + 1) = 2 ^ 64.
+ by rewrite -exprD_nneg 1,2:/# (_: 63 - s + (s + 1) = 64) 1:/#.
have Hk: 0 < 2 ^ (63 - s) by rewrite StdOrder.IntOrder.expr_gt0.
have Hs2: 0 < 2 ^ (s + 1) by rewrite StdOrder.IntOrder.expr_gt0.
have Hl := modz_cmp e (2 ^ (63 - s)) Hk.
have Hlt: e %% 2 ^ (63 - s) * 2 ^ (s + 1) < 2 ^ 64.
+ by rewrite -H64 StdOrder.IntOrder.ltr_pmul2r //; smt().
have Hge: 0 <= e %% 2 ^ (63 - s) * 2 ^ (s + 1) by smt(StdOrder.IntOrder.mulr_ge0).
rewrite (_: 64 - s = (63 - s) + 1) 1:/# mod_pow2S 1:/#.
rewrite (_: (e %% 2 ^ (63 - s) + e %/ 2 ^ (63 - s) %% 2 * 2 ^ (63 - s)) * 2 ^ s * 2
          = e %% 2 ^ (63 - s) * 2 ^ (s + 1) + (e %/ 2 ^ (63 - s) %% 2) * 2 ^ 64).
+ by rewrite -H64 pow2S 1:/#; ring.
by rewrite modzMDr modz_small //.
qed.

lemma div_bit e k: 0 <= k =>
  e %/ 2 ^ k = e %/ 2 ^ (k + 1) * 2 + e %/ 2 ^ k %% 2.
proof. by move=> Hk; rewrite -div_pow2S // -divz_eq. qed.

(* the same, in terms of the number k of bits still to scan *)
lemma ladder_cf e k: 0 < k <= 64 => 0 <= e =>
  (2 ^ 63 <= e %% 2 ^ k * 2 ^ (64 - k)) = (e %/ 2 ^ (k - 1) %% 2 = 1).
proof.
move=> Hk He; have := msb_bit e (64 - k) _ _; 1,2: smt().
by rewrite (_: 64 - (64 - k) = k) 1:/# (_: 63 - (64 - k) = k - 1) 1:/#.
qed.

lemma ladder_t e k: 0 < k <= 64 => 0 <= e =>
  (e %% 2 ^ k * 2 ^ (64 - k) * 2) %% W64.modulus = e %% 2 ^ (k - 1) * 2 ^ (64 - (k - 1)).
proof.
move=> Hk He; have := shl_low e (64 - k) _ _; 1,2: smt().
rewrite (_: 64 - (64 - k) = k) 1:/# (_: 63 - (64 - k) = k - 1) 1:/#.
by rewrite (_: 64 - k + 1 = 64 - (k - 1)) 1:/#.
qed.

lemma ladder_exp H e k: 0 < k <= 64 => 0 <= e =>
  H * 2 ^ (64 - (k - 1)) + e %/ 2 ^ (k - 1)
  = 2 * (H * 2 ^ (64 - k) + e %/ 2 ^ k) + b2i (e %/ 2 ^ (k - 1) %% 2 = 1).
proof.
move=> Hk He.
have Hd := div_bit e (k - 1) _; first smt().
move: Hd; rewrite (_: k - 1 + 1 = k) 1:/# => Hd.
rewrite (_: 64 - (k - 1) = (64 - k) + 1) 1:/# pow2S 1:/#.
have: e %/ 2 ^ (k - 1) %% 2 = 0 \/ e %/ 2 ^ (k - 1) %% 2 = 1 by smt(modz_ge0 ltz_pmod).
by move=> [Hb|Hb]; move: Hd; rewrite Hb /= => Hd; rewrite Hd /b2i /=; ring.
qed.

(* The Montgomery ladder with one conditional swap per bit. For the scanned
   prefix E of the exponent, the pair (x0, x1) holds A^E and A^(E+1),
   swapped by the last bit scanned, s (the parity of E). For the next bit b:
   swap by s xor b, x1 := x1*x0, x0 := x0^2; the pair then holds A^E' and
   A^(E'+1), E' = 2E + b, swapped by b. *)
lemma ladder_step c A E (s b: bool) x0 x1:
  mok c => mdom c A => 0 <= E =>
  x0 = mexp c A (E + b2i s) => x1 = mexp c A (E + b2i (!s)) =>
  let y0 = if s <> b then x1 else x0 in
  let y1 = if s <> b then x0 else x1 in
  mmul c y0 y0 = mexp c A (2 * E + b2i b + b2i b)
  /\ mmul c y1 y0 = mexp c A (2 * E + b2i b + b2i (!b)).
proof.
move=> Hc HA HE -> -> /=.
case: s; case: b => _ _; rewrite /b2i /=.
- split.
  + by rewrite mexp_sqr // 1:/# (_: 2 * (E + 1) = 2 * E + 1 + 1) 1:/#.
  + by rewrite -mexpD // 1:/# (_: E + (E + 1) = 2 * E + 1) 1:/#.
- split.
  + by rewrite mexp_sqr.
  + by rewrite -mexpD // 1:/# (_: E + 1 + E = 2 * E + 1) 1:/#.
- split.
  + by rewrite mexp_sqr // 1:/# (_: 2 * (E + 1) = 2 * E + 1 + 1) 1:/#.
  + by rewrite -mexpD // 1:/# (_: E + (E + 1) = 2 * E + 1) 1:/#.
- split.
  + by rewrite mexp_sqr.
  + by rewrite -mexpD // 1:/# (_: E + 1 + E = 2 * E + 1) 1:/#.
qed.

(* the masks of the swaps: 0 or -1 *)
lemma mask_xor (s b: bool):
  W64.of_int (- b2i s) `^` W64.of_int (- b2i b) = W64.of_int (- b2i (s <> b)).
proof.
by case: s; case: b => _ _; rewrite /b2i /= ?JBigNumber.W64_of_int_m1 ?xorwK ?xorw0 ?xor0w.
qed.

lemma mask_nz (s: bool): (W64.of_int (- b2i s) <> W64.zero) = s.
proof.
case: s => _; rewrite /b2i //=.
by rewrite JBigNumber.W64_of_int_m1 W64.to_uint_eq W64.to_uint_onew.
qed.

(* the state of the ladder for the scanned prefix E: m is the mask of the
   swap in force, x0 and x1 the values of the pair *)
op [opaque] linv (c: W64.t FPC.CTX.t) (A E: int) (m: W64.t) (x0 x1: int) : bool =
  m = W64.of_int (- b2i (E %% 2 = 1))
  /\ x0 = mexp c A (E + b2i (E %% 2 = 1))
  /\ x1 = mexp c A (E + b2i (! (E %% 2 = 1))).

lemma linv0 c A: mok c => mdom c A => linv c A 0 W64.zero (mone c) A.
proof. by move=> Hc HA; rewrite /linv /b2i /= mexp0 mexp1. qed.

(* one bit: sw is the mask of the swap, y0 and y1 the pair after it *)
lemma linv_step c A E (b: bool) m x0 x1:
  mok c => mdom c A => 0 <= E =>
  linv c A E m x0 x1 =>
  let sw = m `^` W64.of_int (- b2i b) in
  let y0 = if sw <> W64.zero then x1 else x0 in
  let y1 = if sw <> W64.zero then x0 else x1 in
  sw = W64.of_int (- b2i (sw <> W64.zero))
  /\ mdom c y0 /\ mdom c y1
  /\ linv c A (2 * E + b2i b) (W64.of_int (- b2i b)) (mmul c y0 y0) (mmul c y1 y0).
proof.
move=> Hc HA HE; rewrite /linv => -[-> [-> ->]] /=.
rewrite mask_xor mask_nz /=.
have Hp: ((2 * E + b2i b) %% 2 = 1) = b by rewrite /b2i; smt().
have := ladder_step c A E (E %% 2 = 1) b (mexp c A (E + b2i (E %% 2 = 1)))
          (mexp c A (E + b2i (E %% 2 <> 1))) Hc HA HE _ _; 1,2: done.
move=> /= [L1 L2].
rewrite Hp L1 L2 /=.
by split; case: ((E %% 2 = 1) <> b) => _ /=; apply mexp_dom => //; rewrite /b2i; smt().
qed.

(* the last swap *)
lemma linv_end c A E m x0 x1:
  linv c A E m x0 x1 =>
  m = W64.of_int (- b2i (m <> W64.zero))
  /\ (if m <> W64.zero then x1 else x0) = mexp c A E.
proof.
rewrite /linv => -[-> [-> ->]]; rewrite mask_nz /=.
by case: (E %% 2 = 1) => _; rewrite /b2i.
qed.

(* signed comparisons with 0, and decrements, of small words *)
lemma sle0E (i: W64.t): (W64.zero \sle i) = (0 <= W64.to_sint i).
proof. by rewrite W64.sleE (W64.to_sintK_small 0). qed.

lemma slt0E (i: W64.t): (W64.zero \slt i) = (0 < W64.to_sint i).
proof. by rewrite W64.sltE (W64.to_sintK_small 0). qed.

lemma to_sint_small (k: W64.t): to_uint k < 2^63 => W64.to_sint k = to_uint k.
proof. by move=> H; rewrite W64.to_sintE /W64.smod /=; move: H => /= H; smt(). qed.

lemma to_sint_one: W64.to_sint W64.one = 1.
proof. by rewrite to_sint_small. qed.

lemma to_sint_dec (i: W64.t): 0 <= W64.to_sint i =>
  W64.to_sint (i - W64.one) = W64.to_sint i - 1.
proof.
move=> H; have Hc := W64.to_sint_cmp i; move: Hc => /= Hc.
by rewrite W64.to_sintB_small to_sint_one //=; smt().
qed.

lemma to_uint_dec (k: W64.t): 0 < to_uint k => to_uint (k - W64.one) = to_uint k - 1.
proof. by move=> H; rewrite W64.to_uintB 1:W64.uleE /=; smt(). qed.

lemma slt0_small (k: W64.t): to_uint k <= 64 => (W64.zero \slt k) = (0 < to_uint k).
proof. by move=> H; rewrite slt0E to_sint_small //; move: H => /= H; smt(). qed.

(* the top bit of e < 2^k (left-to-right scanning of the first limb) *)
lemma top_div e k: 0 < k => 0 <= e < 2 ^ k => 0 <= e %/ 2 ^ (k - 1) < 2.
proof.
move=> Hk [He0 He1]; have Hp: 0 < 2 ^ (k - 1) by rewrite StdOrder.IntOrder.expr_gt0.
split; first by apply divz_ge0.
move=> _; rewrite ltz_divLR //.
by rewrite (_: 2 * 2 ^ (k - 1) = 2 ^ k) // -exprS 1:/#; congr; ring.
qed.

lemma top_bit0 e k: 0 < k => 0 <= e < 2 ^ k =>
  !(e %/ 2 ^ (k - 1) %% 2 = 1) => e < 2 ^ (k - 1).
proof.
move=> Hk He Hb; have [Hq0 Hq1] := top_div e k Hk He.
have Hp: 0 < 2 ^ (k - 1) by rewrite StdOrder.IntOrder.expr_gt0.
have Hq: e %/ 2 ^ (k - 1) = 0 by move: Hb; rewrite modz_small /#.
by rewrite (divz_eq e (2 ^ (k - 1))) Hq /=; apply ltz_pmod.
qed.

lemma top_bit1 e k: 0 < k => 0 <= e < 2 ^ k =>
  e %/ 2 ^ (k - 1) %% 2 = 1 => e %/ 2 ^ (k - 1) = 1.
proof.
move=> Hk He Hb; have [Hq0 Hq1] := top_div e k Hk He.
by move: Hb; rewrite modz_small /#.
qed.

(* the value of the upper limbs of an exponent *)
lemma bnkup_ge0 k (x: BNexp.t): 0 <= k <= nlimbsexp => 0 <= BNexp.bnkup k x.
proof.
move=> Hk; rewrite -BNexp.bn_div_kup 1:/#; apply divz_ge0.
- by smt(StdOrder.IntOrder.expr_gt0).
- by smt(BNexp.bnk_cmp).
qed.

(* Windows of 4 bits, in the left-to-right scanning of a limb e: with k
   windows still to scan, t holds e mod 2^(4k), shifted to the top. The
   next window is the top 4 bits of t (idx), and t is shifted by 4. *)
lemma mod_pow2_win e m: 0 <= m =>
  e %% 2 ^ (m + 4) = e %% 2 ^ m + (e %/ 2 ^ m %% 16) * 2 ^ m.
proof.
move=> Hm.
have H2: 0 < 2 ^ m by rewrite StdOrder.IntOrder.expr_gt0.
have Hp: 2 ^ (m + 4) = 2 ^ m * 16 by rewrite exprD_nneg.
have Hd: 2 ^ m %| 2 ^ (m + 4) by rewrite Hp dvdz_mulr dvdzz.
rewrite {1}(divz_eq (e %% 2 ^ (m + 4)) (2 ^ m)) modz_dvd //.
rewrite Hp -JUtils.divz_mod_mul // 1:/# (mulzC 16).
by ring.
qed.

lemma win_idx e k: 0 < k <= 16 => 0 <= e =>
  (e %% 2 ^ (4 * k) * 2 ^ (64 - 4 * k)) %/ 2 ^ 60 = e %/ 2 ^ (4 * (k - 1)) %% 16.
proof.
move=> Hk He; pose m := 4 * (k - 1).
have Hm: 0 <= m by smt().
have H2: 0 < 2 ^ m by rewrite StdOrder.IntOrder.expr_gt0.
have H3: 0 < 2 ^ (60 - m) by rewrite StdOrder.IntOrder.expr_gt0.
have H60: 2 ^ 60 = 2 ^ m * 2 ^ (60 - m).
+ by rewrite -exprD_nneg 1,2:/# (_: m + (60 - m) = 60) 1:/#.
rewrite (_: 4 * k = m + 4) 1:/# (_: 64 - (m + 4) = 60 - m) 1:/# H60 divzMpr //.
have Hp: 2 ^ (m + 4) = 16 * 2 ^ m by rewrite exprD_nneg // mulzC.
by rewrite Hp JUtils.divz_mod_mul 1:/#.
qed.

lemma win_t e k: 0 < k <= 16 => 0 <= e =>
  (e %% 2 ^ (4 * k) * 2 ^ (64 - 4 * k) * 2 ^ 4) %% W64.modulus
  = e %% 2 ^ (4 * (k - 1)) * 2 ^ (64 - 4 * (k - 1)).
proof.
move=> Hk He; pose m := 4 * (k - 1).
have Hm: 0 <= m by smt().
have H2: 0 < 2 ^ m by rewrite StdOrder.IntOrder.expr_gt0.
have H3: 0 < 2 ^ (64 - m) by rewrite StdOrder.IntOrder.expr_gt0.
have H64: 2 ^ m * 2 ^ (64 - m) = 2 ^ 64.
+ by rewrite -exprD_nneg 1,2:/# (_: m + (64 - m) = 64) 1:/#.
have Hs: 2 ^ (64 - m) = 2 ^ (60 - m) * 2 ^ 4.
+ by rewrite -exprD_nneg 1,2:/# (_: 60 - m + 4 = 64 - m) 1:/#.
have Hl := modz_cmp e (2 ^ m) H2.
have Hlt: e %% 2 ^ m * 2 ^ (64 - m) < 2 ^ 64.
+ by rewrite -H64 StdOrder.IntOrder.ltr_pmul2r //; smt().
have Hge: 0 <= e %% 2 ^ m * 2 ^ (64 - m) by smt(StdOrder.IntOrder.mulr_ge0).
rewrite (_: 4 * k = m + 4) 1:/# (_: 64 - (m + 4) = 60 - m) 1:/# mod_pow2_win //.
rewrite (_: (e %% 2 ^ m + e %/ 2 ^ m %% 16 * 2 ^ m) * 2 ^ (60 - m) * 2 ^ 4
          = e %% 2 ^ m * 2 ^ (64 - m) + (e %/ 2 ^ m %% 16) * 2 ^ 64).
+ by rewrite -H64 Hs; ring.
by rewrite (_: W64.modulus = 2 ^ 64) // modzMDr modz_small //; smt().
qed.

lemma win_exp H e k: 0 < k <= 16 => 0 <= e =>
  H * 2 ^ (64 - 4 * (k - 1)) + e %/ 2 ^ (4 * (k - 1))
  = 16 * (H * 2 ^ (64 - 4 * k) + e %/ 2 ^ (4 * k)) + e %/ 2 ^ (4 * (k - 1)) %% 16.
proof.
move=> Hk He; pose m := 4 * (k - 1).
have Hm: 0 <= m by smt().
have H2: 0 < 2 ^ m by rewrite StdOrder.IntOrder.expr_gt0.
have Hs: 2 ^ (64 - m) = 16 * 2 ^ (60 - m).
+ by rewrite (_: 64 - m = 4 + (60 - m)) 1:/# exprD_nneg 1,2:/#.
have Hd: e %/ 2 ^ (m + 4) = e %/ 2 ^ m %/ 16.
+ by rewrite exprD_nneg // divzMr //; smt().
rewrite (_: 4 * k = m + 4) 1:/# (_: 64 - (m + 4) = 60 - m) 1:/# Hs Hd.
by rewrite {1}(divz_eq (e %/ 2 ^ m) 16); ring.
qed.

(* the window and the shift of t, as words *)
lemma win_step (t: W64.t) e k: 0 < k <= 16 => 0 <= e =>
  to_uint t = e %% 2 ^ (4 * k) * 2 ^ (64 - 4 * k) =>
  to_uint (t `>>` W8.of_int 60) = e %/ 2 ^ (4 * (k - 1)) %% 16
  /\ to_uint (t `<<` W8.of_int 4) = e %% 2 ^ (4 * (k - 1)) * 2 ^ (64 - 4 * (k - 1)).
proof.
move=> Hk He Ht; split.
- by rewrite W64.shr_div_le // Ht win_idx.
- by rewrite W64.shl_shlw // W64.to_uint_shl // Ht win_t.
qed.

(* four squarings and the multiplication by the entry of the window *)
lemma mexp_win c x E d: mok c => mdom c x => 0 <= E => 0 <= d =>
  mmul c (mexp c x (2 ^ 4 * E)) (mexp c x d) = mexp c x (16 * E + d).
proof.
by move=> Hc Hx HE Hd; rewrite -mexpD // 1:/# (_: 2 ^ 4 = 16).
qed.

(* s squarings *)
lemma mexp_sqrs c x E s: mok c => mdom c x => 0 <= E => 0 <= s =>
  mmul c (mexp c x (2 ^ s * E)) (mexp c x (2 ^ s * E)) = mexp c x (2 ^ (s + 1) * E).
proof.
move=> Hc Hx HE Hs.
have H2: 0 <= 2 ^ s by apply StdOrder.IntOrder.expr_ge0.
rewrite mexp_sqr //; first by apply StdOrder.IntOrder.mulr_ge0.
by congr; rewrite exprS //; ring.
qed.

(* The scanned prefix of the exponent: H is the value of the limbs above
   the one being scanned, e that limb, with k windows still to scan. *)
op wexp (H e k: int) : int = H * 2 ^ (64 - 4 * k) + e %/ 2 ^ (4 * k).

lemma wexp16 H e: 0 <= e < W64.modulus => wexp H e 16 = H.
proof. by move=> He; rewrite /wexp /= divz_small. qed.


lemma wexp0 H e: wexp H e 0 = e + H * W64.modulus.
proof. by rewrite /wexp /=; ring. qed.

lemma wexp_ge0 H e k: 0 <= H => 0 <= e => 0 <= wexp H e k.
proof.
move=> HH He; rewrite /wexp.
have H1: 0 <= H * 2 ^ (64 - 4 * k).
+ by apply StdOrder.IntOrder.mulr_ge0 => //; apply StdOrder.IntOrder.expr_ge0.
have H2: 0 <= e %/ 2 ^ (4 * k).
+ by apply divz_ge0 => //; apply StdOrder.IntOrder.expr_gt0.
smt().
qed.

lemma wexp_step H e k: 0 < k <= 16 => 0 <= e =>
  wexp H e (k - 1) = 16 * wexp H e k + e %/ 2 ^ (4 * (k - 1)) %% 16.
proof. by move=> Hk He; rewrite /wexp win_exp. qed.

