    (of_0, hi) <- (ADOX_64 hi _zero of_0);
    r.[(W64.to_uint (k + (W64.of_int nlimbs)))] <- hi;
    return r;
  }
  proc _os_muln (r:BN2.t, a:BN.t,
                                b:BN.t) : BN2.t = {
