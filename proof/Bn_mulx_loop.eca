have HY: 0 < 18446744073709551616 ^ (to_uint k{hr} + nlimbs) by apply StdOrder.IntOrder.expr_gt0.
have [Hr0 _] := BN2.bnk_cmp (to_uint k{hr} + nlimbs) r0.
have Htop: to_uint hi0 + b2i cf0 + b2i of0 < 18446744073709551616.
 have E: 18446744073709551616 ^ (to_uint k{hr} + nlimbs + 1)
          = 18446744073709551616 ^ (to_uint k{hr} + nlimbs) * 18446744073709551616
  by rewrite exprSr 1:/#.
 have H: (to_uint hi0 + b2i cf0 + b2i of0) * 18446744073709551616 ^ (to_uint k{hr} + nlimbs)
         < 18446744073709551616 * 18446744073709551616 ^ (to_uint k{hr} + nlimbs)
  by move: Hbnd Hinv Hr0 E; smt().
 by move: H; rewrite StdOrder.IntOrder.ltr_pmul2r.
have [_ E1] := JBigNumber.addc_nc hi0 W64.zero cf0 _.
