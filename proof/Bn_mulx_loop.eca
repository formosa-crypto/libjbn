    r <@ __mul1 (r, ai, b);
    k <- (W64.of_int 1);
    while ((k \ult (W64.of_int nlimbs))) {
      ai <- a.[(W64.to_uint k)];
      r <@ __mul1acc (k, r, ai, b);
      k <- (k + (W64.of_int 1));
    }
    return r;
  }
  proc _os_muln_ (r:BN2.t, a:BN.t,
                                 b:BN.t) : BN2.t = {
    
    r <- r;
    a <- a;
    b <- b;
    r <@ _os_muln (r, a, b);
    r <- r;
    return r;
  }
  proc _os_sqrn (r:BN2.t, a:BN.t) : 
  BN2.t = {
    var ai:W64.t;
    var k:W64.t;
    ai <- a.[0];
