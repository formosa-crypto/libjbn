move=> cf0 hi0 i0 of0 r0 H1 H2 H3 Hfr Hinv; have Ei: i0 = nlimbs by smt().
move: Hinv; rewrite Ei => Hinv.
have ->: to_uint (k{hr} + W64.of_int nlimbs) = to_uint k{hr} + nlimbs
