 **                     LOSSLESSNESS                                         **
 ******************************************************************************)

lemma __mul1_ll: islossless M.__mul1.
proof. by proc; wp; while (true) (nlimbs - i); auto => /#. qed.

lemma __mul1acc_ll: islossless M.__mul1acc.
proof. by proc; wp; while (true) (nlimbs - i); auto => /#. qed.

lemma _os_muln_ll: islossless M._os_muln.
proof.
proc; while (true) (nlimbs - to_uint k).
 move=> z; wp; call __mul1acc_ll; auto => &hr; rewrite ult_nlimbs => -[H <-].
 by rewrite to_uint_k1 //; smt().
by wp; call __mul1_ll; auto => /> k; rewrite ult_nlimbs /#.
qed.

lemma _os_muln__ll: islossless M._os_muln_.
proof. by proc; wp; call _os_muln_ll; auto. qed.

lemma _os_sqrn_ll: islossless M._os_sqrn.
proof.
proc; while (true) (nlimbs - to_uint k).
 move=> z; wp; call __mul1acc_ll; auto => &hr; rewrite ult_nlimbs => -[H <-].
 by rewrite to_uint_k1 //; smt().
by wp; call __mul1_ll; auto => /> k; rewrite ult_nlimbs /#.
qed.

lemma _os_sqrn__ll: islossless M._os_sqrn_.
proof. by proc; wp; call _os_sqrn_ll; auto. qed.

lemma __mont_redM_ll: islossless M.__mont_redM.
proof.
proc; call BNB._cminusP__ll; wp.
while (true) (nlimbs - to_uint k).
 move=> z; wp; while (true) (nlimbs - i).
  by move=> z'; auto => /#.
 auto => &hr; rewrite ult_nlimbs => -[H <-] i.
 by rewrite to_uint_k1 //; smt().
wp; while (true) (nlimbs - i).
 by move=> z; auto => /#.
by auto => /> i; split; [smt() | move=> _ k; rewrite ult_nlimbs /#].
qed.


(******************************************************************************
 **                     CORRECTNESS                                          **
 ******************************************************************************)

(* first row: r[0..nlimbs] = a * b; the carry chain is CF, and the pending
   value of the next word is hi + cf *)
hoare __mul1_h _a _b:
 M.__mul1 : a=_a /\ b=_b ==> BN2.bnk (nlimbs+1) res = to_uint _a * bn _b.
proof.
proc.
wp; while (a=_a /\ b=_b /\ 1 <= i <= nlimbs /\ to_uint hi <= 18446744073709551616 - 2
           /\ BN2.bnk i r + (to_uint hi + b2i cf) * 18446744073709551616 ^ i
              = to_uint _a * bnk i _b).
 wp; skip => /> &hr Hi1 _ Hh Hinv Hi2.
 rewrite /ADCX_64 /MULX_64 /=.
 split; first smt().
 split; first exact JBigNumber.mulu_hi_bnd.
 rewrite BN2.bnk_put 1:/# bnkS 1:/# /=.
 have A := JBigNumber.addc_to_uint hi{hr} (mulu _a _b.[i{hr}]).`2 cf{hr}.
 have M := JBigNumber.mulu_to_uint _a _b.[i{hr}].
 have ->: to_uint (addc hi{hr} (mulu _a _b.[i{hr}]).`2 cf{hr}).`2
          + 18446744073709551616 * (to_uint (mulu _a _b.[i{hr}]).`1
                                    + b2i (addc_carry hi{hr} (mulu _a _b.[i{hr}]).`2 cf{hr}))
          = to_uint hi{hr} + b2i cf{hr} + to_uint _a * to_uint _b.[i{hr}]
  by move: A M; rewrite (_: W64.modulus = 18446744073709551616) //; smt().
 have ->: BN2.bnk i{hr} r{hr}
          = to_uint _a * bnk i{hr} _b - (to_uint hi{hr} + b2i cf{hr}) * 18446744073709551616 ^ i{hr}
  by rewrite -Hinv; ring.
 by ring.
wp; skip => &hr />.
rewrite /ADCX_64 /MULX_64 /set0_64_ /=.
split.
 split; first smt(gt0_nlimbs).
 split; first exact JBigNumber.mulu_hi_bnd.
 rewrite BN2.bnk1 bnk1 /= BN2.A.get_setE; first smt(gt0_nlimbs).
 have := JBigNumber.mulu_to_uint a{hr} b{hr}.[0].
 by rewrite (_: W64.modulus = 18446744073709551616) //=; smt().
move=> cf0 hi0 i0 r0 H1 H2 H3 Hh Hinv; have Ei: i0 = nlimbs by smt().
move: Hinv; rewrite Ei => Hinv.
have [_ E] := JBigNumber.addc_nc hi0 W64.zero cf0 _.
 by rewrite W64.to_uint0; move: Hh; case: cf0 => /= /#.
rewrite BN2.bnkS 1:/# /= BN2.A.get_setE 1:/# /= BN2.bnk_setO 1:/# E W64.to_uint0.
by move: Hinv; smt().
qed.

(* row k: r[k..k+nlimbs] += a * b (r[k+nlimbs] is not read). The carries
   of the two chains (CF: high words, OF: low words) and the last high word
   are pending into the next word; the bound keeps the top word from
   overflowing *)
hoare __mul1acc_h _k _r _a _b:
 M.__mul1acc : k=_k /\ r=_r /\ a=_a /\ b=_b /\ to_uint _k < nlimbs
   /\ BN2.bnk (to_uint _k + nlimbs) _r
      + 18446744073709551616 ^ to_uint _k * (to_uint _a * bn _b)
      < 18446744073709551616 ^ (to_uint _k + nlimbs + 1)
 ==> BN2.bnk (to_uint _k + nlimbs + 1) res
     = BN2.bnk (to_uint _k + nlimbs) _r
       + 18446744073709551616 ^ to_uint _k * (to_uint _a * bn _b).
proof.
proc.
wp; while (k=_k /\ a=_a /\ b=_b /\ 1 <= i <= nlimbs /\ to_uint _k < nlimbs
           /\ BN2.bnk (to_uint _k + nlimbs) _r
               + 18446744073709551616 ^ to_uint _k * (to_uint _a * bn _b)
              < 18446744073709551616 ^ (to_uint _k + nlimbs + 1)
           /\ (forall j, to_uint _k + i <= j < 2*nlimbs => r.[j] = _r.[j])
           /\ BN2.bnk (to_uint _k + i) r
               + (to_uint hi + b2i cf + b2i of_0) * 18446744073709551616 ^ (to_uint _k + i)
              = BN2.bnk (to_uint _k + i) _r
                + 18446744073709551616 ^ to_uint _k * (to_uint _a * bnk i _b)).
 wp; skip => /> &hr Hi1 _ Hk Hbnd Hfr Hinv Hi2.
 have [Hk0 _] := W64.to_uint_cmp _k.
 have ->: to_uint (_k + W64.of_int i{hr}) = to_uint _k + i{hr}
  by rewrite JBigNumber.to_uint_kD //; move: Hk Hi1 Hi2 nlimbs_bndN; smt().
 rewrite /ADCX_64 /ADOX_64 /MULX_64 /=.
 split; first smt().
 split.
  by move=> j Hj1 Hj2; rewrite BN2.A.get_setE 1:/# (_: j <> to_uint _k + i{hr}) 1:/# /= Hfr /#.
 rewrite (_: to_uint _k + (i{hr} + 1) = to_uint _k + i{hr} + 1) 1:/#.
 rewrite BN2.bnk_put 1:/# Hfr 1:/# BN2.bnkS 1:/# bnkS 1:/# /=.
 pose t1 := addc _r.[to_uint _k + i{hr}] hi{hr} cf{hr}.
 pose t2 := addc t1.`2 (mulu _a _b.[i{hr}]).`2 of_0{hr}.
 have A1 := JBigNumber.addc_to_uint _r.[to_uint _k + i{hr}] hi{hr} cf{hr}.
 have A2 := JBigNumber.addc_to_uint t1.`2 (mulu _a _b.[i{hr}]).`2 of_0{hr}.
 have M := JBigNumber.mulu_to_uint _a _b.[i{hr}].
 have ->: to_uint t2.`2 + 18446744073709551616
            * (to_uint (mulu _a _b.[i{hr}]).`1 + b2i t1.`1 + b2i t2.`1)
          = to_uint _r.[to_uint _k + i{hr}] + to_uint hi{hr} + b2i cf{hr} + b2i of_0{hr}
            + to_uint _a * to_uint _b.[i{hr}]
  by move: A1 A2 M; rewrite -/t1 -/t2 (_: W64.modulus = 18446744073709551616) //; smt().
 have ->: BN2.bnk (to_uint _k + i{hr}) r{hr}
          = BN2.bnk (to_uint _k + i{hr}) _r
            + 18446744073709551616 ^ to_uint _k * (to_uint _a * bnk i{hr} _b)
            - (to_uint hi{hr} + b2i cf{hr} + b2i of_0{hr})
              * 18446744073709551616 ^ (to_uint _k + i{hr})
  by rewrite -Hinv; ring.
 by rewrite exprD_nneg 1,2:/#; ring.
wp; skip => &hr />.
have [Hk0 Hk1] := W64.to_uint_cmp k{hr}.
move=> Hk Hbnd; rewrite /ADCX_64 /ADOX_64 /MULX_64 /set0_64_ /=.
split.
 split; first smt(gt0_nlimbs).
 split.
  by move=> j Hj1 Hj2; rewrite BN2.A.get_setE 1:/# (_: j <> to_uint k{hr}) 1:/#.
 rewrite BN2.bnk_put 1:/# BN2.bnkS 1:/# bnk1 /=.
 have A := JBigNumber.addc_to_uint r{hr}.[to_uint k{hr}] (mulu a{hr} b{hr}.[0]).`2 false.
 have M := JBigNumber.mulu_to_uint a{hr} b{hr}.[0].
 move: A M; rewrite (_: W64.modulus = 18446744073709551616) // /=.
 move=> A M.
 have ->: to_uint (addc r{hr}.[to_uint k{hr}] (mulu a{hr} b{hr}.[0]).`2 false).`2
          + 18446744073709551616
            * (to_uint (mulu a{hr} b{hr}.[0]).`1 + b2i false
