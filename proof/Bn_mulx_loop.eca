    var  _1:bool;
    var  _2:bool;
    var  _3:bool;
    ( _0, cf,  _1,  _2,  _3, _zero) <- (set0_64);
    (hi, lo) <- (MULX_64 a b.[0]);
    r.[0] <- lo;
    i <- 1;
    while ((i < nlimbs)) {
      t <- hi;
      (hi, lo) <- (MULX_64 a b.[i]);
      (cf, t) <- (ADCX_64 t lo cf);
      r.[i] <- t;
      i <- (i + 1);
    }
    (cf, hi) <- (ADCX_64 hi _zero cf);
    r.[nlimbs] <- hi;
    return r;
  }
  proc __mul1acc (k:W64.t, r:BN2.t, a:W64.t,
                                 b:BN.t) : BN2.t = {
    var of_0:bool;
    var cf:bool;
    var _zero:W64.t;
    var hi:W64.t;
    var lo:W64.t;
    var t:W64.t;
    var i:int;
    var  _0:bool;
    var  _1:bool;
    var  _2:bool;
    (of_0, cf,  _0,  _1,  _2, _zero) <- (set0_64);
    (hi, lo) <- (MULX_64 a b.[0]);
    t <- r.[(W64.to_uint k)];
    (of_0, t) <- (ADOX_64 t lo of_0);
    r.[(W64.to_uint k)] <- t;
