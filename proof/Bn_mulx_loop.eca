require JBigNumber.

(* Correctness contracts for bn_mulx_loop@n.jinc: operand-scanning multiplication and squaring, and Montgomery
   reduction, with a run-time loop over MULX/ADCX/ADOX rows.

   The statements are those of Bn_mul, so that the four modules selected
   by bn_mulsel have one contract. *)

(* Parameters *)
op nlimbs: int.
axiom gt0_nlimbs: 0 < nlimbs.
(* the row index is a word, and k + nlimbs (< 2*nlimbs) must not wrap
   (the bound of Bn_mul) *)
axiom nlimbs_bnd: 4 * nlimbs < W64.modulus.
lemma nlimbs_bndN: 4 * nlimbs < 18446744073709551616 by have := nlimbs_bnd.

clone export JBigNumber.BigN
 with op nlimbs <- nlimbs
      proof gt0_nlimbs by exact gt0_nlimbs.

import BN2.
import BN.

require Bn_util.
clone Bn_util as BNUTIL.
module BNUTIL_M = BNUTIL.M.

require Bn_base.
clone Bn_base as BNB
 with op nlimbs <- nlimbs,
      theory BigN <- BigN,
      theory BNUTIL <- BNUTIL
      proof gt0_nlimbs by exact gt0_nlimbs.
module BNB_M = BNB.M.

(* module M: the extracted code of bn_mulx_loop@n.jinc (see proof/Makefile) *)
