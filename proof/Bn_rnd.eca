(******************************************************************************
 **                the system call and the extracted module                   **
 ******************************************************************************)

import BigN.BN_Abytes BigN.BN_WAbytes.

(* the system call of the extraction (#randombytes), at the size of the
   theory: random words, drawn as random bytes, as in the extraction *)
module type Syscall_t = {
  proc randombytes_W64 (_: BN.t) : BN.t
}.

module Syscall : Syscall_t = {
  proc randombytes_W64 (a: BN.t) : BN.t = {
    a <$ dmap BN_WAbytes.darray (fun a => A.init (fun i => BN_WAbytes.get64 a i));
    return a;
  }
}.

(* BEGIN generated by scripts/xtr_sync.py from src/amd64/ref/extracted/BNRND_bn_rnd.ec
   (bn_rnd@n.jinc); do not edit: run `make -C proof update` *)
module M(SC: Syscall_t) = {
  proc _rnd_ (a:BN.t) : BN.t = {
    
    a <- a;
    a <@ SC.randombytes_W64 (a);
    a <- a;
    return a;
  }
  proc __bnd_mask (mask:BN.t, bnd:BN.t) : 
  BN.t = {
    var inc:int;
    var hi:W64.t;
    var i:int;
    var w:W64.t;
    var t:W64.t;
    hi <- (W64.of_int 0);
    inc <- (- 1);
    i <- (nlimbs - 1);
    while ((inc < i)) {
      w <- bnd.[i];
      t <- w;
      t <- (t `>>` (W8.of_int 1));
      w <- (w `|` t);
      t <- w;
      t <- (t `>>` (W8.of_int 2));
      w <- (w `|` t);
      t <- w;
      t <- (t `>>` (W8.of_int 4));
      w <- (w `|` t);
      t <- w;
      t <- (t `>>` (W8.of_int 8));
      w <- (w `|` t);
      t <- w;
      t <- (t `>>` (W8.of_int 16));
      w <- (w `|` t);
      t <- w;
      t <- (t `>>` (W8.of_int 32));
      w <- (w `|` t);
      w <- (w `|` hi);
      mask.[i] <- w;
      t <- w;
      t <- (- t);
      t <- (t `|` w);
      t <- (t `|>>` (W8.of_int 63));
      hi <- (hi `|` t);
      i <- (i - 1);
    }
    return mask;
  }
  proc _rsample_ (a:BN.t, bnd:BN.t) : BN.t = {
    var _mask:BN.t;
    var mask:BN.t;
    var cf:bool;
    var i:int;
    var t:W64.t;
    _mask <- witness;
    mask <- witness;
    mask <- _mask;
    mask <@ __bnd_mask (mask, bnd);
    _mask <- mask;
    a <@ _rnd_ (a);
    i <- 0;
    while ((i < nlimbs)) {
      t <- _mask.[i];
      a.[i] <- (a.[i] `&` t);
      i <- (i + 1);
    }
    cf <@ BNB_M._lt_cf_ (a, bnd);
    while ((! cf)) {
      a <@ _rnd_ (a);
      i <- 0;
      while ((i < nlimbs)) {
        t <- _mask.[i];
        a.[i] <- (a.[i] `&` t);
        i <- (i + 1);
      }
      cf <@ BNB_M._lt_cf_ (a, bnd);
    }
    return a;
  }
}.
(* END generated *)

(* idealised versions of _rnd_ and _rsample_ *)
module Spec = {
  proc rndspec (a:BN.t) : BN.t = {
    a <$ BN.bn_rnd;
    return a;
  }

  proc rsamplespec (a:BN.t, bnd: BN.t) : BN.t = {
    var i;
    i <$ [0..bn bnd - 1];
    a <- bn_ofint i;
    return a;
  }

  (* rejection sampling, without the mask of _rsample_ *)
  proc rsampleaux (a:BN.t, bnd:BN.t) : BN.t = {
    var cf:bool;
    a <@ rndspec (a);
    cf <@ BNB_M._lt_cf_ (a, bnd);
    while ((! cf)) {
      a <@ rndspec (a);
      cf <@ BNB_M._lt_cf_ (a, bnd);
    }
    return (a);
  }
}.

(******************************************************************************
 **               Library LEMMAS                                             **
 **                                                                          **
 ******************************************************************************)

lemma _rnd__ll: islossless M(Syscall)._rnd_.
proof.
proc; inline *; auto => />.
apply dmap_ll; rewrite /BN_WAbytes.darray; apply dmap_ll; apply dlist_ll.
exact W8.dword_ll.
qed.

(* the words of an array of bytes, and back *)
lemma get64_w64A (x: BN.t): A.init (fun i => BN_WAbytes.get64 (w64A_bytes x) i) = x.
proof.
apply A.ext_eq => i Hi.
rewrite A.initiE //= /w64A_bytes get64E -(W8u8.unpack8K x.[i]); congr.
apply W8u8.Pack.ext_eq => j Hj.
rewrite W8u8.Pack.initiE //= /init64 BN_WAbytes.initiE 1:/# /= W8u8.unpack8E W8u8.Pack.initiE //=.
by rewrite (_: (8 * i + j) %/ 8 = i) 1:/# (_: (8 * i + j) %% 8 = j) 1:/#.
qed.

lemma w64A_get64 (b: BN_WAbytes.t): w64A_bytes (A.init (fun i => BN_WAbytes.get64 b i)) = b.
proof.
apply BN_WAbytes.ext_eq => k Hk.
rewrite /w64A_bytes /init64 BN_WAbytes.initiE //= A.initiE 1:/# /= get64E pack8bE 1:/# /=.
by rewrite W8u8.Pack.initiE 1:/# /= (_: 8 * (k %/ 8) + k %% 8 = k) 1:/#.
qed.

(* -------------------------------------------------------------------- *)
(* the mask of _rsample_ (__bnd_mask): words                            *)

(* one shift-or step, and the six of __bnd_mask: the bits of w smeared
   towards the least significant *)
op smear1 (w: W64.t) (n: int) : W64.t = w `|` (w `>>` W8.of_int n).
op smear (w: W64.t) : W64.t =
  smear1 (smear1 (smear1 (smear1 (smear1 (smear1 w 1) 2) 4) 8) 16) 32.

lemma smear1_bit y n k: 0 <= n < 64 => 0 <= k < 64 =>
  (smear1 y n).[k] = (y.[k] \/ y.[k + n]).
proof. by move=> Hn Hk; rewrite /smear1 W64.orwE W64.shr_shrw // W64.shrwE Hk. qed.

(* after the steps of shifts below n, bit k is set iff a bit of w from k
   to k + n - 1 is *)
pred smeared (n: int) (y w: W64.t) =
  forall k, 0 <= k < 64 => (y.[k] <=> exists d, 0 <= d < n /\ w.[k + d]).

lemma smeared_step n m y w: 0 < n < 64 => m = 2 * n =>
  smeared n y w => smeared m (smear1 y n) w.
proof.
move=> Hn -> HQ k Hk; rewrite smear1_bit 1,2:/# (HQ k Hk).
case: (k + n < 64) => Hkn.
- rewrite (HQ (k + n)) 1:/#; split.
  + case=> [[d [Hd Hw]] | [d [Hd Hw]]].
    * by exists d; smt().
    * by exists (n + d); split; [smt() | rewrite addzA].
  + move=> [d [Hd Hw]]; case: (d < n) => Hdn.
    * by left; exists d; smt().
    * by right; exists (d - n); split; [smt() | rewrite (_: k + n + (d - n) = k + d) 1:/#].
- rewrite (W64.get_out y (k + n)) 1:/# /=; split.
  + by move=> [d [Hd Hw]]; exists d; smt().
  + move=> [d [Hd Hw]]; exists d; split => //.
    have: k + d < 64 by move: Hw; apply contraLR => H; rewrite W64.get_out /#.
    smt().
qed.

lemma smear_bit w k: 0 <= k < 64 =>
  (smear w).[k] = (exists j, k <= j < 64 /\ w.[j]).
proof.
move=> Hk.
have Q1: smeared 1 w w.
- move=> i Hi; split => [H | [d [Hd Hw]]]; first by exists 0.
  by rewrite (_: d = 0) 1:/# in Hw.
have Q2 := smeared_step 1 2 w w _ _ Q1 => //.
have Q4 := smeared_step 2 4 _ w _ _ Q2 => //.
have Q8 := smeared_step 4 8 _ w _ _ Q4 => //.
have Q16 := smeared_step 8 16 _ w _ _ Q8 => //.
have Q32 := smeared_step 16 32 _ w _ _ Q16 => //.
have Q64 := smeared_step 32 64 _ w _ _ Q32 => //.
rewrite /smear (eq_iff _ _) (Q64 k Hk); split.
- move=> [d [Hd Hw]]; exists (k + d); split => //.
  by move: Hw; apply contraLR => H; rewrite W64.get_out /#.
- by move=> [j [Hj Hw]]; exists (j - k); split; [smt() | rewrite (_: k + (j - k) = j) 1:/#].
qed.

lemma smear0 w: (smear w = W64.zero) <=> (w = W64.zero).
proof.
split => [H | ->].
- apply W64.wordP => i Hi; rewrite W64.zerowE.
  have Hno: !(exists j, 0 <= j < 64 /\ w.[j]).
  + have := smear_bit w 0 _ => //.
    by rewrite H W64.zerowE => <-.
  by apply contraT => Hw; apply Hno; exists i; smt().
- by apply W64.wordP => i Hi; rewrite W64.zerowE smear_bit.
qed.

(* a word not above w is covered by its smearing *)
lemma smear_le x w: to_uint x <= to_uint w => x `&` smear w = x.
proof.
move=> Hle; apply W64.wordP => k Hk; rewrite W64.andwE smear_bit //.
case: (x.[k]) => //= Hxk.
apply contraT => Hno.
have Hw: to_uint w < 2 ^ k.
- have ->: w = w `&` W64.masklsb k.
  + apply W64.wordP => j Hj; rewrite W64.andwE W64.masklsbE.
    case: (j < k) => Hjk; first smt().
    case: (w.[j]) => //= Hwj.
    have: exists j', k <= j' < 64 /\ w.[j'] by exists j; smt().
    smt().
  rewrite (_: max 0 k = k) 1:/# W64.to_uint_and_mod 1:/#.
  by apply ltz_pmod; apply StdOrder.IntOrder.expr_gt0.
have Hx: 2 ^ k <= to_uint x.
- move: Hxk; rewrite W64.get_to_uint => -[_ H].
  have [H0 _] := W64.to_uint_cmp x.
  apply contraT => Hlt; apply H.
  by rewrite divz_small 1:/#.
smt().
qed.

(* t = w; t = -t; t |= w; t >>s= 63: all ones iff w is not zero *)
op nzmask (w: W64.t) : W64.t = ((- w) `|` w) `|>>` W8.of_int 63.

lemma nzmaskE w: nzmask w = if w = W64.zero then W64.zero else W64.onew.
proof.
apply W64.wordP => k Hk.
rewrite /nzmask /(`|>>`) W8.of_uintK /= W64.sarE W64.initiE //=.
rewrite (_: min 63 (k + 63) = 63) 1:/#.
case: (w = W64.zero) => [-> | Hw].
- rewrite /= !W64.get_to_uint /= W64.to_uintN.
  by rewrite (_: to_uint W64.zero = 0) 1:W64.to_uint0.
rewrite W64.onewE Hk /= !W64.get_to_uint /= W64.to_uintNE.
have [H0 H1] := W64.to_uint_cmp w.
have Hw0: to_uint w <> 0.
- by move: Hw; apply contra => H; apply W64.to_uint_eq; rewrite H.
have HM: W64.modulus = 18446744073709551616 by done.
move: H1; rewrite HM => H1.
case: (to_uint w < 9223372036854775808) => Hlt.
- have E: (18446744073709551616 - to_uint w) %% 18446744073709551616
         = 18446744073709551616 - to_uint w.
  + by apply IntDiv.modz_small; apply JUtils.bound_abs; smt().
  rewrite E.
  have ->: (18446744073709551616 - to_uint w) %/ 9223372036854775808 = 1.
  + smt(divz_eq modz_ge0 ltz_pmod).
  done.
- have ->: to_uint w %/ 9223372036854775808 = 1 by smt(divz_eq modz_ge0 ltz_pmod).
  done.
qed.

(* REJECTION SAMPLING *)
phoare rndspec_ph _res:
 [ Spec.rndspec :
   true ==> res = _res ] = (mu1 bn_rnd _res).
proof. by proc; rnd; skip => />. qed.

phoare bn_rsamplespec_ph _bnd _res:
 [ Spec.rsamplespec :
   bnd=_bnd ==> res = _res ] = (mu1 (bn_rnd_bnd bnd) _res).
proof. 
proc; wp; rnd; skip => />. 
by rewrite dmap1E /pred1 /(\o) /=.
qed.

equiv rndspec_eq:
 M(Syscall)._rnd_ ~ Spec.rndspec:
 true ==> ={res}.
proof.
proc; inline *; wp.
rnd; auto => />.
split.
- move=> a _.
  rewrite bn_rnd1E dmap1E /pred1 /(\o) /=.
  rewrite (mu_eq _ _ (pred1 (w64A_bytes a))).
  + move=> b; rewrite /pred1 eq_iff; split.
    - by move=> <-; rewrite w64A_get64.
    - by move=> ->; rewrite get64_w64A.
  rewrite WAbytes_darray1E; congr; congr.
  by rewrite bn_modulusE -!exprM /#.
by move=> _ a _; apply bn_rnd_fu.
qed.

phoare bn_rnd_ph _res:
 [ M(Syscall)._rnd_ :
   true ==> res = _res ] = (mu1 bn_rnd _res).
proof.
by conseq rndspec_eq (rndspec_ph _res) => /#.
qed.

require import DInterval Dexcepted.

(* the random words of the system call are uniform *)
lemma syscall_rndE:
  dmap BN_WAbytes.darray (fun a => A.init (fun i => BN_WAbytes.get64 a i)) = bn_rnd.
proof.
apply eq_distr => a.
rewrite bn_rnd1E dmap1E /pred1 /(\o) /=.
rewrite (mu_eq _ _ (pred1 (w64A_bytes a))).
+ move=> b; rewrite /pred1 eq_iff; split.
  - by move=> <-; rewrite w64A_get64.
  - by move=> ->; rewrite get64_w64A.
rewrite WAbytes_darray1E; congr; congr.
by rewrite bn_modulusE -!exprM /#.
qed.

(* -------------------------------------------------------------------- *)
(* the mask of _rsample_ (__bnd_mask): big numbers                      *)

(* limb-wise and, xor *)
op bn_and (a m: BN.t) : BN.t = A.init (fun i => a.[i] `&` m.[i]).
op bn_xor (a b: BN.t) : BN.t = A.init (fun i => a.[i] +^ b.[i]).

(* m covers the numbers below b *)
pred covers (m b: BN.t) = forall x, bn x < bn b => bn_and x m = x.

(* the part of the mask from the limbs above i: all ones iff one of them
   is not zero *)
op hi_of (b: BN.t) (i: int) : W64.t =
  if exists j, i < j < nlimbs /\ b.[j] <> W64.zero then W64.onew else W64.zero.

hoare bnd_mask_h _b:
 M(Syscall).__bnd_mask : bnd = _b
   ==> forall j, 0 <= j < nlimbs => res.[j] = smear _b.[j] `|` hi_of _b j.
proof.
proc.
while (bnd = _b /\ inc = -1 /\ -1 <= i < nlimbs /\ hi = hi_of _b i /\
       forall j, i < j < nlimbs => mask.[j] = smear _b.[j] `|` hi_of _b j).
- seq 19 : (bnd = _b /\ inc = -1 /\ -1 <= i < nlimbs /\ inc < i /\ hi = hi_of _b i /\
            (forall j, i < j < nlimbs => mask.[j] = smear _b.[j] `|` hi_of _b j) /\
            w = smear bnd.[i]).
  + by wp; skip => /> &hr *; rewrite /smear /smear1.
  wp; skip => /> &hr Hi0 Hi1 Hmask Hlt.
  split; first smt().
  split.
  + rewrite /hi_of; case: (exists j, i{hr} < j < nlimbs /\ _b.[j] <> W64.zero) => HE /=.
    * by rewrite ifT //; case: HE => j Hj; exists j; smt().
    rewrite -/(nzmask (smear _b.[i{hr}])) nzmaskE smear0.
    case: (_b.[i{hr}] = W64.zero) => Hbi.
    * by rewrite ifF //; apply/negP => -[j Hj]; apply HE; exists j; smt().
    * by rewrite ifT //; exists i{hr}; smt().
  move=> j Hj1 Hj2; rewrite A.get_setE 1:/#.
  by case: (j = i{hr}) => [-> | Hji] /=; [done | apply Hlt; smt()].
wp; skip => /> &hr; split.
- split; first smt(gt0_nlimbs).
  split; first by rewrite /hi_of ifF //; smt().
  smt().
by move=> i mask Hi0 Hi1 Hi2 Hm j Hj0 Hj1; apply Hm; smt().
qed.

(* the mask covers the numbers below the bound *)
lemma mask_covers (b m: BN.t):
  (forall j, 0 <= j < nlimbs => m.[j] = smear b.[j] `|` hi_of b j) => covers m b.
proof.
move=> Hm x Hx; apply A.ext_eq => j Hj.
rewrite /bn_and A.initiE //= Hm // /hi_of.
case: (exists j', j < j' < nlimbs /\ b.[j'] <> W64.zero) => HE /=.
- done.
apply smear_le.
have Hz: forall j', j < j' < nlimbs => b.[j'] = W64.zero.
- by move=> j' Hj'; apply contraT => H; apply HE; exists j'.
have Eb: bn b = bnk (j + 1) b.
- rewrite (bn_k_kup (j + 1) b) 1:/#.
  have ->: bnkup (j + 1) b = 0.
  + rewrite /bnkup StdBigop.Bigint.BIA.big1_seq //= => i; rewrite mem_range => -[Hi0 Hi].
    by rewrite Hz 1:/# (_: to_uint W64.zero = 0) 1:W64.to_uint0.
  done.
have Ex: bnk (j + 1) x <= bn x.
- rewrite (bn_k_kup (j + 1) x) 1:/#.
  have H1: 0 <= bnkup (j + 1) x.
  + rewrite /bnkup; apply StdBigop.Bigint.sumr_ge0 => i _ /=.
    apply StdOrder.IntOrder.mulr_ge0; first smt(W64.to_uint_cmp).
    by apply StdOrder.IntOrder.expr_ge0.
  have H2: 0 <= W64.modulus ^ (j + 1) by apply StdOrder.IntOrder.expr_ge0.
  have := StdOrder.IntOrder.mulr_ge0 _ _ H1 H2.
  smt().
move: Eb Ex; rewrite !bnkS 1,2:/# /dig => Eb Ex.
have [_ Hbj] := bnk_cmp j b.
have [Hxj _] := bnk_cmp j x.
have HR: 0 < W64.modulus ^ j by apply StdOrder.IntOrder.expr_gt0.
have H: to_uint x.[j] * W64.modulus ^ j < (to_uint b.[j] + 1) * W64.modulus ^ j.
- move: Eb Ex Hbj Hx Hxj.
  pose P := W64.modulus ^ j.
  rewrite mulzDl mul1z.
  pose X := to_uint x.[j] * P; pose B := to_uint b.[j] * P.
  smt().
have := StdOrder.IntOrder.ltr_pmul2r _ HR (to_uint x.[j]) (to_uint b.[j] + 1).
smt().
qed.

(* the samples of _rsample_ before the test: uniform numbers, masked *)
op dmask (m: BN.t) : BN.t distr = dmap bn_rnd (fun a => bn_and a m).

lemma dmask_ll m: is_lossless (dmask m).
proof. by apply dmap_ll; apply bn_rnd_ll. qed.

lemma bn_andK a m: bn_and (bn_and a m) m = bn_and a m.
proof.
apply A.ext_eq => i Hi; rewrite /bn_and A.initiE //= A.initiE //=.
by rewrite -W64.andwA W64.andwK.
qed.

lemma supp_dmask m x: x \in dmask m <=> bn_and x m = x.
proof.
rewrite /dmask supp_dmap; split.
- by move=> [a [_ ->]]; rewrite bn_andK.
- by move=> Hx; exists x; split; [apply bn_rnd_fu | rewrite /= Hx].
qed.

lemma bn_xorC a b: bn_xor a b = bn_xor b a.
proof. by apply A.ext_eq => i Hi; rewrite /bn_xor !A.initiE //= W64.xorwC. qed.

lemma bn_xorK a b: bn_xor (bn_xor a b) b = a.
proof.
apply A.ext_eq => i Hi; rewrite /bn_xor A.initiE //= A.initiE //=.
by rewrite -W64.xorwA W64.xorwK W64.xorw0.
qed.

lemma bn_xorKl a b: bn_xor a (bn_xor a b) = b.
proof. by rewrite bn_xorC (bn_xorC a b) bn_xorK. qed.

lemma bn_rnd_funi: is_funiform bn_rnd.
proof. by apply is_full_funiform; [apply bn_rnd_fu | apply bn_rnd_uni]. qed.

(* xoring a constant leaves the uniform distribution unchanged *)
lemma dmap_bn_xor b: dmap bn_rnd (fun a => bn_xor a b) = bn_rnd.
proof.
apply eq_funi_ll.
- apply dmap_funi; last exact bn_rnd_funi.
  by exists (fun a => bn_xor a b); split => a /=; apply bn_xorK.
- by apply dmap_ll; apply bn_rnd_ll.
- exact bn_rnd_funi.
- exact bn_rnd_ll.
qed.

(* the masked samples are uniform (over the numbers the mask covers) *)
lemma dmask_uni m: is_uniform (dmask m).
proof.
move=> x y; rewrite !supp_dmask => Hx Hy.
rewrite /dmask !dmap1E -{1}(dmap_bn_xor (bn_xor x y)) dmapE.
apply mu_eq => a; rewrite /pred1 /(\o) /=.
have ->: bn_and (bn_xor a (bn_xor x y)) m = bn_xor (bn_and a m) (bn_xor x y).
- apply A.ext_eq => i Hi.
  have Hxi: x.[i] `&` m.[i] = x.[i].
  + by have := congr1 (fun z: BN.t => z.[i]) _ _ Hx; rewrite /= /bn_and A.initiE.
  have Hyi: y.[i] `&` m.[i] = y.[i].
  + by have := congr1 (fun z: BN.t => z.[i]) _ _ Hy; rewrite /= /bn_and A.initiE.
  rewrite /bn_and /bn_xor; do (rewrite A.initiE //=).
  by rewrite W64.andwDl W64.andwDl Hxi Hyi.
apply eq_iff; split => [H | ->].
- by rewrite -(bn_xorK (bn_and a m) (bn_xor x y)) H bn_xorKl.
- by rewrite (bn_xorC x y) bn_xorKl.
qed.

lemma bn_lt_modulus x: bn x < bn_modulus.
proof. by rewrite bn_modulusE; have [_ ->] := bnk_cmp nlimbs x. qed.

lemma bn_ofint_small i: 0 <= i < bn_modulus => bn (bn_ofint i) = i.
proof. by move=> Hi; rewrite bn_ofintK modz_small //; apply JUtils.bound_abs. qed.

(* rejection sampling from the masked samples: uniform below the bound *)
lemma dmask_excepted m b: covers m b =>
  dmask m \ (fun x => ! bn x < bn b) = bn_rnd_bnd b.
proof.
move=> Hc.
case: (bn b = 0) => Hb0.
- apply eq_distr => x.
  rewrite dexcepted1E_in /=; first smt(bnk_cmp).
  rewrite /bn_rnd_bnd dmap1E eq_sym; apply mu0_false => i.
  by rewrite supp_dinter Hb0 /#.
have [_ HbR] := bnk_cmp nlimbs b.
have Hb: 0 < bn b by smt(bnk_cmp).
pose x0 := bn_ofint 0.
have Hx0: bn x0 = 0 by rewrite /x0 bn_ofintK mod0z.
have L1: is_lossless (dmask m \ (fun x => ! bn x < bn b)).
- apply dexcepted_ll; first exact dmask_ll.
  have Hs: x0 \in dmask m by rewrite supp_dmask Hc // Hx0.
  have Hle: mu1 (dmask m) x0 <= mu (dmask m) (predC (fun x => ! bn x < bn b)).
  + by apply mu_le => x _ @/pred1 @/predC ->; rewrite Hx0.
  have := mu_not (dmask m) (fun x => ! bn x < bn b); rewrite dmask_ll.
  smt().
have U1: is_uniform (dmask m \ (fun x => ! bn x < bn b)).
- by apply dexcepted_uni; apply dmask_uni.
have L2: is_lossless (bn_rnd_bnd b).
- by rewrite /bn_rnd_bnd; apply dmap_ll; apply dinter_ll; smt().
have U2: is_uniform (bn_rnd_bnd b).
- rewrite /bn_rnd_bnd; apply dmap_uni_in_inj; last exact dinter_uni.
  move=> i j; rewrite !supp_dinter => Hi Hj Hij.
  have Hb' := bn_lt_modulus b.
  by rewrite -(bn_ofint_small i) 1:/# -(bn_ofint_small j) 1:/# Hij.
have Es: support (dmask m \ (fun x => ! bn x < bn b)) = support (bn_rnd_bnd b).
- apply fun_ext => x; apply eq_iff.
  rewrite supp_dexcepted supp_dmask /bn_rnd_bnd supp_dmap /=; split.
  + by move=> [_ Hx]; exists (bn x); rewrite supp_dinter bnK; smt(bnk_cmp).
  + move=> [i [Hi ->]]; move: Hi; rewrite supp_dinter => Hi.
    have Hbi: bn (bn_ofint i) = i by apply bn_ofint_small; smt(bn_lt_modulus).
    by rewrite Hbi; split; [apply Hc; rewrite Hbi /# | smt()].
apply eq_distr => x.
by rewrite (mu1_uni_ll _ _ U1 L1) (mu1_uni_ll _ _ U2 L2) Es.
qed.

clone import WhileSampling as RS
 with type input = BN.t,
      type t = BN.t,
      op dt m = dmask m.

(* -------------------------------------------------------------------- *)
(* _rsample_: rejection sampling from the masked samples                *)

lemma bnd_mask_ll: islossless M(Syscall).__bnd_mask.
proof. by proc; while (true) (i - inc); auto => /#. qed.

phoare bnd_mask_ph _b:
 [ M(Syscall).__bnd_mask : bnd = _b
   ==> forall j, 0 <= j < nlimbs => res.[j] = smear _b.[j] `|` hi_of _b j ] = 1%r.
proof. by conseq bnd_mask_ll (bnd_mask_h _b). qed.

(* _rsample_ through the masked samples, as a rejection sampling *)
module RSI = {
  (* a masked sample: a uniform number, masked *)
  proc smask (m: BN.t) : BN.t = {
    var a;
    a <$ bn_rnd;
    a <- bn_and a m;
    return a;
  }

  (* the same, drawn from dmask *)
  proc smaskd (m: BN.t) : BN.t = {
    var a;
    a <$ dmask m;
    return a;
  }

  (* _rsample_, with the system call and the masking loop as smask *)
  proc r0 (a: BN.t, bnd: BN.t) : BN.t = {
    var mask, cf;
    mask <@ M(Syscall).__bnd_mask(witness, bnd);
    a <@ smask(mask);
    cf <- bn a < bn bnd;
    while (!cf) {
      a <@ smask(mask);
      cf <- bn a < bn bnd;
    }
    return a;
  }

  (* the same, with smaskd *)
  proc r1 (a: BN.t, bnd: BN.t) : BN.t = {
    var mask, cf;
    mask <@ M(Syscall).__bnd_mask(witness, bnd);
    a <@ smaskd(mask);
    cf <- bn a < bn bnd;
    while (!cf) {
      a <@ smaskd(mask);
      cf <- bn a < bn bnd;
    }
    return a;
  }

  (* the while sampling of Dexcepted, from the masked samples *)
  proc rw (a: BN.t, bnd: BN.t) : BN.t = {
    var mask;
    mask <@ M(Syscall).__bnd_mask(witness, bnd);
    a <@ RS.SampleW.sample(mask, fun (_: BN.t) (x: BN.t) => ! bn x < bn bnd);
    return a;
  }

  (* the masked samples, excepted the numbers not below the bound *)
  proc re (a: BN.t, bnd: BN.t) : BN.t = {
    var mask;
    mask <@ M(Syscall).__bnd_mask(witness, bnd);
    a <@ RS.SampleE.sample(mask, fun (_: BN.t) (x: BN.t) => ! bn x < bn bnd);
    return a;
  }
}.

equiv rsample_r0: M(Syscall)._rsample_ ~ RSI.r0 : ={a, bnd} ==> ={res}.
proof.
proc.
while (={a, bnd, cf} /\ _mask{1} = mask{2}).
- inline{1} M(Syscall)._rnd_ Syscall.randombytes_W64; inline{2} RSI.smask.
  wp; ecall{1} (BNB._lt_cf__ph a{1} bnd{1}).
  while{1} (0 <= i{1} <= nlimbs /\ _mask{1} = m{2} /\
            (forall j, 0 <= j < i{1} => a{1}.[j] = (bn_and a0{2} m{2}).[j]) /\
            (forall j, i{1} <= j < nlimbs => a{1}.[j] = a0{2}.[j]))
           (nlimbs - i{1}).
  + move=> &2 z; auto => /> &hr Hi0 Hi1 Hlo Hhi Hlt.
    split; last smt().
    split; first smt().
    split.
    * move=> j Hj0 Hj1; rewrite A.get_setE 1:/#.
      case: (j = i{hr}) => [-> /= | Hji]; last by apply Hlo; smt().
      by rewrite Hhi 1:/# /bn_and A.initiE /#.
    * move=> j Hj0 Hj1; rewrite A.get_setE 1:/# (_: j <> i{hr}) 1:/# /=.
      by apply Hhi; smt().
  wp; rnd; wp; skip => />.
  rewrite syscall_rndE /= => &2 _ smp Hs; split => // _.
  split; first smt(gt0_nlimbs).
  move=> aL iL; split; first smt().
  move=> Hexit Hi0 Hi1 Hlo Hhi.
  have ->: aL = bn_and smp mask{2} by apply A.ext_eq => j Hj; apply Hlo; smt().
  done.
inline{1} M(Syscall)._rnd_ Syscall.randombytes_W64; inline{2} RSI.smask.
wp; ecall{1} (BNB._lt_cf__ph a{1} bnd{1}).
while{1} (0 <= i{1} <= nlimbs /\ _mask{1} = m{2} /\
          (forall j, 0 <= j < i{1} => a{1}.[j] = (bn_and a0{2} m{2}).[j]) /\
          (forall j, i{1} <= j < nlimbs => a{1}.[j] = a0{2}.[j]))
         (nlimbs - i{1}).
- move=> &2 z; auto => /> &hr Hi0 Hi1 Hlo Hhi Hlt.
  split; last smt().
  split; first smt().
  split.
  + move=> j Hj0 Hj1; rewrite A.get_setE 1:/#.
    case: (j = i{hr}) => [-> /= | Hji]; last by apply Hlo; smt().
    by rewrite Hhi 1:/# /bn_and A.initiE /#.
  + move=> j Hj0 Hj1; rewrite A.get_setE 1:/# (_: j <> i{hr}) 1:/# /=.
    by apply Hhi; smt().
wp; rnd; wp; call (_: ={arg} ==> ={res}); first by sim.
wp; skip => />.
rewrite syscall_rndE /= => &2 mR smp Hs; split => // _.
split; first smt(gt0_nlimbs).
move=> aL iL; split; first smt().
move=> Hexit Hi0 Hi1 Hlo Hhi.
have ->: aL = bn_and smp mR by apply A.ext_eq => j Hj; apply Hlo; smt().
done.
qed.

equiv smask_eq: RSI.smask ~ RSI.smaskd : ={m} ==> ={res}.
proof.
bypr (res{1}) (res{2}) => // &1 &2 x Hm.
have ->: Pr[RSI.smask(m{1}) @ &1 : res = x] = mu1 (dmask m{1}) x.
- byphoare (_: m = m{1} ==> res = x) => //.
  proc; wp; rnd; skip => /> .
  by rewrite /dmask dmap1E /(\o) /pred1.
have ->: Pr[RSI.smaskd(m{2}) @ &2 : res = x] = mu1 (dmask m{2}) x.
- by byphoare (_: m = m{2} ==> res = x) => //; proc; rnd; skip.
by rewrite Hm.
qed.

equiv r0_r1: RSI.r0 ~ RSI.r1 : ={a, bnd} ==> ={res}.
proof.
proc.
while (={a, bnd, cf, mask}); first by wp; call smask_eq; auto.
wp; call smask_eq; call (_: ={arg} ==> ={res}); first by sim.
by auto.
qed.

equiv r1_rw: RSI.r1 ~ RSI.rw : ={a, bnd} ==> ={res}.
proof.
proc; inline{1} RSI.smaskd; inline{2} RS.SampleW.sample RS.SampleWi.sample.
wp; while (={bnd} /\ a{1} = r0{2} /\ i0{2} = mask{1} /\
           test0{2} = (fun (_: BN.t) (x: BN.t) => ! bn x < bn bnd{1}) /\
           (! cf{1}) = test0{2} i0{2} r0{2}).
- by wp; rnd; wp; skip => />.
wp; rnd; wp; call (_: ={arg} ==> ={res}); first by sim.
by auto => />.
qed.

equiv re_rw: RSI.re ~ RSI.rw : ={a, bnd} ==> ={res}.
proof.
proc; call RS.sampleE_sampleW; call (_: ={arg} ==> ={res}); first by sim.
by auto => /> *; apply dmask_ll.
qed.

equiv re_spec: RSI.re ~ Spec.rsamplespec : ={bnd} ==> ={res}.
proof.
proc; inline RS.SampleE.sample.
wp; rnd (fun (r: BN.t) => bn r) (fun (i: int) => bn_ofint i).
wp; ecall{1} (bnd_mask_ph bnd{1}).
skip => /> &2 m Hm.
have Hc := mask_covers _ _ Hm.
rewrite /dt (dmask_excepted _ _ Hc) /bn_rnd_bnd.
have Hb := bn_lt_modulus bnd{2}.
have Hsm: forall i, i \in [0..bn bnd{2} - 1] => bn (bn_ofint i) = i.
- by move=> i; rewrite supp_dinter => Hi; apply bn_ofint_small; smt().
split; first by move=> i Hi; rewrite Hsm.
move=> _; split.
- move=> i Hi; rewrite dmap1E /pred1 /(\o) /=.
  apply mu_eq_support => j Hj /=; apply eq_iff; split => [-> // | H].
  by rewrite -(Hsm i Hi) -(Hsm j Hj) H.
move=> _ r; rewrite supp_dmap => -[i [Hi ->]].
by rewrite Hsm.
qed.

(* the masked rejection sampling is uniform below the bound *)
equiv _rsample__eq:
 M(Syscall)._rsample_ ~ Spec.rsamplespec :
 ={bnd} ==> ={res}.
proof.
transitivity RSI.r0 (={a, bnd} ==> ={res}) (={bnd} ==> ={res}) => //.
- by move=> &1 &2 H; exists (a{1}, bnd{1}).
- exact rsample_r0.
transitivity RSI.r1 (={a, bnd} ==> ={res}) (={bnd} ==> ={res}) => //.
- by move=> &1 &2 H; exists (a{1}, bnd{1}).
- exact r0_r1.
transitivity RSI.rw (={a, bnd} ==> ={res}) (={bnd} ==> ={res}) => //.
- by move=> &1 &2 H; exists (a{1}, bnd{1}).
- exact r1_rw.
transitivity RSI.re (={a, bnd} ==> ={res}) (={bnd} ==> ={res}) => //.
- by move=> &1 &2 H; exists (a{1}, bnd{1}).
- by symmetry; conseq re_rw => /#.
exact re_spec.
qed.

phoare _rsample__ph _bnd _res:
 [ M(Syscall)._rsample_ :
   bnd=_bnd ==> res = _res ] = (mu1 (bn_rnd_bnd bnd) _res).
proof.
conseq _rsample__eq (bn_rsamplespec_ph _bnd _res) => /> &1.
by exists (bnd{1},bnd{1}); smt().
qed.

lemma rsamplespec_ll:
 phoare [ Spec.rsamplespec : 0 < bn bnd ==> true ] = 1%r.
proof.
proc; simplify; auto => /> &m Hbnd.
by rewrite weight_dinter /#.
qed.

lemma _rsample__ll:
 phoare [ M(Syscall)._rsample_ : 0 < bn bnd ==> true ] = 1%r.
proof.
conseq _rsample__eq rsamplespec_ll => //=.
by move=> /> &1 Hbnd; exists (witness, bnd{1}) => /#.
qed.


