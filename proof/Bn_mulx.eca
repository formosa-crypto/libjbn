           = bnk (k{hr} + 1) _a * bnk nlimbs _b by rewrite bnkS 1:/# /=; ring.
  have [Ha0 Ha1] := bnk_cmp (k{hr} + 1) _a; have [Hb0 Hb1] := bnk_cmp nlimbs _b.
  rewrite (_: k{hr} + nlimbs + 1 = (k{hr} + 1) + nlimbs) 1:/# exprD_nneg 1,2:/#.
  by apply StdOrder.IntOrder.ltr_pmul; move: Ha0 Ha1 Hb0 Hb1; smt().
 move=> _ _ r' Hr'; split; first smt().
 rewrite (_: k{hr} + 1 + nlimbs = k{hr} + nlimbs + 1) 1:/# Hr' Hinv.
 by rewrite bnkS 1:/# /=; ring.
wp; ecall (__mul1_h ai b); wp; skip => /> r' Hr'.
split.
 split; first smt(gt0_nlimbs).
 by rewrite addzC Hr' bnk1 /=.
move=> k0 r0 Hk0 Hk1 Hk2 Hinv.
by move: Hinv; rewrite (_: k0 = nlimbs) 1:/# (_: nlimbs + nlimbs = 2 * nlimbs) 1:/#.
qed.

hoare _os_muln__h _a _b:
 M._os_muln_ : a=_a /\ b=_b ==> bn res = bn _a * bn _b.
proof. by proc; wp; ecall (_os_muln_h a b); auto. qed.

(* Squaring: a^2 = 2 * X + D, with X the products above the diagonal,
   accumulated by rows (row j adds a[j] times the limbs above j), and D the
   squares of the limbs *)
op sqx (k: int) (a: BN.t) : int =
  bigi predT (fun j => to_uint a.[j] * 18446744073709551616 ^ j * (bn a - bnk (j+1) a)) 0 k.
op sqd (k: int) (a: BN.t) : int =
  bigi predT (fun j => to_uint a.[j] * to_uint a.[j] * 18446744073709551616 ^ (2*j)) 0 k.

lemma sqx0 a: sqx 0 a = 0.
proof. by rewrite /sqx big_geq. qed.

lemma sqxS k a: 0 <= k =>
 sqx (k+1) a = sqx k a + to_uint a.[k] * 18446744073709551616 ^ k * (bn a - bnk (k+1) a).
proof. by move=> Hk; rewrite /sqx big_int_recr. qed.

lemma sqd0 a: sqd 0 a = 0.
proof. by rewrite /sqd big_geq. qed.

lemma sqdS k a: 0 <= k =>
 sqd (k+1) a = sqd k a + to_uint a.[k] * to_uint a.[k] * 18446744073709551616 ^ (2*k).
proof. by move=> Hk; rewrite /sqd big_int_recr. qed.

(* the identity, on the first k limbs *)
lemma sq_identk k a: 0 <= k <= nlimbs =>
 2 * sqx k a + bnk k a * bnk k a + sqd k a = 2 * bn a * bnk k a.
proof.
elim/natind: k => [k Hk H | k Hk IH H].
 by rewrite (_: k = 0) 1:/# sqx0 sqd0 bnk0.
rewrite sqxS // sqdS // bnkS //= (_: 2 * k = k + k) 1:/# exprD_nneg 1,2:/#.
have := IH _; first smt().
move=> {IH} IH.
have ->: 2 * (sqx k a + to_uint a.[k] * 18446744073709551616 ^ k * (bn a - (to_uint a.[k] * 18446744073709551616 ^ k + bnk k a)))
         + (to_uint a.[k] * 18446744073709551616 ^ k + bnk k a) * (to_uint a.[k] * 18446744073709551616 ^ k + bnk k a)
         + (sqd k a + to_uint a.[k] * to_uint a.[k] * (18446744073709551616 ^ k * 18446744073709551616 ^ k))
         = (2 * sqx k a + bnk k a * bnk k a + sqd k a)
           + 2 * to_uint a.[k] * 18446744073709551616 ^ k * bn a by ring.
by rewrite IH; ring.
qed.

lemma sq_ident a: bn a * bn a = 2 * sqx nlimbs a + sqd nlimbs a.
proof. by have := sq_identk nlimbs a _; [smt(gt0_nlimbs) | smt()]. qed.

(* the last row is empty *)
lemma sqx_last a: sqx nlimbs a = sqx (nlimbs - 1) a.
proof.
have := sqxS (nlimbs - 1) a _; first smt(gt0_nlimbs).
by rewrite (_: nlimbs - 1 + 1 = nlimbs) 1:/# => ->; ring.
qed.

(* the limbs from k up *)
lemma bn_sub_bnk (x: BN.t) k: 0 <= k <= nlimbs =>
 bn x - bnk k x <= 18446744073709551616 ^ nlimbs - 18446744073709551616 ^ k.
proof.
move=> Hk; have E := bn_k_kup k x Hk.
have [Hx0 Hx1] := bnk_cmp nlimbs x; have [Hk0 _] := bnk_cmp k x.
have HY: 0 < 18446744073709551616 ^ k by apply StdOrder.IntOrder.expr_gt0.
have EW: 18446744073709551616 ^ nlimbs
         = 18446744073709551616 ^ (nlimbs - k) * 18446744073709551616 ^ k
 by rewrite -exprD_nneg 1,2:/#; congr; ring.
have Hu: bnkup k x < 18446744073709551616 ^ (nlimbs - k).
 rewrite -(StdOrder.IntOrder.ltr_pmul2r _ HY) -EW.
 by move: E Hx1 Hk0; rewrite (_: W64.modulus = 18446744073709551616) //; smt().
have : bnkup k x * 18446744073709551616 ^ k <= (18446744073709551616 ^ (nlimbs - k) - 1) * 18446744073709551616 ^ k.
 by apply StdOrder.IntOrder.ler_wpmul2r; smt().
by move: E; rewrite (_: W64.modulus = 18446744073709551616) // => E; rewrite E EW; smt().
qed.

(* the rows so far stay below (W^nlimbs - W) * a[0..k) *)
lemma sqx_bnd k a: 0 <= k <= nlimbs =>
 sqx k a <= bnk k a * (18446744073709551616 ^ nlimbs - 18446744073709551616).
proof.
elim/natind: k => [k Hk H | k Hk IH H].
 by rewrite (_: k = 0) 1:/# sqx0 bnk0.
rewrite sqxS // bnkS //=.
have := IH _; first smt().
have Hs := bn_sub_bnk a (k+1) _; first smt().
have HW: 18446744073709551616 <= 18446744073709551616 ^ (k+1).
 have := StdOrder.IntOrder.expr_gt0 k 18446744073709551616 _ => //.
 by rewrite exprS //; smt().
have [Ha0 _] := W64.to_uint_cmp a.[k].
have HY: 0 <= to_uint a.[k] * 18446744073709551616 ^ k
 by apply StdOrder.IntOrder.mulr_ge0 => //; smt(StdOrder.IntOrder.expr_gt0).
have : to_uint a.[k] * 18446744073709551616 ^ k * (bn a - bnk (k + 1) a)
       <= to_uint a.[k] * 18446744073709551616 ^ k * (18446744073709551616 ^ nlimbs - 18446744073709551616)
 by apply StdOrder.IntOrder.ler_wpmul2l => //; smt().
move=> H1 H2.
have ->: (to_uint a.[k] * 18446744073709551616 ^ k + bnk k a)
         * (18446744073709551616 ^ nlimbs - 18446744073709551616)
         = to_uint a.[k] * 18446744073709551616 ^ k
           * (18446744073709551616 ^ nlimbs - 18446744073709551616)
           + bnk k a * (18446744073709551616 ^ nlimbs - 18446744073709551616) by ring.
by move: H1 H2; rewrite bnkS //=; smt().
qed.

(* row 0 of X: r[1..nlimbs] = a[0] * a[1..nlimbs) (r[0] is not written) *)
hoare __sqr_row0_h _r _a:
 M.__sqr_row0 : r=_r /\ a=_a /\ 2 <= nlimbs
 ==> res.[0] = _r.[0] /\ BN2.bnk (nlimbs+1) res = to_uint _r.[0] + sqx 1 _a.
proof.
proc.
wp; while (a=_a /\ ai = _a.[0] /\ 2 <= j <= nlimbs /\ r.[0] = _r.[0]
           /\ to_uint hi <= 18446744073709551616 - 2
           /\ BN2.bnk j r + (to_uint hi + b2i cf) * 18446744073709551616 ^ j
              = to_uint _r.[0] + to_uint _a.[0] * (bnk j _a - bnk 1 _a)).
 wp; skip => /> &hr Hj1 _ Hr0 Hh Hinv Hj2.
 rewrite /ADCX_64 /MULX_64 /=.
 split; first smt().
 split; first by rewrite BN2.A.get_setE 1:/# (_: 0 <> j{hr}) 1:/#.
 split; first exact JBigNumber.mulu_hi_bnd.
 rewrite BN2.bnk_put 1:/# bnkS 1:/# /=.
 have A := JBigNumber.addc_to_uint hi{hr} (mulu _a.[0] _a.[j{hr}]).`2 cf{hr}.
 have M := JBigNumber.mulu_to_uint _a.[0] _a.[j{hr}].
 have ->: to_uint (addc hi{hr} (mulu _a.[0] _a.[j{hr}]).`2 cf{hr}).`2
          + 18446744073709551616 * (to_uint (mulu _a.[0] _a.[j{hr}]).`1
                                    + b2i (addc_carry hi{hr} (mulu _a.[0] _a.[j{hr}]).`2 cf{hr}))
          = to_uint hi{hr} + b2i cf{hr} + to_uint _a.[0] * to_uint _a.[j{hr}]
  by move: A M; rewrite (_: W64.modulus = 18446744073709551616) //; smt().
 have ->: BN2.bnk j{hr} r{hr}
          = to_uint _r.[0] + to_uint _a.[0] * (bnk j{hr} _a - bnk 1 _a)
            - (to_uint hi{hr} + b2i cf{hr}) * 18446744073709551616 ^ j{hr}
  by rewrite -Hinv; ring.
 by ring.
wp; skip => &hr /> H2.
rewrite /ADCX_64 /MULX_64 /set0_64_ /=.
split.
 split; first by rewrite BN2.A.get_setE 1:/#.
 split; first exact JBigNumber.mulu_hi_bnd.
 rewrite (_: 2 = 1 + 1) // BN2.bnkS //= BN2.bnk1 /= !BN2.A.get_setE 1,2:/# /=.
 rewrite (_: bnk 2 a{hr} = to_uint a{hr}.[1] * 18446744073709551616 + to_uint a{hr}.[0]).
  by rewrite (_: 2 = 1 + 1) // bnkS //= bnk1.
 rewrite bnk1 /=.
 have M := JBigNumber.mulu_to_uint a{hr}.[0] a{hr}.[1].
 by move: M; rewrite (_: W64.modulus = 18446744073709551616) //= => M; smt().
move=> cf0 hi0 j0 r0 H1 H2' H3 Hr0 Hh Hinv; have Ej: j0 = nlimbs by smt().
move: Hinv; rewrite Ej => Hinv.
have [_ E] := JBigNumber.addc_nc hi0 W64.zero cf0 _.
 by rewrite W64.to_uint0; move: Hh; case: cf0 => /= /#.
split; first by rewrite BN2.A.get_setE 1:/# (_: 0 <> nlimbs) 1:/# /= Hr0.
rewrite BN2.bnkS 1:/# /= BN2.A.get_setE 1:/# /= BN2.bnk_setO 1:/# E W64.to_uint0.
have ->: sqx 1 a{hr} = to_uint a{hr}.[0] * (bn a{hr} - bnk 1 a{hr})
 by rewrite (_: 1 = 0 + 1) // sqxS // sqx0 /=.
by move: Hinv; smt().
qed.

(* row i of X (0 < i < nlimbs-1): r[2i+1..i+nlimbs] += a[i] * a(i..nlimbs),
   with the carries of the two chains pending as in the multiplication *)
hoare __sqr_rowacc_h _i _r _a:
 M.__sqr_rowacc : i=_i /\ r=_r /\ a=_a /\ 1 <= _i < nlimbs - 1
   /\ BN2.bnk (_i + nlimbs) _r
      + to_uint _a.[_i] * 18446744073709551616 ^ _i * (bn _a - bnk (_i+1) _a)
      < 18446744073709551616 ^ (_i + nlimbs + 1)
 ==> res.[0] = _r.[0]
     /\ BN2.bnk (_i + nlimbs + 1) res
         = BN2.bnk (_i + nlimbs) _r
           + to_uint _a.[_i] * 18446744073709551616 ^ _i * (bn _a - bnk (_i+1) _a).
proof.
proc.
wp; while (i=_i /\ a=_a /\ ai = _a.[_i] /\ _i + 2 <= j <= nlimbs /\ 1 <= _i < nlimbs - 1
           /\ BN2.bnk (_i + nlimbs) _r
               + to_uint _a.[_i] * 18446744073709551616 ^ _i * (bn _a - bnk (_i+1) _a)
              < 18446744073709551616 ^ (_i + nlimbs + 1)
           /\ (forall j', _i + j <= j' < 2*nlimbs \/ j' = 0 => r.[j'] = _r.[j'])
           /\ BN2.bnk (_i + j) r
               + (to_uint hi + b2i cf + b2i of_0) * 18446744073709551616 ^ (_i + j)
              = BN2.bnk (_i + j) _r
                + to_uint _a.[_i] * 18446744073709551616 ^ _i * (bnk j _a - bnk (_i+1) _a)).
 wp; skip => /> &hr Hj1 _ Hi1 Hi2 Hbnd Hfr Hinv Hj2.
 rewrite /ADCX_64 /ADOX_64 /MULX_64 /=.
 split; first smt().
 split.
  by move=> j' Hj'; rewrite BN2.A.get_setE 1:/# (_: j' <> _i + j{hr}) 1:/# /= Hfr /#.
 rewrite (_: _i + (j{hr} + 1) = _i + j{hr} + 1) 1:/#.
 rewrite BN2.bnk_put 1:/# Hfr 1:/# BN2.bnkS 1:/# bnkS 1:/# /=.
 pose t1 := addc _r.[_i + j{hr}] hi{hr} cf{hr}.
 pose t2 := addc t1.`2 (mulu _a.[_i] _a.[j{hr}]).`2 of_0{hr}.
 have A1 := JBigNumber.addc_to_uint _r.[_i + j{hr}] hi{hr} cf{hr}.
 have A2 := JBigNumber.addc_to_uint t1.`2 (mulu _a.[_i] _a.[j{hr}]).`2 of_0{hr}.
 have M := JBigNumber.mulu_to_uint _a.[_i] _a.[j{hr}].
 have ->: to_uint t2.`2 + 18446744073709551616
            * (to_uint (mulu _a.[_i] _a.[j{hr}]).`1 + b2i t1.`1 + b2i t2.`1)
          = to_uint _r.[_i + j{hr}] + to_uint hi{hr} + b2i cf{hr} + b2i of_0{hr}
            + to_uint _a.[_i] * to_uint _a.[j{hr}]
  by move: A1 A2 M; rewrite -/t1 -/t2 (_: W64.modulus = 18446744073709551616) //; smt().
 have ->: BN2.bnk (_i + j{hr}) r{hr}
          = BN2.bnk (_i + j{hr}) _r
            + to_uint _a.[_i] * 18446744073709551616 ^ _i * (bnk j{hr} _a - bnk (_i+1) _a)
            - (to_uint hi{hr} + b2i cf{hr} + b2i of_0{hr})
              * 18446744073709551616 ^ (_i + j{hr})
  by rewrite -Hinv; ring.
 by rewrite exprD_nneg 1,2:/#; ring.
wp; skip => &hr /> Hi1 Hi2 Hbnd.
rewrite /ADCX_64 /ADOX_64 /MULX_64 /set0_64_ /=.
split.
 split; first smt().
 split.
  by move=> j' Hj'; rewrite BN2.A.get_setE 1:/# (_: j' <> 2 * i{hr} + 1) 1:/#.
 rewrite (_: i{hr} + (i{hr} + 2) = (2 * i{hr} + 1) + 1) 1:/#.
 rewrite BN2.bnk_put 1:/# (BN2.bnkS (2 * i{hr} + 1)) 1:/# /=.
 rewrite (_: i{hr} + 2 = (i{hr} + 1) + 1) 1:/# bnkS 1:/# /=.
 have A := JBigNumber.addc_to_uint r{hr}.[2 * i{hr} + 1] (mulu a{hr}.[i{hr}] a{hr}.[i{hr} + 1]).`2 false.
 have M := JBigNumber.mulu_to_uint a{hr}.[i{hr}] a{hr}.[i{hr} + 1].
 move: A M; rewrite (_: W64.modulus = 18446744073709551616) // /= => A M.
 have ->: to_uint (addc r{hr}.[2 * i{hr} + 1] (mulu a{hr}.[i{hr}] a{hr}.[i{hr} + 1]).`2 false).`2
          + 18446744073709551616
            * (to_uint (mulu a{hr}.[i{hr}] a{hr}.[i{hr} + 1]).`1 + b2i false
               + b2i (addc_carry r{hr}.[2 * i{hr} + 1] (mulu a{hr}.[i{hr}] a{hr}.[i{hr} + 1]).`2 false))
          = to_uint r{hr}.[2 * i{hr} + 1] + to_uint a{hr}.[i{hr}] * to_uint a{hr}.[i{hr} + 1]
  by move: A M; smt().
 rewrite (_: 2 * i{hr} + 1 = i{hr} + (i{hr} + 1)) 1:/# exprD_nneg 1,2:/# exprS 1:/#.
 by ring.
move=> cf0 hi0 j0 of0 r0 H1 H2 H3 Hfr Hinv; have Ej: j0 = nlimbs by smt().
move: Hinv; rewrite Ej => Hinv.
(* the top word does not overflow *)
have HY: 0 < 18446744073709551616 ^ (i{hr} + nlimbs) by apply StdOrder.IntOrder.expr_gt0.
have [Hr0 _] := BN2.bnk_cmp (i{hr} + nlimbs) r0.
have Htop: to_uint hi0 + b2i cf0 + b2i of0 < 18446744073709551616.
 have E: 18446744073709551616 ^ (i{hr} + nlimbs + 1)
          = 18446744073709551616 ^ (i{hr} + nlimbs) * 18446744073709551616
  by rewrite exprSr 1:/#.
 have H: (to_uint hi0 + b2i cf0 + b2i of0) * 18446744073709551616 ^ (i{hr} + nlimbs)
         < 18446744073709551616 * 18446744073709551616 ^ (i{hr} + nlimbs)
  by move: Hbnd Hinv Hr0 E; smt().
 by move: H; rewrite StdOrder.IntOrder.ltr_pmul2r.
have [_ E1] := JBigNumber.addc_nc hi0 W64.zero cf0 _.
 by rewrite W64.to_uint0; move: Htop; case: cf0; case: of0 => /= /#.
have [_ E2] := JBigNumber.addc_nc (addc hi0 W64.zero cf0).`2 W64.zero of0 _.
 by rewrite E1 W64.to_uint0; move: Htop; case: cf0; case: of0 => /= /#.
split; first by rewrite BN2.A.get_setE 1:/# (_: 0 <> i{hr} + nlimbs) 1:/# /= Hfr.
rewrite BN2.bnkS 1:/# /= BN2.A.get_setE 1:/# /= BN2.bnk_setO 1:/# E2 E1 !W64.to_uint0 /=.
by move: Hinv; smt().
qed.

(* r = 2 * X + D, for X in r[1..2*nlimbs-2]: the doubling runs on the CF
   chain, the addition of the squares on the OF chain *)
hoare __sqr_diag_h _r _a:
 M.__sqr_diag : r=_r /\ a=_a /\ 2 <= nlimbs
   /\ 2 * (BN2.bnk (2*nlimbs-1) _r - to_uint _r.[0]) + sqd nlimbs _a
      < 18446744073709551616 ^ (2*nlimbs)
 ==> BN2.bnk (2*nlimbs) res
     = 2 * (BN2.bnk (2*nlimbs-1) _r - to_uint _r.[0]) + sqd nlimbs _a.
proof.
proc.
wp; while (a=_a /\ inc = nlimbs - 1 /\ 1 <= i <= nlimbs - 1 /\ 2 <= nlimbs
           /\ 2 * (BN2.bnk (2*nlimbs-1) _r - to_uint _r.[0]) + sqd nlimbs _a
              < 18446744073709551616 ^ (2*nlimbs)
           /\ (forall j, 2*i <= j < 2*nlimbs => r.[j] = _r.[j])
           /\ BN2.bnk (2*i) r + (b2i cf + b2i of_0) * 18446744073709551616 ^ (2*i)
              = 2 * (BN2.bnk (2*i) _r - to_uint _r.[0]) + sqd i _a).
 wp; skip => /> &hr Hi1 _ Hn Hbnd Hfr Hinv Hi2.
 rewrite /ADCX_64 /ADOX_64 /MULX_64 /=.
 split; first smt().
 split.
  move=> j Hj1 Hj2; rewrite BN2.A.get_setE 1:/# (_: j <> 2 * i{hr} + 1) 1:/# /=.
  by rewrite BN2.A.get_setE 1:/# (_: j <> 2 * i{hr}) 1:/# /= Hfr /#.
 rewrite (BN2.A.get_setE r{hr} (2 * i{hr}) (2 * i{hr} + 1)) 1:/#.
 rewrite (_: (2 * i{hr} + 1 = 2 * i{hr}) = false) 1:/# /=.
 rewrite Hfr 1:/# (Hfr (2 * i{hr} + 1)) 1:/#.
 pose x0 := _r.[2 * i{hr}]; pose x1 := _r.[2 * i{hr} + 1].
 pose p := mulu _a.[i{hr}] _a.[i{hr}].
 pose u1 := addc x0 x0 cf{hr}; pose u2 := addc u1.`2 p.`2 of_0{hr}.
 pose v1 := addc x1 x1 u1.`1; pose v2 := addc v1.`2 p.`1 u2.`1.
 rewrite (_: 2 * (i{hr} + 1) = (2 * i{hr} + 1) + 1) 1:/#.
 rewrite BN2.bnk_put 1:/# BN2.bnk_put 1:/#.
 rewrite (BN2.bnkS (2 * i{hr} + 1)) 1:/# (BN2.bnkS (2 * i{hr})) 1:/# /= sqdS 1:/# -/x0 -/x1.
 have A1 := JBigNumber.addc_to_uint x0 x0 cf{hr}.
 have A2 := JBigNumber.addc_to_uint u1.`2 p.`2 of_0{hr}.
 have A3 := JBigNumber.addc_to_uint x1 x1 u1.`1.
 have A4 := JBigNumber.addc_to_uint v1.`2 p.`1 u2.`1.
 have M := JBigNumber.mulu_to_uint _a.[i{hr}] _a.[i{hr}].
 have Hin: to_uint u2.`2 + 18446744073709551616
             * (to_uint v2.`2 + 18446744073709551616 * (b2i v1.`1 + b2i v2.`1))
           = 2 * (to_uint x0 + 18446744073709551616 * to_uint x1) + b2i cf{hr} + b2i of_0{hr}
             + to_uint _a.[i{hr}] * to_uint _a.[i{hr}]
  by move: A1 A2 A3 A4 M; rewrite -/x0 -/x1 -/p -/u1 -/u2 -/v1 -/v2
       (_: W64.modulus = 18446744073709551616) //; smt().
 rewrite Hin.
 have E1: 18446744073709551616 ^ (2 * i{hr} + 1)
          = 18446744073709551616 ^ (2 * i{hr}) * 18446744073709551616 by rewrite exprSr 1:/#.
 have ->: BN2.bnk (2 * i{hr}) r{hr}
          = 2 * (BN2.bnk (2 * i{hr}) _r - to_uint _r.[0]) + sqd i{hr} _a
            - (b2i cf{hr} + b2i of_0{hr}) * 18446744073709551616 ^ (2 * i{hr})
  by rewrite -Hinv; ring.
 by rewrite E1; ring.
wp; skip => &hr /> Hn Hbnd.
rewrite /ADCX_64 /ADOX_64 /MULX_64 /set0_64_ /=.
split.
 split; first smt().
 split.
  move=> j Hj1 Hj2; rewrite BN2.A.get_setE 1:/# (_: j <> 1) 1:/# /=.
  by rewrite BN2.A.get_setE 1:/# (_: j <> 0) 1:/#.
 rewrite (BN2.A.get_setE r{hr} 0 1) 1:/# /=.
 have E2: forall (x: BN2.t), BN2.bnk 2 x = to_uint x.[0] + to_uint x.[1] * 18446744073709551616.
  by move=> x; rewrite (_: 2 = 1 + 1) // BN2.bnkS //= BN2.bnk1 /=; ring.
 have ->: sqd 1 a{hr} = to_uint a{hr}.[0] * to_uint a{hr}.[0]
  by rewrite (_: 1 = 0 + 1) // sqdS // sqd0.
 rewrite !E2 !BN2.A.get_setE 1..4:/# /=.
 pose x1 := r{hr}.[1].
 pose p := mulu a{hr}.[0] a{hr}.[0].
 pose u1 := addc x1 x1 false.
 pose u2 := addc u1.`2 p.`1 false.
 have A1 := JBigNumber.addc_to_uint x1 x1 false.
 have A2 := JBigNumber.addc_to_uint u1.`2 p.`1 false.
 have M := JBigNumber.mulu_to_uint a{hr}.[0] a{hr}.[0].
 move: A1 A2 M; rewrite -/x1 -/p -/u1 -/u2 (_: W64.modulus = 18446744073709551616) // /=.
 smt().
(* the last position, and the top word (which does not overflow) *)
move=> cf0 i0 of0 r0 H1 H2 H3 Hfr Hinv.
have Ei: i0 = nlimbs - 1 by smt().
move: Hinv Hfr; rewrite Ei (_: 2 * (nlimbs - 1) = 2 * nlimbs - 2) 1:/# => Hinv Hfr.
rewrite Hfr 1:/#.
pose x := r{hr}.[2 * nlimbs - 2].
pose p := mulu a{hr}.[nlimbs - 1] a{hr}.[nlimbs - 1].
pose u1 := addc x x cf0.
pose u2 := addc u1.`2 p.`2 of0.
have A1 := JBigNumber.addc_to_uint x x cf0.
have A2 := JBigNumber.addc_to_uint u1.`2 p.`2 of0.
have M := JBigNumber.mulu_to_uint a{hr}.[nlimbs - 1] a{hr}.[nlimbs - 1].
move: A1 A2 M; rewrite -/x -/p -/u1 -/u2 (_: W64.modulus = 18446744073709551616) // => A1 A2 M.
have EV: BN2.bnk (2 * nlimbs - 1) r0.[2 * nlimbs - 2 <- u2.`2] + (to_uint p.`1 + b2i u1.`1 + b2i u2.`1) * 18446744073709551616 ^ (2 * nlimbs - 1) = 2 * (BN2.bnk (2 * nlimbs - 1) r{hr} - to_uint r{hr}.[0]) + sqd nlimbs a{hr}.
  rewrite (_: 2 * nlimbs - 1 = (2 * nlimbs - 2) + 1) 1:/# BN2.bnk_put 1:/#.
  rewrite (BN2.bnkS (2 * nlimbs - 2)) 1:/# /= -/x.
  rewrite (_: nlimbs = (nlimbs - 1) + 1) 1:/# sqdS 1:/# /=.
  rewrite (_: 2 * (nlimbs - 1) = 2 * nlimbs - 2) 1:/#.
  have ->: to_uint u2.`2 + 18446744073709551616 * (to_uint p.`1 + b2i u1.`1 + b2i u2.`1) = 2 * to_uint x + b2i cf0 + b2i of0 + to_uint a{hr}.[nlimbs - 1] * to_uint a{hr}.[nlimbs - 1] by smt().
  have ->: BN2.bnk (2 * nlimbs - 2) r0 = 2 * (BN2.bnk (2 * nlimbs - 2) r{hr} - to_uint r{hr}.[0]) + sqd (nlimbs - 1) a{hr} - (b2i cf0 + b2i of0) * 18446744073709551616 ^ (2 * nlimbs - 2) by rewrite -Hinv; ring.
  ring.
have HY: 0 < 18446744073709551616 ^ (2 * nlimbs - 1) by apply StdOrder.IntOrder.expr_gt0.
have [Hr0 _] := BN2.bnk_cmp (2 * nlimbs - 1) r0.[2 * nlimbs - 2 <- u2.`2].
have EW: 18446744073709551616 ^ (2 * nlimbs) = 18446744073709551616 ^ (2 * nlimbs - 1) * 18446744073709551616 by rewrite -exprSr; smt(gt0_nlimbs).
have HX: to_uint p.`1 + b2i u1.`1 + b2i u2.`1 < 18446744073709551616.
  have H: (to_uint p.`1 + b2i u1.`1 + b2i u2.`1) * 18446744073709551616 ^ (2 * nlimbs - 1) < 18446744073709551616 * 18446744073709551616 ^ (2 * nlimbs - 1) by move: EV Hbnd Hr0 EW; smt().
  by move: H; rewrite StdOrder.IntOrder.ltr_pmul2r.
have [_ E1] := JBigNumber.addc_nc p.`1 W64.zero u1.`1 _.
  by rewrite W64.to_uint0; move: HX; case: (u1.`1); case: (u2.`1) => /= /#.
have [_ E2] := JBigNumber.addc_nc (addc p.`1 W64.zero u1.`1).`2 W64.zero u2.`1 _.
  by rewrite E1 W64.to_uint0; move: HX; case: (u1.`1); case: (u2.`1) => /= /#.
have B2: forall (y: BN2.t), BN2.bnk (2 * nlimbs) y = BN2.bnk (2 * nlimbs - 1) y + to_uint y.[2 * nlimbs - 1] * 18446744073709551616 ^ (2 * nlimbs - 1).
  move=> y; have := BN2.bnkS (2 * nlimbs - 1) y _; first smt(gt0_nlimbs).
  by rewrite (_: 2 * nlimbs - 1 + 1 = 2 * nlimbs) 1:/# => -> /=; ring.
rewrite B2 BN2.A.get_setE 1:/# /= BN2.bnk_setO 1:/# E2 E1 !W64.to_uint0 /=.
by rewrite -EV; ring.
qed.

(* the squaring: row 0, rows 1..nlimbs-2, then the doubling (a single
   product when nlimbs = 1) *)
hoare _os_sqrn_h _a:
 M._os_sqrn : a=_a ==> BN2.bn res = bn _a * bn _a.
proof.
proc.
exists* r; elim* => r00.
if.
 wp; skip => /> Hn.
 rewrite /MULX_64 /= Hn /= (_: 2 = 1 + 1) // BN2.bnkS //= BN2.bnk1 /= bnk1 /=.
 rewrite !BN2.A.get_setE 1..4:/# /=.
 have M := JBigNumber.mulu_to_uint _a.[0] _a.[0].
 by move: M; rewrite (_: W64.modulus = 18446744073709551616) // => M; smt().
ecall (__sqr_diag_h r a).
while (a = _a /\ inc = nlimbs - 1 /\ 1 <= i <= nlimbs - 1 /\ 2 <= nlimbs
       /\ r.[0] = r00.[0]
       /\ BN2.bnk (i + nlimbs) r = to_uint r00.[0] + sqx i _a).
 wp; ecall (__sqr_rowacc_h i r a); skip => /> &hr Hi1 _ Hn Hr0 Hinv Hi2.
 split.
  rewrite Hinv.
  have ->: to_uint r00.[0] + sqx i{hr} _a
           + to_uint _a.[i{hr}] * 18446744073709551616 ^ i{hr} * (bn _a - bnk (i{hr} + 1) _a)
           = to_uint r00.[0] + sqx (i{hr} + 1) _a by rewrite sqxS 1:/#; ring.
  have Hb := sqx_bnd (i{hr} + 1) _a _; first smt().
  have [Hk0 Hk1] := bnk_cmp (i{hr} + 1) _a.
  have [Hr00 Hr01] := W64.to_uint_cmp r00.[0].
  have HW1: 18446744073709551616 <= 18446744073709551616 ^ nlimbs.
   have := StdOrder.IntOrder.expr_gt0 (nlimbs - 1) 18446744073709551616 _ => //.
   have ->: 18446744073709551616 ^ nlimbs
            = 18446744073709551616 ^ (nlimbs - 1) * 18446744073709551616
    by rewrite -exprSr; smt(gt0_nlimbs).
   smt().
  have HW2: 18446744073709551616 * 18446744073709551616 <= 18446744073709551616 ^ (i{hr} + 2).
   have := StdOrder.IntOrder.expr_gt0 i{hr} 18446744073709551616 _ => //.
   by rewrite (_: i{hr} + 2 = i{hr} + 1 + 1) 1:/# exprS 1:/# exprS 1:/#; smt().
  have Hk2: bnk (i{hr} + 1) _a <= 18446744073709551616 ^ (i{hr} + 1) - 1
   by move: Hk1; rewrite (_: W64.modulus = 18446744073709551616) //; smt().
  have : bnk (i{hr} + 1) _a * (18446744073709551616 ^ nlimbs - 18446744073709551616)
         <= (18446744073709551616 ^ (i{hr} + 1) - 1) * (18446744073709551616 ^ nlimbs - 18446744073709551616)
   by apply StdOrder.IntOrder.ler_wpmul2r; smt().
  have ->: 18446744073709551616 ^ (i{hr} + nlimbs + 1)
           = 18446744073709551616 ^ (i{hr} + 1) * 18446744073709551616 ^ nlimbs
   by rewrite -exprD_nneg 1,2:/#; congr; ring.
  have E3: 18446744073709551616 ^ (i{hr} + 2)
           = 18446744073709551616 ^ (i{hr} + 1) * 18446744073709551616
   by rewrite -exprSr 1:/#.
  move: HW2; rewrite E3 => HW2.
  move: Hr01 HW1 HW2 Hb; rewrite (_: W64.modulus = 18446744073709551616) //; smt().
 move=> _ r' Hr'0 Hr'; split; first smt().
 rewrite Hr'0 Hr0 /= (_: i{hr} + 1 + nlimbs = i{hr} + nlimbs + 1) 1:/# Hr' Hinv sqxS 1:/#.
 by ring.
wp; ecall (__sqr_row0_h r a); wp; skip => /> Hn.
have Hn2: 2 <= nlimbs by smt(gt0_nlimbs).
split; first done.
move=> _ r' Hr'0 Hr'.
split; first by split; [smt() | rewrite addzC Hr'].
move=> i0 r0 Hi0 Hi1 Hi2 Hr0 Hinv; have Ei: i0 = nlimbs - 1 by smt().
move: Hinv; rewrite Ei (_: nlimbs - 1 + nlimbs = 2 * nlimbs - 1) 1:/# => Hinv.
have EX: 2 * (BN2.bnk (2 * nlimbs - 1) r0 - to_uint r0.[0]) + sqd nlimbs _a = bn _a * bn _a
 by rewrite Hinv Hr0 sq_ident sqx_last; ring.
split.
 rewrite EX.
 have [Ha0 Ha1] := bnk_cmp nlimbs _a.
 rewrite (_: 2 * nlimbs = nlimbs + nlimbs) 1:/# exprD_nneg 1,2:/#.
 by apply StdOrder.IntOrder.ltr_pmul; move: Ha0 Ha1;
    rewrite (_: W64.modulus = 18446744073709551616) //; smt().
by move=> _ r1 ->; rewrite EX.
qed.

hoare _os_sqrn__h _a:
 M._os_sqrn_ : a=_a ==> bn res = bn _a * bn _a.
proof. by proc; wp; ecall (_os_sqrn_h a); auto. qed.

(* Montgomery reduction, the constants given as the two halves of [_P_mP].
   Row 0 reads its window from a, later rows from r (the "window" X0
   below); w0 holds the window's first word. At row k, with M the sum of
   the multipliers so far (a ghost):
     (window + c * R) * W^k = a[0..nlimbs+k) + M * P,   0 <= M < W^k *)
lemma __mont_redM_halves_h rInv __P __mP __U0 _a:
 (rInv * BN.bn_modulus) %% BN.bn __P = 1 =>
 bn __P + BN.bn __mP = BN.bn_modulus =>
 __U0 * __P.[0] = W64.of_int (-1) =>
 bn _a < bn __P * BN.bn_modulus =>
 hoare [ M.__mont_redM
       : BN.A.init (fun i => _P_mP.[i]) = __P
         /\ BN.A.init (fun i => _P_mP.[nlimbs + i]) = __mP /\ _U0=__U0 /\ a=_a
         ==> bn res = (bn _a * rInv) %% bn __P
       ].
proof.
move => rInv_r P_mP U0_P0 a_bnd.
proc.
ecall (BNB._cminusP__h r mP c); wp.
while (a = _a /\ BN.A.init (fun i => _P_mP.[i]) = __P
       /\ BN.A.init (fun i => _P_mP.[nlimbs + i]) = __mP /\ _U0 = __U0
       /\ 0 <= k <= nlimbs /\ to_uint c <= 1 /\ (k = 0 => c = W64.zero)
       /\ w0 = (if k = 0 then _a.[0] else r.[0])
       /\ exists M, 0 <= M < 18446744073709551616 ^ k
           /\ ((if k = 0 then BN2.bnk nlimbs _a else BN.bnk nlimbs r)
                + to_uint c * 18446744073709551616 ^ nlimbs) * 18446744073709551616 ^ k
              = BN2.bnk (nlimbs + k) _a + M * BN.bnk nlimbs __P).
 exists* r, c, k, w0; elim* => r0 c0 k0 w00 M0.
 pose X0 := if k0 = 0 then BN.A.init (fun j => _a.[j]) else r0.
 wp.
 while (a = _a /\ BN.A.init (fun i => _P_mP.[i]) = __P
        /\ BN.A.init (fun i => _P_mP.[nlimbs + i]) = __mP /\ _U0 = __U0
        /\ k = k0 /\ c = c0 /\ 0 <= k0 < nlimbs /\ to_uint c0 <= 1
        /\ (k0 = 0 => c0 = W64.zero)
        /\ w00 = X0.[0] /\ 0 <= M0 < 18446744073709551616 ^ k0
        /\ (BN.bnk nlimbs X0 + to_uint c0 * 18446744073709551616 ^ nlimbs)
            * 18446744073709551616 ^ k0
           = BN2.bnk (nlimbs + k0) _a + M0 * BN.bnk nlimbs __P
        /\ m = w00 * __U0
        /\ 1 <= i <= nlimbs /\ (forall j, i <= j < nlimbs => r.[j] = r0.[j])
        /\ (2 <= i => w0 = r.[0])
        /\ to_uint hi <= 18446744073709551616 - 2
        /\ (BN.bnk (i-1) r
            + (to_uint hi + b2i cf + b2i of_0) * 18446744073709551616 ^ (i-1))
            * 18446744073709551616
           = BN.bnk i X0 + to_uint m * BN.bnk i __P).
  seq 1 : (#pre /\ t = X0.[i]).
   if.
    by auto => /> &hr *; rewrite /X0; smt(BN.A.initiE).
   by auto => /> &hr *; rewrite /X0; smt().
  seq 4 : (a = _a /\ BN.A.init (fun i => _P_mP.[i]) = __P
           /\ BN.A.init (fun i => _P_mP.[nlimbs + i]) = __mP /\ _U0 = __U0
           /\ k = k0 /\ c = c0 /\ 0 <= k0 < nlimbs /\ to_uint c0 <= 1
           /\ (k0 = 0 => c0 = W64.zero)
           /\ w00 = X0.[0] /\ 0 <= M0 < 18446744073709551616 ^ k0
           /\ (BN.bnk nlimbs X0 + to_uint c0 * 18446744073709551616 ^ nlimbs)
               * 18446744073709551616 ^ k0
              = BN2.bnk (nlimbs + k0) _a + M0 * BN.bnk nlimbs __P
           /\ m = w00 * __U0
           /\ 1 <= i < nlimbs /\ (forall j, i + 1 <= j < nlimbs => r.[j] = r0.[j])
           /\ (2 <= i => w0 = r.[0]) /\ r.[i-1] = t
           /\ to_uint hi <= 18446744073709551616 - 2
           /\ (BN.bnk i r
               + (to_uint hi + b2i cf + b2i of_0) * 18446744073709551616 ^ i)
               * 18446744073709551616
              = BN.bnk (i+1) X0 + to_uint m * BN.bnk (i+1) __P).
   wp; skip => /> &hr.
   move=> HP HmP Hk0 Hk1 Hc0 Hc00 HM0 HM1 Hinv0 Hi1 Hi2 Hfr Hw0 Hh Hinv Hi3.
   rewrite /ADCX_64 /ADOX_64 /MULX_64 /=.
   split.
   by move=> j Hj1 Hj2; rewrite BN.A.get_setE 1:/# (_: j <> i{hr} - 1) 1:/# /= Hfr /#.
   split.
   by move=> H2; rewrite BN.A.get_setE 1:/# (_: 0 <> i{hr} - 1) 1:/# /= Hw0.
   split; first by rewrite BN.A.get_setE 1:/#.
   split; first exact JBigNumber.mulu_hi_bnd.
   have EP: _P_mP{hr}.[i{hr}] = __P.[i{hr}] by rewrite -HP BN.A.initiE 1:/#.
   rewrite HP in Hinv; rewrite HP BN.bnk_putS 1:/# EP !bnkS 1,2:/# /=.
   pose m := X0.[0] * __U0.
   pose t1 := addc X0.[i{hr}] hi{hr} cf{hr}.
   pose t2 := addc t1.`2 (mulu m __P.[i{hr}]).`2 of_0{hr}.
   have A1 := JBigNumber.addc_to_uint X0.[i{hr}] hi{hr} cf{hr}.
   have A2 := JBigNumber.addc_to_uint t1.`2 (mulu m __P.[i{hr}]).`2 of_0{hr}.
   have M := JBigNumber.mulu_to_uint m __P.[i{hr}].
   have ->: to_uint t2.`2 + 18446744073709551616 * (to_uint (mulu m __P.[i{hr}]).`1 + b2i t1.`1 + b2i t2.`1) = to_uint X0.[i{hr}] + to_uint hi{hr} + b2i cf{hr} + b2i of_0{hr} + to_uint m * to_uint __P.[i{hr}] by move: A1 A2 M; rewrite -/t1 -/t2 (_: W64.modulus = 18446744073709551616) //; smt().
   have EW: 18446744073709551616 ^ i{hr} = 18446744073709551616 ^ (i{hr} - 1) * 18446744073709551616 by rewrite -exprSr 1:/#.
   have ->: bnk i{hr} X0 = (bnk (i{hr} - 1) r{hr} + (to_uint hi{hr} + b2i cf{hr} + b2i of_0{hr}) * 18446744073709551616 ^ (i{hr} - 1)) * 18446744073709551616 - to_uint m * bnk i{hr} __P by rewrite Hinv /m; ring.
   by rewrite EW; ring.
  if; auto => /> &hr.
   by move=> *; smt().
  by move=> *; smt().
 (* the row: its first word vanishes; its top word, with the carry, and
    the first word of the next window *)
 wp; skip => /> &hr.
 move=> HP HmP Hk00 Hk01 Hc0 Hc00 HM0 HM1 Hinv0 Hk.
 have EX0: (if k0 = 0 then _a.[0] else r0.[0]) = X0.[0].
 rewrite /X0; case: (k0 = 0) => // _; rewrite BN.A.initiE; smt(gt0_nlimbs).
 have EXn: (if k0 = 0 then BN2.bnk nlimbs _a else BN.bnk nlimbs r0) = BN.bnk nlimbs X0.
 rewrite /X0; case: (k0 = 0) => // _; rewrite (bnk_low _ _a nlimbs) //; [smt(gt0_nlimbs) | move=> j Hj; rewrite BN.A.initiE /#].
 move: Hinv0; rewrite EXn => Hinv0.
 rewrite EX0 HP; rewrite HP in Hinv0.
 rewrite /ADCX_64 /ADOX_64 /MULX_64 /set0_64_ /=.
 have EP0: _P_mP{hr}.[0] = __P.[0] by rewrite -HP BN.A.initiE; smt(gt0_nlimbs).
 rewrite EP0.
 split.
 split; first done.
 split; first smt(gt0_nlimbs).
 split; first by have := JBigNumber.mulu_hi_bnd (X0.[0] * __U0) __P.[0].
 rewrite BN.bnk0 !bnk1 /=.
 have M := JBigNumber.mulu_to_uint (X0.[0] * __U0) __P.[0].
 have A := JBigNumber.addc_to_uint X0.[0] (mulu (X0.[0] * __U0) __P.[0]).`2 false.
 have L := JBigNumber.mont_low0 X0.[0] __U0 __P.[0] U0_P0.
 pose t := addc X0.[0] (mulu (X0.[0] * __U0) __P.[0]).`2 false.
 have [Ht0 Ht1] := W64.to_uint_cmp t.`2.
 have E1: to_uint X0.[0] + to_uint (X0.[0] * __U0) * to_uint __P.[0] = to_uint t.`2 + W64.modulus * (b2i t.`1 + to_uint (mulu (X0.[0] * __U0) __P.[0]).`1) by move: A M; rewrite -/t; smt().
 have Ht: to_uint t.`2 = 0 by move: L; rewrite E1 (mulzC W64.modulus) modzMDr modz_small //; smt().
 by rewrite E1 Ht (_: W64.modulus = 18446744073709551616) // b2i0 /=; ring.
 move=> cf0 hi0 i0 of0 r1 w01 Hi0 _ Hi01 Hi02 Hfr Hw0 Hh Hinv.
 have Ei: i0 = nlimbs by smt().
 move: Hinv Hfr Hw0; rewrite Ei => Hinv _ Hw0.
 have [Hr00 Hr01] := bnk_cmp nlimbs X0.
 have [HP0 HP1] := bnk_cmp nlimbs __P.
 have [Hm0 Hm1] := W64.to_uint_cmp (X0.[0] * __U0).
 have [Hr10 _] := bnk_cmp (nlimbs - 1) r1.
 have E2: 18446744073709551616 ^ nlimbs = 18446744073709551616 ^ (nlimbs - 1) * 18446744073709551616 by rewrite -exprSr; smt(gt0_nlimbs).
 have Hm2: to_uint (X0.[0] * __U0) <= 18446744073709551616 - 1 by move: Hm1; rewrite (_: W64.modulus = 18446744073709551616) //; smt().
 have HP2: bnk nlimbs __P <= 18446744073709551616 ^ nlimbs - 1 by move: HP1; smt().
 have HmPb := StdOrder.IntOrder.ler_pmul (to_uint (X0.[0] * __U0)) (18446744073709551616 - 1) (bnk nlimbs __P) (18446744073709551616 ^ nlimbs - 1) Hm0 HP0 Hm2 HP2.
 have H: (to_uint hi0 + b2i cf0 + b2i of0) * (18446744073709551616 ^ (nlimbs - 1) * 18446744073709551616) < 18446744073709551616 * (18446744073709551616 ^ (nlimbs - 1) * 18446744073709551616) by move: Hinv Hr00 Hr01 HmPb Hr10 E2; smt().
 have HX: to_uint hi0 + b2i cf0 + b2i of0 < 18446744073709551616 by move: H; rewrite StdOrder.IntOrder.ltr_pmul2r 1:/#.
 have [_ E3] := JBigNumber.addc_nc hi0 W64.zero cf0 _.
 by rewrite W64.to_uint0; move: Hh; case: cf0 => /= /#.
 have [_ E4] := JBigNumber.addc_nc (addc hi0 W64.zero cf0).`2 W64.zero of0 _.
 by rewrite E3 W64.to_uint0; move: HX; case: cf0; case: of0 => /= /#.
 pose w := (addc (addc hi0 W64.zero cf0).`2 W64.zero of0).`2.
 have Ew: to_uint w = to_uint hi0 + b2i cf0 + b2i of0 by rewrite /w E4 E3 !W64.to_uint0.
 have GEN: forall (ci: bool) (K: int), K = k0 + nlimbs => b2i ci = to_uint c0 =>
   b2i (addc w _a.[K] ci).`1 <= 1 /\
   exists M1, 0 <= M1 < 18446744073709551616 ^ (k0 + 1) /\
    (bnk nlimbs r1.[nlimbs - 1 <- (addc w _a.[K] ci).`2]
     + b2i (addc w _a.[K] ci).`1 * 18446744073709551616 ^ nlimbs) * 18446744073709551616 ^ (k0 + 1)
    = bnk (nlimbs + (k0 + 1)) _a + M1 * bnk nlimbs __P.
 move=> ci K EK Eci.
 pose s := addc w _a.[K] ci.
 have A := JBigNumber.addc_to_uint w _a.[K] ci.
 split; first by case: (s.`1).
 exists (M0 + to_uint (X0.[0] * __U0) * 18446744073709551616 ^ k0).
 have HY: 0 < 18446744073709551616 ^ k0 by apply StdOrder.IntOrder.expr_gt0.
 have E1: 18446744073709551616 ^ (k0 + 1) = 18446744073709551616 ^ k0 * 18446744073709551616 by rewrite exprSr.
 split.
 have Hle: to_uint (X0.[0] * __U0) * 18446744073709551616 ^ k0 <= (18446744073709551616 - 1) * 18446744073709551616 ^ k0 by apply StdOrder.IntOrder.ler_wpmul2r; [smt() | move: Hm2; smt()].
 by rewrite E1; move: HM0 HM1 Hm0 HY Hle; smt().
 have ->: bnk nlimbs r1.[nlimbs - 1 <- s.`2] = bnk (nlimbs - 1) r1 + to_uint s.`2 * 18446744073709551616 ^ (nlimbs - 1).
 have := BN.bnkS (nlimbs - 1) r1.[nlimbs - 1 <- s.`2] _; first smt(gt0_nlimbs).
 rewrite (_: nlimbs - 1 + 1 = nlimbs) 1:/# => ->.
 rewrite /= BN.A.get_setE; first smt(gt0_nlimbs).
 by rewrite /= BN.bnk_setO; [smt(gt0_nlimbs) | ring].
 have Es: to_uint s.`2 = to_uint hi0 + b2i cf0 + b2i of0 + to_uint _a.[K] + to_uint c0 - 18446744073709551616 * b2i s.`1 by move: A; rewrite Eci Ew.
 rewrite Es EK (_: nlimbs + (k0 + 1) = nlimbs + k0 + 1) 1:/# BN2.bnkS 1:/# /= (addzC nlimbs k0).
 have E5: 18446744073709551616 ^ (k0 + nlimbs) = 18446744073709551616 ^ nlimbs * 18446744073709551616 ^ k0 by rewrite exprD_nneg 1,2:/#; ring.
 rewrite E1 E5; move: Hinv0; rewrite (addzC nlimbs k0) => Hinv0.
 have ->: bnk (k0 + nlimbs) _a = (bnk nlimbs X0 + to_uint c0 * 18446744073709551616 ^ nlimbs) * 18446744073709551616 ^ k0 - M0 * bnk nlimbs __P by rewrite Hinv0; ring.
 have ->: bnk nlimbs X0 = (bnk (nlimbs - 1) r1 + (to_uint hi0 + b2i cf0 + b2i of0) * 18446744073709551616 ^ (nlimbs - 1)) * 18446744073709551616 - to_uint (X0.[0] * __U0) * bnk nlimbs __P by rewrite Hinv; ring.
 by rewrite E2; ring.
 have EM: forall (b: bool), to_uint (addc (MOV_64 W64.zero) W64.zero b).`2 = b2i b.
 move=> b; rewrite /MOV_64; have [_ ->] := JBigNumber.addc_nc W64.zero W64.zero b _.
 by rewrite W64.to_uint0; case: b.
 by rewrite W64.to_uint0.
 rewrite !EM.
 split.
 move=> Hk0.
 have Ec0: to_uint c0 = 0 by rewrite Hc00 // W64.to_uint0.
 have [G1 [M1 [GM G2]]] := GEN false nlimbs _ _; [by rewrite Hk0 | by rewrite Ec0 |].
 move: GM G2; rewrite Hk0 /= => GM G2.
 split => Hn1.
 do! split; [smt(gt0_nlimbs) | done | by rewrite BN.A.get_setE 1:/# Hn1 | by exists M1].
 do! split; [smt(gt0_nlimbs) | done | | by exists M1].
 by rewrite BN.A.get_setE 1:/# (_: 0 <> nlimbs - 1) 1:/# /= Hw0 1:/#.
 move=> Hk0.
 have EC: b2i (NEG_64 c0).`2 = to_uint c0.
 rewrite /NEG_64 /=; case: (c0 = W64.zero) => [-> | Hc]; first by rewrite W64.to_uint0.
 have H0: to_uint c0 <> 0 by move: Hc; rewrite W64.to_uint_eq W64.to_uint0.
 by rewrite /= b2i1; move: Hc0 H0 (W64.to_uint_cmp c0); smt().
 have [G1 [M1 [GM G2]]] := GEN (NEG_64 c0).`2 (k0 + nlimbs) _ EC => //.
 rewrite (_: (k0 + 1 = 0) = false) 1:/# /=.
 split => Hn1.
 do! split; [smt() | smt() | done | by rewrite BN.A.get_setE 1:/# Hn1 | by exists M1].
 do! split; [smt() | smt() | done | | by exists M1].
 by rewrite BN.A.get_setE 1:/# (_: 0 <> nlimbs - 1) 1:/# /= Hw0 1:/#.
(* the start (the window is a) and the final conditional subtraction *)
wp; skip => /> &hr HP HmP.
rewrite HP HmP.
split.
split; first smt(gt0_nlimbs).
by exists 0.
move=> c0 k0 r1 Hk0 _ Hk1 Hc0 Hc00 M0 HM0 HM1 Hinv.
have EK: k0 = nlimbs by smt().
have Hn := gt0_nlimbs.
move: HM1 Hinv; rewrite EK (_: (nlimbs = 0) = false) 1:/# /= (_: nlimbs + nlimbs = 2 * nlimbs) 1:/# => HM1 Hinv.
have ER: BN.bn_modulus = 18446744073709551616 ^ nlimbs by rewrite BN.bn_modulusE.
have HPr: 0 <= BN.bnk nlimbs __P <= BN.bn_modulus by move: (BN.bnk_cmp nlimbs __P) (BN.bnk_cmp nlimbs __mP) P_mP; rewrite ER; smt().
have HA: 0 <= BN2.bnk (2*nlimbs) _a < BN.bnk nlimbs __P * BN.bn_modulus by move: (BN2.bnk_cmp (2*nlimbs) _a) a_bnd; smt().
have HM: 0 <= M0 < BN.bn_modulus by rewrite ER; smt().
have Hr: 0 <= BN.bnk nlimbs r1 < BN.bn_modulus by move: (BN.bnk_cmp nlimbs r1); rewrite ER.
have HT: (BN.bnk nlimbs r1 + to_uint c0 * BN.bn_modulus) * BN.bn_modulus = BN2.bnk (2*nlimbs) _a + M0 * BN.bnk nlimbs __P by rewrite ER.
have [Hlb1 HMR] := JBigNumber.montred_math (BN2.bnk (2*nlimbs) _a) M0 (BN.bnk nlimbs __P) BN.bn_modulus (BN.bnk nlimbs r1 + to_uint c0 * BN.bn_modulus) rInv (to_uint c0) (BN.bnk nlimbs r1) HPr rInv_r HA HM HT _ Hr _.
done.
smt(W64.to_uint_cmp).
have ->: BN.bnk nlimbs __mP = BN.bn_modulus - BN.bnk nlimbs __P by smt().
move: HMR; case: (BN.bn_modulus <= to_uint c0 * BN.bn_modulus + BN.bnk nlimbs r1 + (BN.bn_modulus - BN.bnk nlimbs __P)) => H /=.
by move=> <-; rewrite BN.bn_ofintK.
done.
qed.

(* [_P_mP] packs P and mP = R - P, as for Bn_mul.__mont_redM_h *)
lemma __mont_redM_h rInv __P __mP __U0 _a:
 (rInv * BN.bn_modulus) %% BN.bn __P = 1 =>
 bn __P + BN.bn __mP = BN.bn_modulus =>
 __U0 * __P.[0] = W64.of_int (-1) =>
 bn _a < bn __P * BN.bn_modulus =>
 hoare [ M.__mont_redM
       : BN2.bn _P_mP = BN.bn __P + BN.bn __mP * BN.bn_modulus /\ _U0=__U0 /\ a=_a
         ==> bn res = (bn _a * rInv) %% bn __P
       ].
proof.
move => rInv_r P_mP U0_P0 a_bnd.
conseq (__mont_redM_halves_h rInv __P __mP __U0 _a rInv_r P_mP U0_P0 a_bnd)
 => // &hr [H [-> ->]].
by have [-> ->] := bn2_unpack _ _ _ H.
qed.


(******************************************************************************
 **                     CORRECTNESS [phoare]                                 **
 ******************************************************************************)

phoare _os_muln__ph _a _b:
 [ M._os_muln_
 : a=_a /\ b=_b ==> bn res = bn _a * bn _b
 ] = 1%r.
proof. by conseq _os_muln__ll (_os_muln__h _a _b). qed.

phoare _os_sqrn__ph _a:
 [ M._os_sqrn_
 : a=_a ==> bn res = bn _a * bn _a
 ] = 1%r.
proof. by conseq _os_sqrn__ll (_os_sqrn__h _a). qed.

lemma __mont_redM_ph rInv __P __mP __U0 _a:
 (rInv * BN.bn_modulus) %% BN.bn __P = 1 =>
 bn __P + BN.bn __mP = BN.bn_modulus =>
 __U0 * __P.[0] = W64.of_int (-1) =>
 bn _a < bn __P * BN.bn_modulus =>
 phoare [ M.__mont_redM
        : BN2.bn _P_mP = BN.bn __P + BN.bn __mP * BN.bn_modulus /\ _U0=__U0 /\ a=_a
          ==> bn res = (bn _a * rInv) %% bn __P
        ] = 1%r.
proof.
move => rInv_r P_mP U0_P0 a_bnd.
by conseq __mont_redM_ll (__mont_redM_h rInv __P __mP __U0 _a rInv_r P_mP U0_P0 a_bnd).
qed.
