(* first row: r[0..nlimbs] = a * b; the carry chain is CF, and the pending
   value of the next word is hi + cf *)
hoare __mul1_h _a _b:
 M.__mul1 : a=_a /\ b=_b ==> BN2.bnk (nlimbs+1) res = to_uint _a * bn _b.
proof.
proc.
wp; while (a=_a /\ b=_b /\ 1 <= i <= nlimbs /\ to_uint hi <= 18446744073709551616 - 2
           /\ BN2.bnk i r + (to_uint hi + b2i cf) * 18446744073709551616 ^ i
              = to_uint _a * bnk i _b).
