 rewrite /ADCX_64 /MULX_64 /=.
 split; first smt().
 split; first exact JBigNumber.mulu_hi_bnd.
 rewrite BN2.bnk_put 1:/# bnkS 1:/# /=.
 have A := JBigNumber.addc_to_uint hi{hr} (mulu _a _b.[i{hr}]).`2 cf{hr}.
 have M := JBigNumber.mulu_to_uint _a _b.[i{hr}].
 have ->: to_uint (addc hi{hr} (mulu _a _b.[i{hr}]).`2 cf{hr}).`2
          + 18446744073709551616 * (to_uint (mulu _a _b.[i{hr}]).`1
                                    + b2i (addc_carry hi{hr} (mulu _a _b.[i{hr}]).`2 cf{hr}))
          = to_uint hi{hr} + b2i cf{hr} + to_uint _a * to_uint _b.[i{hr}]
  by move: A M; rewrite (_: W64.modulus = 18446744073709551616) //; smt().
 have ->: BN2.bnk i{hr} r{hr}
          = to_uint _a * bnk i{hr} _b - (to_uint hi{hr} + b2i cf{hr}) * 18446744073709551616 ^ i{hr}
  by rewrite -Hinv; ring.
 by ring.
wp; skip => &hr />.
rewrite /ADCX_64 /MULX_64 /set0_64_ /=.
split.
 split; first smt(gt0_nlimbs).
 split; first exact JBigNumber.mulu_hi_bnd.
 rewrite BN2.bnk1 bnk1 /= BN2.A.get_setE; first smt(gt0_nlimbs).
 have := JBigNumber.mulu_to_uint a{hr} b{hr}.[0].
 by rewrite (_: W64.modulus = 18446744073709551616) //=; smt().
move=> cf0 hi0 i0 r0 H1 H2 H3 Hh Hinv; have Ei: i0 = nlimbs by smt().
move: Hinv; rewrite Ei => Hinv.
have [_ E] := JBigNumber.addc_nc hi0 W64.zero cf0 _.
