proc; inline _addc1U_ _addc1U; wp.
ecall (__addc1U_h a1 b1 cf1).
wp; skip => /> r ->.
rewrite bn_set0_hi {1}(:1=0+1) 1:// bnk_withcarryS_r 1:/#.
rewrite bnk_withcarry0 !bnk1 /=.
by ring.
qed.

