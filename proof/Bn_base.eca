(* obs: the carry is propagated from limb [k] *)
hoare __carrypropU_h _a _cf _k:
 M.__carrypropU : a=_a /\ cf=_cf /\ k=_k /\ 0 <= _k <= nlimbs
 ==> bn_withcarry res = bn _a + b2i _cf * W64.modulus ^ _k.
proof.
proc.
while (0 <= _k <= i <= nlimbs /\
       (forall j, i <= j < nlimbs => a.[j] = _a.[j]) /\
       bnk_withcarry i (cf, a) = bnk i _a + b2i _cf * W64.modulus ^ _k).
 wp; skip => /> &hr Hk Hi1 _ Ha H Hi2.
 split; first smt().
 split.
  by move=> j Hj1 Hj2; rewrite get_setE 1:/# ifF /#.
 rewrite bnk_withcarryS_r 1:/# H bnkS 1:/# /= Ha 1:/#.
 by ring.
auto => /> Hk1 Hk2; split.
 by rewrite /bnk_withcarry /=; ring.
by move=> a cf i ???; rewrite (:i=nlimbs) 1:/#.
qed.

(* inner loop of [addcU]: limbs [1..nlimbs-1] *)
hoare __addc1U_h _a _b _cf:
 M.__addc1U : a=_a /\ b=_b /\ cf=_cf
 ==> bn_withcarry res
     = bnk_withcarry 1 (_cf, _a) + (bn _a - bnk 1 _a) + (bn _b - bnk 1 _b).
proof.
have Hlimbs:= gt0_nlimbs; proc.
while (1 <= i <= nlimbs /\ b = _b /\
       (forall j, i <= j < nlimbs => a.[j] = _a.[j]) /\
       bnk_withcarry i (cf, a)
       = bnk_withcarry 1 (_cf, _a) + (bnk i _a - bnk 1 _a) + (bnk i _b - bnk 1 _b)).
 wp; skip => /> &hr Hi1 _ Ha H Hi2.
 split; first smt().
 split.
  by move=> j Hj1 Hj2; rewrite get_setE 1:/# ifF /#.
 rewrite bnk_withcarryS_r 1:/# H !bnkS 1..2:/# /= Ha 1:/#.
 by ring.
auto => />; split; first smt().
by move=> a cf i ???; rewrite (:i=nlimbs) 1:/#.
qed.

