proc; inline _ltc1_cf_ _ltc1_cf; wp.
ecall (__ltc1_cf_h a1 b1 cf1).
wp; skip => />.
rewrite (bn_k_kup 1 _a) 1:/# (bn_k_kup 1 _b) 1:/# subcE /borrow_sub /= !bnk1 /=.
have := W64.to_uint_cmp _a.[0]; have := W64.to_uint_cmp _b.[0].
move: (to_uint _a.[0]) (to_uint _b.[0]) (bnkup 1 _a) (bnkup 1 _b) => a0 b0 PA PB /= Hb Ha.
smt().
qed.

