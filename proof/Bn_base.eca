(* inner loop of [ltc_cf]: limbs [1..nlimbs-1] (only the final borrow is kept) *)
hoare __ltc1_cf_h _a _b _cf:
 M.__ltc1_cf : a=_a /\ b=_b /\ cf=_cf
 ==> res = (bn _a - bnk 1 _a < bn _b - bnk 1 _b + b2i _cf * W64.modulus).
proof.
have Hlimbs:= gt0_nlimbs; proc.
while (1 <= i <= nlimbs /\ a = _a /\ b = _b /\
       0 <= (bnk i _a - bnk 1 _a) - (bnk i _b - bnk 1 _b) - b2i _cf * W64.modulus
            + b2i cf * W64.modulus ^ i < W64.modulus ^ i).
 wp; skip => /> &hr Hi1 _ H1 H2 Hi2.
 have Hc := to_uint_withborrow_subc _a.[i{hr}] _b.[i{hr}] cf{hr}.
 case _: (subc _a.[i{hr}] _b.[i{hr}] cf{hr}) Hc => c w E /=.
 rewrite /to_uint_withborrow /= => Hc.
 have := W64.to_uint_cmp w; rewrite /= => -[Hw1 Hw2].
 rewrite !bnkS 1..2:/# /= exprS 1:/#.
 have ->: to_uint _a.[i{hr}]
          = to_uint w - b2i c * 18446744073709551616 + to_uint _b.[i{hr}] + b2i cf{hr}
  by smt().
 have HX: 0 < 18446744073709551616 ^ i{hr} by apply StdOrder.IntOrder.expr_gt0.
 move: H1 H2 HX Hw1 Hw2.
 move: (bnk i{hr} _a) (bnk 1 _a) (bnk i{hr} _b) (bnk 1 _b) (to_uint w)
       (to_uint _b.[i{hr}]) (18446744073709551616 ^ i{hr}) => A A1 B B1 W Bi X H1 H2 HX Hw1 Hw2.
 have HW: 0 <= X * W <= X * (18446744073709551616 - 1).
  by split; [apply StdOrder.IntOrder.mulr_ge0 | move=> _; apply StdOrder.IntOrder.ler_wpmul2l]; smt().
 have ->: (W - b2i c * 18446744073709551616 + Bi + b2i cf{hr}) * X + A - A1 - (Bi * X + B - B1)
          - b2i _cf * 18446744073709551616 + b2i c * (18446744073709551616 * X)
          = (A - A1 - (B - B1) - b2i _cf * 18446744073709551616 + b2i cf{hr} * X) + X * W
  by ring.
 smt().
auto => />; split; first smt(StdOrder.IntOrder.expr_gt0).
move=> cf i ???; rewrite (:i=nlimbs) 1:/# => H1 H2.
have HX: 0 < W64.modulus ^ nlimbs by apply StdOrder.IntOrder.expr_gt0.
by case: cf H1 H2 => /= H1 H2; smt().
qed.

hoare _lt_cf__h _a _b:
 M._lt_cf_ : a=_a /\ b=_b ==> res = bn _a < bn _b.
proof.
