import JBigNumber.
hoare _load__h:
 M._load_ :  true  ==>  true.
proof. by proc; inline*; wp; while true; auto. qed.

hoare _store__h:
 M._store_ :  true  ==>  true.
proof. by proc; inline*; wp; while true; auto. qed.

(* [_load_] reads limb [i] from address [ap + 8*i] and leaves memory unchanged *)
hoare _load__mem_h _m _p:
 M._load_ : Glob.mem = _m /\ ap = _p
 ==> Glob.mem = _m /\
     forall i, 0 <= i < nlimbs =>
       res.[i] = loadW64 _m (W64.to_uint (_p + W64.of_int (8 * i))).
proof.
proc; inline*.
wp; while (0 <= i <= nlimbs /\ Glob.mem = _m /\ ap1 = _p /\
           forall j, 0 <= j < i =>
             a1.[j] = loadW64 _m (W64.to_uint (_p + W64.of_int (8 * j)))).
 wp; skip => /> &hr Hi1 _ H Hi2; split; first smt().
 by move=> j Hj1 Hj2; rewrite BN.A.get_setE 1:/#; case: (j = i{hr}) => [->|?] /#.
auto => /> &hr; split; first smt(gt0_nlimbs).
by move=> a i ??? H j ??; apply H => /#.
qed.

(* when the [nlimbs] limbs at [p] do not wrap around, the address of limb [k]
   is [p + 8*k] (as an integer) *)
lemma to_uint_addr_small (p: W64.t) (k: int):
  W64.to_uint p + 8 * nlimbs <= W64.modulus => 0 <= k < nlimbs =>
  W64.to_uint (p + W64.of_int (8 * k)) = W64.to_uint p + 8 * k.
proof.
move=> Hp Hk; have Hp0 := W64.to_uint_cmp p.
(* [pose] hides the literal [2^64], on which the SMT solvers choke *)
have Hk8: 0 <= 8 * k < W64.modulus.
 by move: Hp Hp0; pose M:= W64.modulus; smt().
have E: W64.to_uint (W64.of_int (8 * k)) = 8 * k by rewrite W64.to_uint_small.
rewrite W64.to_uintD_small E //.
by move: Hp Hp0 Hk; pose M:= W64.modulus; smt().
qed.

(* [_store_] writes limb [i] at address [ap + 8*i] and leaves the rest of
   memory unchanged (provided the destination does not wrap around) *)
hoare _store__mem_h _m _p _a:
 M._store_ : Glob.mem = _m /\ ap = _p /\ a = _a /\
             W64.to_uint _p + 8 * nlimbs <= W64.modulus
 ==> (forall i, 0 <= i < nlimbs =>
        loadW64 Glob.mem (W64.to_uint (_p + W64.of_int (8 * i))) = _a.[i]) /\
     (forall x, x + 8 <= W64.to_uint _p \/ W64.to_uint _p + 8 * nlimbs <= x =>
        loadW64 Glob.mem x = loadW64 _m x).
proof.
have ?:= gt0_nlimbs.
proc; inline*.
wp; while (0 <= i <= nlimbs /\ ap0 = _p /\ a0 = _a /\
           W64.to_uint _p + 8 * nlimbs <= W64.modulus /\
           (forall j, 0 <= j < i =>
              loadW64 Glob.mem (W64.to_uint (_p + W64.of_int (8 * j))) = _a.[j]) /\
           (forall x, x + 8 <= W64.to_uint _p \/ W64.to_uint _p + 8 * nlimbs <= x =>
              loadW64 Glob.mem x = loadW64 _m x)).
 wp; skip => /> &hr Hi1 _ Hp H1 H2 Hi2; split; first smt().
 split.
 - move=> j Hj1 Hj2; case: (j = i{hr}) => [->|?].
   + by rewrite store_load64_eq.
   rewrite store_load64_neq; last by apply H1 => /#.
   by rewrite !to_uint_addr_small // /#.
 - move=> x Hx; rewrite store_load64_neq; last by apply H2.
   by rewrite to_uint_addr_small // /#.
auto => /> Hp; split; first smt().
by move=> mem i ??? H1 _ j ??; apply H1 => /#.
qed.

hoare __eq_zf_h _a _b:
 M.__eq_zf: a=_a /\ b=_b ==> res =  (_a=_b).
proof.
proc; simplify. 
wp; while ( #pre /\ 0 <= i <= nlimbs /\ ((acc = W64.zero) <=> (bnk i a = bnk i b))).
 wp; skip => /> &hr Hi1 Hi2 [HL HR] Hi3.
 split; first smt().
 split.
  rewrite W64_orw_eq0 W64_xorw_eq0; move => [E1 E2].
  by rewrite !bnkS 1..2:/# /= E2 (HL E1) /#.
 move => /(BN.bnkS_eq _ _ _ Hi1) [E1 E2].
 by rewrite W64_orw_eq0 (HR E2) E1.
wp; skip => />; split; first smt(gt0_nlimbs BN.bnk0).
move=> acc i ???; rewrite (_:i=nlimbs) 1:/#.
move=> [H1 H2].
rewrite /AND_64 /rflags_of_bwop_w /flags_w /rflags_of_bwop /ZF_of /=.
by case: (acc = W64.zero) => C; smt(BN.bn_inj).
qed.

hoare _eq_zf__h _a _b:
 M._eq_zf_: a=_a /\ b=_b ==> res =  (_a=_b).
proof. by proc; inline _eq_zf; wp; ecall (__eq_zf_h a b); auto. qed.

hoare _eq__h _a _b:
 M._eq_ : a=_a /\ b=_b ==> to_uint res = b2i (_a=_b).
proof.
proc; wp; ecall (_eq_zf__h a b); auto => />.
by case: (_a=_b) => /> E.
qed.

hoare __test0_zf_h _a:
 M.__test0_zf : a=_a ==> res = (bn _a=0).
proof.
proc.
wp; while ( #pre /\ 0 <= i <= nlimbs /\ ((acc = W64.zero) <=> (bnk i a = 0))).
 wp; skip; progress; first 2 smt().
  move: H3; rewrite W64_orw_eq0 => [[E1 E2]].
  by rewrite bnkS 1:/# /= E2 to_uint0 /= -H1 E1.
 move: (BN.bnkS_eq0 _ _ H H3) => {H3} [H31 H32].
 by rewrite W64_orw_eq0 H1 H32 /= to_uint_eq /#.
wp; skip => />; progress.
   smt(gt0_nlimbs).
  by rewrite bnk1 /= H to_uint0.
 by move: H; rewrite bnk1 /= to_uint_eq /=.
move: H2; rewrite (_:i0=nlimbs) 1:/# => <-.
by rewrite /AND_64 /#.
qed.

hoare _test0_zf__h _a:
 M._test0_zf_: a=_a ==> res =  (bn _a=0).
proof. by proc; inline _eq_zf; wp; ecall (__test0_zf_h a); auto. qed.

hoare _test0__h _a:
 M._test0_ : a=_a ==> to_uint res = b2i (bn _a=0).
proof.
proc; wp; ecall (_test0_zf__h a); auto => />.
case (bn _a = 0) => _; smt().
qed.

hoare __copy_h _a:
 M.__copy : a=_a ==> res = _a.
proof.
proc; while (0 <= i <= nlimbs /\ _a = a /\ (forall j, 0 <= j < i => r.[j] = _a.[j])).
 by wp; skip; progress; [smt() | smt() | rewrite get_setE => /#]. 
wp; skip; progress; first 2 smt(gt0_nlimbs).  
by rewrite tP /#.
qed.

hoare _mov__h _a:
 M._mov_ : a=_a ==> res = _a.
proof.
proc; inline*.
wp; while (0 <= i <= nlimbs /\ _a = a1 /\ (forall j, 0 <= j < i => r1.[j] = _a.[j])).
 by wp; skip; progress; [smt() | smt() | rewrite get_setE /#].
wp; skip; progress; first 2 smt(gt0_nlimbs).  
by rewrite tP /#.
qed.

hoare _cmov__h _a _b _cond :
 M._cmov_ : cond=_cond /\ a=_a /\ b=_b
              ==> res = if _cond then _b else _a.
proof.
proc; inline*.
wp; while (0 <= i <= nlimbs /\ _cond = cond1 /\ _b = b1 /\
       (forall j, i <= j < nlimbs => a1.[j] = _a.[j]) /\
       forall j, 0 <= j < i => a1.[j] = if _cond then _b.[j] else _a.[j]).
 wp; skip => /> &hr *; split; first smt().
 split.
  move=> j Hj1 Hj2; rewrite get_setE 1:/#.
  by rewrite ifF 1:/# /#.
 by move=> j Hj1 Hj2; rewrite get_setE 1:/# /#.
wp; skip => />; split; first smt(gt0_nlimbs).
move=> a i ???; rewrite (:i=nlimbs) 1:/# => H1 H2.
by rewrite tP /#.
qed.

hoare __cswap_mask_h _x _y _cond:
 M.__cswap_mask : mask=W64.of_int (- b2i _cond) /\ x=_x /\ y=_y
                   ==> res = if _cond then (_y,_x) else (_x, _y).
proof.
have ?:= gt0_nlimbs.
proc; wp.
while (0 <= i <= nlimbs /\ mask=W64.of_int (- b2i _cond) /\
       (forall j, 0 <= j < i => x.[j] = (if _cond then _y.[j] else _x.[j])
                             /\ y.[j] = (if _cond then _x.[j] else _y.[j])) /\
       (forall j, i <= j < nlimbs => x.[j] = _x.[j] /\ y.[j] = _y.[j])).
 auto => /> &m Hi1 _ H1 H2 Hi2; split; first smt().
 split.
  move=> j Hj1 Hj2; rewrite !get_setE 1..2:/#.
  case: (j = i{m}) => [->|E]; last by apply H1 => /#.
  have [-> ->] := H2 i{m} _; first smt().
  case: (_cond) => /= _.
   rewrite b2i1 W64_of_int_m1 andw1; split.
    by rewrite xorwA xorwK xor0w.
   by rewrite xorwA (W64.xorwC _y.[i{m}] _x.[i{m}]) -xorwA xorwK xorw0.
  by rewrite b2i0 /=.
 move=> j Hj1 Hj2; rewrite !get_setE 1..2:/# !ifF 1..2:/#.
 by apply H2 => /#.
auto => />; split; first smt().
move=> i x y ???; rewrite (:i=nlimbs) 1:/# => H1 _.
by case: (_cond) => C; congr; rewrite tP => j Hj; smt().
qed.

hoare _cswap_mask__h _x _y _cond:
 M._cswap_mask_ : mask=W64.of_int (- b2i _cond) /\ x=_x /\ y=_y
                   ==> res = if _cond then (_y,_x) else (_x, _y).
proof.
proc; inline _cswap_mask; wp; ecall (__cswap_mask_h x0 y0 _cond).
by auto => />; case: (_cond).
qed.

hoare _cswap_cf__h _x _y _cf:
 M._cswap_cf_ : cf=_cf /\ x=_x /\ y=_y
                  ==> res = if _cf then (_y,_x) else (_x, _y).
proof.
proc.
ecall (_cswap_mask__h x y cf).
ecall (BNUTIL.__cf_mask_h cf).
by auto => /> /#.
qed.

hoare _fill__h _x:
 M._fill_ : x = _x ==> forall k, 0 <= k < nlimbs => res.[k] = _x.
proof.
have ?:= BN.gt0_nlimbs.
proc; inline*.
wp; while (0 <= i <= nlimbs /\ x0=_x /\
           forall j, 0 <= j < i => a0.[j] = _x).
 auto => /> &m *. split; first smt().
 move=> j Hj1 Hj2; rewrite get_setE 1:/#. 
 by case: (j=i{m}) => E /#.
by auto => /> &m /#.
qed.

hoare _set0__h:
 M._set0_ : true ==> bn res = 0.
proof.
proc.
ecall (_fill__h t); auto => /> a Ha.
have: nlimbs <= nlimbs by done.
elim/natind: {1 3}nlimbs => n Hn.
 by rewrite bnkN.
move=> IH Hnlimbs.
by rewrite bnkS 1:/# /dig Ha 1:/# /= IH /#.
qed.

hoare __cfill_h _a _cond _x:
 M.__cfill : b=_cond /\ x=_x /\ a=_a
              ==> if _cond then (forall k, 0 <= k < nlimbs => res.[k] = _x) else res = _a.
