qed.

hoare _negc__h _a _cf:
 M._negc_ : a=_a /\ cf=_cf ==> bn_withborrow res = 0 - (bn _a + b2i _cf).
proof.
have Hlimbs:= gt0_nlimbs.
proc; inline _negc1_ _negc1; wp.
ecall (__negc1_h r1 a1 cf1).
wp; skip => /> &hr [c r] /= ->.
rewrite {1}(:1=0+1) 1:// bnk_withborrowS_r 1:/#.
rewrite bnk_withborrow0 !bnk1 /=.
by ring.
qed.

hoare _cnegU__h _a _cond:
 M._cnegU_ : a=_a /\ cond=_cond
              ==> res = if to_uint _cond = 0 then _a else BN.bn_ofint (- bn _a).
proof.
proc.
ecall (_cmov__h a x cf).
ecall (BNUTIL.__mask_cf_h cond).
ecall (_neg__h a).
wp; skip => /> [c x] /= /bn_withborrow_ofint ->.
by case: (to_uint _cond = 0).
qed.

hoare _caddU__h _x _y _cf:
 M._caddU_ : x=_x /\ y=_y /\ cf=_cf
              ==> res = if _cf then BN.bn_ofint (bn _x + bn _y) else _x.
proof.
proc.
ecall (_addU__h x tmp).
ecall (_and_mask__h tmp mask).
ecall (BNUTIL.__cf_mask_h cf).
ecall (_mov__h y).
wp; skip => /> t H [c r] /= /bn_withcarry_ofint ->.
case: (_cf) => C /=.
 have ->//: t = _y.
 by rewrite tP => k Hk; rewrite H // C b2i1 W64_of_int_m1 andw1.
rewrite (bn_eq0 t) /=; last by rewrite bnK.
by move=> k Hk; rewrite H // C b2i0 andw0.
qed.


(* [lastbit] is an extra (most significant) bit of [x];
   the result is [x+mP] (mod bn_modulus) when that sum overflows *)
hoare _cminusP__h _x _mP _lastbit:
 M._cminusP_ : x=_x /\ mP=_mP /\ lastbit=_lastbit /\ to_uint _lastbit <= 1
                ==> res = if BN.bn_modulus <= to_uint _lastbit * BN.bn_modulus + bn _x + bn _mP
                          then BN.bn_ofint (bn _x + bn _mP)
                          else _x.
proof.
proc.
ecall (_cmov__h x tmp _cf).
wp.
ecall (_addU__h tmp mP).
ecall (_mov__h x).
wp; skip => /> Hlb [c r] /= Hr.
rewrite /NEG_64 /= addcE /= -(bn_withcarry_ofint _ _ _ Hr).
have ->: (_lastbit + W64.of_int (b2i c) <> W64.zero) = (to_uint _lastbit + b2i c <> 0).
 rewrite W64.to_uint_eq W64.to_uintD_small W64.of_uintK /=; smt(W64.to_uint_cmp).
move: Hr; rewrite /bnk_withcarry /= bn_modulusE /= => Hr.
have := bnk_cmp nlimbs r; rewrite /= => -[Hr1 Hr2].
have [Hx1 _] := bnk_cmp nlimbs _x.
have [Hm1 _] := bnk_cmp nlimbs _mP.
have [->|->]: to_uint _lastbit = 0 \/ to_uint _lastbit = 1 by smt(W64.to_uint_cmp).
 by case: c Hr => /= Hr; smt().
by case: c Hr => /= Hr; smt().
qed.


hoare __pack2_h _lo _hi:
 M.__pack2 : lo=_lo /\ hi=_hi ==> bn res = bn _lo + bn _hi * BN.bn_modulus.
proof.
have Hlimbs:= gt0_nlimbs; proc.
while (0 <= i <= nlimbs /\ hi = _hi /\
       (forall j, 0 <= j < nlimbs => r.[j] = _lo.[j]) /\
       (forall j, 0 <= j < i => r.[nlimbs + j] = _hi.[j])).
 wp; skip => /> &hr Hi1 _ H1 H2 Hi2.
 split; first smt().
 split.
  by move=> j Hj1 Hj2; rewrite BN2.A.get_setE 1:/# ifF 1:/# H1 //.
 by move=> j Hj1 Hj2; rewrite BN2.A.get_setE 1:/#; case: (j = i{hr}) => [->|?] /#.
wp; while (0 <= i <= nlimbs /\ lo = _lo /\ hi = _hi /\
           (forall j, 0 <= j < i => r.[j] = _lo.[j])).
 wp; skip => /> &hr Hi1 _ H1 Hi2.
 split; first smt().
 by move=> j Hj1 Hj2; rewrite BN2.A.get_setE 1:/#; case: (j = i{hr}) => [->|?] /#.
auto => /> &hr; split; first smt().
move=> i r ???; rewrite (:i=nlimbs) 1:/# => H1; split; first smt().
move=> i0 r0 ???; rewrite (:i0=nlimbs) 1:/# => H1p H2p.
by apply bn2_pack.
qed.

hoare _pack2__h _lo _hi:
 M._pack2_ : lo=_lo /\ hi=_hi ==> bn res = bn _lo + bn _hi * BN.bn_modulus.
proof. by proc; wp; ecall (__pack2_h lo hi); auto. qed.


(** PHoare statements *)

phoare _load__ph:
 [ M._load_
 : true ==> true
 ] = 1%r.
proof. by conseq _load__ll (_load__h). qed.

phoare _store__ph:
 [ M._store_
 : true ==> true
 ] = 1%r.
proof. by conseq _store__ll (_store__h). qed.

phoare _load__mem_ph _m _p:
 [ M._load_
 : Glob.mem = _m /\ ap = _p
 ==> Glob.mem = _m /\
     forall i, 0 <= i < nlimbs =>
       res.[i] = loadW64 _m (W64.to_uint (_p + W64.of_int (8 * i)))
 ] = 1%r.
proof. by conseq _load__ll (_load__mem_h _m _p). qed.

phoare _store__mem_ph _m _p _a:
 [ M._store_
 : Glob.mem = _m /\ ap = _p /\ a = _a /\
   W64.to_uint _p + 8 * nlimbs <= W64.modulus
 ==> (forall i, 0 <= i < nlimbs =>
        loadW64 Glob.mem (W64.to_uint (_p + W64.of_int (8 * i))) = _a.[i]) /\
     (forall x, x + 8 <= W64.to_uint _p \/ W64.to_uint _p + 8 * nlimbs <= x =>
        loadW64 Glob.mem x = loadW64 _m x)
 ] = 1%r.
proof. by conseq _store__ll (_store__mem_h _m _p _a). qed.

phoare _eq_zf__ph _a _b:
 [ M._eq_zf_
 : a=_a /\ b=_b ==> res = (_a=_b)
 ] = 1%r.
proof. by conseq _eq_zf__ll (_eq_zf__h _a _b). qed.

phoare _eq__ph _a _b:
 [ M._eq_
 : a=_a /\ b=_b ==> to_uint res = b2i (_a=_b)
 ] = 1%r.
proof. by conseq _eq__ll (_eq__h _a _b). qed.

phoare _test0_zf__ph _a:
 [ M._test0_zf_
 : a=_a ==> res =  (bn _a=0)
 ] = 1%r.
proof. by conseq _test0_zf__ll (_test0_zf__h _a). qed.

phoare _test0__ph _a:
 [ M._test0_
 : a=_a ==> to_uint res = b2i (bn _a=0)
 ] = 1%r.
proof. by conseq _test0__ll (_test0__h _a). qed.

phoare __copy_ph _a:
 [ M.__copy
 : a=_a ==> res = _a
 ] = 1%r.
proof. by conseq __copy_ll (__copy_h _a). qed.

phoare _mov__ph _a:
 [ M._mov_
 : a=_a ==> res = _a
 ] = 1%r.
proof. by conseq _mov__ll (_mov__h _a). qed.

phoare _cmov__ph _a _b _cond :
 [ M._cmov_
 : cond=_cond /\ a=_a /\ b=_b ==> res = if _cond then _b else _a
 ] = 1%r.
proof. by conseq _cmov__ll (_cmov__h _a _b _cond). qed.

phoare _cswap_mask__ph _x _y _cond:
 [ M._cswap_mask_
 : mask=W64.of_int (- b2i _cond) /\ x=_x /\ y=_y
                   ==> res = if _cond then (_y,_x) else (_x, _y)
 ] = 1%r.
proof. by conseq _cswap_mask__ll (_cswap_mask__h _x _y _cond). qed.

phoare _cswap_cf__ph _x _y _cf:
 [ M._cswap_cf_
 : cf=_cf /\ x=_x /\ y=_y
                   ==> res = if _cf then (_y,_x) else (_x, _y)
 ] = 1%r.
proof. by conseq _cswap_cf__ll (_cswap_cf__h _x _y _cf). qed.

phoare _fill__ph _x:
 [ M._fill_
 : x = _x ==> forall k, 0 <= k < nlimbs => res.[k] = _x
 ] = 1%r.
proof. by conseq _fill__ll (_fill__h _x). qed.

phoare _set0__ph:
 [ M._set0_
 : true ==> bn res = 0
 ] = 1%r.
proof. by conseq _set0__ll (_set0__h). qed.

phoare __cfill_ph _a _cond _x:
 [ M.__cfill
 : b=_cond /\ x=_x /\ a=_a
              ==> if _cond then (forall k, 0 <= k < nlimbs => res.[k] = _x) else res = _a
 ] = 1%r.
proof. by conseq __cfill_ll (__cfill_h _a _cond _x). qed.

phoare _or_mask__ph _a _mask:
 [ M._or_mask_
 : a=_a /\ mask=_mask  ==> forall k, 0 <= k < nlimbs => res.[k] = _a.[k] `|` _mask
 ] = 1%r.
proof. by conseq _or_mask__ll (_or_mask__h _a _mask). qed.

phoare _and_mask__ph _a _mask:
 [ M._and_mask_
 : a=_a /\ mask=_mask  ==> forall k, 0 <= k < nlimbs => res.[k] = _a.[k] `&` _mask
 ] = 1%r.
proof. by conseq _and_mask__ll (_and_mask__h _a _mask). qed.

phoare _set_err__ph _a _cond:
 [ M._set_err_
 : _err=W64.of_int (- b2i _cond) /\ a=_a
                  ==> if _cond then res=bn_err else res=_a
 ] = 1%r.
proof. by conseq _set_err__ll (_set_err__h _a _cond). qed.

phoare __carrypropU_ph _a _cf _k:
 [ M.__carrypropU
 : a=_a /\ cf=_cf /\ k=_k /\ 0 <= _k <= nlimbs
 ==> bn_withcarry res = bn _a + b2i _cf * W64.modulus ^ _k
 ] = 1%r.
proof. by conseq __carrypropU_ll (__carrypropU_h _a _cf _k). qed.

