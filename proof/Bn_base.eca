(* moveto JBigNum: "bn_err" = bn_modulus - 1 *)
op bn_err: BN.t = BN.A.create W64.onew.

lemma bn_errE: bn bn_err = BN.bn_modulus - 1.
proof.
have: forall k, 0 <= k <= nlimbs => bnk k bn_err = W64.modulus^k - 1.
 elim/natind => [k Hk Hk0|k Hk IH Hk0].
  by rewrite (_:k=0) 1:/# bnk0 expr0.
 rewrite bnkS // IH 1:/# /bn_err /= createiE 1:/# W64.to_uint_onew exprS //.
 by ring.
by rewrite bn_modulusE; apply; smt(gt0_nlimbs).
qed.

hoare _set_err__h _a _cond:
 M._set_err_ : _err=W64.of_int (- b2i _cond) /\ a=_a
                  ==> if _cond then res=bn_err else res=_a.
proof.
proc; ecall (_or_mask__h a err); auto => /> r H.
split => C; rewrite tP => k Hk; rewrite H // C /=.
 by rewrite /bn_err createiE // W64_of_int_m1 orw1.
by rewrite b2i0 orw0.
qed.

