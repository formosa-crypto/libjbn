require import AllCore Int IntDiv List.

from Jasmin require import JModel_x86.
import SLH64.

require JBigNumber.

(* Correctness contracts for bn_mulsel@n.jinc: the multiplication, squaring
   and Montgomery reduction selected at compile time, from the profile,
   among bn_mul, bn_mul_loop, bn_mulx and bn_mulx_loop.

   The profile (features and unrolling threshold) is abstract: each
   contract holds for every profile, by the contracts of the four modules,
   one per branch of the selection. Those of Bn_mul are proved; those of
   Bn_mul_loop, Bn_mulx and Bn_mulx_loop are admitted (in their theories).
   The statements are those of Bn_mul. *)

(* Parameters *)
op nlimbs: int.
axiom gt0_nlimbs: 0 < nlimbs.
(* for Bn_mul (the 3-word accumulators of product scanning) *)
axiom nlimbs_bnd: 4 * nlimbs < W64.modulus.

(* the profile (src/amd64/ref/profiles): JBN_FEATURES and JBN_UNROLL_MAX;
   any values *)
op jbn_features: int.
op jbn_unroll_max: int.

clone export JBigNumber.BigN
 with op nlimbs <- nlimbs
      proof gt0_nlimbs by exact gt0_nlimbs.

import BN2.
import BN.

require Bn_util.
clone Bn_util as BNUTIL.
module BNUTIL_M = BNUTIL.M.

require Bn_base.
clone Bn_base as BNB
 with op nlimbs <- nlimbs,
      theory BigN <- BigN,
      theory BNUTIL <- BNUTIL
      proof gt0_nlimbs by exact gt0_nlimbs.
module BNB_M = BNB.M.

(* the four modules: MUL::UNR, MUL::LOOP, MUL::XUNR, MUL::XLOOP *)
require Bn_mul.
clone Bn_mul as BNMUL
 with op nlimbs <- nlimbs,
      theory BigN <- BigN,
      theory BNUTIL <- BNUTIL,
      theory BNB <- BNB
      proof gt0_nlimbs by exact gt0_nlimbs,
            nlimbs_bnd by exact nlimbs_bnd.
module BNMUL_M = BNMUL.M.

require Bn_mul_loop.
clone Bn_mul_loop as BNMULL
 with op nlimbs <- nlimbs,
      theory BigN <- BigN,
      theory BNUTIL <- BNUTIL,
      theory BNB <- BNB
      proof gt0_nlimbs by exact gt0_nlimbs.
module BNMULL_M = BNMULL.M.

require Bn_mulx.
clone Bn_mulx as BNMULX
 with op nlimbs <- nlimbs,
      theory BigN <- BigN,
      theory BNUTIL <- BNUTIL,
      theory BNB <- BNB
      proof gt0_nlimbs by exact gt0_nlimbs.
module BNMULX_M = BNMULX.M.

require Bn_mulx_loop.
clone Bn_mulx_loop as BNMULXL
 with op nlimbs <- nlimbs,
      theory BigN <- BigN,
      theory BNUTIL <- BNUTIL,
      theory BNB <- BNB
      proof gt0_nlimbs by exact gt0_nlimbs.
module BNMULXL_M = BNMULXL.M.

(* module M: the extracted code of bn_mulsel@n.jinc (see proof/Makefile) *)
(* BEGIN generated by scripts/xtr_sync.py from src/amd64/ref/extracted/BNMULSEL_bn_mulsel.ec
   (bn_mulsel@n.jinc); do not edit: run `make -C proof update` *)
module M = {
  proc _muln_ (r:BN2.t, a:BN.t,
                       b:BN.t) : BN2.t = {
    
    if ((((W256.of_int jbn_features) `&` (W256.of_int (1 + 2))) =
        (W256.of_int (1 + 2)))) {
      if ((nlimbs <= jbn_unroll_max)) {
        r <@ BNMULX_M._os_muln_ (r, a, b);
      } else {
        r <@ BNMULXL_M._os_muln_ (r, a, b);
      }
    } else {
      if ((nlimbs <= jbn_unroll_max)) {
        r <@ BNMUL_M._ps_muln_ (r, a, b);
      } else {
        r <@ BNMULL_M._os_muln_ (r, a, b);
      }
    }
    return r;
  }
  proc _sqrn_ (r:BN2.t, a:BN.t) : BN2.t = {
    
    if ((((W256.of_int jbn_features) `&` (W256.of_int (1 + 2))) =
        (W256.of_int (1 + 2)))) {
      if ((nlimbs <= jbn_unroll_max)) {
        r <@ BNMULX_M._os_sqrn_ (r, a);
      } else {
        r <@ BNMULXL_M._os_sqrn_ (r, a);
      }
    } else {
      if ((nlimbs <= jbn_unroll_max)) {
        r <@ BNMUL_M._ps_sqrn_ (r, a);
      } else {
        r <@ BNMULL_M._os_sqrn_ (r, a);
      }
    }
    return r;
  }
  proc __mont_redM (r:BN.t, a:BN2.t,
                            _P_mP:BN2.t, _U0:W64.t) : BN.t = {
    
    if ((((W256.of_int jbn_features) `&` (W256.of_int (1 + 2))) =
        (W256.of_int (1 + 2)))) {
      if ((nlimbs <= jbn_unroll_max)) {
        r <@ BNMULX_M.__mont_redM (r, a, _P_mP, _U0);
      } else {
        r <@ BNMULXL_M.__mont_redM (r, a, _P_mP, _U0);
      }
    } else {
      if ((nlimbs <= jbn_unroll_max)) {
        r <@ BNMUL_M.__mont_redM (r, a, _P_mP, _U0);
      } else {
        r <@ BNMULL_M.__mont_redM (r, a, _P_mP, _U0);
      }
    }
    return r;
  }
}.
(* END generated *)


(******************************************************************************
 **                     LOSSLESSNESS                                         **
 ******************************************************************************)

lemma _muln__ll: islossless M._muln_.
proof.
proc; if; [if | if].
- by call BNMULX._os_muln__ll.
- by call BNMULXL._os_muln__ll.
- by call BNMUL._ps_muln__ll.
- by call BNMULL._os_muln__ll.
qed.

lemma _sqrn__ll: islossless M._sqrn_.
proof.
proc; if; [if | if].
- by call BNMULX._os_sqrn__ll.
- by call BNMULXL._os_sqrn__ll.
- by call BNMUL._ps_sqrn__ll.
- by call BNMULL._os_sqrn__ll.
qed.

lemma __mont_redM_ll: islossless M.__mont_redM.
proof.
proc; if; [if | if].
- by call BNMULX.__mont_redM_ll.
- by call BNMULXL.__mont_redM_ll.
- by call BNMUL.__mont_redM_ll.
- by call BNMULL.__mont_redM_ll.
qed.


(******************************************************************************
 **                     CORRECTNESS                                          **
 ******************************************************************************)

hoare _muln__h _a _b:
 M._muln_ : a=_a /\ b=_b ==> bn res = bn _a * bn _b.
proof.
proc; if; [if | if].
- by ecall (BNMULX._os_muln__h a b).
- by ecall (BNMULXL._os_muln__h a b).
- by ecall (BNMUL._ps_muln__h a b).
- by ecall (BNMULL._os_muln__h a b).
qed.

hoare _sqrn__h _a:
 M._sqrn_ : a=_a ==> bn res = bn _a * bn _a.
proof.
proc; if; [if | if].
- by ecall (BNMULX._os_sqrn__h a).
- by ecall (BNMULXL._os_sqrn__h a).
- by ecall (BNMUL._ps_sqrn__h a).
- by ecall (BNMULL._os_sqrn__h a).
qed.

(* [_P_mP] packs P and mP = R - P (the first 2*nlimbs words of a field
   context, or the result of [BN::_pack2_]) *)
lemma __mont_redM_h rInv __P __mP __U0 _a:
 (rInv * BN.bn_modulus) %% BN.bn __P = 1 =>
 bn __P + BN.bn __mP = BN.bn_modulus =>
 __U0 * __P.[0] = W64.of_int (-1) =>
 bn _a < bn __P * BN.bn_modulus =>
 hoare [ M.__mont_redM
       : BN2.bn _P_mP = BN.bn __P + BN.bn __mP * BN.bn_modulus /\ _U0=__U0 /\ a=_a
         ==> bn res = (bn _a * rInv) %% bn __P
       ].
proof.
move => rInv_r P_mP U0_P0 a_bnd.
proc; if; [if | if].
- by ecall (BNMULX.__mont_redM_h rInv __P __mP __U0 _a rInv_r P_mP U0_P0 a_bnd).
- by ecall (BNMULXL.__mont_redM_h rInv __P __mP __U0 _a rInv_r P_mP U0_P0 a_bnd).
- by ecall (BNMUL.__mont_redM_h rInv __P __mP __U0 _a rInv_r P_mP U0_P0 a_bnd).
- by ecall (BNMULL.__mont_redM_h rInv __P __mP __U0 _a rInv_r P_mP U0_P0 a_bnd).
qed.


(******************************************************************************
 **                     CORRECTNESS [phoare]                                 **
 ******************************************************************************)

phoare _muln__ph _a _b:
 [ M._muln_
 : a=_a /\ b=_b ==> bn res = bn _a * bn _b
 ] = 1%r.
proof. by conseq _muln__ll (_muln__h _a _b). qed.

phoare _sqrn__ph _a:
 [ M._sqrn_
 : a=_a ==> bn res = bn _a * bn _a
 ] = 1%r.
proof. by conseq _sqrn__ll (_sqrn__h _a). qed.

lemma __mont_redM_ph rInv __P __mP __U0 _a:
 (rInv * BN.bn_modulus) %% BN.bn __P = 1 =>
 bn __P + BN.bn __mP = BN.bn_modulus =>
 __U0 * __P.[0] = W64.of_int (-1) =>
 bn _a < bn __P * BN.bn_modulus =>
 phoare [ M.__mont_redM
        : BN2.bn _P_mP = BN.bn __P + BN.bn __mP * BN.bn_modulus /\ _U0=__U0 /\ a=_a
          ==> bn res = (bn _a * rInv) %% bn __P
        ] = 1%r.
proof.
move => rInv_r P_mP U0_P0 a_bnd.
by conseq __mont_redM_ll (__mont_redM_h rInv __P __mP __U0 _a rInv_r P_mP U0_P0 a_bnd).
qed.
