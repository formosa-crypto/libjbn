import IntOrder.

(******************************************************************************
 **  Integers                                                               **
 ******************************************************************************)

lemma sqr_abs (x: int): `|x| * `|x| = x * x.
proof. smt(). qed.

(* the word that counts the borrows of the three subtractions: two are
   added to it and one subtracted, and it does not wrap when their sum is
   not negative *)
lemma cnt3 (b1 b2 b3: bool):
 0 <= b2i b1 + b2i b2 - b2i b3 =>
 to_uint (sbb_64 (adc_64 (adc_64 (W64.of_int 0) (W64.of_int 0) b1).`2 (W64.of_int 0) b2).`2
                 (W64.of_int 0) b3).`2
 = b2i b1 + b2i b2 - b2i b3.
proof. by case: b1; case: b2; case: b3; rewrite !addcE !subcE /=. qed.

(* The squaring, on integers. With lo^2 = q0 + q1 B and hi^2 = q2 + q3 B,
   t1 and t2 are (lo - hi)^2 - lo^2 and t1 - hi^2 modulo B^2, with borrows
   b1 and b2, and m is the middle window q1 + q2 B minus t2, with borrow b3.
   Then the word b1 + b2 - b3 is 0, 1 or 2, adding it to the top quarter q3
   does not overflow it, and the four quarters are the square. *)
lemma ksqr_math (B lo hi q0 q1 q2 q3 t1 t2 m: int) (b1 b2 b3: bool):
  0 < B => 0 <= lo < B => 0 <= hi < B =>
  0 <= q0 < B => 0 <= q1 < B => 0 <= q2 < B => 0 <= q3 < B =>
  q0 + q1 * B = lo * lo => q2 + q3 * B = hi * hi =>
  0 <= t1 < B * B => t1 - b2i b1 * (B * B) = (lo - hi) * (lo - hi) - lo * lo =>
  0 <= t2 < B * B => t2 - b2i b2 * (B * B) = t1 - hi * hi =>
  0 <= m  < B * B => m  - b2i b3 * (B * B) = q1 + q2 * B - t2 =>
  0 <= b2i b1 + b2i b2 - b2i b3 <= 2
  /\ q3 + (b2i b1 + b2i b2 - b2i b3) < B
  /\ q0 + m * B + (q3 + (b2i b1 + b2i b2 - b2i b3)) * (B * B * B)
     = (lo + hi * B) * (lo + hi * B).
proof.
move=> HB [Hlo0 Hlo1] [Hhi0 Hhi1] [Hq00 Hq01] [Hq10 Hq11] [Hq20 Hq21] [Hq30 Hq31] E0 E1
       [Ht10 Ht11] Et1 [Ht20 Ht21] Et2 [Hm0 Hm1] Em.
have Hlh: 0 <= lo * hi by apply mulr_ge0.
have Hq2B: 0 <= q2 * B by apply mulr_ge0 => /#.
have HBB: 0 < B * B by apply mulr_gt0.
have X: (lo - hi) * (lo - hi) = lo * lo - 2 * (lo * hi) + hi * hi by ring.
(* the counter is not negative: with no borrow in t1 and t2, lo * hi = 0 *)
have Hc: 0 <= b2i b1 + b2i b2 - b2i b3.
 move: Et1 Et2 Em Ht10 Ht11 Ht20 Ht21 Hm0 Hm1 Hlh Hq2B HBB Hq10 X.
 by case: b1; case: b2; case: b3 => /= /#.
(* the identity *)
have Id: q0 + m * B + (q3 + (b2i b1 + b2i b2 - b2i b3)) * (B * B * B)
         = (lo + hi * B) * (lo + hi * B).
 have ->: m = q1 + q2 * B - t2 + b2i b3 * (B * B) by smt().
 have ->: t2 = t1 - hi * hi + b2i b2 * (B * B) by smt().
 have ->: t1 = (lo - hi) * (lo - hi) - lo * lo + b2i b1 * (B * B) by smt().
 by ring E0 E1.
(* the top quarter does not overflow: the square is below B^4 *)
have Hx: lo + hi * B <= B * B - 1.
 have: hi * B <= (B - 1) * B by apply ler_wpmul2r => /#.
 smt().
have Hx0: 0 <= lo + hi * B by smt(mulr_ge0).
have Hsq: (lo + hi * B) * (lo + hi * B) <= (B * B - 1) * (B * B - 1) by apply ler_pmul.
have HmB: 0 <= m * B by apply mulr_ge0 => /#.
have HBBB: 0 < B * B * B by apply mulr_gt0.
have Htop: (q3 + (b2i b1 + b2i b2 - b2i b3)) * (B * B * B) < B * (B * B * B).
 have: (B * B - 1) * (B * B - 1) < B * (B * B * B).
  have ->: B * (B * B * B) = (B * B) * (B * B) by ring.
  have ->: (B * B - 1) * (B * B - 1) = (B * B) * (B * B) - 2 * (B * B) + 1 by ring.
  smt().
 smt().
split; first smt().
split; last exact Id.
by move: Htop; rewrite ltr_pmul2r.
qed.

(******************************************************************************
 **  Arrays: halves, the middle window, a word of the top quarter           **
 ******************************************************************************)

(* the halves of an array of 2*nlimbs words *)
op lo2 (a: BN2.t) : BN.t = BN.A.init (fun i => a.[i]).
op hi2 (a: BN2.t) : BN.t = BN.A.init (fun i => a.[nlimbs + i]).

lemma bn2_halves (a: BN2.t): BN2.bn a = bn (lo2 a) + bn (hi2 a) * BN.bn_modulus.
proof. by apply bn2_pack => j Hj; rewrite BN.A.initiE. qed.

lemma bn2_modE: BN2.bn_modulus = BN.bn_modulus * BN.bn_modulus.
proof.
rewrite BN2.bn_modulusE BN.bn_modulusE (_: 2 * nlimbs = nlimbs + nlimbs) 1:/#.
by rewrite exprD_nneg; smt(gt0_nlimbs).
qed.

(* an array of 4*nlimbs words as its low quarter, its middle window of
   2*nlimbs words, which is not one of its halves, and its top quarter *)
lemma bn4_lmh (r: BigN2.BN2.t) (l: BN.t) (m: BN2.t) (u: BN.t):
  (forall j, 0 <= j < nlimbs => r.[j] = l.[j]) =>
  (forall j, 0 <= j < 2 * nlimbs => r.[nlimbs + j] = m.[j]) =>
  (forall j, 0 <= j < nlimbs => r.[3 * nlimbs + j] = u.[j]) =>
  BigN2.BN2.bn r = BN.bn l + BN2.bn m * BN.bn_modulus
                   + BN.bn u * (BN.bn_modulus * BN.bn_modulus * BN.bn_modulus).
proof.
move=> Hl Hm Hu; have Hn := gt0_nlimbs.
pose rl := BN2.A.init (fun i => r.[i]).
pose rh := BN2.A.init (fun i => r.[2 * nlimbs + i]).
have Er: BigN2.BN2.bn r = BN2.bn rl + BN2.bn rh * BN2.bn_modulus.
 by apply BigN2.bn2_pack => j Hj; rewrite BN2.A.initiE.
have El: BN2.bn rl = BN.bn l + BN.bn (lo2 m) * BN.bn_modulus.
 apply bn2_pack => j Hj; rewrite BN2.A.initiE 1:/# /=.
 - by apply Hl.
 - by rewrite /lo2 BN.A.initiE 1:/# /= Hm /#.
have Eh: BN2.bn rh = BN.bn (hi2 m) + BN.bn u * BN.bn_modulus.
 apply bn2_pack => j Hj; rewrite BN2.A.initiE 1:/# /=.
 - rewrite /hi2 BN.A.initiE 1:/# /= (_: 2 * nlimbs + j = nlimbs + (nlimbs + j)) 1:/#.
   by rewrite Hm /#.
 - by rewrite (_: 2 * nlimbs + (nlimbs + j) = 3 * nlimbs + j) 1:/# Hu.
by rewrite Er El Eh (bn2_halves m) bn2_modE; ring.
qed.

(* replacing word 0 *)
lemma bn_set0w (x: BN.t) (y: W64.t):
  bn x.[0 <- y] = bn x - to_uint x.[0] + to_uint y.
proof.
have Hn := gt0_nlimbs.
have E := BN.bn_k_kup 1 x.[0 <- y] _; first smt().
have Ex := BN.bn_k_kup 1 x _; first smt().
have Hup := BN.bnkup_setO 1 x y _; first smt().
move: Hup; rewrite (_: 1 - 1 = 0) 1:// => Hup.
by rewrite E Ex Hup !BN.bnk1 /= BN.A.get_setE 1:/#; ring.
qed.

(******************************************************************************
 **  The linear passes, on the values                                       **
 ******************************************************************************)

(* [RLO] and [RHI] are the squares of the halves of [a0] and [T0] the square
   of their difference; [T1], [T2] and [M] are the results of the three
   subtractions, with borrows [b1], [b2] and [b3], and [c] the word that
   counts them; [q] is word 0 of the top quarter, to which [c] is added,
   [TOPIN] the top quarter before the carry is propagated, and [TOP] after.
   [r] is the result: the low quarter of [RLO], the middle window [M] and
   the top quarter [TOP]. *)
lemma ksqr_combine (a0: BN2.t) (RLO RHI T0 T1 T2 M: BN2.t) (TOPIN TOP: BN.t)
                   (b1 b2 b3 cf: bool) (c q: W64.t) (r: BigN2.BN2.t):
 BN2.bn T0 = (bn (lo2 a0) - bn (hi2 a0)) * (bn (lo2 a0) - bn (hi2 a0)) =>
 BN2.bn RLO = bn (lo2 a0) * bn (lo2 a0) =>
 BN2.bn RHI = bn (hi2 a0) * bn (hi2 a0) =>
 BN2.bn_withborrow (b1, T1) = BN2.bn T0 - BN2.bn RLO =>
 BN2.bn_withborrow (b2, T2) = BN2.bn T1 - BN2.bn RHI =>
 BN2.bn_withborrow (b3, M) = bn (hi2 RLO) + bn (lo2 RHI) * BN.bn_modulus - BN2.bn T2 =>
 c = (sbb_64 (adc_64 (adc_64 (W64.of_int 0) (W64.of_int 0) b1).`2 (W64.of_int 0) b2).`2
             (W64.of_int 0) b3).`2 =>
 q = (hi2 RHI).[0] =>
 TOPIN = (hi2 RHI).[0 <- (adc_64 q c false).`2] =>
 BN.bn_withcarry (cf, TOP) = bn TOPIN + b2i (adc_64 q c false).`1 * W64.modulus =>
 (forall j, 0 <= j < nlimbs => r.[j] = RLO.[j]) =>
 (forall j, 0 <= j < 2 * nlimbs => r.[nlimbs + j] = M.[j]) =>
 (forall j, 0 <= j < nlimbs => r.[3 * nlimbs + j] = TOP.[j]) =>
 BigN2.BN2.bn r = BN2.bn a0 * BN2.bn a0.
proof.
move=> ET0 ELO EHI E1 E2 E3 Hc Hq HTOPIN Etop Hl Hm Hu.
have Hn := gt0_nlimbs.
pose B := BN.bn_modulus.
have HB: 0 < B by rewrite /B BN.bn_modulusE expr_gt0.
have EBB: BN2.bn_modulus = B * B by exact bn2_modE.
(* the three subtractions, on integers *)
have {E1} E1: BN2.bn T1 - b2i b1 * (B * B) = BN2.bn T0 - BN2.bn RLO.
 by rewrite -EBB BN2.bn_modulusE -E1 /bnk_withborrow.
have {E2} E2: BN2.bn T2 - b2i b2 * (B * B) = BN2.bn T1 - BN2.bn RHI.
 by rewrite -EBB BN2.bn_modulusE -E2 /bnk_withborrow.
have {E3} E3: BN2.bn M - b2i b3 * (B * B) = bn (hi2 RLO) + bn (lo2 RHI) * B - BN2.bn T2.
 by rewrite -EBB BN2.bn_modulusE -E3 /bnk_withborrow.
(* ranges *)
have R1: forall (x: BN.t), 0 <= bn x < B.
 by move=> x; rewrite /B BN.bn_modulusE; exact BN.bnk_cmp.
have R2: forall (x: BN2.t), 0 <= BN2.bn x < B * B.
 by move=> x; rewrite -EBB BN2.bn_modulusE; exact BN2.bnk_cmp.
have Hlo := bn2_halves RLO.
have Hhi := bn2_halves RHI.
have [Hcnt [Htop Id]] := ksqr_math B (bn (lo2 a0)) (bn (hi2 a0))
   (bn (lo2 RLO)) (bn (hi2 RLO)) (bn (lo2 RHI)) (bn (hi2 RHI))
   (BN2.bn T1) (BN2.bn T2) (BN2.bn M) b1 b2 b3
   HB (R1 (lo2 a0)) (R1 (hi2 a0)) (R1 (lo2 RLO)) (R1 (hi2 RLO)) (R1 (lo2 RHI)) (R1 (hi2 RHI))
   _ _ (R2 T1) _ (R2 T2) _ (R2 M) _.
- by rewrite -ELO Hlo.
- by rewrite -EHI Hhi.
- by rewrite E1 ET0 ELO.
- by rewrite E2 EHI.
- by rewrite E3.
(* the counter, and the top quarter *)
have Ec: to_uint c = b2i b1 + b2i b2 - b2i b3 by rewrite Hc; apply cnt3; smt().
have Ea := JBigNumber.addc_to_uint q c false.
have Etopin: bn TOPIN = bn (hi2 RHI) - to_uint q + to_uint (adc_64 q c false).`2.
 by rewrite HTOPIN bn_set0w Hq.
have EB: W64.modulus ^ nlimbs = B by rewrite /B BN.bn_modulusE.
have Et: bn TOP = bn (hi2 RHI) + (b2i b1 + b2i b2 - b2i b3).
 have := R1 TOP; have := R1 (hi2 RHI).
 move: Etop Etopin Ea Ec EB Htop Hcnt; rewrite /bnk_withcarry /=.
 by case: cf => /= /#.
(* the result *)
rewrite (bn4_lmh r (lo2 RLO) M TOP) //.
- by move=> j Hj; rewrite /lo2 BN.A.initiE 1:// /= Hl.
by rewrite (bn2_halves a0) Et -/B -Id.
qed.

(******************************************************************************
 **  The procedures                                                         **
 ******************************************************************************)

section.

declare module P <: MParam.

declare axiom fun_ksqrn_ll: islossless P.fun_ksqrn.
declare axiom fun_ksqrn_h _a:
 hoare [ P.fun_ksqrn : arg.`2 = _a ==> BN2.bn res = bn _a * bn _a ].

hoare __sub_abs_h _a _b:
 M(P).__sub_abs : a=_a /\ b=_b ==> bn res = `|bn _a - bn _b|.
proof.
proc.
ecall (BNB._cnegU__h r sign).
ecall (BNUTIL.__cf_mask_h cf).
ecall (BNB._sub__h a b).
skip => />.
move=> [c x] /=; rewrite /bnk_withborrow /= => E.
have Hx := BN.bnk_cmp nlimbs x; have Ha := BN.bnk_cmp nlimbs _a; have Hb := BN.bnk_cmp nlimbs _b.
move: E Hx Ha Hb; case: c => /= _ E Hx Ha Hb.
- (* a borrow: a < b, and the difference is negated *)
  rewrite /= ?JBigNumber.W64_of_int_m1 ?W64.to_uint_onew /= BN.bn_ofintK BN.bn_modulusE /=.
  have ->: - bnk nlimbs x
           = (bnk nlimbs _b - bnk nlimbs _a) + (-1) * 18446744073709551616 ^ nlimbs by smt().
  by rewrite modzMDr modz_small /#.
- by move: E; rewrite !b2i0 /= /#.
qed.

hoare _kar_sqrn_h a0:
 M(P)._kar_sqrn : a = a0 ==> BigN2.BN2.bn res = BN2.bn a0 * BN2.bn a0.
proof.
have Hn := gt0_nlimbs.
proc.
(* d = |lo - hi| *)
seq 15 : (a = a0 /\ bn d = `|bn (lo2 a0) - bn (hi2 a0)|).
 by ecall (__sub_abs_h alo ahi); auto.
(* tmp = d^2 *)
seq 8 : (_a = a0
         /\ BN2.bn _tmp = (bn (lo2 a0) - bn (hi2 a0)) * (bn (lo2 a0) - bn (hi2 a0))).
 wp; ecall (fun_ksqrn_h d); wp; skip => />.
 move=> &hr Hd result ->.
 have ->: BN.A.init ("_.[_]" (BN2.A.init ("_.[_]" (BigN2.BN2.A.init
            (fun (i : int) => if 0 <= i < nlimbs then d{hr}.[i] else r{hr}.[i]))))) = d{hr}.
  apply BN.A.ext_eq => i Hi.
  by rewrite BN.A.initiE 1:// /= BN2.A.initiE 1:/# /= BigN2.BN2.A.initiE 1:/# /= Hi.
 by rewrite Hd sqr_abs.
(* r = lo^2 + B^2 hi^2 *)
seq 5 : (_a = a0
         /\ BN2.bn _tmp = (bn (lo2 a0) - bn (hi2 a0)) * (bn (lo2 a0) - bn (hi2 a0))
         /\ BN2.bn rlo = bn (lo2 a0) * bn (lo2 a0)
         /\ (forall j, 0 <= j < 2 * nlimbs => _r.[j] = rlo.[j])).
 wp; ecall (fun_ksqrn_h alo); wp; skip => />.
 move=> &hr Ht result Hr j Hj1 Hj2.
 by rewrite BigN2.BN2.A.initiE 1:/# /= Hj1 Hj2.
seq 6 : (BN2.bn _tmp = (bn (lo2 a0) - bn (hi2 a0)) * (bn (lo2 a0) - bn (hi2 a0))
         /\ BN2.bn rlo = bn (lo2 a0) * bn (lo2 a0)
         /\ BN2.bn rhi = bn (hi2 a0) * bn (hi2 a0)
         /\ (forall j, 0 <= j < 2 * nlimbs => _r.[j] = rlo.[j])
         /\ (forall j, 0 <= j < 2 * nlimbs => _r.[2 * nlimbs + j] = rhi.[j])).
 wp; ecall (fun_ksqrn_h ahi); wp; skip => />.
 move=> &hr Ht Hlo Hrl result Hr; split => j Hj1 Hj2.
 - by rewrite BigN2.BN2.A.initiE 1:/# /= ifF 1:/# Hrl.
 - by rewrite BigN2.BN2.A.initiE 1:/# /= ifT 1:/#; congr; ring.
(* the three subtractions, the counter and the top quarter *)
wp; ecall (BNB.__carrypropU_h rhihi cf 1); wp.
ecall (BNB2._subU__h rmid tmp); wp.
ecall (BNB2._subU__h tmp rhi); wp.
ecall (BNB2._subU__h tmp rlo); wp; skip => />.
move=> &hr ET0 ELO EHI Hrl Hrh [b1 T1] /= E1 [b2 T2] /= E2 [b3 M] /= E3.
split; first smt().
move=> _ [cf TOP] /=.
pose c := (subc (addc (addc W64.zero W64.zero b1).`2 W64.zero b2).`2 W64.zero b3).`2.
pose R1 := BigN2.BN2.A.init
             (fun (i0 : int) => if nlimbs <= i0 < nlimbs + 2 * nlimbs then M.[i0 - nlimbs]
                                else _r{hr}.[i0]).
pose q := R1.[3 * nlimbs].
pose w := (addc q c false).`2.
pose TOPIN := BN.A.init (fun (i : int) => R1.[3 * nlimbs <- w].[3 * nlimbs + i]).
move=> Etop.
(* the operands of the subtractions are the two squares and the middle window *)
have Xlo: BN2.A.init (fun i => _r{hr}.[i]) = rlo{hr}.
 by apply BN2.A.ext_eq => i Hi; rewrite BN2.A.initiE 1:// /= Hrl.
have Xhi: BN2.A.init (fun i => _r{hr}.[2 * nlimbs + i]) = rhi{hr}.
 by apply BN2.A.ext_eq => i Hi; rewrite BN2.A.initiE 1:// /= Hrh.
have Xmid: BN2.bn (BN2.A.init (fun i => _r{hr}.[nlimbs + i]))
           = bn (hi2 rlo{hr}) + bn (lo2 rhi{hr}) * BN.bn_modulus.
 apply bn2_pack => j Hj; rewrite BN2.A.initiE 1:/# /=.
 - by rewrite /hi2 BN.A.initiE 1:// /= Hrl /#.
 - rewrite /lo2 BN.A.initiE 1:// /= (_: nlimbs + (nlimbs + j) = 2 * nlimbs + j) 1:/#.
   by rewrite Hrh /#.
have {E1} E1: BN2.bn_withborrow (b1, T1) = BN2.bn _tmp{hr} - BN2.bn rlo{hr}.
 by rewrite -Xlo; exact E1.
have {E2} E2: BN2.bn_withborrow (b2, T2) = BN2.bn T1 - BN2.bn rhi{hr}.
 by rewrite -Xhi; exact E2.
have {E3} E3: BN2.bn_withborrow (b3, M)
              = bn (hi2 rlo{hr}) + bn (lo2 rhi{hr}) * BN.bn_modulus - BN2.bn T2.
 by rewrite -Xmid; exact E3.
(* the top quarter, before the carry: the one of hi^2, with word 0 replaced *)
have Hq: q = (hi2 rhi{hr}).[0].
 rewrite /q /R1 BigN2.BN2.A.initiE 1:/# /= ifF 1:/# /hi2 BN.A.initiE 1:/# /=.
 by rewrite (_: 3 * nlimbs = 2 * nlimbs + nlimbs) 1:/# Hrh 1:/#.
have HT: TOPIN = (hi2 rhi{hr}).[0 <- w].
 apply BN.A.ext_eq => i Hi; rewrite /TOPIN BN.A.initiE 1:// /=.
 rewrite BigN2.BN2.A.get_setE 1:/# BN.A.get_setE 1:/#.
 case: (i = 0) => [->|Hi0] /=; first done.
 rewrite ifF 1:/# /R1 BigN2.BN2.A.initiE 1:/# /= ifF 1:/# /hi2 BN.A.initiE 1:// /=.
 by rewrite (_: 3 * nlimbs + i = 2 * nlimbs + (nlimbs + i)) 1:/# Hrh 1:/#.
apply (ksqr_combine a0 rlo{hr} rhi{hr} _tmp{hr} T1 T2 M TOPIN TOP b1 b2 b3 cf c q _
         ET0 ELO EHI E1 E2 E3 _ Hq HT Etop _ _ _).
- done.
- move=> j Hj; rewrite BigN2.BN2.A.initiE 1:/# /= ifF 1:/# BigN2.BN2.A.get_setE 1:/# ifF 1:/#.
  by rewrite /R1 BigN2.BN2.A.initiE 1:/# /= ifF 1:/# Hrl /#.
- move=> j Hj; rewrite BigN2.BN2.A.initiE 1:/# /= ifF 1:/# BigN2.BN2.A.get_setE 1:/# ifF 1:/#.
  by rewrite /R1 BigN2.BN2.A.initiE 1:/# /= ifT 1:/#; congr; ring.
- by move=> j Hj; rewrite BigN2.BN2.A.initiE 1:/# /= ifT 1:/#; congr; ring.
qed.

hoare _kar_sqrn__h a0:
 M(P)._kar_sqrn_ : a = a0 ==> BigN2.BN2.bn res = BN2.bn a0 * BN2.bn a0.
proof. by proc; wp; call (_kar_sqrn_h a0); auto. qed.

lemma __sub_abs_ll: islossless M(P).__sub_abs.
proof.
by proc; call BNB._cnegU__ll; call BNUTIL.__cf_mask_ll; call BNB._sub__ll.
qed.

lemma _kar_sqrn_ll: islossless M(P)._kar_sqrn.
proof.
proc.
wp; call BNB.__carrypropU_ll; wp.
call BNB2._subU__ll; wp; call BNB2._subU__ll; wp; call BNB2._subU__ll; wp.
call fun_ksqrn_ll; wp; call fun_ksqrn_ll; wp; call fun_ksqrn_ll; wp.
by call __sub_abs_ll; wp.
qed.

lemma _kar_sqrn__ll: islossless M(P)._kar_sqrn_.
proof. by proc; wp; call _kar_sqrn_ll; wp. qed.

phoare _kar_sqrn__ph a0:
 [ M(P)._kar_sqrn_ : a = a0 ==> BigN2.BN2.bn res = BN2.bn a0 * BN2.bn a0 ] = 1%r.
proof. by conseq _kar_sqrn__ll (_kar_sqrn__h a0). qed.

end section.
