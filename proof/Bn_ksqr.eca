    (fun i => (if (0 <= i < (0 + nlimbs)) then d.[(i - 0)] else r.[i])));
    _a <- a;
    _r <- r;
    rlo <- (BN2.A.init (fun i => _r.[(0 + i)]));
    d <- (BN.A.init (fun i => rlo.[(0 + i)]));
    tmp <- _tmp;
    tmp <@ P.fun_ksqrn (tmp, d);
    _tmp <- tmp;
    a <- _a;
    alo <- (BN.A.init (fun i => a.[(0 + i)]));
