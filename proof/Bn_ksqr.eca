require import AllCore Int IntDiv List StdOrder.

from Jasmin require import JModel_x86.
import SLH64.

require JBigNumber.

(* Correctness contract for bn_ksqr@2n.jinc: the squaring over the half size
   (one Karatsuba level), on top of a given squaring of the half size.

   A theory over two sizes. Its parameter [nlimbs] is the half size (the
   scope H of the module): the operand has 2*nlimbs words and the result
   4*nlimbs. [BigN] has the arrays of nlimbs and 2*nlimbs words (BN, BN2),
   and [BigN2] is the same theory at 2*nlimbs, whose single array is the
   double one of [BigN] (BigN2.BN = BigN.BN2) and whose double array has
   the 4*nlimbs words of the result (BigN2.BN2). The contract is the one of
   every squaring of the library, stated in [BigN2]:
       BigN2.BN2.bn res = BigN2.BN.bn a * BigN2.BN.bn a
   so that a field theory at 2*nlimbs limbs that shares [BigN2] takes
   [_kar_sqrn_] as its squaring (Fp_mont_ksqr.eca does it for Fp_mont). *)

(* Parameters *)
op nlimbs: int.
axiom gt0_nlimbs: 0 < nlimbs.

clone export JBigNumber.BigN
 with op nlimbs <- nlimbs
      proof gt0_nlimbs by exact gt0_nlimbs.

clone JBigNumber.BigN as BigN2
 with op nlimbs <- 2 * nlimbs,
      theory BN <- BigN.BN2
      proof gt0_nlimbs by smt(gt0_nlimbs).

import BN2.
import BN.
import BigN2.BN2.A.

require Bn_util.
clone Bn_util as BNUTIL.
module BNUTIL_M = BNUTIL.M.

require Bn_base.
(* bn_base at the half size (H::BN) *)
clone Bn_base as BNB
 with op nlimbs <- nlimbs,
      theory BigN <- BigN,
      theory BNUTIL <- BNUTIL
      proof gt0_nlimbs by exact gt0_nlimbs.
module BNB_M = BNB.M.
(* and at the size of the operand (BN) *)
clone Bn_base as BNB2
 with op nlimbs <- 2 * nlimbs,
      theory BigN <- BigN2,
      theory BNUTIL <- BNUTIL
      proof gt0_nlimbs by smt(gt0_nlimbs).
module BNB2_M = BNB2.M.

