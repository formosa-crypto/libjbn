(* Correctness contracts for bn_mulxr@n.jinc: operand-scanning multiplication
   and squaring, and Montgomery reduction, unrolled, with MULX/ADCX/ADOX rows
   whose accumulator is a register array (the rows of bn_mulx, Bn_mulx.eca,
   with the window in the array t instead of the result r).

   The statements are those of Bn_mul, so that the five modules selected
   by bn_mulsel have one contract. *)

(* Parameters *)
op nlimbs: int.
axiom gt0_nlimbs: 0 < nlimbs.

clone export JBigNumber.BigN
 with op nlimbs <- nlimbs
      proof gt0_nlimbs by exact gt0_nlimbs.

import BN2.
import BN.

require Bn_util.
clone Bn_util as BNUTIL.
module BNUTIL_M = BNUTIL.M.

require Bn_base.
clone Bn_base as BNB
