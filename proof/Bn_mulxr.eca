(* writing two consecutive words *)
lemma bnk_put2 (r: BN2.t) i (x y: W64.t):
 0 <= i => i + 1 < 2*nlimbs =>
 BN2.bnk (i+2) r.[i <- x].[i+1 <- y]
 = BN2.bnk i r + to_uint x * 18446744073709551616 ^ i
   + to_uint y * 18446744073709551616 ^ (i+1).
proof.
move=> Hi0 Hi1; rewrite (_: i + 2 = (i + 1) + 1) 1:/# BN2.bnkS 1:/# /=.
rewrite BN2.A.get_setE 1:/# /= BN2.bnk_setO 1:/# BN2.bnkS 1:/# /=.
by rewrite BN2.A.get_setE 1:/# /= BN2.bnk_setO 1:/#; ring.
qed.

(* the top word x of a value v + x * W^n below W^(n+1) is a word *)
lemma top_bnd n (v x y: int):
 0 <= n => 0 <= v => v + x * 18446744073709551616 ^ n = y =>
 y < 18446744073709551616 ^ (n+1) => x < 18446744073709551616.
proof.
move=> Hn Hv E Hy.
have HY: 0 < 18446744073709551616 ^ n by apply StdOrder.IntOrder.expr_gt0.
have: x * 18446744073709551616 ^ n < 18446744073709551616 * 18446744073709551616 ^ n.
 by move: Hy; rewrite exprSr // -E; smt().
by rewrite StdOrder.IntOrder.ltr_pmul2r.
qed.

(* first row: t[0..nlimbs] = a * b; the carry chain is CF, and the pending
   value of the next word is t[i] (the high word of the last product) + cf *)
hoare __mulr_row0_h _a _b:
 M.__mulr_row0 : a=_a /\ b=_b ==> BN2.bnk (nlimbs+1) res = to_uint _a * bn _b.
proof.
proc.
wp; while (a=_a /\ b=_b /\ 1 <= i <= nlimbs /\ to_uint t.[i] <= 18446744073709551616 - 2
           /\ BN2.bnk i t + (to_uint t.[i] + b2i cf) * 18446744073709551616 ^ i
              = to_uint _a * bnk i _b).
 wp; skip => /> &hr Hi1 _ Hh Hinv Hi2.
 rewrite /ADCX_64 /MULX_64 /=.
 rewrite (BN2.A.get_setE t{hr} (i{hr} + 1)) 1:/# (_: (i{hr} = i{hr} + 1) = false) 1:/# /=.
 split; first smt().
 split.
  rewrite BN2.A.get_setE 1:/# (_: (i{hr} + 1 = i{hr}) = false) 1:/# /=.
  by rewrite BN2.A.get_setE 1:/# /=; exact JBigNumber.mulu_hi_bnd.
 rewrite BN2.bnk_put 1:/# BN2.bnk_setO 1:/# bnkS 1:/# /=.
 rewrite BN2.A.get_setE 1:/# (_: (i{hr} + 1 = i{hr}) = false) 1:/# /=.
 rewrite BN2.A.get_setE 1:/# /=.
 have A := JBigNumber.addc_to_uint t{hr}.[i{hr}] (mulu _a _b.[i{hr}]).`2 cf{hr}.
 have M := JBigNumber.mulu_to_uint _a _b.[i{hr}].
 have ->: to_uint (addc t{hr}.[i{hr}] (mulu _a _b.[i{hr}]).`2 cf{hr}).`2
          + 18446744073709551616 * (to_uint (mulu _a _b.[i{hr}]).`1
                                    + b2i (addc_carry t{hr}.[i{hr}] (mulu _a _b.[i{hr}]).`2 cf{hr}))
          = to_uint t{hr}.[i{hr}] + b2i cf{hr} + to_uint _a * to_uint _b.[i{hr}]
  by move: A M; rewrite (_: W64.modulus = 18446744073709551616) //; smt().
 have ->: BN2.bnk i{hr} t{hr}
          = to_uint _a * bnk i{hr} _b - (to_uint t{hr}.[i{hr}] + b2i cf{hr}) * 18446744073709551616 ^ i{hr}
  by rewrite -Hinv; ring.
 by ring.
wp; skip => &hr />.
have Hn := gt0_nlimbs.
rewrite /ADCX_64 /MULX_64 /set0_64_ /=.
split.
 rewrite (BN2.A.get_setE _ 0 1) 1:/# /= BN2.A.get_setE 1:/# /=.
 split; first smt(gt0_nlimbs).
 split; first exact JBigNumber.mulu_hi_bnd.
 rewrite BN2.bnk1 bnk1 /= BN2.A.get_setE; first smt(gt0_nlimbs).
 have := JBigNumber.mulu_to_uint a{hr} b{hr}.[0].
 by rewrite (_: W64.modulus = 18446744073709551616) //=; smt().
move=> cf0 i0 t0 H1 H2 H3 Hh Hinv; have Ei: i0 = nlimbs by smt().
move: Hinv Hh; rewrite Ei => Hinv Hh.
have [_ E] := JBigNumber.addc_nc t0.[nlimbs] W64.zero cf0 _.
 by rewrite W64.to_uint0; move: Hh; case: cf0 => /= /#.
rewrite BN2.bnkS 1:/# /= BN2.A.get_setE 1:/# /= BN2.bnk_setO 1:/# E W64.to_uint0.
by move: Hinv; smt().
qed.

(* row k: t[k..k+nlimbs] += a * b (t[k+nlimbs] is not read: the high word
   of the last product goes there). Before step i, the carries pending
   are OF into word k+i and CF into word k+i+1; the bound keeps the top
   word from overflowing *)
hoare __mulr_rowk_h _k _t _a _b:
 M.__mulr_rowk : k=_k /\ t=_t /\ a=_a /\ b=_b /\ 0 <= _k < nlimbs
   /\ BN2.bnk (_k + nlimbs) _t + 18446744073709551616 ^ _k * (to_uint _a * bn _b)
      < 18446744073709551616 ^ (_k + nlimbs + 1)
 ==> (forall j, 0 <= j < _k => res.[j] = _t.[j])
     /\ BN2.bnk (_k + nlimbs + 1) res
        = BN2.bnk (_k + nlimbs) _t + 18446744073709551616 ^ _k * (to_uint _a * bn _b).
proof.
proc.
wp; while (k=_k /\ a=_a /\ b=_b /\ inc = nlimbs - 1 /\ 0 <= i <= nlimbs - 1 /\ 0 <= _k < nlimbs
           /\ BN2.bnk (_k + nlimbs) _t + 18446744073709551616 ^ _k * (to_uint _a * bn _b)
              < 18446744073709551616 ^ (_k + nlimbs + 1)
           /\ (forall j, 0 <= j < _k \/ _k + i < j < 2*nlimbs => t.[j] = _t.[j])
           /\ BN2.bnk (_k + i + 1) t
               + (b2i of_0 + 18446744073709551616 * b2i cf) * 18446744073709551616 ^ (_k + i)
              = BN2.bnk (_k + i + 1) _t
                + 18446744073709551616 ^ _k * (to_uint _a * bnk i _b)).
 wp; skip => /> &hr Hi1 _ Hk0 Hk Hbnd Hfr Hinv Hi2.
 rewrite /ADCX_64 /ADOX_64 /MULX_64 /=.
 rewrite (BN2.A.get_setE t{hr} (_k + i{hr})) 1:/# (_: (_k + i{hr} + 1 = _k + i{hr}) = false) 1:/# /=.
 rewrite (Hfr (_k + i{hr} + 1)) 1:/#.
 split; first smt().
 split.
  move=> j Hj; rewrite BN2.A.get_setE 1:/# (_: (j = _k + i{hr} + 1) = false) 1:/# /=.
  by rewrite BN2.A.get_setE 1:/# (_: (j = _k + i{hr}) = false) 1:/# /= Hfr /#.
 rewrite (_: _k + (i{hr} + 1) + 1 = (_k + i{hr}) + 2) 1:/# bnk_put2 1,2:/#.
 rewrite (_: _k + i{hr} + 2 = (_k + i{hr} + 1) + 1) 1:/# (BN2.bnkS (_k + i{hr} + 1) _t) 1:/# /=.
 rewrite (_: _k + (i{hr} + 1) = _k + i{hr} + 1) 1:/# bnkS 1:/# /=.
 move: Hinv; rewrite (BN2.bnkS (_k + i{hr})) 1:/# /= => Hinv.
 have A1 := JBigNumber.addc_to_uint t{hr}.[_k + i{hr}] (mulu _a _b.[i{hr}]).`2 of_0{hr}.
 have A2 := JBigNumber.addc_to_uint _t.[_k + i{hr} + 1] (mulu _a _b.[i{hr}]).`1 cf{hr}.
 have M := JBigNumber.mulu_to_uint _a _b.[i{hr}].
 move: A1 A2 M; rewrite (_: W64.modulus = 18446744073709551616) // /= => A1 A2 M.
 rewrite A1 A2 /=.
 have ->: BN2.bnk (_k + i{hr}) t{hr}
          = BN2.bnk (_k + i{hr} + 1) _t
            + 18446744073709551616 ^ _k * (to_uint _a * bnk i{hr} _b)
            - (b2i of_0{hr} + 18446744073709551616 * b2i cf{hr}) * 18446744073709551616 ^ (_k + i{hr})
            - to_uint t{hr}.[_k + i{hr}] * 18446744073709551616 ^ (_k + i{hr})
  by rewrite -Hinv; ring.
 have ->: 18446744073709551616 ^ (_k + i{hr} + 1)
          = 18446744073709551616 ^ (_k + i{hr}) * 18446744073709551616 by rewrite exprSr 1:/#.
 have ->: 18446744073709551616 ^ (_k + i{hr})
          = 18446744073709551616 ^ _k * 18446744073709551616 ^ i{hr} by rewrite exprD_nneg 1,2:/#.
 have ->: to_uint (mulu _a _b.[i{hr}]).`2
          = to_uint _a * to_uint _b.[i{hr}] - 18446744073709551616 * to_uint (mulu _a _b.[i{hr}]).`1
  by rewrite -M; ring.
 by ring.
wp; skip => &hr />.
move=> Hk0 Hk Hbnd; rewrite /ADCX_64 /ADOX_64 /MULX_64 /set0_64_ /=.
split.
 split; first smt(gt0_nlimbs).
 by rewrite bnk0 /=.
move=> cf0 i0 of0 t0 H1 H2 H3 Hfr Hinv; have Ei: i0 = nlimbs - 1 by smt().
have Hn := gt0_nlimbs.
move: Hinv Hfr; rewrite Ei (_: k{hr} + (nlimbs - 1) = k{hr} + nlimbs - 1) 1:/#.
rewrite (_: k{hr} + nlimbs - 1 + 1 = k{hr} + nlimbs) 1:/# => Hinv Hfr.
(* the reads of the last step *)
rewrite (BN2.A.get_setE t0 (k{hr} + nlimbs) (k{hr} + nlimbs - 1)) 1:/#.
rewrite (_: (k{hr} + nlimbs - 1 = k{hr} + nlimbs) = false) 1:/# /=.
pose h := (mulu a{hr} b{hr}.[nlimbs - 1]).`1.
pose l := (mulu a{hr} b{hr}.[nlimbs - 1]).`2.
pose x := addc t0.[k{hr} + nlimbs - 1] l of0.
rewrite (BN2.A.get_setE _ (k{hr} + nlimbs - 1) (k{hr} + nlimbs)) 1:/#.
rewrite (_: (k{hr} + nlimbs = k{hr} + nlimbs - 1) = false) 1:/# /=.
rewrite (BN2.A.get_setE t0 (k{hr} + nlimbs) (k{hr} + nlimbs)) 1:/# /=.
pose y := addc h W64.zero cf0.
rewrite (BN2.A.get_setE _ (k{hr} + nlimbs) (k{hr} + nlimbs)) 1:/# /=.
pose z := addc y.`2 W64.zero x.`1.
(* the writes: word k+nlimbs-1, then the top word *)
rewrite (BN2.A.set_set_swap t0 (k{hr} + nlimbs) (k{hr} + nlimbs - 1)) 1:/# BN2.A.set_set_eq.
split.
 move=> j Hj1 Hj2; rewrite !BN2.A.get_setE 1,2:/#.
 by rewrite (_: (j = k{hr} + nlimbs) = false) 1:/# (_: (j = k{hr} + nlimbs - 1) = false) 1:/# /= Hfr /#.
rewrite bnk_put2 1,2:/# (_: k{hr} + nlimbs - 1 + 1 = k{hr} + nlimbs) 1:/#.
have Et0: BN2.bnk (k{hr} + nlimbs) t0
          = to_uint t0.[k{hr} + nlimbs - 1] * 18446744073709551616 ^ (k{hr} + nlimbs - 1)
            + BN2.bnk (k{hr} + nlimbs - 1) t0.
 have := BN2.bnkS (k{hr} + nlimbs - 1) t0 _; first smt().
 by rewrite (_: k{hr} + nlimbs - 1 + 1 = k{hr} + nlimbs) 1:/#.
have Eb: bnk nlimbs b{hr}
         = to_uint b{hr}.[nlimbs - 1] * 18446744073709551616 ^ (nlimbs - 1) + bnk (nlimbs - 1) b{hr}.
 have := bnkS (nlimbs - 1) b{hr} _; first smt().
 by rewrite (_: nlimbs - 1 + 1 = nlimbs) 1:/#.
have EW1: 18446744073709551616 ^ (k{hr} + nlimbs)
          = 18446744073709551616 ^ (k{hr} + nlimbs - 1) * 18446744073709551616.
 by rewrite -exprSr 1:/#; congr; ring.
have EW2: 18446744073709551616 ^ (k{hr} + nlimbs - 1)
          = 18446744073709551616 ^ k{hr} * 18446744073709551616 ^ (nlimbs - 1).
 by rewrite -exprD_nneg 1,2:/#; congr; ring.
have A := JBigNumber.addc_to_uint t0.[k{hr} + nlimbs - 1] l of0.
have M := JBigNumber.mulu_to_uint a{hr} b{hr}.[nlimbs - 1].
move: A M; rewrite -/x -/h -/l (_: W64.modulus = 18446744073709551616) // => A M.
(* the value, with the top word as an integer *)
have EV: BN2.bnk (k{hr} + nlimbs - 1) t0 + to_uint x.`2 * 18446744073709551616 ^ (k{hr} + nlimbs - 1)
         + (to_uint h + b2i cf0 + b2i x.`1) * 18446744073709551616 ^ (k{hr} + nlimbs)
         = BN2.bnk (k{hr} + nlimbs) t{hr}
           + 18446744073709551616 ^ k{hr} * (to_uint a{hr} * bnk nlimbs b{hr}).
 have ->: BN2.bnk (k{hr} + nlimbs - 1) t0
          = BN2.bnk (k{hr} + nlimbs) t{hr}
            + 18446744073709551616 ^ k{hr} * (to_uint a{hr} * bnk (nlimbs - 1) b{hr})
            - (b2i of0 + 18446744073709551616 * b2i cf0) * 18446744073709551616 ^ (k{hr} + nlimbs - 1)
            - to_uint t0.[k{hr} + nlimbs - 1] * 18446744073709551616 ^ (k{hr} + nlimbs - 1)
  by rewrite -Hinv Et0; ring.
 rewrite A.
 have ->: to_uint l = to_uint a{hr} * to_uint b{hr}.[nlimbs - 1] - 18446744073709551616 * to_uint h
  by rewrite -M; ring.
 by rewrite EW1 Eb EW2; ring.
(* the top word does not overflow *)
have [Ht0 _] := BN2.bnk_cmp (k{hr} + nlimbs - 1) t0.
have [Hx0 _] := W64.to_uint_cmp x.`2.
have HY: 0 <= 18446744073709551616 ^ (k{hr} + nlimbs - 1)
 by apply StdOrder.IntOrder.expr_ge0.
have Htop := top_bnd (k{hr} + nlimbs) _ _ _ _ _ EV Hbnd; first smt().
 by apply StdOrder.IntOrder.addr_ge0 => //; apply StdOrder.IntOrder.mulr_ge0.
have [_ E1] := JBigNumber.addc_nc h W64.zero cf0 _.
 by rewrite W64.to_uint0; move: Htop; case: (x.`1) => /= /#.
have [_ E2] := JBigNumber.addc_nc y.`2 W64.zero x.`1 _.
 by rewrite /y E1 W64.to_uint0; move: Htop; case: (x.`1) => /= /#.
by rewrite /z E2 /y E1 !W64.to_uint0 -EV; ring.
qed.

(* the rows of operand scanning: word k of the result is copied from t
   after row k (no later row writes it), the top words after the last *)
hoare _os_muln_h _a _b:
 M._os_muln : a=_a /\ b=_b ==> BN2.bn res = bn _a * bn _b.
proof.
proc.
while (a=_a /\ b=_b /\ inc = 2*nlimbs /\ nlimbs <= k <= 2*nlimbs
       /\ BN2.bnk (2*nlimbs) t = bnk nlimbs _a * bn _b
       /\ (forall j, 0 <= j < k => r.[j] = t.[j])).
 wp; skip => /> &hr Hk1 _ Ht Hfr Hk2.
 split; first smt().
 move=> j Hj1 Hj2; rewrite BN2.A.get_setE 1:/#.
 by case: (j = k{hr}) => // Hj; rewrite Hfr /#.
wp; while (a=_a /\ b=_b /\ 1 <= k <= nlimbs
           /\ BN2.bnk (k + nlimbs) t = bnk k _a * bn _b
           /\ (forall j, 0 <= j < k => r.[j] = t.[j])).
 wp; ecall (__mulr_rowk_h k t ak b); wp; skip => /> &hr Hk1 Hk2 Hinv Hfr Hk3; split.
  split; first smt().
  rewrite Hinv.
  have ->: bnk k{hr} _a * bnk nlimbs _b
           + 18446744073709551616 ^ k{hr} * (to_uint _a.[k{hr}] * bnk nlimbs _b)
           = bnk (k{hr} + 1) _a * bnk nlimbs _b by rewrite bnkS 1:/# /=; ring.
  have [Ha0 Ha1] := bnk_cmp (k{hr} + 1) _a; have [Hb0 Hb1] := bnk_cmp nlimbs _b.
  rewrite (_: k{hr} + nlimbs + 1 = (k{hr} + 1) + nlimbs) 1:/# exprD_nneg 1,2:/#.
  by apply StdOrder.IntOrder.ltr_pmul; move: Ha0 Ha1 Hb0 Hb1; smt().
 move=> _ _ t' Ht'fr Ht'; split; first smt().
 split.
  rewrite (_: k{hr} + 1 + nlimbs = k{hr} + nlimbs + 1) 1:/# Ht' Hinv.
  by rewrite bnkS 1:/# /=; ring.
 move=> j Hj1 Hj2; rewrite BN2.A.get_setE 1:/#.
 by case: (j = k{hr}) => // Hj; rewrite Hfr 1:/# Ht'fr /#.
wp; ecall (__mulr_row0_h ak b); wp; skip => /> &hr t' Ht'.
have Hn := gt0_nlimbs.
split.
 split; first smt().
 split; first by rewrite addzC Ht' bnk1 /=.
 by move=> j Hj1 Hj2; rewrite BN2.A.get_setE 1:/# (_: j = 0) 1:/#.
move=> k0 r0 t0 Hk0 Hk1 Hk2 Hinv Hfr.
have Ek: k0 = nlimbs by smt().
move: Hinv Hfr; rewrite Ek (_: nlimbs + nlimbs = 2 * nlimbs) 1:/# => Hinv Hfr.
split; first by do! split => //; smt().
move=> k1 r1 Hk3 Hk4 Hk5 _ Hfr1.
have ->: r1 = t0 by apply BN2.A.ext_eq => j Hj; rewrite Hfr1 /#.
done.
qed.

hoare _os_muln__h _a _b:
 M._os_muln_ : a=_a /\ b=_b ==> bn res = bn _a * bn _b.
proof. by proc; wp; ecall (_os_muln_h a b); auto. qed.

(* Squaring: a^2 = 2 * X + D, with X the products above the diagonal,
   accumulated by rows (row j adds a[j] times the limbs above j), and D the
   squares of the limbs *)
op sqx (k: int) (a: BN.t) : int =
  bigi predT (fun j => to_uint a.[j] * 18446744073709551616 ^ j * (bn a - bnk (j+1) a)) 0 k.
op sqd (k: int) (a: BN.t) : int =
  bigi predT (fun j => to_uint a.[j] * to_uint a.[j] * 18446744073709551616 ^ (2*j)) 0 k.

lemma sqx0 a: sqx 0 a = 0.
proof. by rewrite /sqx big_geq. qed.

lemma sqxS k a: 0 <= k =>
 sqx (k+1) a = sqx k a + to_uint a.[k] * 18446744073709551616 ^ k * (bn a - bnk (k+1) a).
proof. by move=> Hk; rewrite /sqx big_int_recr. qed.

lemma sqd0 a: sqd 0 a = 0.
proof. by rewrite /sqd big_geq. qed.

lemma sqdS k a: 0 <= k =>
 sqd (k+1) a = sqd k a + to_uint a.[k] * to_uint a.[k] * 18446744073709551616 ^ (2*k).
proof. by move=> Hk; rewrite /sqd big_int_recr. qed.

(* the identity, on the first k limbs *)
lemma sq_identk k a: 0 <= k <= nlimbs =>
 2 * sqx k a + bnk k a * bnk k a + sqd k a = 2 * bn a * bnk k a.
proof.
elim/natind: k => [k Hk H | k Hk IH H].
 by rewrite (_: k = 0) 1:/# sqx0 sqd0 bnk0.
rewrite sqxS // sqdS // bnkS //= (_: 2 * k = k + k) 1:/# exprD_nneg 1,2:/#.
have := IH _; first smt().
move=> {IH} IH.
have ->: 2 * (sqx k a + to_uint a.[k] * 18446744073709551616 ^ k * (bn a - (to_uint a.[k] * 18446744073709551616 ^ k + bnk k a)))
         + (to_uint a.[k] * 18446744073709551616 ^ k + bnk k a) * (to_uint a.[k] * 18446744073709551616 ^ k + bnk k a)
         + (sqd k a + to_uint a.[k] * to_uint a.[k] * (18446744073709551616 ^ k * 18446744073709551616 ^ k))
         = (2 * sqx k a + bnk k a * bnk k a + sqd k a)
           + 2 * to_uint a.[k] * 18446744073709551616 ^ k * bn a by ring.
by rewrite IH; ring.
qed.

lemma sq_ident a: bn a * bn a = 2 * sqx nlimbs a + sqd nlimbs a.
proof. by have := sq_identk nlimbs a _; [smt(gt0_nlimbs) | smt()]. qed.

(* the last row is empty *)
lemma sqx_last a: sqx nlimbs a = sqx (nlimbs - 1) a.
proof.
have := sqxS (nlimbs - 1) a _; first smt(gt0_nlimbs).
by rewrite (_: nlimbs - 1 + 1 = nlimbs) 1:/# => ->; ring.
qed.

(* the limbs from k up *)
lemma bn_sub_bnk (x: BN.t) k: 0 <= k <= nlimbs =>
 bn x - bnk k x <= 18446744073709551616 ^ nlimbs - 18446744073709551616 ^ k.
proof.
move=> Hk; have E := bn_k_kup k x Hk.
have [Hx0 Hx1] := bnk_cmp nlimbs x; have [Hk0 _] := bnk_cmp k x.
have HY: 0 < 18446744073709551616 ^ k by apply StdOrder.IntOrder.expr_gt0.
have EW: 18446744073709551616 ^ nlimbs
         = 18446744073709551616 ^ (nlimbs - k) * 18446744073709551616 ^ k
 by rewrite -exprD_nneg 1,2:/#; congr; ring.
have Hu: bnkup k x < 18446744073709551616 ^ (nlimbs - k).
 rewrite -(StdOrder.IntOrder.ltr_pmul2r _ HY) -EW.
 by move: E Hx1 Hk0; rewrite (_: W64.modulus = 18446744073709551616) //; smt().
have : bnkup k x * 18446744073709551616 ^ k <= (18446744073709551616 ^ (nlimbs - k) - 1) * 18446744073709551616 ^ k.
 by apply StdOrder.IntOrder.ler_wpmul2r; smt().
by move: E; rewrite (_: W64.modulus = 18446744073709551616) // => E; rewrite E EW; smt().
qed.

(* the rows so far stay below (W^nlimbs - W) * a[0..k) *)
lemma sqx_bnd k a: 0 <= k <= nlimbs =>
 sqx k a <= bnk k a * (18446744073709551616 ^ nlimbs - 18446744073709551616).
proof.
elim/natind: k => [k Hk H | k Hk IH H].
 by rewrite (_: k = 0) 1:/# sqx0 bnk0.
rewrite sqxS // bnkS //=.
have := IH _; first smt().
have Hs := bn_sub_bnk a (k+1) _; first smt().
have HW: 18446744073709551616 <= 18446744073709551616 ^ (k+1).
 have := StdOrder.IntOrder.expr_gt0 k 18446744073709551616 _ => //.
 by rewrite exprS //; smt().
have [Ha0 _] := W64.to_uint_cmp a.[k].
have HY: 0 <= to_uint a.[k] * 18446744073709551616 ^ k
 by apply StdOrder.IntOrder.mulr_ge0 => //; smt(StdOrder.IntOrder.expr_gt0).
have : to_uint a.[k] * 18446744073709551616 ^ k * (bn a - bnk (k + 1) a)
       <= to_uint a.[k] * 18446744073709551616 ^ k * (18446744073709551616 ^ nlimbs - 18446744073709551616)
 by apply StdOrder.IntOrder.ler_wpmul2l => //; smt().
move=> H1 H2.
have ->: (to_uint a.[k] * 18446744073709551616 ^ k + bnk k a)
         * (18446744073709551616 ^ nlimbs - 18446744073709551616)
         = to_uint a.[k] * 18446744073709551616 ^ k
           * (18446744073709551616 ^ nlimbs - 18446744073709551616)
           + bnk k a * (18446744073709551616 ^ nlimbs - 18446744073709551616) by ring.
by move: H1 H2; rewrite bnkS //=; smt().
qed.

(* row 0 of X: t[1..nlimbs] = a[0] * a[1..nlimbs) (t[0] is not written) *)
hoare __sqrr_row0_h _a:
 M.__sqrr_row0 : a=_a /\ 2 <= nlimbs
 ==> BN2.bnk (nlimbs+1) res = to_uint res.[0] + sqx 1 _a.
proof.
proc.
wp; while (a=_a /\ ai = _a.[0] /\ 2 <= j <= nlimbs
           /\ to_uint t.[j] <= 18446744073709551616 - 2
           /\ BN2.bnk j t + (to_uint t.[j] + b2i cf) * 18446744073709551616 ^ j
              = to_uint t.[0] + to_uint _a.[0] * (bnk j _a - bnk 1 _a)).
 wp; skip => /> &hr Hj1 _ Hh Hinv Hj2.
 rewrite /ADCX_64 /MULX_64 /=.
 rewrite (BN2.A.get_setE t{hr} (j{hr} + 1) j{hr}) 1:/# (_: (j{hr} = j{hr} + 1) = false) 1:/# /=.
 split; first smt().
 split.
  rewrite BN2.A.get_setE 1:/# (_: (j{hr} + 1 = j{hr}) = false) 1:/# /=.
  by rewrite BN2.A.get_setE 1:/# /=; exact JBigNumber.mulu_hi_bnd.
 rewrite (BN2.A.get_setE _ j{hr} 0) 1:/# (_: (0 = j{hr}) = false) 1:/# /=.
 rewrite (BN2.A.get_setE _ (j{hr} + 1) 0) 1:/# (_: (0 = j{hr} + 1) = false) 1:/# /=.
 rewrite BN2.bnk_put 1:/# BN2.bnk_setO 1:/# bnkS 1:/# /=.
 rewrite BN2.A.get_setE 1:/# (_: (j{hr} + 1 = j{hr}) = false) 1:/# /=.
 rewrite BN2.A.get_setE 1:/# /=.
 have A := JBigNumber.addc_to_uint t{hr}.[j{hr}] (mulu _a.[0] _a.[j{hr}]).`2 cf{hr}.
 have M := JBigNumber.mulu_to_uint _a.[0] _a.[j{hr}].
 have ->: to_uint (addc t{hr}.[j{hr}] (mulu _a.[0] _a.[j{hr}]).`2 cf{hr}).`2
          + 18446744073709551616 * (to_uint (mulu _a.[0] _a.[j{hr}]).`1
                                    + b2i (addc_carry t{hr}.[j{hr}] (mulu _a.[0] _a.[j{hr}]).`2 cf{hr}))
          = to_uint t{hr}.[j{hr}] + b2i cf{hr} + to_uint _a.[0] * to_uint _a.[j{hr}]
  by move: A M; rewrite (_: W64.modulus = 18446744073709551616) //; smt().
 have ->: BN2.bnk j{hr} t{hr}
          = to_uint t{hr}.[0] + to_uint _a.[0] * (bnk j{hr} _a - bnk 1 _a)
            - (to_uint t{hr}.[j{hr}] + b2i cf{hr}) * 18446744073709551616 ^ j{hr}
  by rewrite -Hinv; ring.
 by ring.
wp; skip => &hr /> H2.
rewrite /ADCX_64 /MULX_64 /set0_64_ /=.
split.
 rewrite (BN2.A.get_setE _ 1 2) 1:/# /= BN2.A.get_setE 1:/# /=.
 split; first exact JBigNumber.mulu_hi_bnd.
 rewrite (_: 2 = 1 + 1) // BN2.bnkS //= BN2.bnk1 /=.
 rewrite (BN2.A.get_setE _ 1 1) 1:/# /=.
 rewrite (_: bnk 2 a{hr} = to_uint a{hr}.[1] * 18446744073709551616 + to_uint a{hr}.[0]).
  by rewrite (_: 2 = 1 + 1) // bnkS //= bnk1.
 rewrite bnk1 /=.
 have M := JBigNumber.mulu_to_uint a{hr}.[0] a{hr}.[1].
 by move: M; rewrite (_: W64.modulus = 18446744073709551616) //= => M; smt().
move=> cf0 j0 t0 H1 H2' H3 Hh Hinv; have Ej: j0 = nlimbs by smt().
move: Hinv Hh; rewrite Ej => Hinv Hh.
have [_ E] := JBigNumber.addc_nc t0.[nlimbs] W64.zero cf0 _.
 by rewrite W64.to_uint0; move: Hh; case: cf0 => /= /#.
rewrite (BN2.A.get_setE _ nlimbs 0) 1:/# (_: (0 = nlimbs) = false) 1:/# /=.
rewrite BN2.bnkS 1:/# /= BN2.A.get_setE 1:/# /= BN2.bnk_setO 1:/# E W64.to_uint0.
have ->: sqx 1 a{hr} = to_uint a{hr}.[0] * (bn a{hr} - bnk 1 a{hr})
 by rewrite (_: 1 = 0 + 1) // sqxS // sqx0 /=.
by move: Hinv; smt().
qed.

(* row i of X (0 < i < nlimbs-1): t[2i+1..i+nlimbs] += a[i] * a(i..nlimbs)
   (t[i+nlimbs] is not read), with the carries of the two chains pending as
   in the multiplication; the words up to 2i are not written *)
hoare __sqrr_rowi_h _i _t _a:
 M.__sqrr_rowi : i=_i /\ t=_t /\ a=_a /\ 1 <= _i < nlimbs - 1
   /\ BN2.bnk (_i + nlimbs) _t
      + to_uint _a.[_i] * 18446744073709551616 ^ _i * (bn _a - bnk (_i+1) _a)
      < 18446744073709551616 ^ (_i + nlimbs + 1)
 ==> (forall w, 0 <= w <= 2*_i => res.[w] = _t.[w])
     /\ BN2.bnk (_i + nlimbs + 1) res
        = BN2.bnk (_i + nlimbs) _t
          + to_uint _a.[_i] * 18446744073709551616 ^ _i * (bn _a - bnk (_i+1) _a).
proof.
proc.
wp; while (i=_i /\ a=_a /\ ai = _a.[_i] /\ inc = nlimbs - 1 /\ _i + 1 <= j <= nlimbs - 1
           /\ 1 <= _i < nlimbs - 1
           /\ BN2.bnk (_i + nlimbs) _t
               + to_uint _a.[_i] * 18446744073709551616 ^ _i * (bn _a - bnk (_i+1) _a)
              < 18446744073709551616 ^ (_i + nlimbs + 1)
           /\ (forall w, 0 <= w <= 2*_i \/ _i + j < w < 2*nlimbs => t.[w] = _t.[w])
           /\ BN2.bnk (_i + j + 1) t
               + (b2i of_0 + 18446744073709551616 * b2i cf) * 18446744073709551616 ^ (_i + j)
              = BN2.bnk (_i + j + 1) _t
                + to_uint _a.[_i] * 18446744073709551616 ^ _i * (bnk j _a - bnk (_i+1) _a)).
 wp; skip => /> &hr Hj1 _ Hi1 Hi2 Hbnd Hfr Hinv Hj2.
 rewrite /ADCX_64 /ADOX_64 /MULX_64 /=.
 rewrite (BN2.A.get_setE t{hr} (_i + j{hr}) (_i + j{hr} + 1)) 1:/#.
 rewrite (_: (_i + j{hr} + 1 = _i + j{hr}) = false) 1:/# /=.
 rewrite (Hfr (_i + j{hr} + 1)) 1:/#.
 split; first smt().
 split.
  move=> w Hw; rewrite BN2.A.get_setE 1:/# (_: (w = _i + j{hr} + 1) = false) 1:/# /=.
  by rewrite BN2.A.get_setE 1:/# (_: (w = _i + j{hr}) = false) 1:/# /= Hfr /#.
 rewrite (_: _i + (j{hr} + 1) + 1 = (_i + j{hr}) + 2) 1:/# bnk_put2 1,2:/#.
 rewrite (_: _i + j{hr} + 2 = (_i + j{hr} + 1) + 1) 1:/# (BN2.bnkS (_i + j{hr} + 1) _t) 1:/# /=.
 rewrite (_: _i + (j{hr} + 1) = _i + j{hr} + 1) 1:/# bnkS 1:/# /=.
 move: Hinv; rewrite (BN2.bnkS (_i + j{hr})) 1:/# /= => Hinv.
 have A1 := JBigNumber.addc_to_uint t{hr}.[_i + j{hr}] (mulu _a.[_i] _a.[j{hr}]).`2 of_0{hr}.
 have A2 := JBigNumber.addc_to_uint _t.[_i + j{hr} + 1] (mulu _a.[_i] _a.[j{hr}]).`1 cf{hr}.
 have M := JBigNumber.mulu_to_uint _a.[_i] _a.[j{hr}].
 move: A1 A2 M; rewrite (_: W64.modulus = 18446744073709551616) // /= => A1 A2 M.
 rewrite A1 A2 /=.
 have ->: BN2.bnk (_i + j{hr}) t{hr}
          = BN2.bnk (_i + j{hr} + 1) _t
            + to_uint _a.[_i] * 18446744073709551616 ^ _i * (bnk j{hr} _a - bnk (_i+1) _a)
            - (b2i of_0{hr} + 18446744073709551616 * b2i cf{hr}) * 18446744073709551616 ^ (_i + j{hr})
            - to_uint t{hr}.[_i + j{hr}] * 18446744073709551616 ^ (_i + j{hr})
  by rewrite -Hinv; ring.
 have ->: 18446744073709551616 ^ (_i + j{hr} + 1)
          = 18446744073709551616 ^ (_i + j{hr}) * 18446744073709551616 by rewrite exprSr 1:/#.
 have ->: 18446744073709551616 ^ (_i + j{hr})
          = 18446744073709551616 ^ _i * 18446744073709551616 ^ j{hr} by rewrite exprD_nneg 1,2:/#.
 have ->: to_uint (mulu _a.[_i] _a.[j{hr}]).`2
          = to_uint _a.[_i] * to_uint _a.[j{hr}] - 18446744073709551616 * to_uint (mulu _a.[_i] _a.[j{hr}]).`1
  by rewrite -M; ring.
 by ring.
wp; skip => &hr /> Hi1 Hi2 Hbnd; rewrite /ADCX_64 /ADOX_64 /MULX_64 /set0_64_ /=.
split; first smt().
move=> cf0 j0 of0 t0 H1 H2 H3 Hfr Hinv; have Ej: j0 = nlimbs - 1 by smt().
have Hn := gt0_nlimbs.
move: Hinv Hfr; rewrite Ej (_: i{hr} + (nlimbs - 1) = i{hr} + nlimbs - 1) 1:/#.
rewrite (_: i{hr} + nlimbs - 1 + 1 = i{hr} + nlimbs) 1:/# => Hinv Hfr.
(* the reads of the last step *)
rewrite (BN2.A.get_setE t0 (i{hr} + nlimbs) (i{hr} + nlimbs - 1)) 1:/#.
rewrite (_: (i{hr} + nlimbs - 1 = i{hr} + nlimbs) = false) 1:/# /=.
pose h := (mulu a{hr}.[i{hr}] a{hr}.[nlimbs - 1]).`1.
pose l := (mulu a{hr}.[i{hr}] a{hr}.[nlimbs - 1]).`2.
pose x := addc t0.[i{hr} + nlimbs - 1] l of0.
rewrite (BN2.A.get_setE _ (i{hr} + nlimbs - 1) (i{hr} + nlimbs)) 1:/#.
rewrite (_: (i{hr} + nlimbs = i{hr} + nlimbs - 1) = false) 1:/# /=.
rewrite (BN2.A.get_setE t0 (i{hr} + nlimbs) (i{hr} + nlimbs)) 1:/# /=.
pose y := addc h W64.zero cf0.
rewrite (BN2.A.get_setE _ (i{hr} + nlimbs) (i{hr} + nlimbs)) 1:/# /=.
pose z := addc y.`2 W64.zero x.`1.
(* the writes: word i+nlimbs-1, then the top word *)
rewrite (BN2.A.set_set_swap t0 (i{hr} + nlimbs) (i{hr} + nlimbs - 1)) 1:/# BN2.A.set_set_eq.
split.
 move=> w Hw1 Hw2; rewrite !BN2.A.get_setE 1,2:/#.
 by rewrite (_: (w = i{hr} + nlimbs) = false) 1:/# (_: (w = i{hr} + nlimbs - 1) = false) 1:/# /= Hfr /#.
rewrite bnk_put2 1,2:/# (_: i{hr} + nlimbs - 1 + 1 = i{hr} + nlimbs) 1:/#.
have Et0: BN2.bnk (i{hr} + nlimbs) t0
          = to_uint t0.[i{hr} + nlimbs - 1] * 18446744073709551616 ^ (i{hr} + nlimbs - 1)
            + BN2.bnk (i{hr} + nlimbs - 1) t0.
 have := BN2.bnkS (i{hr} + nlimbs - 1) t0 _; first smt().
 by rewrite (_: i{hr} + nlimbs - 1 + 1 = i{hr} + nlimbs) 1:/#.
have Ea: bnk nlimbs a{hr}
         = to_uint a{hr}.[nlimbs - 1] * 18446744073709551616 ^ (nlimbs - 1) + bnk (nlimbs - 1) a{hr}.
 have := bnkS (nlimbs - 1) a{hr} _; first smt().
 by rewrite (_: nlimbs - 1 + 1 = nlimbs) 1:/#.
have EW1: 18446744073709551616 ^ (i{hr} + nlimbs)
          = 18446744073709551616 ^ (i{hr} + nlimbs - 1) * 18446744073709551616.
 by rewrite -exprSr 1:/#; congr; ring.
have EW2: 18446744073709551616 ^ (i{hr} + nlimbs - 1)
          = 18446744073709551616 ^ i{hr} * 18446744073709551616 ^ (nlimbs - 1).
 by rewrite -exprD_nneg 1,2:/#; congr; ring.
have A := JBigNumber.addc_to_uint t0.[i{hr} + nlimbs - 1] l of0.
have M := JBigNumber.mulu_to_uint a{hr}.[i{hr}] a{hr}.[nlimbs - 1].
move: A M; rewrite -/x -/h -/l (_: W64.modulus = 18446744073709551616) // => A M.
(* the value, with the top word as an integer *)
have EV: BN2.bnk (i{hr} + nlimbs - 1) t0 + to_uint x.`2 * 18446744073709551616 ^ (i{hr} + nlimbs - 1)
         + (to_uint h + b2i cf0 + b2i x.`1) * 18446744073709551616 ^ (i{hr} + nlimbs)
         = BN2.bnk (i{hr} + nlimbs) t{hr}
           + to_uint a{hr}.[i{hr}] * 18446744073709551616 ^ i{hr} * (bn a{hr} - bnk (i{hr} + 1) a{hr}).
 have ->: BN2.bnk (i{hr} + nlimbs - 1) t0
          = BN2.bnk (i{hr} + nlimbs) t{hr}
            + to_uint a{hr}.[i{hr}] * 18446744073709551616 ^ i{hr}
              * (bnk (nlimbs - 1) a{hr} - bnk (i{hr} + 1) a{hr})
            - (b2i of0 + 18446744073709551616 * b2i cf0) * 18446744073709551616 ^ (i{hr} + nlimbs - 1)
            - to_uint t0.[i{hr} + nlimbs - 1] * 18446744073709551616 ^ (i{hr} + nlimbs - 1)
  by rewrite -Hinv Et0; ring.
 rewrite A.
 have ->: to_uint l
          = to_uint a{hr}.[i{hr}] * to_uint a{hr}.[nlimbs - 1] - 18446744073709551616 * to_uint h
  by rewrite -M; ring.
 by rewrite EW1 Ea EW2; ring.
(* the top word does not overflow *)
have [Ht0 _] := BN2.bnk_cmp (i{hr} + nlimbs - 1) t0.
have [Hx0 _] := W64.to_uint_cmp x.`2.
have HY: 0 <= 18446744073709551616 ^ (i{hr} + nlimbs - 1)
 by apply StdOrder.IntOrder.expr_ge0.
have Htop := top_bnd (i{hr} + nlimbs) _ _ _ _ _ EV Hbnd; first smt().
 by apply StdOrder.IntOrder.addr_ge0 => //; apply StdOrder.IntOrder.mulr_ge0.
have [_ E1] := JBigNumber.addc_nc h W64.zero cf0 _.
 by rewrite W64.to_uint0; move: Htop; case: (x.`1) => /= /#.
have [_ E2] := JBigNumber.addc_nc y.`2 W64.zero x.`1 _.
 by rewrite /y E1 W64.to_uint0; move: Htop; case: (x.`1) => /= /#.
by rewrite /z E2 /y E1 !W64.to_uint0 -EV; ring.
qed.

(* a word of X, read from r when it was copied there, from t otherwise *)
lemma rd_copy (c: bool) (x y: W64.t): (c => x = y) => (if c then x else y) = y.
proof. by case: c. qed.

(* r = 2 * X + D, for X in t[1..2*nlimbs-2] (or in r[w], for its low words
   w with w + 10 <= 2*nlimbs, copied there by _os_sqrn): the doubling runs
   on the CF chain, the addition of the squares on the OF chain *)
hoare __sqrr_diag_h _r _t _a:
 M.__sqrr_diag : r=_r /\ t=_t /\ a=_a /\ 2 <= nlimbs
   /\ (forall w, 1 <= w < 2*nlimbs - 2 => w + 10 <= 2*nlimbs => _r.[w] = _t.[w])
   /\ 2 * (BN2.bnk (2*nlimbs-1) _t - to_uint _t.[0]) + sqd nlimbs _a
      < 18446744073709551616 ^ (2*nlimbs)
 ==> BN2.bnk (2*nlimbs) res
     = 2 * (BN2.bnk (2*nlimbs-1) _t - to_uint _t.[0]) + sqd nlimbs _a.
proof.
proc.
(* the reads of X, as expressions *)
proc change 6 : { x <- if (w + 10 <= 2 * nlimbs) then r.[w] else t.[w]; }; first by auto.
wp; while (a=_a /\ t=_t /\ inc = nlimbs - 1 /\ 1 <= i <= nlimbs - 1 /\ 2 <= nlimbs
           /\ 2 * (BN2.bnk (2*nlimbs-1) _t - to_uint _t.[0]) + sqd nlimbs _a
              < 18446744073709551616 ^ (2*nlimbs)
           /\ (forall w, 2*i <= w < 2*nlimbs - 2 => w + 10 <= 2*nlimbs => r.[w] = _t.[w])
           /\ BN2.bnk (2*i) r + (b2i cf + b2i of_0) * 18446744073709551616 ^ (2*i)
              = 2 * (BN2.bnk (2*i) _t - to_uint _t.[0]) + sqd i _a).
 proc change 4 : { x <- if (w + 10 <= 2 * nlimbs) then r.[w] else t.[w]; }; first by auto.
 proc change 9 : { x <- if (w + 10 <= 2 * nlimbs) then r.[w] else t.[w]; }; first by auto.
 wp; skip => /> &hr Hi1 _ Hn Hbnd Hfr Hinv Hi2.
 rewrite /ADCX_64 /ADOX_64 /MULX_64 /=.
 rewrite (BN2.A.get_setE r{hr} (2 * i{hr}) (2 * i{hr} + 1)) 1:/#.
 rewrite (_: (2 * i{hr} + 1 = 2 * i{hr}) = false) 1:/# /=.
 rewrite (rd_copy _ r{hr}.[2 * i{hr}]); first by move=> Hc; rewrite Hfr /#.
 rewrite (rd_copy _ r{hr}.[2 * i{hr} + 1]); first by move=> Hc; rewrite Hfr /#.
 split; first smt().
 split.
  move=> w Hw1 Hw2 Hw3; rewrite BN2.A.get_setE 1:/# (_: (w = 2 * i{hr} + 1) = false) 1:/# /=.
  by rewrite BN2.A.get_setE 1:/# (_: (w = 2 * i{hr}) = false) 1:/# /= Hfr /#.
 pose x0 := _t.[2 * i{hr}]; pose x1 := _t.[2 * i{hr} + 1].
 pose p := mulu _a.[i{hr}] _a.[i{hr}].
 pose u1 := addc x0 x0 cf{hr}; pose u2 := addc u1.`2 p.`2 of_0{hr}.
 pose v1 := addc x1 x1 u1.`1; pose v2 := addc v1.`2 p.`1 u2.`1.
 rewrite (_: 2 * (i{hr} + 1) = 2 * i{hr} + 2) 1:/# bnk_put2 1,2:/#.
 rewrite (_: 2 * i{hr} + 2 = (2 * i{hr} + 1) + 1) 1:/#.
 rewrite (BN2.bnkS (2 * i{hr} + 1)) 1:/# (BN2.bnkS (2 * i{hr})) 1:/# /= sqdS 1:/# -/x0 -/x1.
 have A1 := JBigNumber.addc_to_uint x0 x0 cf{hr}.
 have A2 := JBigNumber.addc_to_uint u1.`2 p.`2 of_0{hr}.
 have A3 := JBigNumber.addc_to_uint x1 x1 u1.`1.
 have A4 := JBigNumber.addc_to_uint v1.`2 p.`1 u2.`1.
 have M := JBigNumber.mulu_to_uint _a.[i{hr}] _a.[i{hr}].
 have Hin: to_uint u2.`2 + 18446744073709551616
             * (to_uint v2.`2 + 18446744073709551616 * (b2i v1.`1 + b2i v2.`1))
           = 2 * (to_uint x0 + 18446744073709551616 * to_uint x1) + b2i cf{hr} + b2i of_0{hr}
             + to_uint _a.[i{hr}] * to_uint _a.[i{hr}]
  by move: A1 A2 A3 A4 M; rewrite -/x0 -/x1 -/p -/u1 -/u2 -/v1 -/v2
       (_: W64.modulus = 18446744073709551616) //; smt().
 have E1: 18446744073709551616 ^ (2 * i{hr} + 1)
          = 18446744073709551616 ^ (2 * i{hr}) * 18446744073709551616 by rewrite exprSr 1:/#.
 have E2: 18446744073709551616 ^ (2 * i{hr} + 1 + 1)
          = 18446744073709551616 ^ (2 * i{hr}) * 18446744073709551616 * 18446744073709551616
  by rewrite exprSr 1:/# E1.
 have ->: BN2.bnk (2 * i{hr}) r{hr}
          = 2 * (BN2.bnk (2 * i{hr}) _t - to_uint _t.[0]) + sqd i{hr} _a
            - (b2i cf{hr} + b2i of_0{hr}) * 18446744073709551616 ^ (2 * i{hr})
  by rewrite -Hinv; ring.
 rewrite E2 E1.
 have ->: to_uint u2.`2
          = 2 * (to_uint x0 + 18446744073709551616 * to_uint x1) + b2i cf{hr} + b2i of_0{hr}
            + to_uint _a.[i{hr}] * to_uint _a.[i{hr}]
            - 18446744073709551616 * (to_uint v2.`2 + 18446744073709551616 * (b2i v1.`1 + b2i v2.`1))
  by rewrite -Hin; ring.
 by ring.
(* the first word: X[1] (in r[1] or in t[1]), doubled, plus the high word of a[0]^2 *)
wp; skip => &hr /> Hn Hcp Hbnd.
rewrite /ADCX_64 /ADOX_64 /MULX_64 /set0_64_ /=.
rewrite (BN2.A.get_setE r{hr} 0 1) 1:/# /=.
rewrite (rd_copy _ r{hr}.[1]); first by move=> Hc; rewrite Hcp /#.
split.
 split; first smt().
 split.
  move=> w Hw1 Hw2 Hw3; rewrite BN2.A.get_setE 1:/# (_: (w = 1) = false) 1:/# /=.
  by rewrite BN2.A.get_setE 1:/# (_: (w = 0) = false) 1:/# /= Hcp /#.
 have E2: forall (x: BN2.t), BN2.bnk 2 x = to_uint x.[0] + to_uint x.[1] * 18446744073709551616.
  by move=> x; rewrite (_: 2 = 1 + 1) // BN2.bnkS //= BN2.bnk1 /=; ring.
 have ->: sqd 1 a{hr} = to_uint a{hr}.[0] * to_uint a{hr}.[0]
  by rewrite (_: 1 = 0 + 1) // sqdS // sqd0.
 rewrite !E2 !BN2.A.get_setE 1..4:/# /=.
 pose x1 := t{hr}.[1].
 pose p := mulu a{hr}.[0] a{hr}.[0].
 pose u1 := addc x1 x1 false.
 pose u2 := addc u1.`2 p.`1 false.
 have A1 := JBigNumber.addc_to_uint x1 x1 false.
 have A2 := JBigNumber.addc_to_uint u1.`2 p.`1 false.
 have M := JBigNumber.mulu_to_uint a{hr}.[0] a{hr}.[0].
 move: A1 A2 M; rewrite -/x1 -/p -/u1 -/u2 (_: W64.modulus = 18446744073709551616) // /=.
 smt().
(* the last position, and the top word (which does not overflow) *)
move=> cf0 i0 of0 r0 H1 H2 H3 Hfr Hinv.
have Ei: i0 = nlimbs - 1 by smt().
move: Hinv Hfr; rewrite Ei (_: 2 * (nlimbs - 1) = 2 * nlimbs - 2) 1:/# => Hinv Hfr.
pose x := t{hr}.[2 * nlimbs - 2].
pose p := mulu a{hr}.[nlimbs - 1] a{hr}.[nlimbs - 1].
pose u1 := addc x x cf0.
pose u2 := addc u1.`2 p.`2 of0.
have A1 := JBigNumber.addc_to_uint x x cf0.
have A2 := JBigNumber.addc_to_uint u1.`2 p.`2 of0.
have M := JBigNumber.mulu_to_uint a{hr}.[nlimbs - 1] a{hr}.[nlimbs - 1].
move: A1 A2 M; rewrite -/x -/p -/u1 -/u2 (_: W64.modulus = 18446744073709551616) // => A1 A2 M.
have EV: BN2.bnk (2 * nlimbs - 1) r0.[2 * nlimbs - 2 <- u2.`2]
         + (to_uint p.`1 + b2i u1.`1 + b2i u2.`1) * 18446744073709551616 ^ (2 * nlimbs - 1)
         = 2 * (BN2.bnk (2 * nlimbs - 1) t{hr} - to_uint t{hr}.[0]) + sqd nlimbs a{hr}.
 rewrite (_: 2 * nlimbs - 1 = (2 * nlimbs - 2) + 1) 1:/# BN2.bnk_put 1:/#.
 rewrite (BN2.bnkS (2 * nlimbs - 2)) 1:/# /= -/x.
 rewrite (_: nlimbs = (nlimbs - 1) + 1) 1:/# sqdS 1:/# /=.
 rewrite (_: 2 * (nlimbs - 1) = 2 * nlimbs - 2) 1:/#.
 have ->: to_uint u2.`2 + 18446744073709551616 * (to_uint p.`1 + b2i u1.`1 + b2i u2.`1)
          = 2 * to_uint x + b2i cf0 + b2i of0
            + to_uint a{hr}.[nlimbs - 1] * to_uint a{hr}.[nlimbs - 1] by smt().
 have ->: BN2.bnk (2 * nlimbs - 2) r0
          = 2 * (BN2.bnk (2 * nlimbs - 2) t{hr} - to_uint t{hr}.[0]) + sqd (nlimbs - 1) a{hr}
            - (b2i cf0 + b2i of0) * 18446744073709551616 ^ (2 * nlimbs - 2)
  by rewrite -Hinv; ring.
 by ring.
have [Hr0 _] := BN2.bnk_cmp (2 * nlimbs - 1) r0.[2 * nlimbs - 2 <- u2.`2].
have HX := top_bnd (2 * nlimbs - 1) _ _ _ _ Hr0 EV _; first smt().
 by rewrite (_: 2 * nlimbs - 1 + 1 = 2 * nlimbs) 1:/#.
have [_ E1] := JBigNumber.addc_nc p.`1 W64.zero u1.`1 _.
 by rewrite W64.to_uint0; move: HX; case: (u1.`1); case: (u2.`1) => /= /#.
have [_ E2] := JBigNumber.addc_nc (addc p.`1 W64.zero u1.`1).`2 W64.zero u2.`1 _.
 by rewrite E1 W64.to_uint0; move: HX; case: (u1.`1); case: (u2.`1) => /= /#.
have B2: forall (y: BN2.t), BN2.bnk (2 * nlimbs) y
         = BN2.bnk (2 * nlimbs - 1) y + to_uint y.[2 * nlimbs - 1] * 18446744073709551616 ^ (2 * nlimbs - 1).
 move=> y; have := BN2.bnkS (2 * nlimbs - 1) y _; first smt(gt0_nlimbs).
 by rewrite (_: 2 * nlimbs - 1 + 1 = 2 * nlimbs) 1:/# => -> /=; ring.
rewrite B2 BN2.A.get_setE 1:/# /= BN2.bnk_setO 1:/# E2 E1 !W64.to_uint0 /=.
by rewrite -EV; ring.
qed.

(* the squaring: row 0, rows 1..nlimbs-2, then the doubling (a single
   product when nlimbs = 1). After row i, the words 2i+1 and 2i+2 of X
   are final, and are copied into r when the diagonal pass reads them
   from there *)
hoare _os_sqrn_h _a:
 M._os_sqrn : a=_a ==> BN2.bn res = bn _a * bn _a.
proof.
proc.
sp; if.
 wp; skip => /> &hr Hn.
 rewrite /MULX_64 /= Hn /= (_: 2 = 1 + 1) // BN2.bnkS //= BN2.bnk1 /= bnk1 /=.
 rewrite !BN2.A.get_setE 1..4:/# /=.
 have M := JBigNumber.mulu_to_uint _a.[0] _a.[0].
 by move: M; rewrite (_: W64.modulus = 18446744073709551616) // => M; smt().
ecall (__sqrr_diag_h r t a).
while (a = _a /\ inc = nlimbs - 1 /\ 1 <= i <= nlimbs - 1 /\ 2 <= nlimbs
       /\ BN2.bnk (i + nlimbs) t = to_uint t.[0] + sqx i _a
       /\ (forall w, 1 <= w <= 2*i => w + 10 <= 2*nlimbs => r.[w] = t.[w])).
 wp; while (a = _a /\ inc = nlimbs - 1 /\ 1 <= i < nlimbs - 1 /\ 2 <= nlimbs
            /\ inc_0 = 2*i + 3 /\ 2*i + 1 <= w <= 2*i + 3
            /\ BN2.bnk (i + 1 + nlimbs) t = to_uint t.[0] + sqx (i + 1) _a
            /\ (forall w', 1 <= w' < w => w' + 10 <= 2*nlimbs => r.[w'] = t.[w'])).
  wp; skip => /> &hr Hi1 Hi2 Hn Hw1 Hw2 Hv Hcp Hw3.
  split => Hc; (split; first smt()); move=> w' Hw'1 Hw'2 Hw'3.
   by rewrite BN2.A.get_setE 1:/#; case: (w' = w{hr}) => // Hne; rewrite Hcp /#.
  by rewrite Hcp /#.
 wp; ecall (__sqrr_rowi_h i t a); skip => /> &hr Hi1 _ Hn Hinv Hcp Hi2.
 split.
  rewrite Hinv.
  have ->: to_uint t{hr}.[0] + sqx i{hr} _a
           + to_uint _a.[i{hr}] * 18446744073709551616 ^ i{hr} * (bn _a - bnk (i{hr} + 1) _a)
           = to_uint t{hr}.[0] + sqx (i{hr} + 1) _a by rewrite sqxS 1:/#; ring.
  have Hb := sqx_bnd (i{hr} + 1) _a _; first smt().
  have [Hk0 Hk1] := bnk_cmp (i{hr} + 1) _a.
  have [Ht00 Ht01] := W64.to_uint_cmp t{hr}.[0].
  have HW1: 18446744073709551616 <= 18446744073709551616 ^ nlimbs.
   have := StdOrder.IntOrder.expr_gt0 (nlimbs - 1) 18446744073709551616 _ => //.
   have ->: 18446744073709551616 ^ nlimbs
            = 18446744073709551616 ^ (nlimbs - 1) * 18446744073709551616
    by rewrite -exprSr; smt(gt0_nlimbs).
   smt().
  have HW2: 18446744073709551616 * 18446744073709551616 <= 18446744073709551616 ^ (i{hr} + 2).
   have := StdOrder.IntOrder.expr_gt0 i{hr} 18446744073709551616 _ => //.
   by rewrite (_: i{hr} + 2 = i{hr} + 1 + 1) 1:/# exprS 1:/# exprS 1:/#; smt().
  have Hk2: bnk (i{hr} + 1) _a <= 18446744073709551616 ^ (i{hr} + 1) - 1
   by move: Hk1; rewrite (_: W64.modulus = 18446744073709551616) //; smt().
  have : bnk (i{hr} + 1) _a * (18446744073709551616 ^ nlimbs - 18446744073709551616)
         <= (18446744073709551616 ^ (i{hr} + 1) - 1) * (18446744073709551616 ^ nlimbs - 18446744073709551616)
   by apply StdOrder.IntOrder.ler_wpmul2r; smt().
  have ->: 18446744073709551616 ^ (i{hr} + nlimbs + 1)
           = 18446744073709551616 ^ (i{hr} + 1) * 18446744073709551616 ^ nlimbs
   by rewrite -exprD_nneg 1,2:/#; congr; ring.
  have E3: 18446744073709551616 ^ (i{hr} + 2)
           = 18446744073709551616 ^ (i{hr} + 1) * 18446744073709551616
   by rewrite -exprSr 1:/#.
  move: HW2; rewrite E3 => HW2.
  move: Ht01 HW1 HW2 Hb; rewrite (_: W64.modulus = 18446744073709551616) //; smt().
 move=> _ t' Ht'fr Ht'.
 have Ht'0: t'.[0] = t{hr}.[0] by rewrite Ht'fr; smt().
 split.
  split; first smt().
  split.
   rewrite Ht'0 (_: i{hr} + 1 + nlimbs = i{hr} + nlimbs + 1) 1:/# Ht' Hinv sqxS 1:/#.
   by ring.
  by move=> w' Hw1 Hw2 Hw3; rewrite Hcp 1:/# // Ht'fr /#.
 move=> r0 w0 Hw0 Hw1 Hw2 _ Hcp0.
 split; first smt().
 by move=> w1 Hw3 Hw4 Hw5; rewrite Hcp0 /#.
(* row 0, and the copies of words 1 and 2 of X *)
wp; while (a = _a /\ 2 <= nlimbs /\ 1 <= w <= 3
           /\ BN2.bnk (nlimbs + 1) t = to_uint t.[0] + sqx 1 _a
           /\ (forall w', 1 <= w' < w => w' + 10 <= 2*nlimbs => r.[w'] = t.[w'])).
 wp; skip => /> &hr Hn Hw1 Hw2 Hv Hcp Hw3.
 split => Hc; (split; first smt()); move=> w' Hw'1 Hw'2 Hw'3.
  by rewrite BN2.A.get_setE 1:/#; case: (w' = w{hr}) => // Hne; rewrite Hcp /#.
 by rewrite Hcp /#.
wp; ecall (__sqrr_row0_h a); skip => /> &hr Hn1.
have Hn2: 2 <= nlimbs by smt(gt0_nlimbs).
split; first done.
move=> _ t' Ht'.
split; first smt().
move=> r0 w0 Hw0 Hw1 Hw2 Hcp0.
split.
 split; first smt().
 split; first by rewrite addzC Ht'.
 by move=> w1 Hw3 Hw4 Hw5; rewrite Hcp0 /#.
move=> i0 r1 t0 Hi0 Hi1 Hi2 Hinv Hcp1; have Ei: i0 = nlimbs - 1 by smt().
move: Hinv Hcp1; rewrite Ei (_: nlimbs - 1 + nlimbs = 2 * nlimbs - 1) 1:/# => Hinv Hcp1.
have EX: 2 * (BN2.bnk (2 * nlimbs - 1) t0 - to_uint t0.[0]) + sqd nlimbs _a = bn _a * bn _a
 by rewrite Hinv sq_ident sqx_last; ring.
split.
 split; first by move=> w1 Hw3 Hw4 Hw5; rewrite Hcp1 /#.
 rewrite EX.
 have [Ha0 Ha1] := bnk_cmp nlimbs _a.
 rewrite (_: 2 * nlimbs = nlimbs + nlimbs) 1:/# exprD_nneg 1,2:/#.
 by apply StdOrder.IntOrder.ltr_pmul; move: Ha0 Ha1;
    rewrite (_: W64.modulus = 18446744073709551616) //; smt().
by move=> _ _ r2 ->; rewrite EX.
qed.

hoare _os_sqrn__h _a:
 M._os_sqrn_ : a=_a ==> bn res = bn _a * bn _a.
proof. by proc; wp; ecall (_os_sqrn_h a); auto. qed.

(* two prefixes of double-size numbers that agree *)
lemma bnk2_eq (x y: BN2.t) k:
 (forall j, 0 <= j < k => x.[j] = y.[j]) => BN2.bnk k x = BN2.bnk k y.
proof.
move=> H; rewrite /BN2.bnk; apply eq_big_seq => j.
by rewrite mem_range => Hj /=; rewrite H.
qed.

(* a prefix of zero words *)
lemma bnk2_zero (x: BN2.t) k:
 0 <= k => (forall j, 0 <= j < k => x.[j] = W64.zero) => BN2.bnk k x = 0.
proof.
elim/natind: k => [k Hk H0 _ | k Hk IH _ H]; first by rewrite (_: k = 0) 1:/# BN2.bnk0.
by rewrite BN2.bnkS //= H 1:/# W64.to_uint0 /= IH // => j Hj; rewrite H /#.
qed.

(* Montgomery reduction, the constants given as the two halves of [_P_mP].
   The window of row k is w[k..k+nlimbs); the words below it are zero
   (each row makes its first word vanish). At row k, with M the sum of the
   multipliers so far (a ghost):
     w[0..k+nlimbs) + c * W^(k+nlimbs) = a[0..k+nlimbs) + M * P,   0 <= M < W^k
   After the last row, [w[nlimbs..2*nlimbs) ; c] * R = a + M * P, and the
   conditional subtraction (inline) is that of BNB._cminusP_ *)
lemma __mont_redM_halves_h rInv __P __mP __U0 _a:
 (rInv * BN.bn_modulus) %% BN.bn __P = 1 =>
 bn __P + BN.bn __mP = BN.bn_modulus =>
 __U0 * __P.[0] = W64.of_int (-1) =>
 bn _a < bn __P * BN.bn_modulus =>
 hoare [ M.__mont_redM
       : BN.A.init (fun i => _P_mP.[i]) = __P
         /\ BN.A.init (fun i => _P_mP.[nlimbs + i]) = __mP /\ _U0=__U0 /\ a=_a
         ==> bn res = (bn _a * rInv) %% bn __P
       ].
proof.
move => rInv_r P_mP U0_P0 a_bnd.
proc.
(* the window starts as the low half of a *)
seq 4 : (BN.A.init (fun i => _P_mP.[i]) = __P
         /\ BN.A.init (fun i => _P_mP.[nlimbs + i]) = __mP /\ _U0 = __U0 /\ a = _a
         /\ (forall j, 0 <= j < nlimbs => w.[j] = _a.[j])).
 wp; while (BN.A.init (fun i => _P_mP.[i]) = __P
            /\ BN.A.init (fun i => _P_mP.[nlimbs + i]) = __mP /\ _U0 = __U0 /\ a = _a
            /\ 0 <= i <= nlimbs /\ (forall j, 0 <= j < i => w.[j] = _a.[j])).
  wp; skip => /> &hr _ _ Hi1 _ Hcp Hi2; split; first smt().
  by move=> j Hj1 Hj2; rewrite BN2.A.get_setE 1:/#; case: (j = i{hr}) => // Hne; rewrite Hcp /#.
 wp; skip => /> &hr _ _; split; first smt(gt0_nlimbs).
 by move=> i0 w0 Hi0 Hi1 Hi2 Hcp j Hj1 Hj2; rewrite Hcp /#.
(* the rows *)
seq 3 : (BN.A.init (fun i => _P_mP.[i]) = __P
         /\ BN.A.init (fun i => _P_mP.[nlimbs + i]) = __mP /\ _U0 = __U0 /\ a = _a
         /\ to_uint c <= 1 /\ (forall j, 0 <= j < nlimbs => w.[j] = W64.zero)
         /\ exists M, 0 <= M < 18446744073709551616 ^ nlimbs
             /\ BN2.bnk (2*nlimbs) w + to_uint c * 18446744073709551616 ^ (2*nlimbs)
                = BN2.bnk (2*nlimbs) _a + M * BN.bnk nlimbs __P).
 while (BN.A.init (fun i => _P_mP.[i]) = __P
        /\ BN.A.init (fun i => _P_mP.[nlimbs + i]) = __mP /\ _U0 = __U0 /\ a = _a
        /\ 0 <= k <= nlimbs /\ to_uint c <= 1 /\ (k = 0 => c = W64.zero)
        /\ (forall j, 0 <= j < k => w.[j] = W64.zero)
        /\ exists M, 0 <= M < 18446744073709551616 ^ k
            /\ BN2.bnk (k + nlimbs) w + to_uint c * 18446744073709551616 ^ (k + nlimbs)
               = BN2.bnk (k + nlimbs) _a + M * BN.bnk nlimbs __P).
  exists* w, c, k; elim* => w0 c0 k0 M0.
  wp.
  while (BN.A.init (fun i => _P_mP.[i]) = __P
         /\ BN.A.init (fun i => _P_mP.[nlimbs + i]) = __mP /\ _U0 = __U0 /\ a = _a
         /\ k = k0 /\ c = c0 /\ 0 <= k0 < nlimbs /\ to_uint c0 <= 1 /\ (k0 = 0 => c0 = W64.zero)
         /\ (forall j, 0 <= j < k0 => w0.[j] = W64.zero) /\ 0 <= M0 < 18446744073709551616 ^ k0
         /\ BN2.bnk (k0 + nlimbs) w0 + to_uint c0 * 18446744073709551616 ^ (k0 + nlimbs)
            = BN2.bnk (k0 + nlimbs) _a + M0 * BN.bnk nlimbs __P
         /\ m = w0.[k0] * __U0
         /\ 1 <= i <= nlimbs
         /\ (forall j, 0 <= j < k0 \/ k0 + i <= j < 2*nlimbs => w.[j] = w0.[j])
         /\ w.[k0] = W64.zero
         /\ to_uint hi <= 18446744073709551616 - 2
         /\ BN2.bnk (k0 + i) w + (to_uint hi + b2i cf + b2i of_0) * 18446744073709551616 ^ (k0 + i)
            = BN2.bnk (k0 + i) w0 + 18446744073709551616 ^ k0 * (to_uint m * BN.bnk i __P)).
   wp; skip => /> &hr HP HmP Hk0 Hk1 Hc0 Hc00 Hz0 HM0 HM1 Hinv0 Hi1 Hi2 Hfr Hw0 Hh Hinv Hi3.
   have EP: _P_mP{hr}.[i{hr}] = __P.[i{hr}] by rewrite -HP BN.A.initiE 1:/#.
   rewrite /ADCX_64 /ADOX_64 /MULX_64 /= HP EP; rewrite HP in Hinv.
   rewrite (BN2.A.get_setE w{hr} (k0 + i{hr}) (k0 + i{hr})) 1:/# /=.
   rewrite (Hfr (k0 + i{hr})) 1:/#.
   split; first smt().
   split.
    by move=> j Hj; rewrite BN2.A.get_setE 1:/# (_: (j = k0 + i{hr}) = false) 1:/# /= Hfr /#.
   split.
    by rewrite BN2.A.get_setE 1:/# (_: (k0 = k0 + i{hr}) = false) 1:/# /= Hw0.
   split; first exact JBigNumber.mulu_hi_bnd.
   rewrite (_: k0 + (i{hr} + 1) = (k0 + i{hr}) + 1) 1:/#.
   rewrite BN2.bnk_put 1:/# (BN2.bnkS (k0 + i{hr}) w0) 1:/# bnkS 1:/# /=.
   pose m := w0.[k0] * __U0.
   pose t1 := addc w0.[k0 + i{hr}] hi{hr} cf{hr}.
   pose t2 := addc t1.`2 (mulu m __P.[i{hr}]).`2 of_0{hr}.
   have A1 := JBigNumber.addc_to_uint w0.[k0 + i{hr}] hi{hr} cf{hr}.
   have A2 := JBigNumber.addc_to_uint t1.`2 (mulu m __P.[i{hr}]).`2 of_0{hr}.
   have M := JBigNumber.mulu_to_uint m __P.[i{hr}].
   move: A1 A2 M; rewrite -/t1 -/t2 (_: W64.modulus = 18446744073709551616) // => A1 A2 M.
   have ->: to_uint t2.`2
            = to_uint w0.[k0 + i{hr}] + to_uint hi{hr} + b2i cf{hr} + b2i of_0{hr}
              + to_uint m * to_uint __P.[i{hr}]
              - 18446744073709551616 * (to_uint (mulu m __P.[i{hr}]).`1 + b2i t1.`1 + b2i t2.`1)
    by rewrite A2 A1 -M; ring.
   have ->: BN2.bnk (k0 + i{hr}) w{hr}
            = BN2.bnk (k0 + i{hr}) w0
              + 18446744073709551616 ^ k0 * (to_uint m * bnk i{hr} __P)
              - (to_uint hi{hr} + b2i cf{hr} + b2i of_0{hr}) * 18446744073709551616 ^ (k0 + i{hr})
    by rewrite -Hinv; ring.
   by rewrite exprD_nneg 1,2:/#; ring.
  (* the row: its first word vanishes; its top word, with a[k+nlimbs] and
     the carry, is the new top word of the window *)
  wp; skip => /> &hr HP HmP Hk0 _ Hc0 Hc00 Hz0 HM0 HM1 Hinv0 Hk.
  have Hn := gt0_nlimbs.
  have EP0: _P_mP{hr}.[0] = __P.[0] by rewrite -HP BN.A.initiE.
  rewrite /ADCX_64 /ADOX_64 /MULX_64 /set0_64_ /= HP EP0; rewrite HP in Hinv0.
  pose m := w0.[k0] * __U0.
  pose t := addc w0.[k0] (mulu m __P.[0]).`2 false.
  have M := JBigNumber.mulu_to_uint m __P.[0].
  have A := JBigNumber.addc_to_uint w0.[k0] (mulu m __P.[0]).`2 false.
  have L := JBigNumber.mont_low0 w0.[k0] __U0 __P.[0] U0_P0.
  have [Ht0 Ht1] := W64.to_uint_cmp t.`2.
  have E1: to_uint w0.[k0] + to_uint m * to_uint __P.[0]
           = to_uint t.`2 + W64.modulus * (b2i t.`1 + to_uint (mulu m __P.[0]).`1)
   by move: A M; rewrite -/t; smt().
  have Ht: to_uint t.`2 = 0
   by move: L; rewrite -/m E1 (mulzC W64.modulus) modzMDr modz_small //; smt().
  split.
   split; first smt().
   split.
    by move=> j Hj; rewrite BN2.A.get_setE 1:/# (_: (j = k0) = false) 1:/#.
   split; first by rewrite BN2.A.get_setE 1:/# /= W64.to_uint_eq Ht W64.to_uint0.
   split; first exact JBigNumber.mulu_hi_bnd.
   rewrite BN2.bnk_put 1:/# (BN2.bnkS k0 w0) 1:/# bnk1 /=.
   move: E1; rewrite (_: W64.modulus = 18446744073709551616) // => E1.
   have ->: to_uint t.`2
            = to_uint w0.[k0] + to_uint m * to_uint __P.[0]
              - 18446744073709551616 * (b2i t.`1 + to_uint (mulu m __P.[0]).`1) by rewrite E1; ring.
   by ring.
  move=> cf0 hi0 i0 of0 w1 Hi0 Hi1 Hi2 Hfr Hw1 Hh Hinv.
  have Ei: i0 = nlimbs by smt().
  move: Hfr Hinv; rewrite Ei => Hfr Hinv.
  (* the top word of the row does not overflow *)
  have [Hw00 Hw01] := BN2.bnk_cmp (k0 + nlimbs) w0.
  have [HP0 HP1] := bnk_cmp nlimbs __P.
  have [Hm0 Hm1] := W64.to_uint_cmp m.
  have [Hw10 _] := BN2.bnk_cmp (k0 + nlimbs) w1.
  have HY: 0 < 18446744073709551616 ^ k0 by apply StdOrder.IntOrder.expr_gt0.
  have Hrow: BN2.bnk (k0 + nlimbs) w0
             + 18446744073709551616 ^ k0 * (to_uint m * bnk nlimbs __P)
             < 18446744073709551616 ^ (k0 + nlimbs + 1).
   have Hm2: to_uint m <= 18446744073709551616 - 1
    by move: Hm1; rewrite (_: W64.modulus = 18446744073709551616) //; smt().
   have HP2: bnk nlimbs __P <= 18446744073709551616 ^ nlimbs - 1 by move: HP1; smt().
   have HmPb := StdOrder.IntOrder.ler_pmul (to_uint m) (18446744073709551616 - 1) (bnk nlimbs __P)
                  (18446744073709551616 ^ nlimbs - 1) Hm0 HP0 Hm2 HP2.
   have HmPk: 18446744073709551616 ^ k0 * (to_uint m * bnk nlimbs __P)
              <= 18446744073709551616 ^ k0 * ((18446744073709551616 - 1) * (18446744073709551616 ^ nlimbs - 1))
    by apply StdOrder.IntOrder.ler_wpmul2l; smt().
   have E2: 18446744073709551616 ^ (k0 + nlimbs + 1)
            = 18446744073709551616 ^ k0 * 18446744073709551616 ^ nlimbs * 18446744073709551616
    by rewrite exprSr 1:/# exprD_nneg 1,2:/#.
   have E3: 18446744073709551616 ^ (k0 + nlimbs) = 18446744073709551616 ^ k0 * 18446744073709551616 ^ nlimbs
    by rewrite exprD_nneg 1,2:/#.
   have E4: 18446744073709551616 ^ k0 * ((18446744073709551616 - 1) * (18446744073709551616 ^ nlimbs - 1))
            = 18446744073709551616 ^ k0 * 18446744073709551616 ^ nlimbs * 18446744073709551616
              - 18446744073709551616 ^ k0 * 18446744073709551616 ^ nlimbs
              - 18446744073709551616 ^ k0 * 18446744073709551616 + 18446744073709551616 ^ k0 by ring.
   move: Hw01 HmPk; rewrite (_: W64.modulus = 18446744073709551616) // E2 E3 E4.
   move: (18446744073709551616 ^ k0 * 18446744073709551616 ^ nlimbs) => KN; smt().
  have HX := top_bnd (k0 + nlimbs) _ _ _ _ Hw10 Hinv Hrow; first smt().
  have [_ E3] := JBigNumber.addc_nc hi0 W64.zero cf0 _.
   by rewrite W64.to_uint0; move: Hh; case: cf0 => /= /#.
  have [_ E4] := JBigNumber.addc_nc (addc hi0 W64.zero cf0).`2 W64.zero of0 _.
   by rewrite E3 W64.to_uint0; move: HX; case: cf0; case: of0 => /= /#.
  pose h := (addc (addc hi0 W64.zero cf0).`2 W64.zero of0).`2.
  have Eh: to_uint h = to_uint hi0 + b2i cf0 + b2i of0 by rewrite /h E4 E3 !W64.to_uint0.
  have EM: forall (b: bool), to_uint (addc (MOV_64 W64.zero) W64.zero b).`2 = b2i b.
   move=> b; rewrite /MOV_64; have [_ ->] := JBigNumber.addc_nc W64.zero W64.zero b _.
    by rewrite W64.to_uint0; case: b.
   by rewrite W64.to_uint0.
  (* the top word, for either carry in (c0, read as a flag) *)
  have GEN: forall (ci: bool) (K: int), K = k0 + nlimbs => b2i ci = to_uint c0 =>
    (forall j, 0 <= j < k0 + 1 => w1.[K <- (addc h _a.[K] ci).`2].[j] = W64.zero) /\
    exists M1, 0 <= M1 < 18446744073709551616 ^ (k0 + 1) /\
     BN2.bnk (k0 + 1 + nlimbs) w1.[K <- (addc h _a.[K] ci).`2]
     + b2i (addc h _a.[K] ci).`1 * 18446744073709551616 ^ (k0 + 1 + nlimbs)
     = BN2.bnk (k0 + 1 + nlimbs) _a + M1 * bnk nlimbs __P.
   move=> ci K EK Eci.
   have A1 := JBigNumber.addc_to_uint h _a.[K] ci.
   split.
    move=> j Hj; rewrite BN2.A.get_setE 1:/# (_: (j = K) = false) 1:/# /=.
    by case: (j = k0) => [-> // | Hne]; rewrite Hfr 1:/# Hz0 /#.
   exists (M0 + to_uint m * 18446744073709551616 ^ k0).
   split.
    have Hle: to_uint m * 18446744073709551616 ^ k0 <= (18446744073709551616 - 1) * 18446744073709551616 ^ k0.
     by apply StdOrder.IntOrder.ler_wpmul2r; [smt() | move: Hm1; smt()].
    by rewrite exprSr 1:/#; move: HM0 HM1 Hm0 HY Hle; smt().
   move: A1; rewrite EK (_: W64.modulus = 18446744073709551616) // => A1.
   rewrite (_: k0 + 1 + nlimbs = (k0 + nlimbs) + 1) 1:/# BN2.bnk_put 1:/#.
   rewrite (BN2.bnkS (k0 + nlimbs) _a) 1:/# /=.
   have ->: to_uint (addc h _a.[k0 + nlimbs] ci).`2
            + 18446744073709551616 * b2i (addc h _a.[k0 + nlimbs] ci).`1
            = to_uint h + to_uint _a.[k0 + nlimbs] + to_uint c0 by rewrite A1 Eci; ring.
   have ->: BN2.bnk (k0 + nlimbs) w1
            = BN2.bnk (k0 + nlimbs) w0 + 18446744073709551616 ^ k0 * (to_uint m * bnk nlimbs __P)
              - (to_uint hi0 + b2i cf0 + b2i of0) * 18446744073709551616 ^ (k0 + nlimbs)
    by rewrite -Hinv; ring.
   have ->: BN2.bnk (k0 + nlimbs) w0
            = BN2.bnk (k0 + nlimbs) _a + M0 * bnk nlimbs __P
              - to_uint c0 * 18446744073709551616 ^ (k0 + nlimbs)
    by rewrite -Hinv0; ring.
   by rewrite Eh; ring.
  split.
   (* row 0: the carry in is zero *)
   move=> Hk00.
   have Ec0: to_uint c0 = 0 by rewrite Hc00 // W64.to_uint0.
   have [G1 [M1 [GM G2]]] := GEN false nlimbs _ _; [by rewrite Hk00 | by rewrite Ec0 |].
   move: G1 GM G2; rewrite Hk00 /= => G1 GM G2.
   rewrite EM; split; first smt().
   split; first by case: (addc h _a.[nlimbs] false).`1.
   split; first by move=> j Hj1 Hj2; apply G1.
   by exists M1.
  (* later rows: the carry in is c0 *)
  move=> Hk00.
  have EC: b2i (NEG_64 c0).`2 = to_uint c0.
   rewrite /NEG_64 /=; case: (c0 = W64.zero) => [-> | Hc]; first by rewrite W64.to_uint0.
   have H0: to_uint c0 <> 0 by move: Hc; rewrite W64.to_uint_eq W64.to_uint0.
   by rewrite /= b2i1; move: Hc0 H0 (W64.to_uint_cmp c0); smt().
  have [G1 [M1 [GM G2]]] := GEN (NEG_64 c0).`2 (k0 + nlimbs) _ EC => //.
  rewrite EM; split; first smt().
  split; first by case: ((addc h _a.[k0 + nlimbs] (NEG_64 c0).`2).`1).
  split; first smt().
  split; first by move=> j Hj1 Hj2; apply G1.
  by exists M1.
 wp; skip => /> &hr _ _ Hcp.
 have Hn := gt0_nlimbs.
 split.
  split; first smt().
  split; first smt().
  by exists 0 => /=; apply bnk2_eq.
 move=> c0 k0 w0 Hk0 Hk1 Hk2 Hc0 _ Hz M0 HM0 HM1 Hinv.
 have Ek: k0 = nlimbs by smt().
 move: Hz HM1 Hinv; rewrite Ek (_: nlimbs + nlimbs = 2 * nlimbs) 1:/# => Hz HM1 Hinv.
 by split; [smt() | exists M0].
(* the conditional subtraction, as BNB._cminusP_: s, a copy of the high half
   of w, then s + mP with its carry, then the selection *)
seq 2 : (#pre /\ s = BN.A.init (fun j => w.[nlimbs + j])).
 wp; while (#pre /\ 0 <= i <= nlimbs /\ (forall j, 0 <= j < i => s.[j] = w.[nlimbs + j])).
  wp; skip => /> &hr *; split; first smt().
  by move=> j Hj1 Hj2; rewrite BN.A.get_setE 1:/#; case: (j = i{hr}) => // Hne; smt().
 wp; skip => /> &hr *; split; first smt(gt0_nlimbs).
 move=> i0 s1 Hi0 Hi1 Hi2 Hcp.
 by apply BN.A.ext_eq => j Hj; rewrite BN.A.initiE // Hcp /#.
(* s + mP, with its carry (s0 the copy of the high half of w) *)
exists* s; elim* => s0 M0.
seq 5 : (BN.A.init (fun i => _P_mP.[i]) = __P
         /\ BN.A.init (fun i => _P_mP.[nlimbs + i]) = __mP /\ a = _a
         /\ to_uint c <= 1 /\ (forall j, 0 <= j < nlimbs => w.[j] = W64.zero)
         /\ 0 <= M0 < 18446744073709551616 ^ nlimbs
         /\ BN2.bnk (2*nlimbs) w + to_uint c * 18446744073709551616 ^ (2*nlimbs)
            = BN2.bnk (2*nlimbs) _a + M0 * BN.bnk nlimbs __P
         /\ s0 = BN.A.init (fun j => w.[nlimbs + j])
         /\ BN.bnk nlimbs s + b2i cf * 18446744073709551616 ^ nlimbs
            = BN.bnk nlimbs s0 + BN.bnk nlimbs __mP).
 while (BN.A.init (fun i => _P_mP.[i]) = __P
        /\ BN.A.init (fun i => _P_mP.[nlimbs + i]) = __mP /\ a = _a
        /\ to_uint c <= 1 /\ (forall j, 0 <= j < nlimbs => w.[j] = W64.zero)
        /\ 0 <= M0 < 18446744073709551616 ^ nlimbs
        /\ BN2.bnk (2*nlimbs) w + to_uint c * 18446744073709551616 ^ (2*nlimbs)
           = BN2.bnk (2*nlimbs) _a + M0 * BN.bnk nlimbs __P
        /\ s0 = BN.A.init (fun j => w.[nlimbs + j])
        /\ 1 <= i <= nlimbs /\ (forall j, i <= j < nlimbs => s.[j] = s0.[j])
        /\ BN.bnk i s + b2i cf * 18446744073709551616 ^ i
           = BN.bnk i s0 + BN.bnk i __mP).
  wp; skip => /> &hr HP HmP Hc Hz HM0 HM1 Hinv Hi1 _ Hfr Hadd Hi2.
  split; first smt().
  split.
   by move=> j Hj1 Hj2; rewrite BN.A.get_setE 1:/# (_: (j = i{hr}) = false) 1:/# /= Hfr /#.
  rewrite BN.bnk_put 1:/# Hfr 1:/# !bnkS 1,2:/# /= !BN.A.initiE 1,2:/# /=.
  have A := JBigNumber.addc_to_uint w{hr}.[nlimbs + i{hr}] _P_mP{hr}.[nlimbs + i{hr}] cf{hr}.
  move: A; rewrite (_: W64.modulus = 18446744073709551616) // => A.
  rewrite A.
  have ->: BN.bnk i{hr} s{hr}
           = BN.bnk i{hr} (init (fun (j : int) => w{hr}.[nlimbs + j]))
             + BN.bnk i{hr} (init (fun (i0 : int) => _P_mP{hr}.[nlimbs + i0]))
             - b2i cf{hr} * 18446744073709551616 ^ i{hr} by rewrite -Hadd; ring.
  by ring.
 wp; skip => /> &hr HP HmP Hc Hz HM0 HM1 Hinv.
 have Hn := gt0_nlimbs.
 split.
  split; first smt().
  split.
   by move=> j Hj1 Hj2; rewrite BN.A.get_setE 1:/# (_: (j = 0) = false) 1:/#.
  rewrite !bnk1 /= BN.A.get_setE 1:/# /= !BN.A.initiE 1,2:/# /=.
  have A := JBigNumber.addc_to_uint w{hr}.[nlimbs] _P_mP{hr}.[nlimbs] false.
  by move: A; rewrite (_: W64.modulus = 18446744073709551616) //= => ->; ring.
 move=> cf0 i0 s1 Hi0 Hi1 Hi2 _ Hadd.
 by move: Hadd; rewrite (_: i0 = nlimbs) 1:/#.
(* the selection: s when [hw ; c] + mP carries out, the high half of w otherwise *)
while (0 <= i <= nlimbs
       /\ (forall j, 0 <= j < i => r.[j] = (if cf then s.[j] else w.[nlimbs + j]))).
 wp; skip => /> &hr Hi1 _ Hsel Hi2; split; first smt().
 move=> j Hj1 Hj2; rewrite BN.A.get_setE 1:/#.
 by case: (j = i{hr}) => [-> /=|Hne]; [case: (cf{hr}) | rewrite Hsel /#].
wp; skip => /> &hr HP HmP Hc Hz HM0 HM1 Hinv Hadd.
have Hn := gt0_nlimbs.
split; first smt().
move=> i0 r0 Hi0 Hi1 Hi2 Hsel.
move: Hsel; rewrite (_: i0 = nlimbs) 1:/# => Hsel.
rewrite HP; move: Hinv Hadd; rewrite HP HmP => Hinv Hadd.
(* the window: [hw ; c] * R = a + M0 * P, hw the high half of w (the low
   half is zero) *)
pose hw := BN.A.init (fun j => w{hr}.[nlimbs + j]).
have ER: BN.bn_modulus = 18446744073709551616 ^ nlimbs by rewrite BN.bn_modulusE.
have Ew: BN2.bnk (2*nlimbs) w{hr} = BN.bnk nlimbs hw * BN.bn_modulus.
 have := bn2_pack w{hr} (BN.A.init (fun j => w{hr}.[j])) hw _ _.
  by move=> j Hj; rewrite BN.A.initiE.
  by move=> j Hj; rewrite /hw BN.A.initiE.
 move=> ->.
 have ->: BN.bnk nlimbs (BN.A.init (fun j => w{hr}.[j])) = 0.
  rewrite (bnk_low _ w{hr} nlimbs) 1:/#; first by move=> j Hj; rewrite BN.A.initiE /#.
  by apply bnk2_zero; [smt() | move=> j Hj; rewrite Hz /#].
 by ring.
have HPr: 0 <= BN.bnk nlimbs __P <= BN.bn_modulus.
 by move: (BN.bnk_cmp nlimbs __P) (BN.bnk_cmp nlimbs __mP) P_mP; rewrite ER; smt().
have HA: 0 <= BN2.bnk (2*nlimbs) _a < BN.bnk nlimbs __P * BN.bn_modulus.
 by move: (BN2.bnk_cmp (2*nlimbs) _a) a_bnd; smt().
have HM: 0 <= M0 < BN.bn_modulus by rewrite ER; smt().
have Hr: 0 <= BN.bnk nlimbs hw < BN.bn_modulus by move: (BN.bnk_cmp nlimbs hw); rewrite ER.
have HT: (BN.bnk nlimbs hw + to_uint c{hr} * BN.bn_modulus) * BN.bn_modulus
         = BN2.bnk (2*nlimbs) _a + M0 * BN.bnk nlimbs __P.
 rewrite -Hinv Ew ER (_: 2 * nlimbs = nlimbs + nlimbs) 1:/# exprD_nneg 1,2:/#; ring.
(* the final subtraction, as Bn_mul does it *)
have [Hlb1 HMR] := JBigNumber.montred_math (BN2.bnk (2*nlimbs) _a) M0 (BN.bnk nlimbs __P)
                     BN.bn_modulus (BN.bnk nlimbs hw + to_uint c{hr} * BN.bn_modulus) rInv
                     (to_uint c{hr}) (BN.bnk nlimbs hw) HPr rInv_r HA HM HT _ Hr _.
done.
smt(W64.to_uint_cmp).
rewrite -HMR.
(* the carry out of hw + mP, added to c, decides the selection *)
have EmP: BN.bn_modulus - BN.bnk nlimbs __P = BN.bnk nlimbs __mP by smt().
rewrite EmP; move: Hadd; rewrite -/hw => Hadd.
have [_ Ec] := JBigNumber.addc_nc c{hr} W64.zero cf{hr} _.
 by rewrite W64.to_uint0; move: Hc; case: (cf{hr}) => /= /#.
have Ecf: (NEG_64 (addc c{hr} W64.zero cf{hr}).`2).`2
          = (to_uint c{hr} + b2i cf{hr} <> 0).
 by rewrite /NEG_64 /= W64.to_uint_eq Ec !W64.to_uint0.
have [Hs0 Hs1] := BN.bnk_cmp nlimbs s{hr}.
have [Hc0 _] := W64.to_uint_cmp c{hr}.
case: (to_uint c{hr} + b2i cf{hr} <> 0) => Hcf.
 have ->: r0 = s{hr} by apply BN.A.ext_eq => j Hj; rewrite Hsel // Ecf Hcf.
 rewrite (_: (BN.bn_modulus <= to_uint c{hr} * BN.bn_modulus + BN.bnk nlimbs hw + BN.bnk nlimbs __mP) = true).
  by move: Hadd Hcf Hs0; rewrite ER; case: (cf{hr}) => /= /#.
 by rewrite /= -Hadd ER modzMDr modz_small //; smt().
have ->: r0 = hw by apply BN.A.ext_eq => j Hj; rewrite Hsel // Ecf Hcf /= /hw BN.A.initiE.
rewrite (_: (BN.bn_modulus <= to_uint c{hr} * BN.bn_modulus + BN.bnk nlimbs hw + BN.bnk nlimbs __mP) = false) //.
by move: Hadd Hcf Hs1; rewrite ER; case: (cf{hr}) => /= /#.
qed.

(* [_P_mP] packs P and mP = R - P, as for Bn_mul.__mont_redM_h *)
lemma __mont_redM_h rInv __P __mP __U0 _a:
 (rInv * BN.bn_modulus) %% BN.bn __P = 1 =>
 bn __P + BN.bn __mP = BN.bn_modulus =>
 __U0 * __P.[0] = W64.of_int (-1) =>
 bn _a < bn __P * BN.bn_modulus =>
 hoare [ M.__mont_redM
       : BN2.bn _P_mP = BN.bn __P + BN.bn __mP * BN.bn_modulus /\ _U0=__U0 /\ a=_a
         ==> bn res = (bn _a * rInv) %% bn __P
       ].
proof.
move => rInv_r P_mP U0_P0 a_bnd.
conseq (__mont_redM_halves_h rInv __P __mP __U0 _a rInv_r P_mP U0_P0 a_bnd)
 => // &hr [H [-> ->]].
by have [-> ->] := bn2_unpack _ _ _ H.
qed.


(******************************************************************************
 **                     CORRECTNESS [phoare]                                 **
 ******************************************************************************)

phoare _os_muln__ph _a _b:
 [ M._os_muln_
 : a=_a /\ b=_b ==> bn res = bn _a * bn _b
 ] = 1%r.
proof. by conseq _os_muln__ll (_os_muln__h _a _b). qed.

phoare _os_sqrn__ph _a:
 [ M._os_sqrn_
 : a=_a ==> bn res = bn _a * bn _a
 ] = 1%r.
proof. by conseq _os_sqrn__ll (_os_sqrn__h _a). qed.

lemma __mont_redM_ph rInv __P __mP __U0 _a:
 (rInv * BN.bn_modulus) %% BN.bn __P = 1 =>
 bn __P + BN.bn __mP = BN.bn_modulus =>
 __U0 * __P.[0] = W64.of_int (-1) =>
 bn _a < bn __P * BN.bn_modulus =>
 phoare [ M.__mont_redM
        : BN2.bn _P_mP = BN.bn __P + BN.bn __mP * BN.bn_modulus /\ _U0=__U0 /\ a=_a
          ==> bn res = (bn _a * rInv) %% bn __P
        ] = 1%r.
proof.
move => rInv_r P_mP U0_P0 a_bnd.
by conseq __mont_redM_ll (__mont_redM_h rInv __P __mP __U0 _a rInv_r P_mP U0_P0 a_bnd).
qed.
