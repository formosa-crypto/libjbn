require import AllCore Int IntDiv List.

from Jasmin require import JModel_x86.
import SLH64.

require JBigNumber.

(* Correctness contracts for bn_mul_loop@n.jinc: operand-scanning multiplication and squaring, and Montgomery
   reduction, with a run-time loop over the rows (MUL/ADC rows).

   NOT PROVED: the contracts below are admitted, so that Bn_mulsel (the
   selector, which uses them) and the fields over it can be proved for
   every profile. The module is tested (README, "Current status"). The
   statements are those of Bn_mul, so that the four modules have one
   contract. *)

(* Parameters *)
op nlimbs: int.
axiom gt0_nlimbs: 0 < nlimbs.

clone export JBigNumber.BigN
 with op nlimbs <- nlimbs
      proof gt0_nlimbs by exact gt0_nlimbs.

import BN2.
import BN.

require Bn_util.
clone Bn_util as BNUTIL.
module BNUTIL_M = BNUTIL.M.

require Bn_base.
clone Bn_base as BNB
 with op nlimbs <- nlimbs,
      theory BigN <- BigN,
      theory BNUTIL <- BNUTIL
      proof gt0_nlimbs by exact gt0_nlimbs.
module BNB_M = BNB.M.

(* module M: the extracted code of bn_mul_loop@n.jinc (see proof/Makefile) *)
(* BEGIN generated by scripts/xtr_sync.py from src/amd64/ref/extracted/BNMULL_bn_mul_loop.ec
   (bn_mul_loop@n.jinc); do not edit: run `make -C proof update` *)
module M = {
  proc __mul1 (r:BN2.t, a:W64.t, b:BN.t) : 
  BN2.t = {
    var lo:W64.t;
    var hi:W64.t;
    var c:W64.t;
    var i:int;
    var cf:bool;
    var  _0:bool;
    lo <- b.[0];
    (hi, lo) <- (mulu_64 lo a);
    r.[0] <- lo;
    c <- hi;
    i <- 1;
    while ((i < nlimbs)) {
      lo <- b.[i];
      (hi, lo) <- (mulu_64 lo a);
      (cf, lo) <- (adc_64 lo c false);
      ( _0, hi) <- (adc_64 hi (W64.of_int 0) cf);
      r.[i] <- lo;
      c <- hi;
      i <- (i + 1);
    }
    r.[nlimbs] <- c;
    return r;
  }
  proc __mul1acc (k:W64.t, r:BN2.t, a:W64.t,
                                b:BN.t) : BN2.t = {
    var aux_0:W64.t;
    var aux:bool;
    var lo:W64.t;
    var hi:W64.t;
    var cf:bool;
    var c:W64.t;
    var i:int;
    var  _0:bool;
    var  _1:bool;
    var  _2:bool;
    lo <- b.[0];
    (hi, lo) <- (mulu_64 lo a);
    (aux, aux_0) <- (adc_64 r.[(W64.to_uint k)] lo false);
    cf <- aux;
    r.[(W64.to_uint k)] <- aux_0;
    ( _0, hi) <- (adc_64 hi (W64.of_int 0) cf);
    c <- hi;
    i <- 1;
    while ((i < nlimbs)) {
      lo <- b.[i];
      (hi, lo) <- (mulu_64 lo a);
      (cf, lo) <- (adc_64 lo r.[(W64.to_uint (k + (W64.of_int i)))] false);
      ( _1, hi) <- (adc_64 hi (W64.of_int 0) cf);
      (cf, lo) <- (adc_64 lo c false);
      ( _2, hi) <- (adc_64 hi (W64.of_int 0) cf);
      r.[(W64.to_uint (k + (W64.of_int i)))] <- lo;
      c <- hi;
      i <- (i + 1);
    }
    r.[(W64.to_uint (k + (W64.of_int nlimbs)))] <- c;
    return r;
  }
  proc _os_muln (r:BN2.t, a:BN.t,
                               b:BN.t) : BN2.t = {
    var ai:W64.t;
    var k:W64.t;
    ai <- a.[0];
    r <@ __mul1 (r, ai, b);
    k <- (W64.of_int 1);
    while ((k \ult (W64.of_int nlimbs))) {
      ai <- a.[(W64.to_uint k)];
      r <@ __mul1acc (k, r, ai, b);
      k <- (k + (W64.of_int 1));
    }
    return r;
  }
  proc _os_muln_ (r:BN2.t, a:BN.t,
                                b:BN.t) : BN2.t = {
    
    r <- r;
    a <- a;
    b <- b;
    r <@ _os_muln (r, a, b);
    r <- r;
    return r;
  }
  proc _os_sqrn (r:BN2.t, a:BN.t) : 
  BN2.t = {
    var ai:W64.t;
    var k:W64.t;
    ai <- a.[0];
    r <@ __mul1 (r, ai, a);
    k <- (W64.of_int 1);
    while ((k \ult (W64.of_int nlimbs))) {
      ai <- a.[(W64.to_uint k)];
      r <@ __mul1acc (k, r, ai, a);
      k <- (k + (W64.of_int 1));
    }
    return r;
  }
  proc _os_sqrn_ (r:BN2.t, a:BN.t) : 
  BN2.t = {
    
    r <- r;
    a <- a;
    r <@ _os_sqrn (r, a);
    r <- r;
    return r;
  }
  proc __mont_redM (r:BN.t, a:BN2.t,
                                  _P_mP:BN2.t, _U0:W64.t) : 
  BN.t = {
    var i:int;
    var lo:W64.t;
    var c:W64.t;
    var k:W64.t;
    var m:W64.t;
    var hi:W64.t;
    var cf:bool;
    var w:W64.t;
    var mP:BN.t;
    var  _0:bool;
    var  _1:bool;
    var  _2:bool;
    var  _3:bool;
    var  _4:bool;
    var  _5:bool;
    var  _6:bool;
    var  _7:bool;
    mP <- witness;
    i <- 0;
    while ((i < nlimbs)) {
      lo <- a.[i];
      r.[i] <- lo;
      i <- (i + 1);
    }
    c <- (W64.of_int 0);
    k <- (W64.of_int 0);
    while ((k \ult (W64.of_int nlimbs))) {
      m <- r.[0];
      m <- (m * _U0);
      lo <- _P_mP.[0];
      (hi, lo) <- (mulu_64 lo m);
      (cf, lo) <- (adc_64 lo r.[0] false);
      ( _0, hi) <- (adc_64 hi (W64.of_int 0) cf);
      w <- hi;
      i <- 1;
      while ((i < nlimbs)) {
        lo <- _P_mP.[i];
        (hi, lo) <- (mulu_64 lo m);
        (cf, lo) <- (adc_64 lo r.[i] false);
        ( _1, hi) <- (adc_64 hi (W64.of_int 0) cf);
        (cf, lo) <- (adc_64 lo w false);
        ( _2, hi) <- (adc_64 hi (W64.of_int 0) cf);
        r.[(i - 1)] <- lo;
        w <- hi;
        i <- (i + 1);
      }
      ( _3, cf,  _4,  _5,  _6, c) <- (NEG_64 c);
      (cf, w) <- (adc_64 w a.[(W64.to_uint (k + (W64.of_int nlimbs)))] cf);
      r.[(nlimbs - 1)] <- w;
      c <- (MOV_64 (W64.of_int 0));
      ( _7, c) <- (adc_64 c (W64.of_int 0) cf);
      k <- (k + (W64.of_int 1));
    }
    mP <- (BN.A.init (fun i_0 => _P_mP.[(nlimbs + i_0)]));
    r <@ BNB_M._cminusP_ (r, mP, c);
    return r;
  }
}.
(* END generated *)


(******************************************************************************
 **                     LOSSLESSNESS (admitted)                              **
 ******************************************************************************)

lemma _os_muln__ll: islossless M._os_muln_.
proof. admit. qed.

lemma _os_sqrn__ll: islossless M._os_sqrn_.
proof. admit. qed.

lemma __mont_redM_ll: islossless M.__mont_redM.
proof. admit. qed.


(******************************************************************************
 **                     CORRECTNESS (admitted)                               **
 ******************************************************************************)

hoare _os_muln__h _a _b:
 M._os_muln_ : a=_a /\ b=_b ==> bn res = bn _a * bn _b.
proof. admit. qed.

hoare _os_sqrn__h _a:
 M._os_sqrn_ : a=_a ==> bn res = bn _a * bn _a.
proof. admit. qed.

(* [_P_mP] packs P and mP = R - P, as for Bn_mul.__mont_redM_h *)
lemma __mont_redM_h rInv __P __mP __U0 _a:
 (rInv * BN.bn_modulus) %% BN.bn __P = 1 =>
 bn __P + BN.bn __mP = BN.bn_modulus =>
 __U0 * __P.[0] = W64.of_int (-1) =>
 bn _a < bn __P * BN.bn_modulus =>
 hoare [ M.__mont_redM
       : BN2.bn _P_mP = BN.bn __P + BN.bn __mP * BN.bn_modulus /\ _U0=__U0 /\ a=_a
         ==> bn res = (bn _a * rInv) %% bn __P
       ].
proof. admit. qed.


(******************************************************************************
 **                     CORRECTNESS [phoare]                                 **
 ******************************************************************************)

phoare _os_muln__ph _a _b:
 [ M._os_muln_
 : a=_a /\ b=_b ==> bn res = bn _a * bn _b
 ] = 1%r.
proof. by conseq _os_muln__ll (_os_muln__h _a _b). qed.

phoare _os_sqrn__ph _a:
 [ M._os_sqrn_
 : a=_a ==> bn res = bn _a * bn _a
 ] = 1%r.
proof. by conseq _os_sqrn__ll (_os_sqrn__h _a). qed.

lemma __mont_redM_ph rInv __P __mP __U0 _a:
 (rInv * BN.bn_modulus) %% BN.bn __P = 1 =>
 bn __P + BN.bn __mP = BN.bn_modulus =>
 __U0 * __P.[0] = W64.of_int (-1) =>
 bn _a < bn __P * BN.bn_modulus =>
 phoare [ M.__mont_redM
        : BN2.bn _P_mP = BN.bn __P + BN.bn __mP * BN.bn_modulus /\ _U0=__U0 /\ a=_a
          ==> bn res = (bn _a * rInv) %% bn __P
        ] = 1%r.
proof.
move => rInv_r P_mP U0_P0 a_bnd.
by conseq __mont_redM_ll (__mont_redM_h rInv __P __mP __U0 _a rInv_r P_mP U0_P0 a_bnd).
qed.
