}.
(* END generated *)


lemma ult_nlimbs (k: W64.t): (k \ult W64.of_int nlimbs) = (to_uint k < nlimbs).
proof. by rewrite W64.ultE W64.to_uint_small //; smt(gt0_nlimbs nlimbs_bndN). qed.

(* the row counter: k + 1, for k < nlimbs (W64.of_int 1 is simplified
   to W64.one in the goals) *)
lemma to_uint_k1 (k: W64.t):
 to_uint k < nlimbs => to_uint (k + W64.one) = to_uint k + 1.
proof.
move=> H; rewrite W64.to_uintD_small W64.to_uint1 //.
by move: H nlimbs_bndN; smt().
qed.


