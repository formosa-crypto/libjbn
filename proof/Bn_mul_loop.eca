    return r;
  }
  proc _os_sqrn_ (r:BN2.t, a:BN.t) : 
  BN2.t = {
    
    r <- r;
    a <- a;
    r <@ _os_sqrn (r, a);
    r <- r;
    return r;
  }
  proc __mont_redM (r:BN.t, a:BN2.t,
                                  _P_mP:BN2.t, _U0:W64.t) : 
  BN.t = {
