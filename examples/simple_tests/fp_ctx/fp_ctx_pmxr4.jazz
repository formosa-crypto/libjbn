/* libjbn instance with run-time pseudo-Mersenne moduli of 4 limbs (fp_pm,
   as fp_ctx_pm4.jazz), over bn_mulxr: MULX/ADCX/ADOX rows with their
   accumulator in registers, which need a CPU with BMI2 and ADX. */

namespace UTIL { from Libjbn require "bn_util.jinc" }

namespace H {
  param int nlimbs = 4;

  namespace BN  { from Libjbn require "bn_base@n.jinc" }
  namespace RND { from Libjbn require "bn_rnd@n.jinc" }
  namespace MUL { from Libjbn require "bn_mulxr@n.jinc" }

  namespace FPM {
    from Libjbn require "fp_mul_os@fp.jinc"
    from Libjbn require "fp_pm@fp.jinc"
  }
}

/* C entry points */
from Libjbn require "fp_mont_ctx_export@2n.jinc"
