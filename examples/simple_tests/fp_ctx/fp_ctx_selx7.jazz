/* libjbn instance with run-time moduli of 7 limbs, whose multiplication,
   squaring and Montgomery reduction are selected by bn_mulsel from the
   profile x86_64_adx: here bn_mulx (7 <= 16). The field
   code FPM is shared by every modulus, whose context (fp_ctx@n.jinc) is
   computed by fpc_ctx_init and passed to the other fpc_* entry points. */

from Libjbn require "profiles/x86_64_adx.jinc"

namespace UTIL { from Libjbn require "bn_util.jinc" }

namespace H {
  param int nlimbs = 7;

  namespace BN  { from Libjbn require "bn_base@n.jinc" }
  namespace RND { from Libjbn require "bn_rnd@n.jinc" }
  namespace MUL { from Libjbn require "bn_mulsel@n.jinc" }

  namespace FPM {
    from Libjbn require "fp_mul_sel@fp.jinc"
    from Libjbn require "fp_mont@fp.jinc"
  }
}

/* C entry points */
from Libjbn require "fp_mont_ctx_export@2n.jinc"
