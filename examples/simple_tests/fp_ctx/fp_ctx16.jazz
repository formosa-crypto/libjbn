/* libjbn instance with run-time moduli of 16 limbs: the field code FPM is
   shared by every modulus, whose context (fp_ctx@n.jinc) is computed by
   fpc_ctx_init and passed to the other fpc_* entry points. */

/* the profile: here for JBN_EXP_WINDOW, the constant-time exponentiation
   of the field (the multiplication module is wired directly, below) */
from Libjbn require "profiles/x86_64.jinc"

namespace UTIL { from Libjbn require "bn_util.jinc" }

namespace H {
  param int nlimbs = 16;

  namespace BN  { from Libjbn require "bn_base@n.jinc" }
  namespace RND { from Libjbn require "bn_rnd@n.jinc" }
  namespace MUL { from Libjbn require "bn_mul@n.jinc" }

  namespace FPM {
    from Libjbn require "fp_mul_ps@fp.jinc"
    from Libjbn require "fp_mont@fp.jinc"
  }
}

/* C entry points */
from Libjbn require "fp_mont_ctx_export@2n.jinc"
