/* libjbn instance with run-time moduli of 16 limbs, whose multiplication,
   squaring and Montgomery reduction are unrolled MULX/ADCX/ADOX rows, which
   need a CPU with BMI2 and ADX (bn_mulx, in the place of bn_mul: compare
   with fp_ctx16.jazz, and with fp_ctx_mulx_loop16.jazz for the same rows
   under a run-time loop): the field code FPM is shared by every modulus,
   whose context (fp_ctx@n.jinc) is computed by fpc_ctx_init and passed to
   the other fpc_* entry points. */

/* the profile: here for JBN_EXP_WINDOW, the constant-time exponentiation
   of the field (the multiplication module is wired directly, below) */
from Libjbn require "profiles/x86_64_adx.jinc"

namespace UTIL { from Libjbn require "bn_util.jinc" }

namespace H {
  param int nlimbs = 16;

  namespace BN  { from Libjbn require "bn_base@n.jinc" }
  namespace RND { from Libjbn require "bn_rnd@n.jinc" }
  namespace MUL { from Libjbn require "bn_mulx@n.jinc" }

  namespace FPM {
    from Libjbn require "fp_mul_os@fp.jinc"
    from Libjbn require "fp_mont@fp.jinc"
  }
}

/* C entry points */
from Libjbn require "fp_mont_ctx_export@2n.jinc"
