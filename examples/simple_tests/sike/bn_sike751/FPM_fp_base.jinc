/* (emulation of https://github.com/jasmin-lang/jasmin/issues/519)

FP_BASE_FNS = _chk_bnds_ _rnd_ _addm_ _addmU_ _subm_ _submU_ _mulm_ _mulmU_ _sqrm_ _sqrmU_ _invmU_
*/

/*

modsignature {
  int nlimbs;		// num. limbs
  u64[limbs] glob_exp0;
  u64[nlimbs] glob_Pm2;
  fn fun_muln ( reg mut ptr u64[2*nlimbs]
              , reg const ptr u64[nlimbs]
              , reg const ptr u64[nlimbs]
              ) -> reg ptr u64[2*nlimbs]
  fn fun_sqrn ( reg mut ptr u64[2*nlimbs]
              , reg const ptr u64[nlimbs]
              ) -> reg ptr u64[2*nlimbs]
  fn fun_red ( reg mut ptr u64[nlimbs]
             , reg const ptr u64[2*nlimbs]
             ) -> reg ptr u64[nlimbs]
}

//require "bn_base" as "BN"
//  with { nlimbs = nlimbs; }

//require "bn_rnd" as "BN"
//  with { nlimbs = nlimbs; }

*/

from MJazz require "BN_bn_base.jinc" // BN qualified

from MJazz require "BN_bn_rnd.jinc" // BNRND qualified

inline fn FPM_chk_bnds_
( stack u64 err
, reg const ptr u64[sike751_nlimbs] a
) -> stack u64 {
 reg ptr u64[sike751_nlimbs] P;
 reg bool cf;
 reg u64 t;
 P = sike751_glob_P;
 cf = BN_lt_cf_(a, P);
 t = BN__ncf_mask(cf);
 err |= t;
 return err;
}

inline fn FPM_rnd_
( reg mut ptr u64[sike751_nlimbs] a
) -> reg ptr u64[sike751_nlimbs] {
 reg ptr u64[sike751_nlimbs] P;
 P = sike751_glob_P;
 a = BN_rsample_(a, P);
 return a;
}

inline fn FPM_addm_
 ( reg mut ptr u64[sike751_nlimbs] r
 , reg const ptr u64[sike751_nlimbs] a b
 ) -> reg ptr u64[sike751_nlimbs]
{
  reg bool cf;
  reg u64 lastbit;
  reg ptr u64[sike751_nlimbs] tmp;

  cf, r = BN_add_(r, a, b);

  lastbit = 0;
  _, lastbit += 0 + cf;
  tmp = sike751_glob_mP;
  r = BN_cminusP_(r, tmp, lastbit);
  return r;
}

inline fn FPM_addmU_
 ( reg mut ptr u64[sike751_nlimbs] a
 , reg const ptr u64[sike751_nlimbs] b
 ) -> reg ptr u64[sike751_nlimbs]
{
  reg bool cf;
  reg u64 lastbit;
  reg ptr u64[sike751_nlimbs] tmp;

  cf, a = BN_addU_(a, b);

  lastbit = 0;
  _, lastbit += 0 + cf;
  tmp = sike751_glob_mP;
  a = BN_cminusP_(a, tmp, lastbit);
  return a;
}

// ////////////////////////////////////

inline fn FPM_subm_
( reg mut ptr u64[sike751_nlimbs] r
, reg const ptr u64[sike751_nlimbs] a b
) -> reg ptr u64[sike751_nlimbs] {
 reg bool cf;
 reg ptr u64[sike751_nlimbs] tmp;
 cf, r = BN_sub_(r, a, b);
 tmp = sike751_glob_P;
 r = BN_caddU_(r, cf, tmp);
 return r;
}

inline fn FPM_submU_
( reg mut ptr u64[sike751_nlimbs] a
, reg const ptr u64[sike751_nlimbs] b
) -> reg ptr u64[sike751_nlimbs] {
 reg bool cf;
 reg ptr u64[sike751_nlimbs] tmp;
 cf, a = BN_subU_(a, b);
 tmp = sike751_glob_P;
 a = BN_caddU_(a, cf, tmp);
 return a;
}

/* Modular multiplication */
inline fn FPM_mulm_
( reg mut ptr u64[sike751_nlimbs] r
, reg ptr u64[sike751_nlimbs] a b
) -> reg ptr u64[sike751_nlimbs] {
  stack u64[2*sike751_nlimbs] _tmp;
  reg ptr u64[2*sike751_nlimbs] tmp;

  tmp = _tmp;
  tmp = BN_ps_muln_(tmp, a, b);
  r = FPM_redM_(r, tmp);
  return r;
}

// ////////////////////////////////////

inline fn FPM_mulmU_ // update inplace
( reg mut ptr u64[sike751_nlimbs] a
, reg ptr u64[sike751_nlimbs] b
) -> reg ptr u64[sike751_nlimbs] {
  stack u64[2*sike751_nlimbs] _tmp;
  reg ptr u64[2*sike751_nlimbs] tmp;
  tmp = _tmp;
  tmp = BN_ps_muln_(tmp, a, b);
  a = FPM_redM_(a, tmp);
  return a;
}

// ////////////////////////////////////

inline fn FPM_sqrm_
( reg mut ptr u64[sike751_nlimbs] r
, reg const ptr u64[sike751_nlimbs] a
) -> reg ptr u64[sike751_nlimbs] {
  stack u64[2*sike751_nlimbs] _tmp;
  reg ptr u64[2*sike751_nlimbs] tmp;
  tmp = _tmp;
  tmp = BN_ps_sqrn_(tmp, a);
  r = FPM_redM_(r, tmp);
  return r;
}

// ////////////////////////////////////

inline fn FPM_sqrmU_ // update inplace
( reg mut ptr u64[sike751_nlimbs] a
) -> reg ptr u64[sike751_nlimbs] {
  stack u64[2*sike751_nlimbs] _tmp;
  reg ptr u64[2*sike751_nlimbs] tmp;
  tmp = _tmp;
  tmp = BN_ps_sqrn_(tmp, a);
  a = FPM_redM_(a, tmp);
  return a;
}

// ////////////////////////////////////

// ???obs: import without qualifier -- declarations
// are added to the "current" scope
// ???obs2: alternative: reuse qualifier

// require "bn_exp.jinc" // as FPM
//  with { nlimbs = nlimbs;
//         nlimbsexp = nlimbs;
//         glob_exp0 = glob_exp0;
//         fun_mulU = FPM_mulmU;
//         fun_sqrU = FPM_sqrmU;
//       }

from MJazz require "FPM_bn_exp.jinc" 


/* Modular Inversion (fermat) */
inline fn FPM_invmU_
( reg mut ptr u64[sike751_nlimbs] a
) -> reg ptr u64[sike751_nlimbs] {
  /* a^{p-2} */
  reg ptr u64[sike751_nlimbs] Pm2;
  Pm2 = sike751_glob_Pm2;
  a = FPM_expmU_noct_(a, Pm2);
  return a;
}

inline fn FPM_invm_
( reg mut ptr u64[sike751_nlimbs] r
, reg const ptr u64[sike751_nlimbs] a
) -> reg ptr u64[sike751_nlimbs] {
  /* a^{p-2} */
  reg ptr u64[sike751_nlimbs] Pm2;
  Pm2 = sike751_glob_Pm2;
  r = FPM_expm_noct_(r, a, Pm2);
  return r;
}

