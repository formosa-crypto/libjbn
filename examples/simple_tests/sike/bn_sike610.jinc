/* libjbn instance for the SIKE-P610 prime field (Montgomery form, 10 limbs).

   Layout (see README): the top level is the scope of the exports; the
   working size (nlimbs = 10) is the size scope H. Each module is
   instantiated exactly once.
*/

namespace UTIL { from Libjbn require "bn_util.jinc" }

namespace H {
  param int nlimbs = 10;

  namespace BN  { from Libjbn require "bn_base.jinc" }
  namespace RND { from Libjbn require "bn_rnd.jinc" }
  namespace MUL { from Libjbn require "bn_mul.jinc" }

  namespace FPM {
    param int nlimbsexp = nlimbs;
    from Libjbn require "params/sike/sike610.jinc"
    from Libjbn require "fp_mul_ps.jinc"
    from Libjbn require "fp_mont.jinc"
  }
}

/* C entry points */
from Libjbn require "bn_base_export.jinc" "fp_mont_export.jinc"
