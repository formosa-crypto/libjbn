  a = BN_load_(a,ap);
  b = BN_load_(b,bp);
  a = FPM_submU_(a, b);
  BN_store_(rp, a);
}

export fn fp_mul(reg u64 rp ap bp)
{
  stack u64[sike434_nlimbs] _a _b _r;
  reg ptr u64[sike434_nlimbs] a b r;

  a = _a;
  b = _b;
  a = BN_load_(a,ap);
  b = BN_load_(b,bp);
  r = _r;
  r = FPM_mulm_(r, a, b);
  BN_store_(rp, r);
}

