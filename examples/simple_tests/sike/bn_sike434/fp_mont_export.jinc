/*
//from Libjbn require "bn_base.mjazz" as "BN"
 with { nlimbs = nlimbs; }
*/
from MJazz require "BN_bn_base.jinc"

/*
//from Libjbn require "fp_mont.mjazz" as "FPM"
 with { nlimbs = nlimbs;
        glob_P = glob_P;
        glob_mP = glob_mP;
        glob_Pi0 = Pi0;
        glob_Pm2 = glob_Pm2; }
*/
from MJazz require "FPM_fp_mont.jinc"

export fn fp_add(reg u64 rp ap bp)
{
  stack u64[sike434_nlimbs] _a _b;
  reg ptr u64[sike434_nlimbs] a b;

  a = _a;
  b = _b;
  a = BN_load_(a,ap);
  b = BN_load_(b,bp);
  a = FPM_addmU_(a, b);
  BN_store_(rp, a);
}


export fn fp_sub( reg u64 rp ap bp)
