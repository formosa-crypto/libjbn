/* This file is indeed a template for a pyhton prototype
   intended to emulate and exercise the "Parametric Modules"
   feature propose in https://github.com/jasmin-lang/jasmin/issues/519.

BN_RND_FNS = _rnd_ _rsample_

*/


/*
modsignature { int nlimbs; }
*/

//require "bn_base.jinc" as "BN"
require "BN_bn_base.jinc"

/*
/* random bytes */
inline fn BN_randombytes_
( reg mut ptr u64[sike434_nlimbs] a
, inline int n
) -> reg ptr u64[sike434_nlimbs] {
  reg ptr u8[8*sike434_nlimbs] a_;
  reg ptr u8[n] tmp; // OBS: not allowed!!!
  a_ = a;
  tmp = a_[0:n];
  tmp = #randombytes(tmp);
  return a;
}
*/

/* random number */
inline fn BN_rnd_
( reg mut ptr u64[sike434_nlimbs] a
) -> reg ptr u64[sike434_nlimbs] {
  a = a;
  a = #randombytes(a);
  a = a;
  return a;
}

/* rejection sampling */
inline fn BN_rsample_
( reg mut ptr u64[sike434_nlimbs] a
, reg const ptr u64[sike434_nlimbs] bnd
) -> reg ptr u64[sike434_nlimbs] {
  reg bool cf;
  while {
    a = BN_rnd_(a);
    cf = BN_lt_cf_(a, bnd);
  }(!cf)
  return a;
}

