/*
   GENERIC EXPONENTIATION

BN_EXP_FNS = _expm_noct_ _expmU_noct_ _expm_ _expmU_

*/

/*
modsignature {
  int nlimbs;		// num. limbs
  int nlimbsexp;	// num. limbs
  u64[nlimbs] glob_exp0;
  fn fun_mulU ( reg mut ptr u64[nlimbs]
              , reg const ptr u64[nlimbs)
              ) -> reg ptr u64[nlimbs]
  fn fun_sqrU ( reg mut ptr u64[nlimbs]
              ) -> reg ptr u64[nlimbs]
}

//require "bn_base.jinc" as "BN"
//  with { nlimbs = nlimbs; }

*/
from MJazz require "BN_bn_base.jinc"

// ////////////////////////////////////

/* Modular exponentiation
  obs: naive square-multiply algorithm. Not Constant-Time!!!
  (good enough to use with public exponents, such as in inversion) */
fn FPM_expm_noct
( reg mut ptr u64[sike503_nlimbs] r
, reg const ptr u64[sike503_nlimbs] a
, reg const ptr u64[sike503_nlimbs] b
) -> reg ptr u64[sike503_nlimbs] {
  inline int j;
  reg u64 t;
  reg bool cf zf;
  reg ptr u64[sike503_nlimbs] x;
  stack u64 _k;
  stack u64[sike503_nlimbs] _x;
  stack ptr u64[sike503_nlimbs] _b;

  _b = b;
  x = _x;
  x = BN_mov_(x, a);
  _x = x;

  for j = 0 to sike503_nlimbs {
    b = _b;
    t = b[(int) j];
    _k = 64;
    while {
      _, cf, _, _, _, t = #SHR(t, 1);
      x = _x;
      if (cf) {
        r = FPM_mulmU_(r, x);
      }
      x = FPM_sqrmU_(x);
      _x = x;
      _, _, _, zf, _k = #DEC(_k);
    } (!zf)
  }
  return r;
}

inline fn FPM_expm_noct_
( reg mut ptr u64[sike503_nlimbs] r
, reg const ptr u64[sike503_nlimbs] a
, reg const ptr u64[sike503_nlimbs] b
) -> reg ptr u64[sike503_nlimbs] {
  reg ptr u64[sike503_nlimbs] exp0;
  exp0 = sike503_glob_oneMP;
  r = BN_mov_(r, exp0);
  a = a; b = b;
  r = FPM_expm_noct(r, a, b);
  r = r;
  return r;
}

inline fn FPM_expmU_noct_
( reg mut ptr u64[sike503_nlimbs] a
, reg const ptr u64[sike503_nlimbs] b
) -> reg ptr u64[sike503_nlimbs] {
  stack u64[sike503_nlimbs] _tmp;
  reg ptr u64[sike503_nlimbs] tmp exp0;
  tmp = _tmp;
  tmp = BN_mov_(tmp, a);
  exp0 = sike503_glob_oneMP;
  a = BN_mov_(a, exp0);
  a = FPM_expm_noct_(a, tmp, b);
  return a;
}

/* Modular exponentiation (constant-time) */
fn FPM_expm
( reg mut ptr u64[sike503_nlimbs] x0 x1
, reg const ptr u64[sike503_nlimbs] b
) -> reg ptr u64[sike503_nlimbs], reg ptr u64[sike503_nlimbs] {
  inline int j;
  reg u64 t mask;
  stack u64 _k _mask _t;
  reg bool cf zf;
  stack ptr u64[sike503_nlimbs] _b;

  _b = b;

  for j = sike503_nlimbs-1 downto -1  {
    b = _b;
    t = b[(int) j];
    _k = 64;
    while {
      _, cf, _, _, _, t = #SHL(t, 1);
      _t = t;
      mask = BN__cf_mask(cf);
      x0, x1 = BN_cswap_mask_(x0, x1, mask);
      _mask = mask;
      x1 = FPM_mulmU_(x1, x0);
      x0 = FPM_sqrmU_(x0);
      mask = _mask;
      x0, x1 = BN_cswap_mask_(x0, x1, mask);
      t = _t;
      _, _, _, zf, _k = #DEC(_k);
    } (!zf)
  }
  return x0, x1;
}

inline fn FPM_expm_
( reg mut ptr u64[sike503_nlimbs] x0
, reg const ptr u64[sike503_nlimbs] a
, reg const ptr u64[sike503_nlimbs] b
) -> reg ptr u64[sike503_nlimbs] {
  stack u64[sike503_nlimbs] _x1;
  reg ptr u64[sike503_nlimbs] x1 exp0;
  x1 = _x1;
  x1 = BN_mov_(x1, a);
  exp0 = sike503_glob_oneMP;
  x0 = BN_mov_(x0, exp0);
  b = b;
  x0, _ = FPM_expm(x0, x1, b);
  x0 = x0;
  return x0;
}

inline fn FPM_expmU_
( reg mut ptr u64[sike503_nlimbs] a
, reg const ptr u64[sike503_nlimbs] b
) -> reg ptr u64[sike503_nlimbs] {
  stack u64[sike503_nlimbs] _x1;
  reg ptr u64[sike503_nlimbs] x1 exp0;
  x1 = _x1;
  x1 = BN_mov_(x1, a);
  exp0 = sike503_glob_oneMP;
  a = BN_mov_(a, exp0);
  b = b;
  a, _ = FPM_expm(a, x1, b);
  a = a;
  return a;
}
