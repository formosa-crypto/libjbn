from MJazz require "BN_bn_base.jinc"

export fn bn_eq(reg u64 ap bp) -> reg u64
{
  stack u64[sike503_nlimbs] _a _b;
  reg ptr u64[sike503_nlimbs] a b;
  reg u64 r;

  a = _a;
  a = BN_load_(a, ap);
  b = _b;
  b = BN_load_(b, bp);
  r = BN_eq_(a, b);
  r = r;
  return r;
}

export fn bn_test0(reg u64 ap) -> reg u64
{
  stack u64[sike503_nlimbs] _a;
  reg ptr u64[sike503_nlimbs] a;
  reg u64 r;
  a = _a;
  a = BN_load_(a, ap);
  r = BN_test0_(a);
  r = r; // avoid extra assignment warning
  return r;
}

export fn bn_copy(reg u64 rp ap)
{
  inline int i;
  reg u64 t;

  for i = 0 to sike503_nlimbs {
    t = [ap + 8*i];
    [rp + 8*i] = t;
  }
}

export fn bn_set0(reg u64 rp)
{
  inline int i;

  for i = 0 to sike503_nlimbs {
    [rp + 8*i] = 0;
  }
}

export fn bn_addU(reg u64 rp ap bp)
{
  stack u64[sike503_nlimbs] _a _b;
  reg ptr u64[sike503_nlimbs] a b;

  a = _a;
  a = BN_load_(a, ap);
  b = _b;
  b = BN_load_(b, bp);
  _, a = BN_addU_(a, b);
  BN_store_(rp, a);
}

export fn bn_subU(reg u64 rp ap bp)
{
 stack u64[sike503_nlimbs] _a _b;
 reg ptr u64[sike503_nlimbs] a b;

 a = _a;
 a = BN_load_(a,ap);
 b = _b;
 b = BN_load_(b,bp);
 _, a = BN_subU_(a, b);
 BN_store(rp, a);
}

