/******************************************************************
                      PRODUCT-SCANNING
*******************************************************************/


// regs: params(5) + 3 = 8
inline fn BN__muln_innerloop
( reg u64[3] x
, inline int k istart iend
, reg ptr u64[sike610_nlimbs] a b
) -> reg u64[3] {
  reg u64 t1, t0;
  inline int i, j;
  for i = istart to iend {
    j = k-i;
    t0 = a[i];
    t1, t0 = t0 * b[j];
    x = BN__addacc3(x, t1, t0, k);
  }
  return x;
}

// regs: params(3) + call(3) + 3(+2) = 9
inline fn BN__ps_muln
( reg mut ptr u64[2*sike610_nlimbs] r
, reg const ptr u64[sike610_nlimbs] a b
) -> reg ptr u64[2*sike610_nlimbs] {
  inline int k;
  reg u64 t0 t1;
  reg u64[3] x;

  t0 = a[0];
  t1, t0 = t0 * b[0];
  r[0] = t0;
  x[1] = t1;
//  _, _, _, _, _, x[2] = #set0();
  x[2] = 0;
//  _, _, _, _, _, x[0] = #set0();
  x[0] = 0;
  for k = 1 to sike610_nlimbs {
    x = BN__muln_innerloop(x, k, 0, k+1, a, b);
    t0 = x[k % 3];
//    _, _, _, _, _, x[k % 3] = #set0();
    x[k % 3] = 0;
    r[k] = t0;
  }
  for k = sike610_nlimbs to 2*sike610_nlimbs-1 {
    x = BN__muln_innerloop(x, k, k-sike610_nlimbs+1, sike610_nlimbs, a, b);
    t0 = x[k % 3];
//    _, _, _, _, _, x[k % 3] = #set0();
    x[k % 3] = 0;
    r[k] = t0;
  }
  r[2*sike610_nlimbs-1] = x[(2*sike610_nlimbs-1) % 3];
  return r;
}

// regs: params(3) + call(6) = 9
fn BN_ps_muln
( reg mut ptr u64[2*sike610_nlimbs] r
, reg const ptr u64[sike610_nlimbs] a b
) -> reg ptr u64[2*sike610_nlimbs] {
  r = BN__ps_muln(r, a, b);
  return r;
}

inline fn BN_ps_muln_
( reg mut ptr u64[2*sike610_nlimbs] r
, reg const ptr u64[sike610_nlimbs] a b
) -> reg ptr u64[2*sike610_nlimbs] {
  r = r; a = a; b = b;
  r = BN_ps_muln(r, a, b);
  r = r;
  return r;
}

