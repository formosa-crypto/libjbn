// regs: params(4) + 2 = 6 
inline fn BN__sqrn_innerloop
( reg u64[3] x
, inline int k istart iend
, reg const ptr u64[sike610_nlimbs] a
) -> reg u64[3] {
  reg u64 ti, tj;
  inline int i, j;
  for i = istart to iend {
    j = k-i;
    ti = a[i];
    tj = a[j];
    x = BN__addacc3x2(x, ti, tj, k);
  }
  return x;
}

inline fn BN__ps_sqrn
( reg mut ptr u64[2*sike610_nlimbs] r
, reg const ptr u64[sike610_nlimbs] a
) -> reg ptr u64[2*sike610_nlimbs] {
  inline int k;
  reg u64 t0 t1;
  reg u64[3] x;

  t0 = a[0];
  t1, t0 = t0 * t0;
  r[0] = t0;
  x[1] = t1;
//  _, _, _, _, _, x[2] = #set0();
  x[2] = 0;
//  _, _, _, _, _, x[0] = #set0();
  x[0] = 0;

  for k = 1 to sike610_nlimbs {
    x = BN__sqrn_innerloop(x, k, 0, (k+1)/2, a);
    if (k % 2 == 0) {
      t0 = a[k/2];
      t1, t0 = t0 * t0;
      x = BN__addacc3(x, t1, t0, k);
    }
    t0 = x[k % 3];
//    _, _, _, _, _, x[k % 3] = #set0();
    x[k % 3] = 0;
    r[k] = t0;
  }
  for k = sike610_nlimbs to 2*sike610_nlimbs-1 {
    x = BN__sqrn_innerloop(x, k, k-sike610_nlimbs+1, (k+1)/2, a);
    if (k % 2 == 0) {
      t0 = a[k/2];
      t1, t0 = t0 * t0;
      x = BN__addacc3(x, t1, t0, k);
    }
    t0 = x[k % 3];
//    _, _, _, _, _, x[k % 3] = #set0();
    x[k % 3] = 0;
    r[k] = t0;
  }
  r[2*sike610_nlimbs-1] = x[(2*sike610_nlimbs-1) % 3];
  return r;
}

fn BN_ps_sqrn
( reg mut ptr u64[2*sike610_nlimbs] r
, reg const ptr u64[sike610_nlimbs] a
) -> reg ptr u64[2*sike610_nlimbs] {
  r = BN__ps_sqrn(r, a);
  return r;
}

inline fn BN_ps_sqrn_
( reg mut ptr u64[2*sike610_nlimbs] r
, reg const ptr u64[sike610_nlimbs] a
) -> reg ptr u64[2*sike610_nlimbs] {
  r = r; a = a;
  r = BN_ps_sqrn(r, a);
  r = r;
  return r;
}

inline fn BN_ps_ksqrn_
( reg mut ptr u64[2*sike610_nlimbs] r
, reg mut ptr u64[sike610_nlimbs] tmp
, reg const ptr u64[sike610_nlimbs] a
) -> reg ptr u64[sike610_nlimbs], reg ptr u64[2*sike610_nlimbs]
{
  r = BN_ps_sqrn_( r, a );
  return tmp, r;
}




// ////////////////////////////////////
// regs: params(3) + call(3) + 3 = 9
inline fn BN__mont_redM
( reg mut ptr u64[sike610_nlimbs] r
, reg const ptr u64[2*sike610_nlimbs] a
, stack u64[sike610_nlimbs] _P
, stack u64[sike610_nlimbs] _mP
, stack u64 _U0
) -> reg ptr u64[sike610_nlimbs] {
  inline int k;
  reg bool cf;
  reg ptr u64[sike610_nlimbs] P mP;
  reg u64 t0 t1 zero lastbit;
  reg u64[3] x;

//  _, _, _, _, _, x[0] = #set0();
  x[0] = 0;
//  _, _, _, _, _, x[1] = #set0();
  x[1] = 0;
//  _, _, _, _, _, x[2] = #set0();
  x[2] = 0;

  for k = 0 to sike610_nlimbs {
    P = _P;
    x = BN__muln_innerloop(x, k, 0, k, r, P); //+3
//    _, _, _, _, _, zero = #set0();
    zero = 0;
    t0 = a[k];
    x = BN__addacc3(x, zero, t0, k);
    t0 = x[k % 3];
    _, t0 = t0 * _U0;
    r[k] = t0;
    t1, t0 = t0 * _P[0];
    x = BN__addacc3(x, t1, t0, k);
  }
  for k = sike610_nlimbs to 2*sike610_nlimbs-1 {
    P = _P;
    x = BN__muln_innerloop(x, k, k-sike610_nlimbs+1, sike610_nlimbs, r, P); //+3
//    _, _, _, _, _, zero = #set0();
    zero = 0;
    t0 = a[k];
    x = BN__addacc3(x, zero, t0, k);
    t0 = x[k % 3];
    r[k-sike610_nlimbs] = t0;
//    _, _, _, _, _, x[k % 3] = #set0();
    x[k % 3] = 0;
  }

  lastbit = 0;
  cf, x[(2*sike610_nlimbs-1) % 3] += a[2*sike610_nlimbs-1];
  _, lastbit += 0 + cf;

  r[sike610_nlimbs-1] = x[(2*sike610_nlimbs-1) % 3];

  mP = _mP;
  r = BN_cminusP_(r, mP, lastbit);
  return r;
}


