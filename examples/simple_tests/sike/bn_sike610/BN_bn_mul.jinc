/* This file is indeed a template for a pyhton prototype
   intended to emulate and exercise the "Parametric Modules"
   feature propose in https://github.com/jasmin-lang/jasmin/issues/519.

BN_MUL_FNS = 

*/




//modsignature { param int sike610_nlimbs; }


//from Libjbn require "bn_util.mjazz"
require "BN_bn_util.jinc"


//from Libjbn require "bn_base.mjazz"
//. with { nlimbs = nlimbs; }
require "BN_bn_base.jinc"


/******************************************************************
                      OPERAND-SCANNING
*******************************************************************/
inline fn BN__mul1
( reg mut ptr u64[2*sike610_nlimbs] r
, reg u64 a
, reg const ptr u64[sike610_nlimbs] b
) -> reg u64, reg bool, reg bool, reg u64[2*sike610_nlimbs]
{
  inline int i;
  reg bool of, cf;
  reg u64 _zero, lo;
  reg u64[sike610_nlimbs+1] rr; // at most 2 alive

  of, cf, _, _, _, _zero = #set0();

  rr[1], rr[0] = #MULX ( a, b[0] );
  r[0] = rr[0]; // kill rr[0]
  for i = 1 to sike610_nlimbs {
    rr[i+1], lo = #MULX ( a, b[i] );
    cf, rr[i] = #ADCX ( rr[i], lo, cf );
    r[i] = rr[i]; // kill rr[i]
  }

  cf, rr[sike610_nlimbs] = #ADCX ( rr[sike610_nlimbs], _zero, cf );
  r[sike610_nlimbs] = rr[sike610_nlimbs];
  // cf = 0

  return _zero, of, cf, r;
}


/* multiplies a (shifted) scalar by a reg array (remaining iterations of mul) */
/* REGS (params + workspace):  */
inline fn BN__mul1acc
( inline int k
, reg mut ptr u64[2*sike610_nlimbs] r
, reg u64 a
, reg const ptr u64[sike610_nlimbs] b
, reg u64 _zero // should be set to 0
, reg bool of cf // should be set to 0
) -> reg u64, reg bool, reg bool, reg u64[2*sike610_nlimbs]
{
  inline int i;
  reg u64 hi lo;
  reg u64[sike610_nlimbs+1] rr; // at most 2 alive

  rr[0] = r[k];
  for i = 0 to sike610_nlimbs-1 {
    rr[i+1] = r[k+i+1];
    hi, lo = #MULX ( a, b[i] ); 
    of, rr[i] = #ADOX ( rr[i], lo, of );
    r[k+i] = rr[i]; // kill rr[i]
    cf, rr[i+1] = #ADCX ( rr[i+1], hi, cf );
  }

  rr[sike610_nlimbs], lo = #MULX ( a, b[sike610_nlimbs-1] ); // a is now dead!
  of, rr[sike610_nlimbs-1] = #ADOX ( rr[sike610_nlimbs-1], lo, of );
  r[k+sike610_nlimbs-1] = rr[sike610_nlimbs-1]; // kill rr[sike610_nlimbs-1]

  cf, rr[sike610_nlimbs] = #ADCX ( rr[sike610_nlimbs], _zero, cf);
  of, rr[sike610_nlimbs] = #ADOX ( rr[sike610_nlimbs], _zero, of);
  r[k+sike610_nlimbs] = rr[sike610_nlimbs];
  // cf = 0, of = 0

  return _zero, of, cf, r;
}


/* Operand-scanning multiplication (first arg. as a reg_ptr) */
fn BN_os_muln
( reg mut ptr u64[2*sike610_nlimbs] r
, reg const ptr u64[sike610_nlimbs] a b //reg u64 fptr,
) -> reg ptr u64[2*sike610_nlimbs]
{
  inline int i;
  reg bool of cf;
  reg u64 _zero ai;

  ai = a[0];

  _zero, of, cf, r = BN__mul1(r, ai, b);

  for i = 1 to sike610_nlimbs {
    ai = a[i];
    _zero, of, cf, r = BN__mul1acc(i, r, ai, b, _zero, of, cf);
  }

  return r;
}

inline fn BN_os_muln_
( reg mut ptr u64[2*sike610_nlimbs] r
, reg const ptr u64[sike610_nlimbs] a b
) -> reg ptr u64[2*sike610_nlimbs]
{
  r = r; a = a; b = b;
  r = BN_os_muln(r, a, b);
  r = r;
  return r;
}


