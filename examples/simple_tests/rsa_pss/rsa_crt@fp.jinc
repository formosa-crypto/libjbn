/* RSA-CRT: one half of the decryption, written for a Montgomery field.

   Required inside a field namespace (see rsapss.jazz: H::H::FPM), so that
   the names below refer to that field's own operations; the prime X is
   given by its context, so one instance serves both primes.

   Expects:   param int nlimbs;              // limbs of the prime X
              _redM_ _toM_ _fromM_ EXP::     // fp_mont
   Provides:  _crt_exp_
*/

/* r = (c mod X)^dX mod X, for c < X * 2^(64*nlimbs) (e.g. c < n = p*q),
   with the constant-time exponentiation; ctx is the context of X. */
inline fn _crt_exp_
( reg mut ptr u64[nlimbs] r
, reg const ptr u64[2*nlimbs] c
, reg const ptr u64[nlimbs] dX
, reg const ptr u64[CTXLEN] ctx
) -> reg ptr u64[nlimbs] {
  stack u64[nlimbs] _cM;
  reg ptr u64[nlimbs] cM;

  cM = _cM;
  cM = _redM_(cM, c, ctx);   // c * R^-1 mod X
  cM = _toM_(cM, ctx);        // c mod X
  cM = _toM_(cM, ctx);        // (c mod X) * R mod X  (Montgomery form)
  r = EXP::_expm_(r, cM, dX, ctx);
  r = _fromM_(r, ctx);
  return r;
}
