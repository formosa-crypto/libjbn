/* libjbn instance: 32-limb schoolbook multiplication.

   Size scopes (halving nesting, see README):
     top : 64 limbs, result store of the exports
     H   : 32 limbs, BN and MUL
*/

param int nlimbs = 64;

namespace UTIL { from Libjbn require "bn_util.jinc" }

namespace H {
  param int nlimbs = 32;
  namespace BN  { from Libjbn require "bn_base.jinc" }
  namespace MUL { from Libjbn require "bn_mul.jinc" }
}

namespace BN { from Libjbn require "bn_base.jinc" }

/* C entry points */
from Libjbn require "bn_mul_export.jinc"
