/* libjbn instance: 32-limb operand-scanning multiplication and squaring,
   unrolled (bn_mulx: MULX/ADCX/ADOX rows).

   Size scopes (halving nesting, see README):
     top : 64 limbs, result store of the exports
     H   : 32 limbs, BN and MUL
*/

param int nlimbs = 64;

namespace UTIL { from Libjbn require "bn_util.jinc" }

namespace H {
  param int nlimbs = 32;
  namespace BN  { from Libjbn require "bn_base@n.jinc" }
  namespace MUL { from Libjbn require "bn_mulx@n.jinc" }
}

namespace BN { from Libjbn require "bn_base@n.jinc" }

/* C entry points (bn_os_muln, bn_os_sqrn) */
from Libjbn require "bn_mul_loop_export@2n.jinc"
