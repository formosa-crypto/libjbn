/* libjbn instance: 32-limb looped squaring with MULX/ADCX/ADOX rows
   (bn_sqrx_loop, a prototype), next to the row-looped multiplication of the
   same size (bn_mulx_loop), whose squaring is the multiplication: the
   reference of the test and of the bench. Needs a CPU with BMI2 and ADX.

   Size scopes (halving nesting, see README):
     top : 64 limbs, result store of the exports
     H   : 32 limbs, BN, MUL (bn_mulx_loop) and SQR (bn_sqrx_loop)

   JBN_SQRL_GROUP and JBN_SQRL_TAIL are the knobs of the prototype (the
   products per group of a row, and its tail: see bn_sqrx_loop@n.jinc).
   `make bench-sqrl` generates its instances from this file: other sizes,
   group sizes and tails.
*/

param int nlimbs = 64;

namespace UTIL { from Libjbn require "bn_util.jinc" }

namespace H {
  param int nlimbs = 32;
  param int JBN_SQRL_GROUP = 4;
  param int JBN_SQRL_TAIL = 1;
  namespace BN  { from Libjbn require "bn_base@n.jinc" }
  namespace MUL { from Libjbn require "bn_mulx_loop@n.jinc" }
  namespace SQR { from Libjbn require "bn_sqrx_loop@n.jinc" }
}

namespace BN { from Libjbn require "bn_base@n.jinc" }

/* C entry points: bn_os_muln and bn_os_sqrn (the squaring by the
   multiplication) */
from Libjbn require "bn_mul_loop_export@2n.jinc"

/* and the looped squaring */
#[safety = { requires = is_mem_init(ap, 8*H::nlimbs) && is_mem_init(rp, 8*nlimbs) }]
export fn bn_osl_sqrn(reg u64 rp ap)
{
  stack u64[H::nlimbs] _a;
  stack u64[nlimbs] _r;
  stack u64 _rp;
  reg ptr u64[H::nlimbs] a;
  reg ptr u64[nlimbs] r;

  _rp = rp;
  a = _a;
  a = H::BN::_load_(a, ap);
  r = _r;
  r = H::SQR::_osl_sqrn_(r, a);
  rp = _rp;
  BN::_store_(rp, r);
}
