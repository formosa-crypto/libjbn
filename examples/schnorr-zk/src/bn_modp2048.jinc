/* libjbn instance for the Schnorr example: the RFC 3526 2048-bit MODP group.

   Layout (see README): a single size (32 limbs), which is the top level.
   The two fields share the size scope's BN, RND and MUL instances:
     FPM : arithmetic modulo P (the group modulus)
     FQM : arithmetic modulo Q = (P-1)/2 (the group order)
*/

param int nlimbs = 32;

namespace UTIL { from Libjbn require "bn_util.jinc" }

namespace BN  { from Libjbn require "bn_base.jinc" }
namespace RND { from Libjbn require "bn_rnd.jinc" }
namespace MUL { from Libjbn require "bn_mul.jinc" }

namespace FPM {
  param int nlimbsexp = nlimbs;
  from Libjbn require "params/rfc3526/modp2048_p.jinc"
  from Libjbn require "fp_mul_ps.jinc"
  from Libjbn require "fp_mont.jinc"

  /* exponentiation of the generator (in Montgomery form) */
  inline fn _gexp_
  ( reg mut ptr u64[nlimbs] r
  , reg const ptr u64[nlimbs] x
  ) -> reg ptr u64[nlimbs] {
    reg ptr u64[nlimbs] gM;
    gM = glob_gM;
    r = EXP::_expm_(r, gM, x);
    return r;
  }
}

namespace FQM {
  param int nlimbsexp = nlimbs;
  from Libjbn require "params/rfc3526/modp2048_q.jinc"
  from Libjbn require "fp_mul_ps.jinc"
  from Libjbn require "fp_mont.jinc"
}
