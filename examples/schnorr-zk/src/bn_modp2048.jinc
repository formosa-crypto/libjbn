/* libjbn instance for the Schnorr example: the RFC 3526 2048-bit MODP group.

   Layout (see README): a single size (32 limbs), which is the top level,
   with one field namespace FPM, shared by the two moduli through their
   contexts:
     FPM::P::glob_ctx : arithmetic modulo P (the group modulus)
     FPM::Q::glob_ctx : arithmetic modulo Q = (P-1)/2 (the group order)
*/

param int nlimbs = 32;

namespace UTIL { from Libjbn require "bn_util.jinc" }

namespace BN  { from Libjbn require "bn_base@n.jinc" }
namespace RND { from Libjbn require "bn_rnd@n.jinc" }
namespace MUL { from Libjbn require "bn_mul@n.jinc" }

namespace FPM {
  from Libjbn require "fp_mul_ps@fp.jinc"
  from Libjbn require "fp_mont@fp.jinc"
  namespace P { from Libjbn require "params/rfc3526/modp2048_p@n.jinc" }
  namespace Q { from Libjbn require "params/rfc3526/modp2048_q@n.jinc" }

  /* exponentiation of the generator (in Montgomery form) */
  inline fn _gexp_
  ( reg mut ptr u64[nlimbs] r
  , reg const ptr u64[nlimbs] x
  ) -> reg ptr u64[nlimbs] {
    reg ptr u64[nlimbs] gM;
    reg ptr u64[CTXLEN] ctx;
    gM = P::glob_gM;
    ctx = P::glob_ctx;
    r = EXP::_expmW_(r, gM, x, ctx);
    return r;
  }
}

