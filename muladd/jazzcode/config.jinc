
param int nlimbs = 32;

/*
 * setting parameters to test u16 arrays 
 */
param int U16_ARRAY1 = 70; // 1092 bits => 68.25 u16 words (we round up to 70 words)
param int U16_ARRAY2 = 36; // 546 bits => 34.125 u16 words (we round up to 36 words)

/*
 * setting parameters to test u32 arrays 
 */
param int U32_ARRAY1 = 35; // 1057 bits => 33.03125 u32 words (we round up to 34 words)
param int U32_ARRAY2 = 18; // 546 bits => 17.0625 u32 words (we round up to 18 words)

/*
 * When BR_CT_MUL15 is enabled, multiplications of 15-bit values (held
 * in 32-bit words) use an alternate implementation which is slower and
 * larger than the normal multiplication, but should ensure
 * constant-time multiplications on most/all architectures where the
 * basic multiplication is not constant-time.
	*/
param int BR_CT_MUL15 = 0;

