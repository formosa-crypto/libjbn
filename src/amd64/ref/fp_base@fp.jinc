/* libjbn -- fp_base: prime-field arithmetic, generic in the reduction.

   Library module, i.e. template (see README, sections 1 and 2): it is meant
   to be `require`d inside a namespace, which becomes the instance; the tag
   in the file name (@fp) gives the kind of namespace. Names below are
   resolved by Jasmin's outward namespace lookup.

   Instance:  a field namespace (e.g. FPM), in a size scope: it serves every
              modulus of that size; normally included by fp_mont
   Expects:   param int nlimbs;
              fn fun_muln (reg mut ptr u64[2*nlimbs], reg const ptr u64[nlimbs],
                           reg const ptr u64[nlimbs]) -> reg ptr u64[2*nlimbs]
              fn fun_sqrn (reg mut ptr u64[2*nlimbs], reg const ptr u64[nlimbs])
                          -> reg ptr u64[2*nlimbs]
              fn fun_red  (reg mut ptr u64[nlimbs], reg const ptr u64[2*nlimbs],
                           reg const ptr u64[CTXLEN]) -> reg ptr u64[nlimbs]
              UTIL::  BN::  RND::          // same size
   Provides:  _chk_bnds_ _rnd_ _addm(U)_ _subm(U)_ _mulm(U)_ _sqrm(U)_ _invm(U)_
              and the context layout (fp_ctx@n.jinc: CTXLEN, CTX_P, ...).
              Every operation takes the field context ctx (the constants of
              the modulus P) as its last argument.
   Sub-instance: EXP (bn_exp with fun_mulU/fun_sqrU := _mulmU_/_sqrmU_, and
              exponents of nlimbs limbs)

   Constant time: the operations are constant time in their operands and in
   the context, except _rnd_ (rejection sampling: its number of iterations
   depends on P) and _invm(U)_ (Fermat inversion, with the variable-time
   exponentiation on P-2): these two assume a public modulus.
*/

require "fp_ctx@n.jinc"

inline fn _chk_bnds_
( stack u64 err
, reg const ptr u64[nlimbs] a
, reg const ptr u64[CTXLEN] ctx
) -> stack u64 {
 reg ptr u64[nlimbs] P;
 reg bool cf;
 reg u64 t;
 P = ctx[CTX_P:nlimbs];
 cf = BN::_lt_cf_(a, P);
 t = UTIL::__ncf_mask(cf);
 err |= t;
 return err;
}

inline fn _rnd_
( reg mut ptr u64[nlimbs] a
, reg const ptr u64[CTXLEN] ctx
) -> reg ptr u64[nlimbs] {
 reg ptr u64[nlimbs] P;
 P = ctx[CTX_P:nlimbs];
 a = RND::_rsample_(a, P);
 return a;
}

inline fn _addm_
 ( reg mut ptr u64[nlimbs] r
 , reg const ptr u64[nlimbs] a b
, reg const ptr u64[CTXLEN] ctx
) -> reg ptr u64[nlimbs]
{
  reg bool cf;
  reg u64 lastbit;
  reg ptr u64[nlimbs] tmp;

  cf, r = BN::_add_(r, a, b);

  lastbit = 0;
  _, lastbit += 0 + cf;
  tmp = ctx[CTX_MP:nlimbs];
  r = BN::_cminusP_(r, tmp, lastbit);
  return r;
}

inline fn _addmU_
 ( reg mut ptr u64[nlimbs] a
 , reg const ptr u64[nlimbs] b
, reg const ptr u64[CTXLEN] ctx
) -> reg ptr u64[nlimbs]
{
  reg bool cf;
  reg u64 lastbit;
  reg ptr u64[nlimbs] tmp;

  cf, a = BN::_addU_(a, b);

  lastbit = 0;
  _, lastbit += 0 + cf;
  tmp = ctx[CTX_MP:nlimbs];
  a = BN::_cminusP_(a, tmp, lastbit);
  return a;
}

// ////////////////////////////////////

inline fn _subm_
( reg mut ptr u64[nlimbs] r
, reg const ptr u64[nlimbs] a b
, reg const ptr u64[CTXLEN] ctx
) -> reg ptr u64[nlimbs] {
 reg bool cf;
 reg ptr u64[nlimbs] tmp;
 cf, r = BN::_sub_(r, a, b);
 tmp = ctx[CTX_P:nlimbs];
 r = BN::_caddU_(r, cf, tmp);
 return r;
}

inline fn _submU_
( reg mut ptr u64[nlimbs] a
, reg const ptr u64[nlimbs] b
, reg const ptr u64[CTXLEN] ctx
) -> reg ptr u64[nlimbs] {
 reg bool cf;
 reg ptr u64[nlimbs] tmp;
 cf, a = BN::_subU_(a, b);
 tmp = ctx[CTX_P:nlimbs];
 a = BN::_caddU_(a, cf, tmp);
 return a;
}

/* Modular multiplication */
inline fn _mulm_
( reg mut ptr u64[nlimbs] r
, reg ptr u64[nlimbs] a b
, reg const ptr u64[CTXLEN] ctx
) -> reg ptr u64[nlimbs] {
  stack u64[2*nlimbs] _tmp;
  reg ptr u64[2*nlimbs] tmp;

  tmp = _tmp;
  tmp = fun_muln(tmp, a, b);
  r = fun_red(r, tmp, ctx);
  return r;
}

// ////////////////////////////////////

inline fn _mulmU_ // update inplace
( reg mut ptr u64[nlimbs] a
, reg ptr u64[nlimbs] b
, reg const ptr u64[CTXLEN] ctx
) -> reg ptr u64[nlimbs] {
  stack u64[2*nlimbs] _tmp;
  reg ptr u64[2*nlimbs] tmp;
  tmp = _tmp;
  tmp = fun_muln(tmp, a, b);
  a = fun_red(a, tmp, ctx);
  return a;
}

// ////////////////////////////////////

inline fn _sqrm_
( reg mut ptr u64[nlimbs] r
, reg const ptr u64[nlimbs] a
, reg const ptr u64[CTXLEN] ctx
) -> reg ptr u64[nlimbs] {
  stack u64[2*nlimbs] _tmp;
  reg ptr u64[2*nlimbs] tmp;
  tmp = _tmp;
  tmp = fun_sqrn(tmp, a);
  r = fun_red(r, tmp, ctx);
  return r;
}

// ////////////////////////////////////

inline fn _sqrmU_ // update inplace
( reg mut ptr u64[nlimbs] a
, reg const ptr u64[CTXLEN] ctx
) -> reg ptr u64[nlimbs] {
  stack u64[2*nlimbs] _tmp;
  reg ptr u64[2*nlimbs] tmp;
  tmp = _tmp;
  tmp = fun_sqrn(tmp, a);
  a = fun_red(a, tmp, ctx);
  return a;
}

// ////////////////////////////////////

/* Exponentiation in this field: sub-instance EXP of bn_exp, whose
   multiplication/squaring parameters are the in-place operations above
   (these wrappers are inline, hence free). */
inline fn fun_mulU
( reg mut ptr u64[nlimbs] a
, reg const ptr u64[nlimbs] b
, reg const ptr u64[CTXLEN] ctx
) -> reg ptr u64[nlimbs] {
  a = _mulmU_(a, b, ctx);
  return a;
}

inline fn fun_sqrU
( reg mut ptr u64[nlimbs] a
, reg const ptr u64[CTXLEN] ctx
) -> reg ptr u64[nlimbs] {
  a = _sqrmU_(a, ctx);
  return a;
}

namespace EXP {
  param int nlimbsexp = nlimbs;
  require "bn_exp@exp.jinc"
}


/* P-2, the exponent of Fermat inversion */
inline fn __Pm2
( reg mut ptr u64[nlimbs] r
, reg const ptr u64[CTXLEN] ctx
) -> reg ptr u64[nlimbs] {
  inline int i;
  reg bool cf;
  reg u64 t;
  t = ctx[CTX_P];
  cf, t -= 2;
  r[0] = t;
  for i = 1 to nlimbs {
    t = ctx[CTX_P + i];
    cf, t -= 0 - cf;
    r[i] = t;
  }
  return r;
}

/* Modular Inversion (fermat) */
inline fn _invmU_
( reg mut ptr u64[nlimbs] a
, reg const ptr u64[CTXLEN] ctx
) -> reg ptr u64[nlimbs] {
  /* a^{p-2} */
  stack u64[nlimbs] _Pm2;
  reg ptr u64[nlimbs] Pm2;
  Pm2 = _Pm2;
  Pm2 = __Pm2(Pm2, ctx);
  a = EXP::_expmU_noct_(a, Pm2, ctx);
  return a;
}

inline fn _invm_
( reg mut ptr u64[nlimbs] r
, reg const ptr u64[nlimbs] a
, reg const ptr u64[CTXLEN] ctx
) -> reg ptr u64[nlimbs] {
  /* a^{p-2} */
  stack u64[nlimbs] _Pm2;
  reg ptr u64[nlimbs] Pm2;
  Pm2 = _Pm2;
  Pm2 = __Pm2(Pm2, ctx);
  r = EXP::_expm_noct_(r, a, Pm2, ctx);
  return r;
}

