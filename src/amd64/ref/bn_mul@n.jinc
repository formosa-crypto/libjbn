/* libjbn -- bn_mul: schoolbook multiplication/squaring and Montgomery reduction.

   Library module, i.e. template (see README, sections 1 and 2): it is meant
   to be `require`d inside a namespace, which becomes the instance; the tag
   in the file name (@n) gives the kind of namespace. Names below are
   resolved by Jasmin's outward namespace lookup.

   Instance:  MUL (in a size scope)
   Expects:   param int nlimbs;
              UTIL::                       // bn_util
              BN::                         // bn_base, same size
   Provides:  operand-scanning (_os_*) and product-scanning (_ps_*)
              multiplication/squaring; Montgomery reduction __mont_redM
              (constants: P || R-P packed in an array, and -P^-1 mod 2^64)
*/

/******************************************************************
                      OPERAND-SCANNING
*******************************************************************/
#[safety = { requires = is_arr_init(b, 0, 8*nlimbs), ensures = is_arr_init(r, 0, 8*(nlimbs+1)) }]
inline fn __mul1
( reg mut ptr u64[2*nlimbs] r
, reg u64 a
, reg const ptr u64[nlimbs] b
) -> reg u64, reg bool, reg bool, reg ptr u64[2*nlimbs]
{
  inline int i;
  reg bool of, cf;
  reg u64 _zero, lo;
  reg u64[nlimbs+1] rr; // at most 2 alive

  of, cf, _, _, _, _zero = #set0();

  rr[1], rr[0] = #MULX ( a, b[0] );
  r[0] = rr[0]; // kill rr[0]
  for i = 1 to nlimbs {
    rr[i+1], lo = #MULX ( a, b[i] );
    cf, rr[i] = #ADCX ( rr[i], lo, cf );
    r[i] = rr[i]; // kill rr[i]
  }

  cf, rr[nlimbs] = #ADCX ( rr[nlimbs], _zero, cf );
  r[nlimbs] = rr[nlimbs];
  // cf = 0

  return _zero, of, cf, r;
}


/* multiplies a (shifted) scalar by a reg array (remaining iterations of mul) */
/* REGS (params + workspace):  */
#[safety = { requires = 1 <= k && k < nlimbs && is_arr_init(r, 0, 8*(k+nlimbs)) && is_arr_init(b, 0, 8*nlimbs), ensures = is_arr_init(r, 0, 8*(k+nlimbs+1)) }]
inline fn __mul1acc
( inline int k
, reg mut ptr u64[2*nlimbs] r
, reg u64 a
, reg const ptr u64[nlimbs] b
, reg u64 _zero // should be set to 0
, reg bool of cf // should be set to 0
) -> reg u64, reg bool, reg bool, reg ptr u64[2*nlimbs]
{
  inline int i;
  reg u64 hi lo;
  reg u64[nlimbs+1] rr; // at most 2 alive

  rr[0] = r[k];
  for i = 0 to nlimbs-1 {
    rr[i+1] = r[k+i+1];
    hi, lo = #MULX ( a, b[i] ); 
    of, rr[i] = #ADOX ( rr[i], lo, of );
    r[k+i] = rr[i]; // kill rr[i]
    cf, rr[i+1] = #ADCX ( rr[i+1], hi, cf );
  }

  rr[nlimbs], lo = #MULX ( a, b[nlimbs-1] ); // a is now dead!
  of, rr[nlimbs-1] = #ADOX ( rr[nlimbs-1], lo, of );
  r[k+nlimbs-1] = rr[nlimbs-1]; // kill rr[nlimbs-1]

  cf, rr[nlimbs] = #ADCX ( rr[nlimbs], _zero, cf);
  of, rr[nlimbs] = #ADOX ( rr[nlimbs], _zero, of);
  r[k+nlimbs] = rr[nlimbs];
  // cf = 0, of = 0

  return _zero, of, cf, r;
}


/* Operand-scanning multiplication (first arg. as a reg_ptr) */
#[safety = { requires = is_arr_init(a, 0, 8*nlimbs) && is_arr_init(b, 0, 8*nlimbs), ensures = is_arr_init(r, 0, 16*nlimbs) }]
fn _os_muln
( reg mut ptr u64[2*nlimbs] r
, reg const ptr u64[nlimbs] a b //reg u64 fptr,
) -> reg ptr u64[2*nlimbs]
{
  inline int i;
  reg bool of cf;
  reg u64 _zero ai;

  ai = a[0];

  _zero, of, cf, r = __mul1(r, ai, b);

  for i = 1 to nlimbs {
    ai = a[i];
    _zero, of, cf, r = __mul1acc(i, r, ai, b, _zero, of, cf);
  }

  return r;
}

#[safety = { requires = is_arr_init(a, 0, 8*nlimbs) && is_arr_init(b, 0, 8*nlimbs), ensures = is_arr_init(r, 0, 16*nlimbs) }]
inline fn _os_muln_
( reg mut ptr u64[2*nlimbs] r
, reg const ptr u64[nlimbs] a b
) -> reg ptr u64[2*nlimbs]
{
  r = r; a = a; b = b;
  r = _os_muln(r, a, b);
  r = r;
  return r;
}


/*
export fn bn_muln_os(reg u64 rp ap bp)
{
  stack u64[nlimbs] _a _b;
  stack u64[2*nlimbs] _r;
  reg ptr u64[nlimbs] a b;
  reg ptr u64[2*nlimbs] r;

  a = _a;
  a = __load(a,ap);
  b = _b;
  b = __load(b,bp);
  r = _r;
  r = _muln_os_(r, a, b);
  __store2(rp, r);
}
*/

/******************************************************************
                      PRODUCT-SCANNING
*******************************************************************/


// regs: params(5) + 3 = 8
#[safety = { requires = 0 <= istart && iend <= nlimbs && 0 <= k - (iend - 1) && k - istart < nlimbs
               && is_arr_init(x, 0, 24) && is_arr_init(a, 8*istart, 8*(iend - istart))
               && is_arr_init(b, 0, 8*nlimbs),
             ensures = is_arr_init(x, 0, 24) }]
inline fn __muln_innerloop
( reg u64[3] x
, inline int k istart iend
, reg ptr u64[nlimbs] a b
) -> reg u64[3] {
  reg u64 t1, t0;
  inline int i, j;
  for i = istart to iend {
    j = k-i;
    t0 = a[i];
    t1, t0 = t0 * b[j];
    x = UTIL::__addacc3(x, t1, t0, k);
  }
  return x;
}

// regs: params(3) + call(3) + 3(+2) = 9
#[safety = { requires = is_arr_init(a, 0, 8*nlimbs) && is_arr_init(b, 0, 8*nlimbs), ensures = is_arr_init(r, 0, 16*nlimbs) }]
inline fn __ps_muln
( reg mut ptr u64[2*nlimbs] r
, reg const ptr u64[nlimbs] a b
) -> reg ptr u64[2*nlimbs] {
  inline int k;
  reg u64 t0 t1;
  reg u64[3] x;

  t0 = a[0];
  t1, t0 = t0 * b[0];
  r[0] = t0;
  x[1] = t1;
//  _, _, _, _, _, x[2] = #set0();
  x[2] = 0;
//  _, _, _, _, _, x[0] = #set0();
  x[0] = 0;
  for k = 1 to nlimbs {
    x = __muln_innerloop(x, k, 0, k+1, a, b);
    t0 = x[k % 3];
//    _, _, _, _, _, x[k % 3] = #set0();
    x[k % 3] = 0;
    r[k] = t0;
  }
  for k = nlimbs to 2*nlimbs-1 {
    x = __muln_innerloop(x, k, k-nlimbs+1, nlimbs, a, b);
    t0 = x[k % 3];
//    _, _, _, _, _, x[k % 3] = #set0();
    x[k % 3] = 0;
    r[k] = t0;
  }
  r[2*nlimbs-1] = x[(2*nlimbs-1) % 3];
  return r;
}

// regs: params(3) + call(6) = 9
#[safety = { requires = is_arr_init(a, 0, 8*nlimbs) && is_arr_init(b, 0, 8*nlimbs), ensures = is_arr_init(r, 0, 16*nlimbs) }]
fn _ps_muln
( reg mut ptr u64[2*nlimbs] r
, reg const ptr u64[nlimbs] a b
) -> reg ptr u64[2*nlimbs] {
  r = __ps_muln(r, a, b);
  return r;
}

#[safety = { requires = is_arr_init(a, 0, 8*nlimbs) && is_arr_init(b, 0, 8*nlimbs), ensures = is_arr_init(r, 0, 16*nlimbs) }]
inline fn _ps_muln_
( reg mut ptr u64[2*nlimbs] r
, reg const ptr u64[nlimbs] a b
) -> reg ptr u64[2*nlimbs] {
  r = r; a = a; b = b;
  r = _ps_muln(r, a, b);
  r = r;
  return r;
}

/*
export fn bn_ps_muln(reg u64 rp ap bp)
{
  stack u64[nlimbs] _a _b;
  stack u64[2*nlimbs] _r;
  reg ptr u64[nlimbs] a b;
  reg ptr u64[2*nlimbs] r;

  a = _a;
  a = __load(a,ap);
  b = _b;
  b = __load(b,bp);
  r = _r;
  r = _ps_muln_(r, a, b);
  __store2(rp, r);
}
*/


// regs: params(4) + 2 = 6 
#[safety = { requires = 0 <= istart && iend <= nlimbs && 0 <= k - (iend - 1) && k - istart < nlimbs && is_arr_init(x, 0, 24) && is_arr_init(a, 0, 8*nlimbs), ensures = is_arr_init(x, 0, 24) }]
inline fn __sqrn_innerloop
( reg u64[3] x
, inline int k istart iend
, reg const ptr u64[nlimbs] a
) -> reg u64[3] {
  reg u64 ti, tj;
  inline int i, j;
  for i = istart to iend {
    j = k-i;
    ti = a[i];
    tj = a[j];
    x = UTIL::__addacc3x2(x, ti, tj, k);
  }
  return x;
}

#[safety = { requires = is_arr_init(a, 0, 8*nlimbs), ensures = is_arr_init(r, 0, 16*nlimbs) }]
inline fn __ps_sqrn
( reg mut ptr u64[2*nlimbs] r
, reg const ptr u64[nlimbs] a
) -> reg ptr u64[2*nlimbs] {
  inline int k;
  reg u64 t0 t1;
  reg u64[3] x;

  t0 = a[0];
  t1, t0 = t0 * t0;
  r[0] = t0;
  x[1] = t1;
//  _, _, _, _, _, x[2] = #set0();
  x[2] = 0;
//  _, _, _, _, _, x[0] = #set0();
  x[0] = 0;

  for k = 1 to nlimbs {
    x = __sqrn_innerloop(x, k, 0, (k+1)/2, a);
    if (k % 2 == 0) {
      t0 = a[k/2];
      t1, t0 = t0 * t0;
      x = UTIL::__addacc3(x, t1, t0, k);
    }
    t0 = x[k % 3];
//    _, _, _, _, _, x[k % 3] = #set0();
    x[k % 3] = 0;
    r[k] = t0;
  }
  for k = nlimbs to 2*nlimbs-1 {
    x = __sqrn_innerloop(x, k, k-nlimbs+1, (k+1)/2, a);
    if (k % 2 == 0) {
      t0 = a[k/2];
      t1, t0 = t0 * t0;
      x = UTIL::__addacc3(x, t1, t0, k);
    }
    t0 = x[k % 3];
//    _, _, _, _, _, x[k % 3] = #set0();
    x[k % 3] = 0;
    r[k] = t0;
  }
  r[2*nlimbs-1] = x[(2*nlimbs-1) % 3];
  return r;
}

#[safety = { requires = is_arr_init(a, 0, 8*nlimbs), ensures = is_arr_init(r, 0, 16*nlimbs) }]
fn _ps_sqrn
( reg mut ptr u64[2*nlimbs] r
, reg const ptr u64[nlimbs] a
) -> reg ptr u64[2*nlimbs] {
  r = __ps_sqrn(r, a);
  return r;
}

#[safety = { requires = is_arr_init(a, 0, 8*nlimbs), ensures = is_arr_init(r, 0, 16*nlimbs) }]
inline fn _ps_sqrn_
( reg mut ptr u64[2*nlimbs] r
, reg const ptr u64[nlimbs] a
) -> reg ptr u64[2*nlimbs] {
  r = r; a = a;
  r = _ps_sqrn(r, a);
  r = r;
  return r;
}

#[safety = { requires = is_arr_init(a, 0, 8*nlimbs), ensures = is_arr_init(r, 0, 16*nlimbs) }]
inline fn _ps_ksqrn_
( reg mut ptr u64[2*nlimbs] r
, reg mut ptr u64[nlimbs] tmp
, reg const ptr u64[nlimbs] a
) -> reg ptr u64[nlimbs], reg ptr u64[2*nlimbs]
{
  r = _ps_sqrn_( r, a );
  return tmp, r;
}




// ////////////////////////////////////
/* Montgomery reduction: r = a * R^-1 mod P, for a < P * R (R = 2^(64*nlimbs)).
   _P_mP packs P and R - P; _U0 = -P^-1 mod 2^64 (kept on the stack, which
   leaves registers to the callers of a non-inline wrapper). */
#[safety = { requires = is_arr_init(a, 0, 16*nlimbs) && is_arr_init(_P_mP, 0, 16*nlimbs), ensures = is_arr_init(r, 0, 8*nlimbs) }]
inline fn __mont_redM
( reg mut ptr u64[nlimbs] r
, reg const ptr u64[2*nlimbs] a
, reg const ptr u64[2*nlimbs] _P_mP
, stack u64 _U0
) -> reg ptr u64[nlimbs] {
  inline int k;
  reg bool cf;
  reg ptr u64[nlimbs] P mP;
  reg u64 t0 t1 zero lastbit;
  reg u64[3] x;

  x[0] = 0;
  x[1] = 0;
  x[2] = 0;

  P = _P_mP[0:nlimbs];

  for k = 0 to nlimbs {
    x = __muln_innerloop(x, k, 0, k, r, P); //+3
    zero = 0;
    t0 = a[k];
    x = UTIL::__addacc3(x, zero, t0, k);
    t0 = x[k % 3];
    _, t0 = t0 * _U0;
    r[k] = t0;
    t1, t0 = t0 * P[0];
    x = UTIL::__addacc3(x, t1, t0, k);
  }
  for k = nlimbs to 2*nlimbs-1 {
    x = __muln_innerloop(x, k, k-nlimbs+1, nlimbs, r, P); //+3
    zero = 0;
    t0 = a[k];
    x = UTIL::__addacc3(x, zero, t0, k);
    t0 = x[k % 3];
    r[k-nlimbs] = t0;
    x[k % 3] = 0;
  }

  // the accumulator (column 2*nlimbs-1) may exceed one word: its second
  // word is the initial value of the extra (most significant) bit
  lastbit = x[(2*nlimbs) % 3];
  cf, x[(2*nlimbs-1) % 3] += a[2*nlimbs-1];
  _, lastbit += 0 + cf;

  r[nlimbs-1] = x[(2*nlimbs-1) % 3];

  mP = _P_mP[nlimbs:nlimbs];
  r = BN::_cminusP_(r, mP, lastbit);
  return r;
}

