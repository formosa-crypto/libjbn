/* libjbn -- bn_rnd: random bignums.

   Library module, i.e. template (see README, sections 1 and 2): it is meant
   to be `require`d inside a namespace, which becomes the instance; the tag
   in the file name (@n) gives the kind of namespace. Names below are
   resolved by Jasmin's outward namespace lookup.

   Instance:  RND (in a size scope)
   Expects:   param int nlimbs;
              BN::                         // bn_base, same size
   Provides:  _rnd_ _rsample_
*/

/*
/* random bytes */
inline fn _randombytes_
( reg mut ptr u64[nlimbs] a
, inline int n
) -> reg ptr u64[nlimbs] {
  reg ptr u8[8*nlimbs] a_;
  reg ptr u8[n] tmp; // OBS: not allowed!!!
  a_ = a;
  tmp = a_[0:n];
  tmp = #randombytes(tmp);
  return a;
}
*/

/* random number */
inline fn _rnd_
( reg mut ptr u64[nlimbs] a
) -> reg ptr u64[nlimbs] {
  a = a;
  a = #randombytes(a);
  a = a;
  return a;
}

/* mask = 2^k - 1, for k the bit length of bnd (bnd is public: the mask
   only depends on it). hi is all-ones below the most significant non-zero
   limb of bnd. */
inline fn __bnd_mask
( reg mut ptr u64[nlimbs] mask
, reg const ptr u64[nlimbs] bnd
) -> reg ptr u64[nlimbs] {
  inline int i;
  reg u64 w t hi;

  hi = 0;
  for i = nlimbs-1 downto -1 {
    w = bnd[i];
    t = w; t >>= 1;  w |= t;
    t = w; t >>= 2;  w |= t;
    t = w; t >>= 4;  w |= t;
    t = w; t >>= 8;  w |= t;
    t = w; t >>= 16; w |= t;
    t = w; t >>= 32; w |= t;     // w = 2^(bit length of bnd[i]) - 1
    w |= hi;
    mask[i] = w;
    t = w; t = -t; t |= w;       // top bit of (w | -w): w != 0
    t >>s= 63;
    hi |= t;
  }
  return mask;
}

/* rejection sampling: a uniform in [0, bnd), for bnd > 0.
   Each sample is first reduced to the bit length of bnd, so that it is
   accepted with probability > 1/2 whatever the size of bnd (without the
   mask, a bound much shorter than the array is practically never met). */
inline fn _rsample_
( reg mut ptr u64[nlimbs] a
, reg const ptr u64[nlimbs] bnd
) -> reg ptr u64[nlimbs] {
  inline int i;
  reg bool cf;
  reg u64 t;
  stack u64[nlimbs] _mask;
  reg ptr u64[nlimbs] mask;

  mask = _mask;
  mask = __bnd_mask(mask, bnd);
  _mask = mask;

  while {
    a = _rnd_(a);
    for i = 0 to nlimbs {
      t = _mask[i];
      a[i] &= t;
    }
    cf = BN::_lt_cf_(a, bnd);
  }(!cf)
  return a;
}

