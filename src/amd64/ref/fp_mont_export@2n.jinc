/* libjbn -- fp_mont_export: C entry points for a Montgomery field.

   Required at the top level (the 2n scope), so that symbols are unqualified.
   Expects:   H::nlimbs, H::BN::, H::FPM:: // working size n, field FPM
*/

export fn fp_add(reg u64 rp ap bp)
{
  stack u64[H::nlimbs] _a _b;
  reg ptr u64[H::nlimbs] a b;

  a = _a;
  b = _b;
  a = H::BN::_load_(a,ap);
  b = H::BN::_load_(b,bp);
  a = H::FPM::_addmU_(a, b);
  H::BN::_store_(rp, a);
}


export fn fp_sub( reg u64 rp ap bp)
{
  stack u64[H::nlimbs] _a _b;
  reg ptr u64[H::nlimbs] a b;

  a = _a;
  b = _b;
  a = H::BN::_load_(a,ap);
  b = H::BN::_load_(b,bp);
  a = H::FPM::_submU_(a, b);
  H::BN::_store_(rp, a);
}

export fn fp_mul(reg u64 rp ap bp)
{
  stack u64[H::nlimbs] _a _b _r;
  reg ptr u64[H::nlimbs] a b r;

  a = _a;
  b = _b;
  a = H::BN::_load_(a,ap);
  b = H::BN::_load_(b,bp);
  r = _r;
  r = H::FPM::_mulm_(r, a, b);
  H::BN::_store_(rp, r);
}

