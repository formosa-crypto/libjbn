/* libjbn -- fp_mont_export: C entry points for a Montgomery field, with a
   static modulus.

   Required at the top level (the 2n scope), so that symbols are unqualified.
   Expects:   H::nlimbs, H::BN::, H::FPM::  // working size n, field FPM
              H::FPM::glob_ctx              // the context of the modulus
                                            // (e.g. a params/**/*@n.jinc file
                                            // required inside FPM)
*/

#[safety = { requires = is_mem_init(ap, 8*H::nlimbs) && is_mem_init(bp, 8*H::nlimbs) && is_mem_init(rp, 8*H::nlimbs) }]
export fn fp_add(reg u64 rp ap bp)
{
  reg ptr u64[H::FPM::CTXLEN] ctx;
  stack u64[H::nlimbs] _a _b;
  reg ptr u64[H::nlimbs] a b;

  a = _a;
  b = _b;
  a = H::BN::_load_(a,ap);
  b = H::BN::_load_(b,bp);
  ctx = H::FPM::glob_ctx;

  a = H::FPM::_addmU_(a, b, ctx);
  H::BN::_store_(rp, a);
}


#[safety = { requires = is_mem_init(ap, 8*H::nlimbs) && is_mem_init(bp, 8*H::nlimbs) && is_mem_init(rp, 8*H::nlimbs) }]
export fn fp_sub( reg u64 rp ap bp)
{
  reg ptr u64[H::FPM::CTXLEN] ctx;
  stack u64[H::nlimbs] _a _b;
  reg ptr u64[H::nlimbs] a b;

  a = _a;
  b = _b;
  a = H::BN::_load_(a,ap);
  b = H::BN::_load_(b,bp);
  ctx = H::FPM::glob_ctx;

  a = H::FPM::_submU_(a, b, ctx);
  H::BN::_store_(rp, a);
}

#[safety = { requires = is_mem_init(ap, 8*H::nlimbs) && is_mem_init(bp, 8*H::nlimbs) && is_mem_init(rp, 8*H::nlimbs) }]
export fn fp_mul(reg u64 rp ap bp)
{
  reg ptr u64[H::FPM::CTXLEN] ctx;
  stack u64[H::nlimbs] _a _b _r;
  reg ptr u64[H::nlimbs] a b r;

  a = _a;
  b = _b;
  a = H::BN::_load_(a,ap);
  b = H::BN::_load_(b,bp);
  r = _r;
  ctx = H::FPM::glob_ctx;

  r = H::FPM::_mulm_(r, a, b, ctx);
  H::BN::_store_(rp, r);
}

