/* libjbn -- bn_mulsel: multiplication, squaring and Montgomery reduction,
   selected at compile time among the five modules that provide them.

   Library module, i.e. template (see README, sections 1 and 2): it is meant
   to be `require`d inside a namespace, which becomes the instance; the tag
   in the file name (@n) gives the kind of namespace. Names below are
   resolved by Jasmin's outward namespace lookup.

   The choice depends on the CPU features of the profile (JBN_FEATURES) and
   on the size, against the thresholds of the profile (JBN_REG_MAX,
   JBN_UNROLL_MAX and JBN_SQR_UNROLL_MAX, which a size scope may shadow).
   The multiplication and the Montgomery reduction:

     BMI2 and ADX   nlimbs <= JBN_REG_MAX      bn_mulxr (accumulator in
                                               registers)
                    nlimbs <= JBN_UNROLL_MAX   bn_mulx
                    otherwise                  bn_mulx_loop
     otherwise      nlimbs <= JBN_UNROLL_MAX   bn_mul (product scanning)
                    otherwise                  bn_mul_loop

   (JBN_REG_MAX is at most 6: above, the reduction of bn_mulxr does not fit
   the registers.) The squaring is chosen in the same way, with
   JBN_SQR_UNROLL_MAX in the place of JBN_UNROLL_MAX: the looped modules
   square by multiplying, so that the unrolled squaring is worth taking
   above JBN_UNROLL_MAX, for as long as it fits the instruction cache with
   the looped multiplication and reduction (README, "Profiles and the
   selection of the multiplication").

   The tests are on parameters: the compiler emits the selected routines
   only, and the others cost nothing. The five modules are instantiated
   below, in sub-namespaces of this one.

   Instance:  MUL (in a size scope), in the place of bn_mul@n.jinc;
              with fp_mul_sel@fp.jinc in the field
   Expects:   param int nlimbs;
              BN:: UTIL::                  // bn_base (same size), bn_util
              JBN_FEATURES JBN_FEATURES_MULX JBN_REG_MAX JBN_UNROLL_MAX
              JBN_SQR_UNROLL_MAX
                                           // a profile
   Provides:  _muln_ _sqrn_                // inline: one call, to the module
              __mont_redM                  // selected (as in bn_mul)
              (constants: P || R-P packed in an array, and -P^-1 mod 2^64)
*/

namespace UNR   { from Libjbn require "bn_mul@n.jinc" }
namespace LOOP  { from Libjbn require "bn_mul_loop@n.jinc" }
namespace XUNR  { from Libjbn require "bn_mulx@n.jinc" }
namespace XLOOP { from Libjbn require "bn_mulx_loop@n.jinc" }
namespace XREG  { from Libjbn require "bn_mulxr@n.jinc" }

/* (defined after the sub-namespaces: a function may not shadow one that
   is visible from an enclosing namespace) */

/* r = a * b */
#[safety = { requires = is_arr_init(a, 0, 8*nlimbs) && is_arr_init(b, 0, 8*nlimbs), ensures = is_arr_init(r, 0, 16*nlimbs) }]
inline fn _muln_
( reg mut ptr u64[2*nlimbs] r
, reg const ptr u64[nlimbs] a b
) -> reg ptr u64[2*nlimbs]
{
  if ((JBN_FEATURES & JBN_FEATURES_MULX) == JBN_FEATURES_MULX) {
    if (nlimbs <= JBN_REG_MAX) {
      r = XREG::_os_muln_(r, a, b);
    } else if (nlimbs <= JBN_UNROLL_MAX) {
      r = XUNR::_os_muln_(r, a, b);
    } else {
      r = XLOOP::_os_muln_(r, a, b);
    }
  } else {
    if (nlimbs <= JBN_UNROLL_MAX) {
      r = UNR::_ps_muln_(r, a, b);
    } else {
      r = LOOP::_os_muln_(r, a, b);
    }
  }
  return r;
}

/* r = a * a (unrolled up to JBN_SQR_UNROLL_MAX, whatever the multiplication) */
#[safety = { requires = is_arr_init(a, 0, 8*nlimbs), ensures = is_arr_init(r, 0, 16*nlimbs) }]
inline fn _sqrn_
( reg mut ptr u64[2*nlimbs] r
, reg const ptr u64[nlimbs] a
) -> reg ptr u64[2*nlimbs]
{
  if ((JBN_FEATURES & JBN_FEATURES_MULX) == JBN_FEATURES_MULX) {
    if (nlimbs <= JBN_REG_MAX) {
      r = XREG::_os_sqrn_(r, a);
    } else if (nlimbs <= JBN_SQR_UNROLL_MAX) {
      r = XUNR::_os_sqrn_(r, a);
    } else {
      r = XLOOP::_os_sqrn_(r, a);
    }
  } else {
    if (nlimbs <= JBN_SQR_UNROLL_MAX) {
      r = UNR::_ps_sqrn_(r, a);
    } else {
      r = LOOP::_os_sqrn_(r, a);
    }
  }
  return r;
}

/* r = a * R^-1 mod P, for a < P * R (R = 2^(64*nlimbs)); _P_mP packs P and
   R - P, _U0 = -P^-1 mod 2^64 (see bn_mul@n.jinc) */
#[safety = { requires = is_arr_init(a, 0, 16*nlimbs) && is_arr_init(_P_mP, 0, 16*nlimbs), ensures = is_arr_init(r, 0, 8*nlimbs) }]
inline fn __mont_redM
( reg mut ptr u64[nlimbs] r
, reg const ptr u64[2*nlimbs] a
, reg const ptr u64[2*nlimbs] _P_mP
, stack u64 _U0
) -> reg ptr u64[nlimbs]
{
  if ((JBN_FEATURES & JBN_FEATURES_MULX) == JBN_FEATURES_MULX) {
    if (nlimbs <= JBN_REG_MAX) {
      r = XREG::__mont_redM(r, a, _P_mP, _U0);
    } else if (nlimbs <= JBN_UNROLL_MAX) {
      r = XUNR::__mont_redM(r, a, _P_mP, _U0);
    } else {
      r = XLOOP::__mont_redM(r, a, _P_mP, _U0);
    }
  } else {
    if (nlimbs <= JBN_UNROLL_MAX) {
      r = UNR::__mont_redM(r, a, _P_mP, _U0);
    } else {
      r = LOOP::__mont_redM(r, a, _P_mP, _U0);
    }
  }
  return r;
}
