/* libjbn -- bn_mulsel: multiplication, squaring and Montgomery reduction,
   selected at compile time among the four modules that provide them.

   Library module, i.e. template (see README, sections 1 and 2): it is meant
   to be `require`d inside a namespace, which becomes the instance; the tag
   in the file name (@n) gives the kind of namespace. Names below are
   resolved by Jasmin's outward namespace lookup.

   The choice depends on the CPU features of the profile (JBN_FEATURES) and
   on the size, against the unrolling threshold of the profile
   (JBN_UNROLL_MAX, which a size scope may shadow):

                          nlimbs <= JBN_UNROLL_MAX   nlimbs > JBN_UNROLL_MAX
     BMI2 and ADX         bn_mulx                    bn_mulx_loop
     otherwise            bn_mul (product scanning)  bn_mul_loop

   It is made once for the three operations of a size scope, which share
   the instruction cache (README, "Profiles and the selection of the
   multiplication"). The tests are on parameters: the compiler emits the
   selected module only, and the others cost nothing. The four modules are
   instantiated below, in sub-namespaces of this one.

   Instance:  MUL (in a size scope), in the place of bn_mul@n.jinc;
              with fp_mul_sel@fp.jinc in the field
   Expects:   param int nlimbs;
              BN:: UTIL::                  // bn_base (same size), bn_util
              JBN_FEATURES JBN_FEATURES_MULX JBN_UNROLL_MAX   // a profile
   Provides:  _muln_ _sqrn_                // inline: one call, to the module
              __mont_redM                  // selected (as in bn_mul)
              (constants: P || R-P packed in an array, and -P^-1 mod 2^64)
*/

namespace UNR   { from Libjbn require "bn_mul@n.jinc" }
namespace LOOP  { from Libjbn require "bn_mul_loop@n.jinc" }
namespace XUNR  { from Libjbn require "bn_mulx@n.jinc" }
namespace XLOOP { from Libjbn require "bn_mulx_loop@n.jinc" }

/* (defined after the sub-namespaces: a function may not shadow one that
   is visible from an enclosing namespace) */

/* r = a * b */
inline fn _muln_
( reg mut ptr u64[2*nlimbs] r
, reg const ptr u64[nlimbs] a b
) -> reg ptr u64[2*nlimbs]
{
  if ((JBN_FEATURES & JBN_FEATURES_MULX) == JBN_FEATURES_MULX) {
    if (nlimbs <= JBN_UNROLL_MAX) {
      r = XUNR::_os_muln_(r, a, b);
    } else {
      r = XLOOP::_os_muln_(r, a, b);
    }
  } else {
    if (nlimbs <= JBN_UNROLL_MAX) {
      r = UNR::_ps_muln_(r, a, b);
    } else {
      r = LOOP::_os_muln_(r, a, b);
    }
  }
  return r;
}

/* r = a * a */
inline fn _sqrn_
( reg mut ptr u64[2*nlimbs] r
, reg const ptr u64[nlimbs] a
) -> reg ptr u64[2*nlimbs]
{
  if ((JBN_FEATURES & JBN_FEATURES_MULX) == JBN_FEATURES_MULX) {
    if (nlimbs <= JBN_UNROLL_MAX) {
      r = XUNR::_os_sqrn_(r, a);
    } else {
      r = XLOOP::_os_sqrn_(r, a);
    }
  } else {
    if (nlimbs <= JBN_UNROLL_MAX) {
      r = UNR::_ps_sqrn_(r, a);
    } else {
      r = LOOP::_os_sqrn_(r, a);
    }
  }
  return r;
}

/* r = a * R^-1 mod P, for a < P * R (R = 2^(64*nlimbs)); _P_mP packs P and
   R - P, _U0 = -P^-1 mod 2^64 (see bn_mul@n.jinc) */
inline fn __mont_redM
( reg mut ptr u64[nlimbs] r
, reg const ptr u64[2*nlimbs] a
, reg const ptr u64[2*nlimbs] _P_mP
, stack u64 _U0
) -> reg ptr u64[nlimbs]
{
  if ((JBN_FEATURES & JBN_FEATURES_MULX) == JBN_FEATURES_MULX) {
    if (nlimbs <= JBN_UNROLL_MAX) {
      r = XUNR::__mont_redM(r, a, _P_mP, _U0);
    } else {
      r = XLOOP::__mont_redM(r, a, _P_mP, _U0);
    }
  } else {
    if (nlimbs <= JBN_UNROLL_MAX) {
      r = UNR::__mont_redM(r, a, _P_mP, _U0);
    } else {
      r = LOOP::__mont_redM(r, a, _P_mP, _U0);
    }
  }
  return r;
}
