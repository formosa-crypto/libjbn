/* libjbn -- fp_ctx: layout of a field context.

   Library module (see README, sections 1 and 2): it only defines integer
   parameters, so it may be required in any namespace whose nlimbs is the
   size of the field (it is required by fp_base, hence by every field
   namespace).

   A field context gathers the constants of one modulus P, so that the field
   code is shared by all moduli of a size (and P may be a run-time value):

     u64[CTXLEN] ctx = [ P | R-P | ONE | R2 | U0 ]

   with R = 2^(64*nlimbs):
     ctx[CTX_P  : nlimbs]   P            (odd, 1 < P < R)
     ctx[CTX_MP : nlimbs]   R - P
     ctx[CTX_ONE: nlimbs]   the representation of 1 (R mod P in Montgomery
                            form)
     ctx[CTX_R2 : nlimbs]   R^2 mod P    (conversion into Montgomery form)
     ctx[CTX_U0]            -P^-1 mod 2^64
   The first 2*nlimbs words (P || R-P) are the packed constants of
   MUL::__mont_redM.

   Static contexts are global arrays (params/**/*@n.jinc, generated by
   scripts/fp_ctx.py); run-time ones are computed by fp_ctx_init.

   Expects:   param int nlimbs;
   Provides:  CTX_P CTX_MP CTX_ONE CTX_R2 CTX_U0 CTXLEN
*/

param int CTX_P   = 0;
param int CTX_MP  = nlimbs;
param int CTX_ONE = 2*nlimbs;
param int CTX_R2  = 3*nlimbs;
param int CTX_U0  = 4*nlimbs;
param int CTXLEN  = 4*nlimbs + 1;
