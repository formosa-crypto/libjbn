/* Dummy parameters for the abstract extraction (see libjbn_abs.jazz),
   required inside the size scope H, with the values of the selected point
   (dummyA/dummy.jinc or dummyB/dummy.jinc); the function parameters (fun_*)
   are stubs in libjbn_abs.jazz, and the field constants are passed in
   contexts (fp_ctx@n.jinc: 4*nlimbs+1 words). After the correctness
   extraction (point A), the numerals 11, 13, 17, 19, 22, ... are replaced by
   the abstract parameters (scripts/xtr_sync.py). */

param int nlimbsexp = DUMMY_NLIMBSEXP;

/* the profile (src/amd64/ref/profiles): features and thresholds become
   the abstract parameters jbn_features, jbn_reg_max and jbn_unroll_max of
   the theories (no value matters: the proofs cover every branch of the
   selection) */
param int JBN_FEATURES = DUMMY_FEATURES;
param int JBN_REG_MAX = DUMMY_REG_MAX;
param int JBN_UNROLL_MAX = DUMMY_UNROLL_MAX;
param int JBN_SQR_UNROLL_MAX = DUMMY_SQR_UNROLL_MAX;
param int JBN_EXP_WINDOW = DUMMY_EXP_WINDOW;   // jbn_exp_window (bn_exp)
