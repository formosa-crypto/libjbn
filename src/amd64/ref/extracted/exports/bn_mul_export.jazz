/* Abstract instantiation of bn_mul_export@2n.jinc for the safety extraction
   (proof/safety/Makefile, exports): the template in the environment it
   expects, at the dummy point selected by `-I Dummy=dummyA` or `dummyB`
   (see ../libjbn_abs.jazz). The library modules are the real ones, so that
   the calls of the exports carry their contracts; the theory of the exports
   takes the procedures they call as parameters. */

from Dummy require "dummy.jinc"

param int nlimbs = 2*DUMMY_NLIMBS;

from Libjbn require "jbn_features.jinc"

namespace UTIL { from Libjbn require "bn_util.jinc" }

namespace H {
  param int nlimbs = DUMMY_NLIMBS;
  require "../preamb@n.jinc"
  namespace BN  { from Libjbn require "bn_base@n.jinc" }
  namespace MUL { from Libjbn require "bn_mul@n.jinc" }
}

namespace BN { from Libjbn require "bn_base@n.jinc" }     // size 2n (result store)

from Libjbn require "bn_mul_export@2n.jinc"
