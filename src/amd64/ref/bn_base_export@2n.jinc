/* libjbn -- bn_base_export: C entry points for bn_base.

   Required at the top level (the 2n scope), so that symbols are unqualified.
   Expects:   H::nlimbs, H::BN::           // working size n
*/

#[safety = { requires = is_mem_init(ap, 8*H::nlimbs) && is_mem_init(bp, 8*H::nlimbs) }]
export fn bn_eq(reg u64 ap bp) -> reg u64
{
  stack u64[H::nlimbs] _a _b;
  reg ptr u64[H::nlimbs] a b;
  reg u64 r;

  a = _a;
  a = H::BN::_load_(a, ap);
  b = _b;
  b = H::BN::_load_(b, bp);
  r = H::BN::_eq_(a, b);
  r = r;
  return r;
}

#[safety = { requires = is_mem_init(ap, 8*H::nlimbs) }]
export fn bn_test0(reg u64 ap) -> reg u64
{
  stack u64[H::nlimbs] _a;
  reg ptr u64[H::nlimbs] a;
  reg u64 r;
  a = _a;
  a = H::BN::_load_(a, ap);
  r = H::BN::_test0_(a);
  r = r; // avoid extra assignment warning
  return r;
}

#[safety = { requires = is_mem_init(ap, 8*H::nlimbs) && is_mem_init(rp, 8*H::nlimbs) }]
export fn bn_copy(reg u64 rp ap)
{
  inline int i;
  reg u64 t;

  for i = 0 to H::nlimbs {
    t = [ap + 8*i];
    [rp + 8*i] = t;
  }
}

#[safety = { requires = is_mem_init(rp, 8*H::nlimbs) }]
export fn bn_set0(reg u64 rp)
{
  inline int i;

  for i = 0 to H::nlimbs {
    [rp + 8*i] = 0;
  }
}

#[safety = { requires = is_mem_init(ap, 8*H::nlimbs) && is_mem_init(bp, 8*H::nlimbs) && is_mem_init(rp, 8*H::nlimbs) }]
export fn bn_addU(reg u64 rp ap bp)
{
  stack u64[H::nlimbs] _a _b;
  reg ptr u64[H::nlimbs] a b;

  a = _a;
  a = H::BN::_load_(a, ap);
  b = _b;
  b = H::BN::_load_(b, bp);
  _, a = H::BN::_addU_(a, b);
  H::BN::_store_(rp, a);
}

#[safety = { requires = is_mem_init(ap, 8*H::nlimbs) && is_mem_init(bp, 8*H::nlimbs) && is_mem_init(rp, 8*H::nlimbs) }]
export fn bn_subU(reg u64 rp ap bp)
{
 stack u64[H::nlimbs] _a _b;
 reg ptr u64[H::nlimbs] a b;

 a = _a;
 a = H::BN::_load_(a,ap);
 b = _b;
 b = H::BN::_load_(b,bp);
 _, a = H::BN::_subU_(a, b);
 H::BN::_store(rp, a);
}

