/* libjbn -- bn_mulx_loop: multiplication, squaring and Montgomery reduction
   with a run-time loop over the rows (code size linear in nlimbs).

   Library module, i.e. template (see README, sections 1 and 2): it is meant
   to be `require`d inside a namespace, which becomes the instance; the tag
   in the file name (@n) gives the kind of namespace. Names below are
   resolved by Jasmin's outward namespace lookup.

   The rows use MULX/ADCX/ADOX (BMI2 and ADX extensions);
   bn_mul_loop@n.jinc is the same module with MUL/ADD/ADC rows.

   The routines of bn_mul@n.jinc are nested `for` loops, which the compiler
   unrolls into straight-line code whose size is quadratic in nlimbs. Here
   the outer loop (over the rows of operand scanning) is a run-time `while`,
   and only the row (MULX/ADCX/ADOX carry chains) is unrolled. No flag is
   live across a row boundary.

   Instance:  MUL (in a size scope), in the place of bn_mul@n.jinc: the names
              and contracts provided are the ones of that module, so that a
              field (fp_mont) takes either
   Expects:   param int nlimbs;
              BN::                         // bn_base, same size
   Provides:  _os_muln _os_muln_ _os_sqrn _os_sqrn_
              __mont_redM
              (constants: P || R-P packed in an array, and -P^-1 mod 2^64)
*/

/******************************************************************
                      OPERAND-SCANNING
*******************************************************************/

/* first row: r[0..nlimbs] = a * b */
#[safety = { requires = is_arr_init(b, 0, 8*nlimbs), ensures = is_arr_init(r, 0, 8*(nlimbs+1)) }]
inline fn __mul1
( reg mut ptr u64[2*nlimbs] r
, reg u64 a
, reg const ptr u64[nlimbs] b
) -> reg ptr u64[2*nlimbs]
{
  inline int i;
  reg bool cf;
  reg u64 _zero hi lo t;

  _, cf, _, _, _, _zero = #set0();

  hi, lo = #MULX ( a, b[0] );
  r[0] = lo;
  for i = 1 to nlimbs {
    t = hi;
    hi, lo = #MULX ( a, b[i] );
    cf, t = #ADCX ( t, lo, cf );
    r[i] = t;
  }
  cf, hi = #ADCX ( hi, _zero, cf );
  r[nlimbs] = hi;
  // cf = 0

  return r;
}

/* row k (run-time, 0 < k < nlimbs): r[k..k+nlimbs] += a * b,
   where r[k+nlimbs] is not read (it is still to be defined) */
#[safety = { requires = 1 <= (uint) k && (uint) k < nlimbs && is_arr_init(r, 0, 8*((uint) k+nlimbs)) && is_arr_init(b, 0, 8*nlimbs), ensures = is_arr_init(r, 0, 8*((uint) k+nlimbs+1)) }]
inline fn __mul1acc
( reg u64 k
, reg mut ptr u64[2*nlimbs] r
, reg u64 a
, reg const ptr u64[nlimbs] b
) -> reg ptr u64[2*nlimbs]
{
  inline int i;
  reg bool of cf;
  reg u64 _zero hi lo t;

  of, cf, _, _, _, _zero = #set0();

  hi, lo = #MULX ( a, b[0] );
  t = r[k];
  of, t = #ADOX ( t, lo, of );
  r[k] = t;
  for i = 1 to nlimbs {
    t = r[k + i];
    cf, t = #ADCX ( t, hi, cf );
    hi, lo = #MULX ( a, b[i] );
    of, t = #ADOX ( t, lo, of );
    r[k + i] = t;
  }
  cf, hi = #ADCX ( hi, _zero, cf );
  of, hi = #ADOX ( hi, _zero, of );
  r[k + nlimbs] = hi;
  // cf = 0, of = 0

  return r;
}

/* Operand-scanning multiplication */
#[safety = { requires = is_arr_init(a, 0, 8*nlimbs) && is_arr_init(b, 0, 8*nlimbs), ensures = is_arr_init(r, 0, 16*nlimbs) }]
fn _os_muln
( reg mut ptr u64[2*nlimbs] r
, reg const ptr u64[nlimbs] a b
) -> reg ptr u64[2*nlimbs]
{
  reg u64 ai k;

  ai = a[0];
  r = __mul1(r, ai, b);

  k = 1;
  while (k < nlimbs) {
    ai = a[k];
    r = __mul1acc(k, r, ai, b);
    k += 1;
  }

  return r;
}

#[safety = { requires = is_arr_init(a, 0, 8*nlimbs) && is_arr_init(b, 0, 8*nlimbs), ensures = is_arr_init(r, 0, 16*nlimbs) }]
inline fn _os_muln_
( reg mut ptr u64[2*nlimbs] r
, reg const ptr u64[nlimbs] a b
) -> reg ptr u64[2*nlimbs]
{
  r = r; a = a; b = b;
  r = _os_muln(r, a, b);
  r = r;
  return r;
}

/* Squaring (by the multiplication: the symmetry is not exploited) */
#[safety = { requires = is_arr_init(a, 0, 8*nlimbs), ensures = is_arr_init(r, 0, 16*nlimbs) }]
fn _os_sqrn
( reg mut ptr u64[2*nlimbs] r
, reg const ptr u64[nlimbs] a
) -> reg ptr u64[2*nlimbs]
{
  reg u64 ai k;

  ai = a[0];
  r = __mul1(r, ai, a);

  k = 1;
  while (k < nlimbs) {
    ai = a[k];
    r = __mul1acc(k, r, ai, a);
    k += 1;
  }

  return r;
}

#[safety = { requires = is_arr_init(a, 0, 8*nlimbs), ensures = is_arr_init(r, 0, 16*nlimbs) }]
inline fn _os_sqrn_
( reg mut ptr u64[2*nlimbs] r
, reg const ptr u64[nlimbs] a
) -> reg ptr u64[2*nlimbs]
{
  r = r; a = a;
  r = _os_sqrn(r, a);
  r = r;
  return r;
}


// ////////////////////////////////////
/* Montgomery reduction: r = a * R^-1 mod P, for a < P * R (R = 2^(64*nlimbs)).
   _P_mP packs P and R - P; _U0 = -P^-1 mod 2^64 (kept on the stack, which
   leaves registers to the callers of a non-inline wrapper).

   r is a window of nlimbs words over the running value: it starts as the
   low half of a and, at row k,
       [r ; c]  :=  ( r + m * P ) / 2^64  +  ( a[nlimbs+k] + c ) * 2^(64*(nlimbs-1))
   with m = r[0] * _U0 (so that the division is exact) and c the carry (one
   bit) out of the window. After nlimbs rows, [r ; c] = (a + M * P) / R < 2*P. */
#[safety = { requires = is_arr_init(a, 0, 16*nlimbs) && is_arr_init(_P_mP, 0, 16*nlimbs), ensures = is_arr_init(r, 0, 8*nlimbs) }]
inline fn __mont_redM
( reg mut ptr u64[nlimbs] r
, reg const ptr u64[2*nlimbs] a
, reg const ptr u64[2*nlimbs] _P_mP
, stack u64 _U0
) -> reg ptr u64[nlimbs] {
  inline int i;
  reg bool of cf;
  reg ptr u64[nlimbs] mP;
  reg u64 _zero hi lo t m k c;

  for i = 0 to nlimbs {
    t = a[i];
    r[i] = t;
  }

  c = 0;
  k = 0;
  while (k < nlimbs) {
    m = r[0];
    m *= _U0;
    of, cf, _, _, _, _zero = #set0();

    // word 0 of r + m * P is zero: only its carry is kept
    hi, lo = #MULX ( m, _P_mP[0] );
    t = r[0];
    of, t = #ADOX ( t, lo, of );
    for i = 1 to nlimbs {
      t = r[i];
      cf, t = #ADCX ( t, hi, cf );
      hi, lo = #MULX ( m, _P_mP[i] );
      of, t = #ADOX ( t, lo, of );
      r[i-1] = t;
    }
    cf, hi = #ADCX ( hi, _zero, cf );
    of, hi = #ADOX ( hi, _zero, of );
    // cf = 0, of = 0

    // top word: hi + a[nlimbs+k] + c
    _, cf, _, _, _, c = #NEG ( c );
    cf, hi += a[k + nlimbs] + cf;
    r[nlimbs-1] = hi;
    c = #MOV ( 0 );
    _, c += 0 + cf;

    k += 1;
  }

  mP = _P_mP[nlimbs:nlimbs];
  r = BN::_cminusP_(r, mP, c);
  return r;
}
