/* NIST P-384: constants of the prime field modulo P (the curve field).
   glob_ctx is the field context (layout: fp_ctx@n.jinc), generated by
   scripts/fp_ctx.py. Required in a namespace whose nlimbs is 6. */

u64[4*nlimbs+1] glob_ctx = {
  // P
  0x00000000ffffffff,
  0xffffffff00000000,
  0xfffffffffffffffe,
  0xffffffffffffffff,
  0xffffffffffffffff,
  0xffffffffffffffff,
  // R - P, with R = 2^(64*nlimbs)
  0xffffffff00000001,
  0x00000000ffffffff,
  0x0000000000000001,
  0x0000000000000000,
  0x0000000000000000,
  0x0000000000000000,
  // R mod P (1 in Montgomery form)
  0xffffffff00000001,
  0x00000000ffffffff,
  0x0000000000000001,
  0x0000000000000000,
  0x0000000000000000,
  0x0000000000000000,
  // R^2 mod P
  0xfffffffe00000001,
  0x0000000200000000,
  0xfffffffe00000000,
  0x0000000200000000,
  0x0000000000000001,
  0x0000000000000000,
  // -P^-1 mod 2^64
  0x0000000100000001
};

// B param in Montgomery form
u64[nlimbs] glob_BM = {
    0x081188719d412dcc,
    0xf729add87a4c32ec,
    0x77f2209b1920022e,
    0xe3374bee94938ae2,
    0xb62b21f41f022094,
    0xcd08114b604fbff9
};

