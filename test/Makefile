# Tests of the fp_toM, fp_exp and fp_fromM entry points of Montgomery field
# instances (generated by misc/: random primes of MIN_NLIMBS..MAX_NLIMBS
# limbs, MAX_TESTS of each size, the SIKE primes, the RFC 3526 1536- and
# 2048-bit groups), against GMP's mpz_powm: each test program prints the
# checksum of its results, which must be the same for libjbn and gmp.
#
# to run the tests (new instances, then build, run and compare; fails if a
# program does not build or run, or if a checksum differs from gmp's):
#
# $ make -j8 check
#
# (`make compare` compares the checksums of the last `make run`; it needs an
# x86-64 machine with GMP and jasminc.)
#
# in CI, errors are logged instead, and reported at the end:
#
# $ make CI=1 distclean && make -j8 CI=1 default && make CI=1 reporter && \
#   make CI=1 ci_err
#
# to change the number of tests, set MIN_NLIMBS, MAX_NLIMBS, and MAX_TESTS:
#
# $ make -j8 MIN_NLIMBS=1 MAX_NLIMBS=8 MAX_TESTS=100 check
#

CC      ?= clang
CFLAGS  ?= -O3 -Wall -Wpedantic -Wvla -Werror -std=c99 \
	         -Wundef -Wshadow -Wcast-align -Wpointer-arith -Wmissing-prototypes \
	         -fstrict-aliasing -fno-common -pipe

INCLUDE := -Icommon/

#--
TOP         = $(abspath $(dir $(firstword $(MAKEFILE_LIST)))../)
TEST        = $(TOP)/test
SRC         = $(TOP)/src
BIN        ?= bin
PARAMS_DIR ?= $(TEST)/$(BIN)/params

#--
JASMIN ?= jasminc
override JFLAGS +=
export JFLAGS

#--
MIN_NLIMBS  ?= 1
MAX_NLIMBS  ?= 8
MAX_TESTS   ?= 2

export MIN_NLIMBS
export MAX_NLIMBS
export MAX_TESTS

# -----------------------------------------------------------------------------
TESTS_FP_LIBS      := libjbn gmp
TESTS_FP_DEFINED   := exp
TESTS_FP_BASE_NAME := $(patsubst %.s, %, $(subst libjbn_,, $(notdir $(shell test -d $(PARAMS_DIR) && find $(PARAMS_DIR) -name '*.s'))))

TESTS_FP     := $(addprefix $(BIN)/fp/, $(foreach LB, $(TESTS_FP_LIBS), $(foreach TD, $(TESTS_FP_DEFINED), $(foreach BN,$(TESTS_FP_BASE_NAME),$(LB)_$(TD)_$(BN)))))
TESTS_FP_BIN := $(addsuffix .bin, $(TESTS_FP))
TESTS_FP_OUT := $(addsuffix .out, $(TESTS_FP))


# -----------------------------------------------------------------------------
# CI   - 0 or 1 depending if in CI or not : example : $ make ... CI=1 ...
# CID  - CI DIRNAME
# CIDR - CI DIRNAME to be used in RULES
# CIC  - CI CLEAR logs and errors
# CIL  - CI LOG stderr
# CILA - CI LOG stderr in append (>>)

CI      ?= 0
export CI

CID  =
CIC  = true
CIL  =
CICL ?= "1"

ifeq ($(CI),1)
CID  = .ci
CIDR = $(@D)/$(CID)

CIC  = (rm -f $(CIDR)/$(@F).*)

CIL  = 2> $(CIDR)/$(@F).log || \
       (echo $$? | cat - $(CIDR)/$(@F).log > $(CIDR)/$(@F).error && \
        rm -f $(CIDR)/$(@F).log)

CILA = 2>> $(CIDR)/$(@F).log || \
       (echo $$? | cat - $(CIDR)/$(@F).log >> $(CIDR)/$(@F).error && \
        rm -f $(CIDR)/$(@F).log)
endif


# -----------------------------------------------------------------------------
default:
	$(MAKE) -C misc/ default
	$(MAKE) run

exec: $(TESTS_FP_BIN)
run: $(TESTS_FP_OUT)

# new instances, then all programs rebuilt (their rules do not depend on the
# instances or on the library), run and compared
check:
	$(MAKE) -C misc/ default
	rm -rf $(BIN)/fp
	$(MAKE) run
	$(MAKE) compare

# compares the checksums of libjbn and gmp (bin/fp/*.out); fails if one
# differs, or if there is none
compare:
	@rm -f $(BIN)/fp/*.checksum_match_with_*
	@./scripts/checksum-compare.sh $(BIN)/ libjbn gmp
	@total=$$(find $(BIN)/fp -name 'libjbn_*.out' 2>/dev/null | wc -l | tr -d ' '); \
	 bad=$$(find $(BIN)/fp -name '*.checksum_match_with_gmp.error' 2>/dev/null | wc -l | tr -d ' '); \
	 if [ "$$total" -eq 0 ]; then echo "compare: no results in $(BIN)/fp (make run)"; exit 1; fi; \
	 if [ "$$bad" -ne 0 ]; then echo "compare: $$bad of $$total instances differ from gmp"; exit 1; fi; \
	 echo "compare: the $$total instances agree with gmp"

# -----------------------------------------------------------------------------
# expm or mul or ...
GET_TEST        = $(word 1, $(subst _, ,$*))

# d(eterministic) or r(andom)
GET_TYPE        = $(word 2, $(subst _, ,$*))

# number of limbs
GET_LIMBS       = $(word 3, $(subst _, ,$*))

# test number
GET_TEST_NUMBER = $(word 4, $(subst _, ,$*))

#--
$(TESTS_FP_BIN):
$(BIN)/fp/gmp_%.bin: $(BIN)/fp/$(CID)
	$(CC) $(CFLAGS) -o $@ -DNLIMBS=$(GET_LIMBS) $(INCLUDE) common/fp/try-$(GET_TEST).c \
   common/fp/gmp-$(GET_TEST).c $(PARAMS_DIR)/libjbn_$(GET_TYPE)_$(GET_LIMBS)_$(GET_TEST_NUMBER).c -lgmp $(CIL)

$(BIN)/fp/libjbn_%.bin: | $(BIN)/fp/$(CID)
	$(CC) $(CFLAGS) -o $@ -DNLIMBS=$(GET_LIMBS) $(INCLUDE) common/fp/try-$(GET_TEST).c \
   common/fp/libjbn-$(GET_TEST).c $(PARAMS_DIR)/libjbn_$(GET_TYPE)_$(GET_LIMBS)_$(GET_TEST_NUMBER).c \
   $(PARAMS_DIR)/libjbn_$(GET_TYPE)_$(GET_LIMBS)_$(GET_TEST_NUMBER).s -lgmp $(CIL)

#--
$(TESTS_FP_OUT):
$(BIN)/fp/%.out: $(BIN)/fp/%.bin | $(BIN)/fp/$(CID)
	./$< > $@ $(CIL)

#--
$(BIN)/fp/: ; mkdir -p $@


# -----------------------------------------------------------------------------
ifeq ($(CI),1)

CI_TAR_NAME := libjbn-test.tar.gz

.PRECIOUS: %/$(CID)
%/$(CID): ; mkdir -p $@

.PRECIOUS: $(CID)
$(CID): ; mkdir -p $@

.PHONY: reporter

reporter:
	$(MAKE) reporter_fp_compile
	$(MAKE) reporter_fp_run
	$(MAKE) reporter_fp_checksums
	$(MAKE) $(CI_TAR_NAME)

reporter_fp_compile:
	./../scripts/ci/reporter/jlog "Status: fp: $(TEST)/$(BIN)/fp/*.bin" $(TEST)/$(BIN)/fp/$(CID)/ "*.bin" $(CICL)

reporter_fp_run:
	./../scripts/ci/reporter/jlog "Status: fp $(TEST)/$(BIN)/fp/*.out" $(TEST)/$(BIN)/fp/$(CID)/ "*.out" $(CICL)

reporter_fp_checksums:
	./scripts/checksum-compare.sh $(BIN)/ libjbn gmp
	./../scripts/ci/reporter/jlog "Status: $(TEST)/$(BIN)/fp/*.checksum*" $(TEST)/$(BIN)/fp/ "*checksum_match_with*" $(CICL)

CI_ERR := $(shell test -d $(TEST)/$(BIN)/ && find $(TEST)/$(BIN)/ -name '*.error')
CI_WARNINGS := $(shell test -d $(TEST)/$(BIN)/ && find $(TEST)/$(BIN)/ -name '*.log')

CI_FILES_TO_TAR := $(CI_ERR) $(CI_WARNINGS)

.PHONY: $(CI_TAR_NAME)
$(CI_TAR_NAME):
	@$(JASMIN) -version > notes
ifeq ($(words $(CI_FILES_TO_TAR)),0)
	@echo "good job." >> notes
	@tar -zcvf $@ notes
else
	@tar -zcvf $@ notes $(CI_FILES_TO_TAR)
endif
	@rm notes

ci_err:
ifneq ($(words $(CI_ERR)),0)
	$(error $(CI_ERR))
endif

endif


# -----------------------------------------------------------------------------
.PHONY: default exec run check compare clean-out clean-bin clean distclean

clean-out:
	rm -f $(BIN)/*.out

clean-bin:
	rm -f $(BIN)/*.bin

clean:
	rm -fr $(BIN) $(CI_TAR_NAME)

distclean: clean

